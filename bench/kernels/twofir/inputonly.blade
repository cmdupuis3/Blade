// twofir inputonly twin -- the input generation and input_checksum of twofir.blade, kernel
// and checksum omitted (kernels/README.md section 3.3: incremental = median(total) -
// median(inputonly)).

type I = Idx<2000003>   // SIZE n

/// README section 5 input generator: five rounds mod 2^31 (affine, quadratic, affine,
/// middle-square, affine), exact in Int64 (h3 * h3 < 2^62).
function gen(k: Int64, seed: Int64, lo: Float64, hi: Float64) -> Float64 = {
    let h1 = ((k + seed) * 1103515245 + 12345) % 2147483648
    let h2 = (h1 * (h1 / 4096 + 1)) % 2147483648
    let h3 = (h2 * 1103515245 + 12345) % 2147483648
    let h4 = (h3 * h3 / 65536) % 2147483648
    let h5 = (h4 * 1103515245 + 12345) % 2147483648
    lo + (hi - lo) * (Float64(h5) / 2147483648.0)
}

function inputs() -> Array<Float64 like I> = {
    method_for(range<I>) <@> lambda(i) where omp -> gen(Int64(i), 10000019, 0.0, 1.0) |> compute
}

function input_sum(x: Array<Float64 like I>) -> Float64 = {
    let s = reduce(x, lambda(p, q) where omp -> p + q, 0.0, axes = 1)
    s
}

let (checksum, input_checksum) = {
    let x = inputs()
    (Float64(0.0), input_sum(x))
}
