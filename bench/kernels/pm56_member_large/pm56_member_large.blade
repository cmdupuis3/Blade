// pm56_member_large -- PM56 membership-representation control (bench/RESULTS.md section 20 (round 4 wave 5, lane E))
//
//   set = (e * gap : e < m) (Int64);  probe(i) = hash(i) mod (m * gap)  (hit rate ~ 1 / gap)
//   keep = mask(probe, contains(set, .));  ids = compound(probe, keep)
//   checksum = sum ids + |ids|  (exact integers)
// The arms differ only in membership hoisting's representation (BLADE_MEMBER_HOIST): the
// chooser (plain blade-cpp), forced linear / bitmap / hash, or off (the per-cell scan).

type Ix = Idx<2000003>   // SIZE n
type Ev = Idx<100003>   // SIZE m
let static gap = 3   // SIZE gap

/// README section 5 input generator: five rounds mod 2^31 (affine, quadratic, affine,
/// middle-square, affine), exact in Int64 (h3 * h3 < 2^62).
function hash(k: Int64, seed: Int64) -> Int64 = {
    let h1 = ((k + seed) * 1103515245 + 12345) % 2147483648
    let h2 = (h1 * (h1 / 4096 + 1)) % 2147483648
    let h3 = (h2 * 1103515245 + 12345) % 2147483648
    let h4 = (h3 * h3 / 65536) % 2147483648
    (h4 * 1103515245 + 12345) % 2147483648
}

function gen(k: Int64, seed: Int64, lo: Float64, hi: Float64) -> Float64 = {
    lo + (hi - lo) * (Float64(hash(k, seed)) / 2147483648.0)
}

let set = method_for(range<Ev>) <@> lambda(e) -> Int64(e) * Int64(gap) |> compute
let probe = method_for(range<Ix>) <@> lambda(i) -> hash(Int64(i), 10000019) % (Int64(extents(set)) * Int64(gap)) |> compute
let keep = mask(probe, lambda(c) -> contains(set, c))
let ids = compound(probe, keep)
let checksum = Float64(reduce(ids, (+))) + Float64(extents(ids))
let input_checksum = Float64(reduce(set, (+))) + Float64(reduce(probe, (+)))
