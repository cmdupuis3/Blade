// pm50_stride -- PM50 inputonly twin of the strided-traversal control (bench/RESULTS.md section 20 (round 4 wave 5, lane E))
//
//   Y: r x s doubles (row-major), every cell read once per repetition, COLUMN by column:
//   the inner fold walks Y(j, c) for j ascending, a stride of s doubles (s * 8 bytes).
//   checksum = sum_t w_t * sum_(c, j) Y(j, c),  w_t = 1 + 0.001 t, t < k
// s = 1 is the contiguous reference; 8 (one 64 B line) and 512 (one 4 KiB page) appear only
// with their odd neighbours (7, 9, 511, 513).

type R = Idx<6000011>   // SIZE r
type C = Idx<1>   // SIZE s
type Rep = Idx<11>   // SIZE k

/// README section 5 input generator: five rounds mod 2^31 (affine, quadratic, affine,
/// middle-square, affine), exact in Int64 (h3 * h3 < 2^62).
function hash(k: Int64, seed: Int64) -> Int64 = {
    let h1 = ((k + seed) * 1103515245 + 12345) % 2147483648
    let h2 = (h1 * (h1 / 4096 + 1)) % 2147483648
    let h3 = (h2 * 1103515245 + 12345) % 2147483648
    let h4 = (h3 * h3 / 65536) % 2147483648
    (h4 * 1103515245 + 12345) % 2147483648
}

function gen(k: Int64, seed: Int64, lo: Float64, hi: Float64) -> Float64 = {
    lo + (hi - lo) * (Float64(hash(k, seed)) / 2147483648.0)
}

function inputs(seed: Int64) -> Array<Float64 like R, C> = {
    method_for(range<R, C>) <@> lambda(j, c) -> gen(Int64(j) + Int64(c) * 1000003, seed, 0.0, 1.0) |> compute
}

let (checksum, input_checksum) = {
    let y = inputs(10000019)
    (Float64(0.0), reduce(y, (+), axes = 2))
}
