// pm53_triad_omp -- PM53 worker-saturation control (bench/RESULTS.md section 20 (round 4 wave 5, lane E))
//
//   the pm49_triad64 recurrence with the step map licensed `where omp(a: 1)`:
//   z(0) = x;  z(t) = 0.5 z(t-1) + y;  checksum = sum z(k-1)^2
// The omp request keeps the step a materialized map with its own per-step team; the ring row
// is then copied (`blade plan`: rec-step-parallel and slice-write-fusion declined), so a step
// moves 5 logical streams (read z(t-1), y; write the step pool; read it; write the ring row).
// Arms differ only in OMP_NUM_THREADS (variants p1 / p3 / p5; plain blade-cpp = 8).

type Ix = Idx<1500007>   // SIZE n
type Step = Idx<21>   // SIZE k

/// README section 5 input generator: five rounds mod 2^31 (affine, quadratic, affine,
/// middle-square, affine), exact in Int64 (h3 * h3 < 2^62).
function hash(k: Int64, seed: Int64) -> Int64 = {
    let h1 = ((k + seed) * 1103515245 + 12345) % 2147483648
    let h2 = (h1 * (h1 / 4096 + 1)) % 2147483648
    let h3 = (h2 * 1103515245 + 12345) % 2147483648
    let h4 = (h3 * h3 / 65536) % 2147483648
    (h4 * 1103515245 + 12345) % 2147483648
}

function gen(k: Int64, seed: Int64, lo: Float64, hi: Float64) -> Float64 = {
    lo + (hi - lo) * (Float64(hash(k, seed)) / 2147483648.0)
}

function inputs(seed: Int64) -> Array<Float64 like Ix> = {
    method_for(range<Ix>) <@> lambda(i) where omp -> gen(Int64(i), seed, 0.0, 1.0) |> compute
}

function step(u: Array<Float64 like Ix>, y: Array<Float64 like Ix>) -> Array<Float64 like Ix> = {
    method_for(zip(u, y)) <@> lambda(a, b) where omp(a: 1) -> 0.5 * a + b |> compute
}

function kernel(x: Array<Float64 like Ix>, y: Array<Float64 like Ix>) -> Float64 = {
    let rec z: Array<Float64 like Step, Ix> =
        match z with
        | zero -> zero
        | zero :: s -> zero :: x
        | prefix :: n -> prefix :: step(prefix(n - 1), y)
    let last = z(20)   // SIZE kl
    reduce(method_for(last) <@> lambda(w) -> w * w, lambda(p, q) where omp -> p + q, 0.0)
}

let (checksum, input_checksum) = {
    let x = inputs(10000019)
    let y = inputs(20000038)
    (kernel(x, y), reduce(x, (+)) + reduce(y, (+)))
}
