// tensorop inputonly twin -- the input generation and input_checksum of tensorop.blade,
// kernel and checksum omitted (kernels/README.md section 3.3: incremental = median(total) -
// median(inputonly)).

let static n1: Int64 = 89    // SIZE n1
let static n2: Int64 = 97    // SIZE n2
let static n3: Int64 = 101   // SIZE n3
type I = Idx<n1>
type J = Idx<n2>
type K = Idx<n3>

/// README section 5 input generator: five rounds mod 2^31 (affine, quadratic, affine,
/// middle-square, affine), exact in Int64 (h3 * h3 < 2^62).
function gen(k: Int64, seed: Int64, lo: Float64, hi: Float64) -> Float64 = {
    let h1 = ((k + seed) * 1103515245 + 12345) % 2147483648
    let h2 = (h1 * (h1 / 4096 + 1)) % 2147483648
    let h3 = (h2 * 1103515245 + 12345) % 2147483648
    let h4 = (h3 * h3 / 65536) % 2147483648
    let h5 = (h4 * 1103515245 + 12345) % 2147483648
    lo + (hi - lo) * (Float64(h5) / 2147483648.0)
}

function gen_x() -> Array<Float64 like I, J, K> = {
    method_for(range<I, J, K>) <@> lambda(i, j, k) where omp(i: 1) ->
        gen((Int64(i) * n2 + Int64(j)) * n3 + Int64(k), 10000019, 0.0, 1.0) |> compute
}
function gen_a() -> Array<Float64 like I, I> = {
    method_for(range<I, I>) <@> lambda(a, i) where omp(a: 1) -> gen(Int64(a) * n1 + Int64(i), 20000038, 0.0, 1.0) |> compute
}
function gen_b() -> Array<Float64 like J, J> = {
    method_for(range<J, J>) <@> lambda(b, j) where omp(b: 1) -> gen(Int64(b) * n2 + Int64(j), 30000057, 0.0, 1.0) |> compute
}
function gen_c() -> Array<Float64 like K, K> = {
    method_for(range<K, K>) <@> lambda(c, k) where omp(c: 1) -> gen(Int64(c) * n3 + Int64(k), 40000076, 0.0, 1.0) |> compute
}

function input_sum(x: Array<Float64 like I, J, K>, am: Array<Float64 like I, I>,
                   bm: Array<Float64 like J, J>, cm: Array<Float64 like K, K>) -> Float64 = {
    let sx = reduce(method_for(range<I>) <@> lambda(i) ->
                        reduce(method_for(range<J>) <@> lambda(j) -> reduce(x(i, j), (+)), (+)),
                    lambda(p, q) where omp -> p + q, 0.0)
    let sa = reduce(method_for(range<I>) <@> lambda(a) -> reduce(am(a), (+)), lambda(p, q) where omp -> p + q, 0.0)
    let sb = reduce(method_for(range<J>) <@> lambda(b) -> reduce(bm(b), (+)), lambda(p, q) where omp -> p + q, 0.0)
    let sc = reduce(method_for(range<K>) <@> lambda(c) -> reduce(cm(c), (+)), lambda(p, q) where omp -> p + q, 0.0)
    sx + sa + sb + sc
}

let (checksum, input_checksum) = {
    let x = gen_x()
    let am = gen_a()
    let bm = gen_b()
    let cm = gen_c()
    (Float64(0.0), input_sum(x, am, bm, cm))
}
