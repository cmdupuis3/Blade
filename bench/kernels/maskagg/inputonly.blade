// maskagg inputonly twin -- the input generation and input_checksum of maskagg.blade, kernel
// omitted (README section 5: net = median(total) - median(inputonly)). The kernel source keeps
// x at top level only because compound is top-level-only; the twin has no compound, so it keeps
// x inside the contract block (the same generating loop is emitted either way) and is safe in
// the LLVM lane too, which ignores --print and would echo a top-level x after the clock.

type Ix = Idx<1000003>   // SIZE n

/// README section 5 input generator: five rounds mod 2^31 (affine, quadratic, affine,
/// middle-square, affine), exact in Int64 (h3 * h3 < 2^62).
function gen(k: Int64, seed: Int64, lo: Float64, hi: Float64) -> Float64 = {
    let h1 = ((k + seed) * 1103515245 + 12345) % 2147483648
    let h2 = (h1 * (h1 / 4096 + 1)) % 2147483648
    let h3 = (h2 * 1103515245 + 12345) % 2147483648
    let h4 = (h3 * h3 / 65536) % 2147483648
    let h5 = (h4 * 1103515245 + 12345) % 2147483648
    lo + (hi - lo) * (Float64(h5) / 2147483648.0)
}

function inputs() -> Array<Float64 like Ix> = {
    method_for(range<Ix>) <@> lambda(i) -> gen(Int64(i), 10000019, 0.0, 2.0) |> compute
}

let (checksum, input_checksum) = {
    let x = inputs()
    (Float64(0.0), reduce(x, (+)))
}
