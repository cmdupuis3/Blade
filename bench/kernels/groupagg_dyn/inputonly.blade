// groupagg_dyn inputonly twin -- the input generation and input_checksum of groupagg_dyn.blade,
// the kernel omitted and checksum = 0.0 (README section 5: net = median(total) - median(inputonly)).

type Ix = Idx<1000003>   // SIZE n
// G is the dynamic keys' source range only: no grouping is declared over it.
type G = Idx<1009>       // SIZE ngroups

/// README section 5 input generator: five rounds mod 2^31 (affine, quadratic, affine,
/// middle-square, affine), exact in Int64 (h3 * h3 < 2^62).
function gen(k: Int64, seed: Int64, lo: Float64, hi: Float64) -> Float64 = {
    let h1 = ((k + seed) * 1103515245 + 12345) % 2147483648
    let h2 = (h1 * (h1 / 4096 + 1)) % 2147483648
    let h3 = (h2 * 1103515245 + 12345) % 2147483648
    let h4 = (h3 * h3 / 65536) % 2147483648
    let h5 = (h4 * 1103515245 + 12345) % 2147483648
    lo + (hi - lo) * (Float64(h5) / 2147483648.0)
}

function keys() -> Array<Int64 like Ix> = {
    method_for(range<Ix>) <@> lambda(i) -> 7919 * Int64(floor(gen(Int64(i), 10000019, 0.0, 1.0) * Float64(extents(range<G>)))) + 13 |> compute
}

function values() -> Array<Float64 like Ix> = {
    method_for(range<Ix>) <@> lambda(i) -> gen(Int64(i), 20000038, 0.0, 2.0) |> compute
}

let (checksum, input_checksum) = {
    let key = keys()
    let x = values()
    (Float64(0.0), reduce(x, (+)) + Float64(reduce(key, (+))))
}
