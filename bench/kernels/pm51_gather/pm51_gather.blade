// pm51_gather -- PM51 gather-locality control (bench/RESULTS.md section 20 (round 4 wave 5, lane E))
//
//   idx(i) by kind: 1 identity (sequential), 2 permutation i * 3708013 mod n (n prime: a full,
//   scattered permutation), 3 permutation inside blocks of 1021 (clustered), 4 repeated:
//   hash(i) mod n (random with replacement), 5 repeated inside blocks of 1021.
//   checksum = sum_t sum_i y(idx(i)) * w_t,  w_t = 1 + 0.001 t,  t < k
// Every kind reads the same n index cells and n gathered values per repetition; both arms
// build the identical index sequence.

type Ix = Idx<6000011>   // SIZE n
type Rep = Idx<11>   // SIZE k
let static kind = 1   // SIZE kind

/// README section 5 input generator: five rounds mod 2^31 (affine, quadratic, affine,
/// middle-square, affine), exact in Int64 (h3 * h3 < 2^62).
function hash(k: Int64, seed: Int64) -> Int64 = {
    let h1 = ((k + seed) * 1103515245 + 12345) % 2147483648
    let h2 = (h1 * (h1 / 4096 + 1)) % 2147483648
    let h3 = (h2 * 1103515245 + 12345) % 2147483648
    let h4 = (h3 * h3 / 65536) % 2147483648
    (h4 * 1103515245 + 12345) % 2147483648
}

function gen(k: Int64, seed: Int64, lo: Float64, hi: Float64) -> Float64 = {
    lo + (hi - lo) * (Float64(hash(k, seed)) / 2147483648.0)
}

function inputs(seed: Int64) -> Array<Float64 like Ix> = {
    method_for(range<Ix>) <@> lambda(i) -> gen(Int64(i), seed, 0.0, 1.0) |> compute
}

function index_of(i: Int64, n: Int64) -> Int64 = {
    let b = i / 1021
    let whole = (b + 1) * 1021 <= n
    if kind == 1 then i
    else if kind == 2 then (i * 3708013) % n
    else if kind == 3 then (if whole then b * 1021 + ((i % 1021) * 523) % 1021 else i)
    else if kind == 4 then hash(i, 30000057) % n
    else (if whole then b * 1021 + hash(i, 30000057) % 1021 else i)
}

function indices(n: Int64) -> Array<Int64 like Ix> = {
    method_for(range<Ix>) <@> lambda(i) -> index_of(Int64(i), n) |> compute
}

function kernel(y: Array<Float64 like Ix>, idx: Array<Int64 like Ix>) -> Float64 = {
    reduce(method_for(range<Rep>) <@> lambda(t) -> {
        let w = 1.0 + 0.001 * Float64(t)
        reduce(method_for(idx) <@> lambda(j) -> y((j : Ix)) * w, (+))
    }, (+))
}

let (checksum, input_checksum) = {
    let y = inputs(10000019)
    let idx = indices(Int64(extents(y)))
    (kernel(y, idx), reduce(y, (+)) + Float64(reduce(idx, (+))))
}
