// gram: G = X X^T (bench/kernels/gram/spec.md), G(i, j) = sum_s X(i, s) X(j, s), for p
// variables x n samples.
// `where comm(a, b)` on the SAME array in both positions derives packed SymIdx<2, p>
// storage (C(p+1, 2) cells) and triangular iteration; `omp(a: 1)` licenses threading
// over the variable axis (emitted only when BLADE_OMP_THREADS is unset).
let static p = 61    // SIZE p
let static n = 31    // SIZE n
type Var = Idx<p>
type Obs = Idx<n>

/// The suite's input generator (bench/README.md section 5, variant D: five rounds): u in [0, 1),
/// exact in Int64 (h3 * h3 < 2^62).
function lcg(k: Int64, seed: Int64) -> Float64 = {
    let h1 = ((k + seed) * 1103515245 + 12345) % 2147483648
    let h2 = (h1 * (h1 / 4096 + 1)) % 2147483648
    let h3 = (h2 * 1103515245 + 12345) % 2147483648
    let h4 = (h3 * h3 / 65536) % 2147483648
    let h5 = (h4 * 1103515245 + 12345) % 2147483648
    Float64(h5) / 2147483648.0
}

let (checksum, input_checksum) = {
    let x = method_for(range<Var>, range<Obs>) <@> lambda(i, s) -> lcg(i * n + s, 10000019) |> compute
    // prodsum is the fused contraction; `reduce(a * b, (+))` would allocate a length-n
    // temporary per cell in the C++ lane (notes/llvm-acceptance-A.md F2).
    // rows typed concretely (Array like Obs) so the dot loop has the constant trip count n
    let g = method_for(x, x) <@> lambda(a: Array<Float64 like Obs>, b: Array<Float64 like Obs>) where comm(a, b), omp(a: 1) -> prodsum(a, b) |> compute
    // the logical sum of squares through the canonicalizing accessor (README 7.2)
    let ss = reduce(method_for(range<Var>) <@> lambda(i) -> reduce(method_for(range<Var>) <@> lambda(j) -> g(i, j) * g(i, j), (+)), (+))
    (ss, reduce(reduce(x, (+)), (+)))
}
