// comoment3: the raw third-moment tensor (bench/kernels/comoment3/spec.md),
// T(i, j, k) = (1/n) sum_s X(i, s) X(j, s) X(k, s),
// over p variables x n samples. `where comm(a, b, c)` on the SAME array in three adjacent
// positions derives packed SymIdx<3, p> storage (C(p+2, 3) cells) and simplex iteration.
let static p = 13    // SIZE p
let static n = 11    // SIZE n
type Var = Idx<p>
type Obs = Idx<n>

/// The suite's input generator (bench/README.md section 5, variant D: five rounds): u in [0, 1),
/// exact in Int64 (h3 * h3 < 2^62).
function lcg(k: Int64, seed: Int64) -> Float64 = {
    let h1 = ((k + seed) * 1103515245 + 12345) % 2147483648
    let h2 = (h1 * (h1 / 4096 + 1)) % 2147483648
    let h3 = (h2 * 1103515245 + 12345) % 2147483648
    let h4 = (h3 * h3 / 65536) % 2147483648
    let h5 = (h4 * 1103515245 + 12345) % 2147483648
    Float64(h5) / 2147483648.0
}

let (checksum, input_checksum) = {
    let x = method_for(range<Var>, range<Obs>) <@> lambda(i, s) -> lcg(i * n + s, 10000019) |> compute
    // prodsum is the fused contraction; `reduce(a * b * c, (+))` would allocate a length-n
    // temporary per cell in the C++ lane (notes/llvm-acceptance-A.md F2, F11).
    // rows typed concretely (Array like Obs) so the dot loop has the constant trip count n
    let t = method_for(x, x, x) <@> lambda(a: Array<Float64 like Obs>, b: Array<Float64 like Obs>, c: Array<Float64 like Obs>) where comm(a, b, c), omp(a: 1) -> prodsum(a, b, c) / Float64(n) |> compute
    // the logical sum of squares through the canonicalizing accessor (README 7.2)
    let ss = reduce(method_for(range<Var>) <@> lambda(i) -> reduce(method_for(range<Var>) <@> lambda(j) -> reduce(method_for(range<Var>) <@> lambda(k) -> t(i, j, k) * t(i, j, k), (+)), (+)), (+))
    (ss, reduce(reduce(x, (+)), (+)))
}
