// fusedchain -- a chain of elementwise stages consumed by one reduction (bench/kernels/fusedchain/spec.md)
//
//   s1 = 1.5 a + 0.25;  s2 = s1 / (1 + |s1|);  s3 = s2^2 - 0.5 s2;  checksum = sum s3^2
//
// The stages are first-class loop objects composed with >>@ before any data is touched;
// applying the composition to `a` and folding it is ONE traversal (no stage temporary).
// The fold carries the parallelism licence (`where omp` on a builtin `+`, bound to its own
// let); the input generator carries the map licence. BLADE_OMP_THREADS=1 builds the serial arm.

type Ix = Idx<20011>   // SIZE n

/// README section 5 input generator: five rounds mod 2^31 (affine, quadratic, affine,
/// middle-square, affine), exact in Int64 (h3 * h3 < 2^62).
function gen(k: Int64, seed: Int64, lo: Float64, hi: Float64) -> Float64 = {
    let h1 = ((k + seed) * 1103515245 + 12345) % 2147483648
    let h2 = (h1 * (h1 / 4096 + 1)) % 2147483648
    let h3 = (h2 * 1103515245 + 12345) % 2147483648
    let h4 = (h3 * h3 / 65536) % 2147483648
    let h5 = (h4 * 1103515245 + 12345) % 2147483648
    lo + (hi - lo) * (Float64(h5) / 2147483648.0)
}

function inputs() -> Array<Float64 like Ix> = {
    method_for(range<Ix>) <@> lambda(i) where omp -> gen(Int64(i), 10000019, 0.0, 1.0) |> compute
}

// ---- the stages, as values -----------------------------------------------------------
let affine = lambda(v) -> 1.5 * v + 0.25
let squash = lambda(v) -> v / (1.0 + abs(v))
let bend = lambda(v) -> v * v - 0.5 * v
let square = lambda(v) -> v * v
let chain = object_for(affine) >>@ object_for(squash) >>@ object_for(bend) >>@ object_for(square)

function kernel(a: Array<Float64 like Ix>) -> Float64 = {
    let s = reduce(chain <@> a, lambda(p, q) where omp -> p + q, 0.0)
    s
}

let (checksum, input_checksum) = {
    let a = inputs()
    (kernel(a), reduce(a, (+)))
}
