// maskagg -- filter (mask + compound) and aggregate (bench/kernels/maskagg/spec.md)
//
//   y = ( x(k) : x(k) > 1.0, k ascending )   (the compacted subsequence, materialized)
//   checksum = sum y^2 + m,  m = |y|
//
// The WHERE idiom of examples/01: `mask` builds the presence vector, `compound` compacts,
// `reduce` / `extents` consume. `compound(dense, mask)` is valid only as a top-level let
// (BL6002 inside a function), so this one kernel keeps its arrays at top level. The LLVM lane
// refuses `compound` ("a compound-index initializer") and falls back to C++, which honours
// `--print checksum,input_checksum`; blade-cpp is the measurable Blade arm. Serial only.

type Ix = Idx<1000003>   // SIZE n

/// README section 5 input generator: five rounds mod 2^31 (affine, quadratic, affine,
/// middle-square, affine), exact in Int64 (h3 * h3 < 2^62).
function gen(k: Int64, seed: Int64, lo: Float64, hi: Float64) -> Float64 = {
    let h1 = ((k + seed) * 1103515245 + 12345) % 2147483648
    let h2 = (h1 * (h1 / 4096 + 1)) % 2147483648
    let h3 = (h2 * 1103515245 + 12345) % 2147483648
    let h4 = (h3 * h3 / 65536) % 2147483648
    let h5 = (h4 * 1103515245 + 12345) % 2147483648
    lo + (hi - lo) * (Float64(h5) / 2147483648.0)
}

let x = method_for(range<Ix>) <@> lambda(i) -> gen(Int64(i), 10000019, 0.0, 2.0) |> compute
let keep = mask(x, lambda(v) -> v > 1.0)
let y = compound(x, keep)
let checksum = reduce(y * y, (+)) + Float64(extents(y))
let input_checksum = reduce(x, (+))
