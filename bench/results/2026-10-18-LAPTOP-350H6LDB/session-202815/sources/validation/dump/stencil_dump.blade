// stencil DUMP variant (methodology review M11): bench/kernels/stencil/stencil.blade at SMOKE
// size (ny = 31, nx = 41), with the named output `lap` exposed as a top-level binding so the
// print pass echoes it cell by cell. Run in the C++ lane (the LLVM lane ignores --print but
// prints the same bindings). Compared cell by cell against numpy by validate_B.py.

type Y = Idx<31>
type X = Idx<41>

/// README section 5 input generator: five rounds mod 2^31 (affine, quadratic, affine,
/// middle-square, affine), exact in Int64 (h3 * h3 < 2^62).
function gen(k: Int64, seed: Int64, lo: Float64, hi: Float64) -> Float64 = {
    let h1 = ((k + seed) * 1103515245 + 12345) % 2147483648
    let h2 = (h1 * (h1 / 4096 + 1)) % 2147483648
    let h3 = (h2 * 1103515245 + 12345) % 2147483648
    let h4 = (h3 * h3 / 65536) % 2147483648
    let h5 = (h4 * 1103515245 + 12345) % 2147483648
    lo + (hi - lo) * (Float64(h5) / 2147483648.0)
}

function inputs() -> Array<Float64 like Y, X> = {
    let nx = Int64(extents(range<X>))
    method_for(range<Y, X>) <@> lambda(i, j) where omp(i: 1) ->
        gen(Int64(i) * nx + Int64(j), 10000019, 0.0, 1.0) |> compute
}

function laplacian(u: Array<Float64 like Y, X>) = {
    method_for(range<halo<Y, [-1, 0, 1]>, halo<X, [-1, 0, 1]>>) <@> lambda(wr, wc) where omp(wr: 1) ->
        u(wr(-1), wc(0)) + u(wr(1), wc(0)) + u(wr(0), wc(-1)) + u(wr(0), wc(1)) - 4.0 * u(wr(0), wc(0)) |> compute
}

let u = inputs()
let lap = laplacian(u)
let checksum = reduce(method_for(lap) <@> lambda(row) -> prodsum(row, row), (+))
let input_checksum = reduce(reduce(u, (+)), (+))
