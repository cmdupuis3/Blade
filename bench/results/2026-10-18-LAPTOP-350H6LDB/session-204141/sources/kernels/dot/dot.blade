// dot -- inner product, the parity control (bench/kernels/dot/spec.md)
//
//   checksum = sum_k a(k) b(k)
//
// The co-iteration of a and b, mapped by the product kernel and folded by a licensed `+`
// (bound to its own let): this streams (no a * b temporary) and, with thread pragmas
// enabled, folds in per-thread contiguous chunks combined in a fixed order. The serial arm
// (BLADE_OMP_THREADS=1) is the plain ascending fold.

type Ix = Idx<3000017>   // SIZE n

/// README section 5 input generator: five rounds mod 2^31 (affine, quadratic, affine,
/// middle-square, affine), exact in Int64 (h3 * h3 < 2^62).
function gen(k: Int64, seed: Int64, lo: Float64, hi: Float64) -> Float64 = {
    let h1 = ((k + seed) * 1103515245 + 12345) % 2147483648
    let h2 = (h1 * (h1 / 4096 + 1)) % 2147483648
    let h3 = (h2 * 1103515245 + 12345) % 2147483648
    let h4 = (h3 * h3 / 65536) % 2147483648
    let h5 = (h4 * 1103515245 + 12345) % 2147483648
    lo + (hi - lo) * (Float64(h5) / 2147483648.0)
}

function inputs(seed: Int64) -> Array<Float64 like Ix> = {
    method_for(range<Ix>) <@> lambda(i) where omp -> gen(Int64(i), seed, 0.0, 1.0) |> compute
}

function kernel(a: Array<Float64 like Ix>, b: Array<Float64 like Ix>) -> Float64 = {
    let s = reduce(method_for(zip(a, b)) <@> lambda(x, y) -> x * y, lambda(p, q) where omp -> p + q, 0.0)
    s
}

let (checksum, input_checksum) = {
    let a = inputs(10000019)
    let b = inputs(20000038)
    (kernel(a, b), reduce(a, (+)) + reduce(b, (+)))
}
