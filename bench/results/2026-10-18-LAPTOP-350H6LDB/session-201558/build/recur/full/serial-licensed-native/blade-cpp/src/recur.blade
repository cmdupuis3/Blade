// recur -- RK4 time-stepping of du/dt = u - u^3 as a recursive array (bench/kernels/recur/spec.md)
//
// The trajectory U(t, x) IS the array: row 0 is the initial field u0, row t is one RK4 step
// (h = 0.01) of row t - 1. Sequentiality in t is derived from the prefix dependence; each
// step is a whole rank-1 field computed by a pseudo-native step function whose elementwise
// expressions are the function body. No imperative loop, no double buffer. Serial only:
// there is no licence slot for x-parallelism inside a let rec step.

type T = Idx<301>     // SIZE nt
type X = Idx<20011>   // SIZE nx

/// README section 5 input generator: five rounds mod 2^31 (affine, quadratic, affine,
/// middle-square, affine), exact in Int64 (h3 * h3 < 2^62).
function gen(k: Int64, seed: Int64, lo: Float64, hi: Float64) -> Float64 = {
    let h1 = ((k + seed) * 1103515245 + 12345) % 2147483648
    let h2 = (h1 * (h1 / 4096 + 1)) % 2147483648
    let h3 = (h2 * 1103515245 + 12345) % 2147483648
    let h4 = (h3 * h3 / 65536) % 2147483648
    let h5 = (h4 * 1103515245 + 12345) % 2147483648
    lo + (hi - lo) * (Float64(h5) / 2147483648.0)
}

function inputs() -> Array<Float64 like X> = {
    method_for(range<X>) <@> lambda(i) -> gen(Int64(i), 10000019, 0.0, 2.0) |> compute
}

/// The right-hand side f(u) = u - u^3, elementwise.
function rhs(u: Array<Float64 like X>) -> Array<Float64 like X> = u - u * u * u

/// One classic RK4 step with h = 0.01.
function step(u: Array<Float64 like X>) -> Array<Float64 like X> = {
    let k1 = rhs(u)
    let k2 = rhs(u + 0.005 * k1)
    let k3 = rhs(u + 0.005 * k2)
    let k4 = rhs(u + 0.01 * k3)
    u + (0.01 / 6.0) * (k1 + 2.0 * k2 + 2.0 * k3 + k4)
}

function kernel(u0: Array<Float64 like X>) -> Float64 = {
    let rec traj: Array<Float64 like T, X> =
        match traj with
        | zero -> zero
        | zero :: s -> zero :: u0
        | prefix :: n -> prefix :: step(prefix(n - 1))
    reduce(method_for(traj) <@> lambda(row) -> prodsum(row, row), (+))
}

let (checksum, input_checksum) = {
    let u0 = inputs()
    (kernel(u0), reduce(u0, (+)))
}
