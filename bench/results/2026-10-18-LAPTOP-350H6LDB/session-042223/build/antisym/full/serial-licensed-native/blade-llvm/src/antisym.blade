// antisym: the angular-momentum tensor L = X Y^T - Y X^T (bench/kernels/antisym/spec.md),
// L(i, j) = sum_s (X(i, s) Y(j, s) - X(j, s) Y(i, s)), for p particles x n components.
// X and Y are stacked as Z(i, 0, s) = X(i, s), Z(i, 1, s) = Y(i, s) so one array occupies
// both positions; `where anticomm(a, b)` derives strict AntisymIdx<2, p> storage
// (C(p, 2) cells, no diagonal) and strict-triangle iteration.
let static p = 1201    // SIZE p
let static n = 401     // SIZE n
type Part = Idx<p>
type Comp = Idx<2>
type Obs = Idx<n>

/// The suite's input generator (bench/README.md section 5, variant D: five rounds): u in [0, 1),
/// exact in Int64 (h3 * h3 < 2^62).
function lcg(k: Int64, seed: Int64) -> Float64 = {
    let h1 = ((k + seed) * 1103515245 + 12345) % 2147483648
    let h2 = (h1 * (h1 / 4096 + 1)) % 2147483648
    let h3 = (h2 * 1103515245 + 12345) % 2147483648
    let h4 = (h3 * h3 / 65536) % 2147483648
    let h5 = (h4 * 1103515245 + 12345) % 2147483648
    Float64(h5) / 2147483648.0
}

let (checksum, input_checksum) = {
    // input j = c + 1 (X first, Y second), seed 10000019 * j, k = i * n + s within each input
    let z = method_for(range<Part>, range<Comp>, range<Obs>) <@> lambda(i, c, s) -> lcg(i * n + s, 10000019 * (c + 1)) |> compute
    // the operand rows are typed concretely (Array like Comp, Obs): on a T^2 parameter even
    // `a((0 : Comp))` keeps a BL8006 literal-bound check (notes/llvm-acceptance-A.md F13)
    let l = method_for(z, z) <@> lambda(a: Array<Float64 like Comp, Obs>, b: Array<Float64 like Comp, Obs>) where anticomm(a, b), omp(a: 1) -> prodsum(a((0 : Comp)), b((1 : Comp))) - prodsum(b((0 : Comp)), a((1 : Comp))) |> compute
    // the logical sum of squares through the canonicalizing accessor (README 7.2)
    let ss = reduce(method_for(range<Part>) <@> lambda(i) -> reduce(method_for(range<Part>) <@> lambda(j) -> l(i, j) * l(i, j), (+)), (+))
    (ss, reduce(reduce(reduce(z, (+)), (+)), (+)))
}
