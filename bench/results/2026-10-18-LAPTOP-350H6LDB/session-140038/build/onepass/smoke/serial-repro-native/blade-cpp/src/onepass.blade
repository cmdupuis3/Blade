// onepass -- four power sums in ONE traversal via the <&!> reduction join
// (bench/kernels/onepass/spec.md)
//
//   S1 = sum x,  S2 = sum x^2,  S3 = sum x^3,  S4 = sum x^4  (powers by repeated multiplication)
//   checksum = S1 + 2 S2 + 3 S3 + 4 S4
//
// One loop object over x, one kernel per statistic, <&!>-fused and folded by (+): the chain
// compiles to one sweep filling four accumulators. There is no licensed parallel spelling of
// a <&!> join today (notes/llvm-acceptance-B.md F4), so the source carries no fold licence;
// the mt8 row reads "no parallel form". The input map carries its own licence.

type Ix = Idx<50021>   // SIZE n

/// README section 5 input generator: five rounds mod 2^31 (affine, quadratic, affine,
/// middle-square, affine), exact in Int64 (h3 * h3 < 2^62).
function gen(k: Int64, seed: Int64, lo: Float64, hi: Float64) -> Float64 = {
    let h1 = ((k + seed) * 1103515245 + 12345) % 2147483648
    let h2 = (h1 * (h1 / 4096 + 1)) % 2147483648
    let h3 = (h2 * 1103515245 + 12345) % 2147483648
    let h4 = (h3 * h3 / 65536) % 2147483648
    let h5 = (h4 * 1103515245 + 12345) % 2147483648
    lo + (hi - lo) * (Float64(h5) / 2147483648.0)
}

function inputs() -> Array<Float64 like Ix> = {
    method_for(range<Ix>) <@> lambda(i) where omp -> gen(Int64(i), 10000019, 0.0, 2.0) |> compute
}

function kernel(x: Array<Float64 like Ix>) -> Float64 = {
    let l = method_for(x)
    let (s1, s2, s3, s4) = reduce((l <@> lambda(v) -> v) <&!> (l <@> lambda(v) -> v * v)
        <&!> (l <@> lambda(v) -> v * v * v) <&!> (l <@> lambda(v) -> v * v * v * v), (+))
    s1 + 2.0 * s2 + 3.0 * s3 + 4.0 * s4
}

let (checksum, input_checksum) = {
    let x = inputs()
    (kernel(x), reduce(x, (+)))
}
