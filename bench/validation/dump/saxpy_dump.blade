// PM49 diagnostic only: smoke output retained for cell-by-cell validation.
// This changes output lifetime and printing; never use its process peaks or time
// as measurements of the benchmark's scalar-returning kernel.
type Ix = Idx<20011>

function gen(k: Int64, seed: Int64, lo: Float64, hi: Float64) -> Float64 = {
    let h1 = ((k + seed) * 1103515245 + 12345) % 2147483648
    let h2 = (h1 * (h1 / 4096 + 1)) % 2147483648
    let h3 = (h2 * 1103515245 + 12345) % 2147483648
    let h4 = (h3 * h3 / 65536) % 2147483648
    let h5 = (h4 * 1103515245 + 12345) % 2147483648
    lo + (hi - lo) * (Float64(h5) / 2147483648.0)
}

function inputs(seed: Int64) -> Array<Float64 like Ix> = {
    method_for(range<Ix>) <@> lambda(i) where omp -> gen(Int64(i), seed, 0.0, 1.0) |> compute
}

function triad(x: Array<Float64 like Ix>, y: Array<Float64 like Ix>) -> Array<Float64 like Ix> = {
    method_for(zip(x, y)) <@> lambda(u, v) where omp(u: 1) -> 1.5 * u + v |> compute
}

let x = inputs(10000019)
let y = inputs(20000038)
let y2 = triad(x, y)
let checksum = reduce(method_for(y2) <@> lambda(w) -> w * w, lambda(p, q) where omp -> p + q, 0.0)
let input_checksum = reduce(x, (+)) + reduce(y, (+))
