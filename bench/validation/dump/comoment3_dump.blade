// VALIDATION ONLY (review M11): comoment3 at SMOKE size with the full logical output printed.
// Same generator, kernel and checksum as bench/kernels/comoment3/comoment3.blade, arrays
// top-level so the C++ lane can print them. `T` is the dense p^3 logical cube read cell by
// cell through the packed simplex's canonicalizing accessor (all six orderings of a cell).
// Run (C++ lane): BLADE_BLAS=0 blade run comoment3_dump.blade --print T,checksum,input_checksum
// Compared against ref_comoment3.py by validate_A.py.
let static p = 13
let static n = 11
type Var = Idx<p>
type Obs = Idx<n>

function lcg(k: Int64, seed: Int64) -> Float64 = {
    let h1 = ((k + seed) * 1103515245 + 12345) % 2147483648
    let h2 = (h1 * (h1 / 4096 + 1)) % 2147483648
    let h3 = (h2 * 1103515245 + 12345) % 2147483648
    let h4 = (h3 * h3 / 65536) % 2147483648
    let h5 = (h4 * 1103515245 + 12345) % 2147483648
    Float64(h5) / 2147483648.0
}

let x = method_for(range<Var>, range<Obs>) <@> lambda(i, s) where omp(i: 1) -> lcg(i * n + s, 10000019) |> compute
let t = method_for(x, x, x) <@> lambda(a: Array<Float64 like Obs>, b: Array<Float64 like Obs>, c: Array<Float64 like Obs>) where comm(a, b, c), omp(a: 1) -> prodsum(a, b, c) / Float64(n) |> compute
let T = method_for(range<Var>, range<Var>, range<Var>) <@> lambda(i, j, k) -> t(i, j, k) |> compute
let checksum = reduce(method_for(range<Var>) <@> lambda(i) -> reduce(method_for(range<Var>) <@> lambda(j) -> reduce(method_for(range<Var>) <@> lambda(k) -> t(i, j, k) * t(i, j, k), (+)), (+)), lambda(u, v) where omp -> u + v, 0.0)
let input_checksum = reduce(reduce(x, (+)), lambda(u, v) where omp -> u + v, 0.0)
