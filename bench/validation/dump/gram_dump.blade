// VALIDATION ONLY (review M11): gram at SMOKE size with the full logical output printed.
// Same generator, kernel and checksum as bench/kernels/gram/gram.blade, but the arrays are
// top-level so the C++ lane can print them. `G` is the dense p x p logical matrix read
// cell by cell through the packed array's canonicalizing accessor (both triangles), so a
// permutation, mirror or sign error in the packed storage shows up cell by cell.
// Run (C++ lane): BLADE_BLAS=0 blade run gram_dump.blade --print G,checksum,input_checksum
// Compared against ref_gram.py by validate_A.py.
let static p: Int64 = 61
let static n: Int64 = 31
type Var = Idx<p>
type Obs = Idx<n>

function lcg(k: Int64, seed: Int64) -> Float64 = {
    let h1 = ((k + seed) * 1103515245 + 12345) % 2147483648
    let h2 = (h1 * (h1 / 4096 + 1)) % 2147483648
    let h3 = (h2 * 1103515245 + 12345) % 2147483648
    let h4 = (h3 * h3 / 65536) % 2147483648
    let h5 = (h4 * 1103515245 + 12345) % 2147483648
    Float64(h5) / 2147483648.0
}

let x = method_for(range<Var>, range<Obs>) <@> lambda(i, s) where omp(i: 1) -> lcg(i * n + s, 10000019) |> compute
let g = method_for(x, x) <@> lambda(a: Array<Float64 like Obs>, b: Array<Float64 like Obs>) where comm(a, b), omp(a: 1) -> prodsum(a, b) |> compute
let G = method_for(range<Var>, range<Var>) <@> lambda(i, j) -> g(i, j) |> compute
let checksum = reduce(method_for(range<Var>) <@> lambda(i) -> reduce(method_for(range<Var>) <@> lambda(j) -> g(i, j) * g(i, j), (+)), lambda(u, v) where omp -> u + v, 0.0)
let input_checksum = reduce(reduce(x, (+)), lambda(u, v) where omp -> u + v, 0.0)
