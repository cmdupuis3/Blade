// band DUMP variant (methodology review M11): bench/kernels/band/band.blade at SMOKE size
// (n = 211, w = 5). The kernel has no array output, so this variant prints what checks the
// ENUMERATION itself, recomputed by validate_B.py from numpy:
//   cells     number of visited cells (must be n(2w+1) - w(w+1) = 2291)
//   lexsum    sum of (i * 1000 + j) over the visited cells (the cell SET)
//   horner    left fold a -> 0.999 * a + term over the band's terms (cell ORDER: i, then j)
//   checksum, input_checksum as in the kernel
// Run in the C++ lane.

let static n: Int64 = 211
let static w: Int64 = 5
type Nx = Idx<n>

static struct Band {
    i: Int64<min=0, max=n-1>,
    j: Int64<min=0, max=n-1>
} where abs(i - j) <= w

/// README section 5 input generator: five rounds mod 2^31 (affine, quadratic, affine,
/// middle-square, affine), exact in Int64 (h3 * h3 < 2^62).
function gen(k: Int64, seed: Int64, lo: Float64, hi: Float64) -> Float64 = {
    let h1 = ((k + seed) * 1103515245 + 12345) % 2147483648
    let h2 = (h1 * (h1 / 4096 + 1)) % 2147483648
    let h3 = (h2 * 1103515245 + 12345) % 2147483648
    let h4 = (h3 * h3 / 65536) % 2147483648
    let h5 = (h4 * 1103515245 + 12345) % 2147483648
    lo + (hi - lo) * (Float64(h5) / 2147483648.0)
}

function inputs() -> Array<Float64 like Nx> = {
    method_for(range<Nx>) <@> lambda(i) -> gen(Int64(i), 10000019, 0.0, 1.0) |> compute
}

function phi(i: Int64, j: Int64) -> Float64 = {
    let d = Float64(i - j)
    (2.0 + d / Float64(w + 1)) / (1.0 + d * d)
}

function fingerprint(x: Array<Float64 like Nx>) = {
    let cells = reduce(method_for(range<Band>) <@> lambda(i, j) -> Int64(1), (+))
    let lexsum = reduce(method_for(range<Band>) <@> lambda(i, j) -> i * 1000 + j, (+))
    let horner = reduce(method_for(range<Band>) <@> lambda(i, j) -> phi(i, j) * x((i : Nx)) * x((j : Nx)),
                        lambda(a, b) -> 0.999 * a + b, 0.0)
    let s = reduce(method_for(range<Band>) <@> lambda(i, j) -> phi(i, j) * x((i : Nx)) * x((j : Nx)), (+))
    (Float64(cells), Float64(lexsum), horner, s)
}

let (cells, lexsum, horner, checksum, input_checksum) = {
    let x = inputs()
    let f = fingerprint(x)
    (f[0], f[1], f[2], f[3], reduce(x, (+)))
}
