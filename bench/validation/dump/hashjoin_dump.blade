// hashjoin DUMP variant (methodology review M11): bench/kernels/hashjoin/hashjoin.blade at
// SMOKE size (N = 211, M = 101, K = 41). The relation `matched` prints as its compact
// buffer, every cell in lex order (i ascending, then j), so validate_B.py compares it cell by
// cell with numpy's brute-force join (row-major np.nonzero of the N x M equality matrix);
// match_count, total and the order fingerprint fp are recomputed too. Run in the C++ lane
// (the LLVM lane refuses the rank-2 compound and falls back to it anyway).

type L = Idx<211>
type R = Idx<101>
let static nkeys = 41

/// README section 5 input generator: five rounds mod 2^31 (affine, quadratic, affine,
/// middle-square, affine), exact in Int64 (h3 * h3 < 2^62).
function gen(k: Int64, seed: Int64, lo: Float64, hi: Float64) -> Float64 = {
    let h1 = ((k + seed) * 1103515245 + 12345) % 2147483648
    let h2 = (h1 * (h1 / 4096 + 1)) % 2147483648
    let h3 = (h2 * 1103515245 + 12345) % 2147483648
    let h4 = (h3 * h3 / 65536) % 2147483648
    let h5 = (h4 * 1103515245 + 12345) % 2147483648
    lo + (hi - lo) * (Float64(h5) / 2147483648.0)
}

let lk = method_for(range<L>) <@> lambda(i) -> Int64(floor(gen(Int64(i), 10000019, 0.0, Float64(nkeys)))) |> compute
let la = method_for(range<L>) <@> lambda(i) -> Int64(floor(gen(Int64(i), 20000038, 0.0, 1024.0))) |> compute
let rk = method_for(range<R>) <@> lambda(j) -> Int64(floor(gen(Int64(j), 30000057, 0.0, Float64(nkeys)))) |> compute
let ra = method_for(range<R>) <@> lambda(j) -> Int64(floor(gen(Int64(j), 40000076, 0.0, 1024.0))) |> compute

let matched = compound(method_for(la, ra) <@> lambda(l, r) -> l * r, mask(method_for(lk, rk) <@> lambda(l, r) -> l == r, lambda(e) -> e))
let match_count = extents(matched)
let total = reduce(matched, (+), 0)
let fp = reduce(matched, lambda(a, b) -> if 3 * a + b >= 3000000021 then 3 * a + b - 3000000021 else if 3 * a + b >= 2000000014 then 3 * a + b - 2000000014 else if 3 * a + b >= 1000000007 then 3 * a + b - 1000000007 else 3 * a + b, 0)
let checksum = Float64(total) + Float64(match_count) + Float64(fp)
let input_checksum = Float64(reduce(lk, (+)) + reduce(la, (+)) + reduce(rk, (+)) + reduce(ra, (+)))
