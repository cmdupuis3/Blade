// TEST: C05 census demanded sparse residual keeps storage
let static K = [(4, 1), (0, 3), (2, 1), (1, 0), (0, 1)]
let vals: Array<Float64 like Idx<5>> = [4.0, 9.0, 2.0, 8.0, 3.0]
let S = sparse(vals, K)
let residual = S((_, 1))
let total = reduce(residual, lambda(a: Float64, b: Float64) -> a * 10.0 + b, 7.0)
let first = residual(0)
let count = extents(residual)
// EXPECT: residual = [4.0, 2.0, 3.0]
// EXPECT: total = 7423.0
// EXPECT: first = 4.0
// EXPECT: count = 3
