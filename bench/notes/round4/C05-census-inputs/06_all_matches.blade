// TEST: C05 census all sparse entries match in supplied key order
// ((((7*10+4)*10+9)*10+2)*10+8)*10+3 = 749283.
let static K = [(4, 1), (0, 1), (2, 1), (1, 1), (3, 1)]
let vals: Array<Float64 like Idx<5>> = [4.0, 9.0, 2.0, 8.0, 3.0]
let S = sparse(vals, K)
let total = reduce(S((_, 1)), lambda(a: Float64, b: Float64) -> a * 10.0 + b, 7.0)
// EXPECT: total = 749283.0
