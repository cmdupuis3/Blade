// REPRO A-F6 (blade-A, 2026-10-17, compiler 0.20.0): THE STYLE GUIDE'S BAND SPELLING IS
// REFUSED WHEN THE HALF-WIDTH IS A `let static`.
// CLAUDE.md's idiom row spells `static struct Band { i: Int<min=0, max=n-1>, j: ... } where
// abs(i - j) <= w`. `Int<...>` fields are Int32 and `let static w = 2` is Int64:
// Lanes affected: all (typecheck refusal).
// Run: blade check A-F6-int32-domain-bound.blade
// Expected: typechecks (or the doc spells the fields Int64<...>).
// Observed: BL4001 "struct Band where-constraint: implicit numeric conversion: an Int32
//   value meets an Int64 operand in `<=`"  (plus a follow-on BL3999 at `range<Band>`).
// With a literal `<= 2` it compiles; with `i: Int64<min=0, max=n-1>` fields it compiles.
let static n = 11
let static w = 2

static struct Band {
    i: Int<min=0, max=n-1>,
    j: Int<min=0, max=n-1>
} where abs(i - j) <= w

let checksum = {
    let r = method_for(range<Band>) <@> lambda(i, j) -> Float64(i * 10 + j) |> compute
    reduce(r, (+))
}
