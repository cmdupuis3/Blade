# ---- Blade compiler output ----
# The C++ the compiler emits, plus the compile+run scratch the test harness
# creates beside the binary.
generated_cpp_tests/
# Same shape, written by the OpenMP coverage/reduction benchmark harnesses.
generated_omp_coverage/
generated_omp_reduce/
# What a DRIFTED BLADE_LLVM emission pin parks beside its golden so the two can
# be diffed as files (tests/LlvmTests.fs). Debugging output, never committed;
# the pin itself, tests/fixtures/llvm/*.ll, is.
/tests/fixtures/llvm/*.ll.actual

# The pinned diff-oracle build (a full copy of bin/Release output; re-pinned
# per-machine from a fully-gated build — never committed).
oracle/

# The compiler deploys its C++ runtime headers next to every generated .cpp,
# and `blade build` with no -o writes them into the current directory -- which
# is how copies end up beside the corpus sources. src/cpp/ is canonical; these
# trees hold only .blade programs and data.
/tests/corpus/**/*.h
/tests/corpus/**/*.hpp
/tests/corpus/**/*.cpp
/tests/corpus/**/*.exe
/tests/corpus/**/*.out
/examples/**/*.h
/examples/**/*.hpp
/examples/**/*.cpp
/examples/**/*.exe
/examples/**/*.out
# The cuBLAS device half (Round D of docs/plan-cpp-perf-exploitation.md).
# `Build.buildCublasDevice` writes a two-line `<stem>_cublas.cu` beside the
# generated .cpp and compiles it into a shared library that the host program
# links AND LOADS AT RUN TIME -- so unlike the deployed runtime headers these
# two cannot be cleaned up after the link, and a gate-on `blade run` on a
# corpus program leaves them in the source tree.
/tests/corpus/**/*_cublas.cu
/tests/corpus/**/*_cublas.dll
/tests/corpus/**/*_cublas.so
/examples/**/*_cublas.cu
/examples/**/*_cublas.dll
/examples/**/*_cublas.so
*.obj
*.ilk
*.pdb
*.exp
*.lib

# ---- OS ----
Thumbs.db
.DS_Store
*.exe

# ---- gr-render build/packaging output ----
# `*.exe` above already covers the Windows build (tools/gr-render/gr-render.exe
# and dist/gr-render-win32-*.exe); linux/macOS artifacts have no extension, so
# they need their own rules.
/tools/gr-render/gr-render
/tools/gr-render/dist/

# graft's local graph cache — regenerable, not committed (run `graft build`).
graft/
blade_llvm_shim.c
