// TEST: Equijoin Order Fingerprint Interleaved
// ----------------------------------------------------------------------------
// The ORDER of the relation is the compound's lex storage order: left row i
// ascending, and within it every matching right row j ascending. Different
// keys interleave on both sides, so a bucket-major walk (right keys grouped)
// or a right-major probe would permute the cells; the non-commutative
// fingerprint `3 * a + b` (exact Int64) pins the order, not just the multiset.
// Pairs: (0,1) (0,4) (1,0) (1,3) (2,2) (3,1) (3,4) (5,0) (5,3).
// ----------------------------------------------------------------------------
type LeftRow = Idx<6>
type RightRow = Idx<5>
let left_key: Array<Int64 like LeftRow> = [7, 3, 5, 7, 8, 3]
let left_amount: Array<Int64 like LeftRow> = [1, 2, 3, 4, 5, 6]
let right_key: Array<Int64 like RightRow> = [3, 7, 5, 3, 7]
let right_amount: Array<Int64 like RightRow> = [10, 20, 30, 40, 50]
let matched = compound(method_for(left_amount, right_amount) <@> lambda(l, r) -> l * 100 + r, mask(method_for(left_key, right_key) <@> lambda(l, r) -> l == r, lambda(e) -> e))
let match_count = extents(matched)
let fp = reduce(matched, lambda(a, b) -> 3 * a + b, 0)
// EXPECT: matched = [120, 150, 210, 240, 330, 420, 450, 610, 640]
// EXPECT: match_count = 9
// EXPECT: fp = 1371370
