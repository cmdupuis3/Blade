// TEST: Equijoin Payload Mask Then Compound
// ----------------------------------------------------------------------------
// Join -> payload predicate -> aggregate (round 4 wave 4 lane H, item H1:
// gap G128, ST15). A predicate over the JOIN's payload cells -- `mask` over
// the rank-2 equijoin compound J, then `compound(J, keep)` -- was a C++
// compile failure (BL9002: the mask read `J.extents`) and gated in the
// interpreter. The mask over a compound is a Bool compound over J's PRESENT
// cells in lex order (left-major / right-minor), sharing J's index; the
// compound over it keeps the selected cells in that order. Duplicate fanout
// on both sides; an order-sensitive fold pins the order. The hash join's
// demand census certifies the mask and the compound (they read J's compact
// buffer and cardinality only), so J keeps its CSR + cardinality-only index.
// ----------------------------------------------------------------------------
type LeftRow = Idx<6>
type RightRow = Idx<7>
let left_key: Array<Int64 like LeftRow> = [1, 2, 2, 7, 1, 3]
let left_amount: Array<Int64 like LeftRow> = [1, 2, 3, 4, 5, 6]
let right_key: Array<Int64 like RightRow> = [2, 1, 2, 2, 3, 1, 9]
let right_amount: Array<Int64 like RightRow> = [10, 20, 30, 40, 50, 60, 70]
let matched = compound(method_for(left_amount, right_amount) <@> lambda(l, r) -> l * r, mask(method_for(left_key, right_key) <@> lambda(l, r) -> l == r, lambda(e) -> e))
let keep = mask(matched, lambda(v) -> v > 50)
let big = compound(matched, keep)
let n_big = extents(big)
let total = reduce(big, (+), 0)
let fp = reduce(big, lambda(a, b) -> a * 3 + b)
// EXPECT: matched = [20, 60, 20, 60, 80, 30, 90, 120, 100, 300, 300]
// EXPECT: keep = [false, true, false, true, true, false, true, true, true, true, true]
// EXPECT: big = [60, 60, 80, 90, 120, 100, 300, 300]
// EXPECT: n_big = 8
// EXPECT: total = 1110
// EXPECT: fp = 207030
