// TEST: Scaled Unit Declaration
// A unit RHS may carry a MAGNITUDE: a numeric factor composes through the
// same mul/div/pow arms as a named unit, contributing scale rather than
// dims. Values are NOT canonicalized into base units -- a Float<day> holds
// a day-magnitude number -- so the conversion factor appears only where two
// magnitudes actually meet.
Unit second
Unit day = 86400 * second
Unit hour = 3600 * second
Unit minute = second * 60

// No conversion anywhere: each value is stored in the unit it was declared in.
let a: Float64<day> = 1.0
let b: Float64<hour> = 12.0

// Unannotated: the LEFT operand's magnitude wins (unitJoin's existing
// nominal preference, extended to scale), so this is a number of days.
let sum_days = a + b

// Annotated: the annotation says what the result is SUPPOSED to be, so each
// operand converts straight into hours -- one exact factor apiece, computed
// in the magnitude the programmer chose, not joined at the left and
// corrected afterwards.
let sum_hours: Float64<hour> = a + b

// A plain ascription across magnitudes is a conversion site too.
let a_seconds: Float64<second> = a
let ninety: Float64<second> = 90.0
let ninety_min: Float64<minute> = ninety

// EXPECT: sum_days = 1.5
// EXPECT: sum_hours = 36.0
// EXPECT: a_seconds = 86400.0
// EXPECT: ninety_min = 1.5
