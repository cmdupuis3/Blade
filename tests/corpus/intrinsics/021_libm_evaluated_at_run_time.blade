// TEST: Libm Evaluated At Run Time
// ============================================================================
// The arithmetic contract (docs/formalism.md section 2.4): a transcendental
// intrinsic's value is the PLATFORM libm's, computed when the program runs --
// never folded at compile time. g++ folds a builtin `sin(7.35615)` through
// MPFR (correctly rounded) while ucrt's sin is 1 ulp away there, so the
// literal and the same value routed through an array disagreed INSIDE ONE
// executable, and the compiled and interpreted lanes disagreed with each
// other. The three inputs are ones where ucrt differs from the correctly
// rounded result (found by an MPFR sweep); on a correctly rounded libm the
// comparisons still hold, trivially.
//
// The `same_*` pins are platform-independent. `amp_sin` amplifies the last-ulp
// difference so it is visible at 15 printed digits; it is left unpinned
// (the value IS the platform libm's), and the interpreter differential
// compares it byte for byte against the compiled lane.

let xs: Array<Float64 like Idx<3>> = [7.35615, 6.53071, 1.64944]
let s_lit = sin(7.35615)
let e_lit = exp(6.53071)
let l_lit = log(1.64944)
let s_arr = sin(xs)
let e_arr = exp(xs)
let l_arr = log(xs)
let same_sin = s_lit == s_arr(0)
let same_exp = e_lit == e_arr(1)
let same_log = l_lit == l_arr(2)
let amp_sin = (sin(7.35615) - 0.87862006801244397) * 1.0e17
let same_pow = 7.35615 ^ 3.5 == xs(0) ^ 3.5
let same_atan2 = atan2(6.53071, 1.64944) == atan2(xs(1), xs(2))
// EXPECT: same_sin = true
// EXPECT: same_exp = true
// EXPECT: same_log = true
// EXPECT: same_pow = true
// EXPECT: same_atan2 = true
