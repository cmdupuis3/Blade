// TEST: Complex Intrinsics Fold Barrier
// ============================================================================
// Complex transcendentals are inside the arithmetic contract (docs/
// formalism.md section 2.4): their value is the platform C library's complex
// function (cexp, clog, csqrt, csin, ccos, ctan, csinh, ccosh, ctanh, casin,
// cacos, catan, cpow), computed AT RUN TIME. Before, std::exp(complex) & co.
// were g++ builtins, and g++ folded a constant operand through MPC (correctly
// rounded) while a run-time one called the library -- measured 1 ulp apart on
// atan(0.5i), and atan(1e20 + i) printed 1e-40 folded vs the library's -0.
// blade_runtime.hpp now binds the library functions behind the same
// asm-label barrier as the real ones, so the two must agree bit for bit.
//
// Each n_* counts the cells where f(constant operands) and f(the same
// operands scaled by `one = exp(0.0)`, which g++ cannot see through) differ
// in either component, by EXACT equality -- one ulp anywhere makes it
// nonzero. All twelve unary intrinsics and every complex `^` overload
// (complex ^ complex, complex ^ real, complex ^ integer, positive and
// negative real ^ complex) are covered.
//
// Equality, not a magnified difference, ON PURPOSE: under the default
// -ffp-contract=fast g++ fuses `r1 * cos(t1) - r2 * cos(t2)` -- the inlined
// polar() products of the two real-base `^` results -- into one fma, whose
// value is the rounding error of a product, not zero, even when the two
// products are bit-identical (measured 1.27e-16 on d_pow_rc). A comparison
// is not an add, so nothing contracts into it.
//
// The interpreter never folds, so its zeros are trivial; the differential
// still checks both lanes print the same.
// ============================================================================
let one = exp(0.0)
let zc: Array<Complex128 like Idx<6>> = [complex(0.5, 0.5), complex(3.0, 4.0), complex(-0.7, 1.3), complex(1.0e-3, -2.0), complex(-2.5, -0.25), complex(0.0, 0.5)]
let zo: Array<Complex128 like Idx<6>> = [complex(0.5 * one, 0.5), complex(3.0 * one, 4.0), complex(-0.7 * one, 1.3), complex(1.0e-3 * one, -2.0), complex(-2.5 * one, -0.25), complex(0.0 * one, 0.5)]
function mismatches(p: Array<Complex128 like Idx<6>>, q: Array<Complex128 like Idx<6>>) -> Float64 = {
    let m = method_for(zip(p, q)) <@> lambda(x, y) -> if real(x) == real(y) && imag(x) == imag(y) then 0.0 else 1.0 |> compute
    reduce(m, (+))
}
let n_exp = mismatches(exp(zc), exp(zo))
let n_log = mismatches(log(zc), log(zo))
let n_sqrt = mismatches(sqrt(zc), sqrt(zo))
let n_sin = mismatches(sin(zc), sin(zo))
let n_cos = mismatches(cos(zc), cos(zo))
let n_tan = mismatches(tan(zc), tan(zo))
let n_sinh = mismatches(sinh(zc), sinh(zo))
let n_cosh = mismatches(cosh(zc), cosh(zo))
let n_tanh = mismatches(tanh(zc), tanh(zo))
let n_asin = mismatches(asin(zc), asin(zo))
let n_acos = mismatches(acos(zc), acos(zo))
let n_atan = mismatches(atan(zc), atan(zo))
let w = complex(0.3, -0.7)
let n_pow_cc = mismatches(zc ^ w, zo ^ w)
let n_pow_cr = mismatches(zc ^ 2.5, zo ^ 2.5)
let n_pow_ci = mismatches(zc ^ 3, zo ^ 3)
let n_pow_rc = mismatches(2.0 ^ zc, (2.0 * one) ^ zc)
let n_pow_nc = mismatches((-2.0) ^ zc, (-2.0 * one) ^ zc)
// EXPECT: n_exp = 0.0
// EXPECT: n_log = 0.0
// EXPECT: n_sqrt = 0.0
// EXPECT: n_sin = 0.0
// EXPECT: n_cos = 0.0
// EXPECT: n_tan = 0.0
// EXPECT: n_sinh = 0.0
// EXPECT: n_cosh = 0.0
// EXPECT: n_tanh = 0.0
// EXPECT: n_asin = 0.0
// EXPECT: n_acos = 0.0
// EXPECT: n_atan = 0.0
// EXPECT: n_pow_cc = 0.0
// EXPECT: n_pow_cr = 0.0
// EXPECT: n_pow_ci = 0.0
// EXPECT: n_pow_rc = 0.0
// EXPECT: n_pow_nc = 0.0
