// TEST: Intrinsics Inverse Trig Complex
// ============================================================================
// asin/acos/atan on a COMPLEX operand. <complex> overloads all three, so they
// sit in Grad.complexMathIntrinsics and preserve the operand's complex type
// (the emitted call is std::atan(std::complex<double>)) -- unlike floor/ceil
// and log10, which have no complex overload and refuse (intrinsics/013).
// atan(0 + i/2) = i*atanh(1/2) = i*ln(3)/2 is the closed form the pin checks.
//
// Split out of intrinsics/010 because the INTERPRETER used to decline complex
// asin/acos/atan as "not yet bit-verified" (a skip in the differential).
//
// On Windows it no longer does: the compiled side's catan/casin/cacos are
// libmingwex's own objects (not ucrtbase's, and not the libstdc++ template
// closed forms an earlier attempt ported and found to disagree), and
// Numerics.fs now ports those objects operation for operation, calling the
// same ucrtbase log/log1p/atan2/hypot -- so this file PASSES in
// `blade test interp intrinsics` there. Other platforms keep the decline
// (glibc/libSystem complex trig are different algorithms) and score
// SKIP-UNSUPPORTED. The regime-by-regime battery is intrinsics/022.
// ============================================================================
let z = complex(0.0, 0.5)
let za = atan(z)

let w = complex(0.5, 0.0)
let ws = asin(w)
let wc = acos(w)

// wc's imaginary part prints as `-0` (std::acos of a real-valued complex
// lands on negative zero); the pin compares numerically, where -0.0 = 0.0.
// EXPECT: za = (0.0, 0.549306144334055)
// EXPECT: ws = (0.523598775598299, 0.0)
// EXPECT: wc = (1.0471975511966, 0.0)
