// TEST: HMC Normal-Normal Conjugate Acceptance
import ppl as ppl
import ad as ad
// THE HMC acceptance test: fixed-leapfrog HMC on the exact ORACLE_PINS.md
// dump-conjugate Normal-Normal block, the same case corpus 108 pins for mh --
// prior N(m0=0, v0=4), known likelihood variance sigma2=2, data
// [1.2, 0.7, 2.3, -0.4, 1.9] -- closed-form posterior
// N(1.0363636363636362, 0.36363636363636365) (post_var = 1/(1/4 + 5/2) =
// 4/11, posterior sd 0.6030). Same density-form model body as 108; the Grad
// pass differentiates it for the leapfrog because the elaborator's hoisted
// logpdf/loglik rewrite keeps the body inside the AD-able subset.
//
// All assertions are deterministic booleans under fixed keys. With eps =
// 0.25, L = 4 (trajectory 1.0 =~ 1.7 posterior sd), n = 4096, burn = 512 the
// post-burn estimates land at mean 1.0352 / var 0.3514 (key 1234) and
// 1.0423 / 0.3609 (key 987654321), so 108's tolerances -- mean within 0.05,
// variance within 0.06 -- hold with real margin for BOTH chains yet sit far
// inside what any wrong posterior produces (the prior alone is off by 1.04
// in mean and 3.6 in variance). Mixing: split-Rhat over the two
// independent-key chains 0.99982 < 1.01.
//
// THE SELLING POINT, pinned as a boolean: on the same posterior at the same
// length, the hmc chain's Geyer ess is 4536.47 (key 1234; the slightly
// antithetic trajectory lawfully pushes ess past n) against 900.95 for the
// scale-1.0 mh chain of corpus 108 under the SAME key -- a 5.0x gain, with
// an absolute floor of 2500 pinned beside the head-to-head comparison.
let data: Array<Float64 like Idx<5>> = [1.2, 0.7, 2.3, -0.4, 1.9]
function logpost(theta: Float64) -> Float64 =
    ppl.logpdf(gaussian(0.0, 4.0), theta) + ppl.loglik(gaussian(theta, 2.0), data)

let ch1 = ppl.hmc(logpost, 0.0, 4096, 0.25, 4, 1234)
let ch2 = ppl.hmc(logpost, 0.0, 4096, 0.25, 4, 987654321)
let cm = ppl.mh(logpost, 0.0, 4096, 1.0, 1234)

let m1 = ppl.chain_mean(ch1, 512)
let v1 = ppl.chain_var(ch1, 512)
let m2 = ppl.chain_mean(ch2, 512)
let v2 = ppl.chain_var(ch2, 512)
let mean_ok_1 = abs(m1 - 1.0363636363636362) < 0.05
// EXPECT: mean_ok_1 = true
let var_ok_1 = abs(v1 - 0.36363636363636365) < 0.06
// EXPECT: var_ok_1 = true
let mean_ok_2 = abs(m2 - 1.0363636363636362) < 0.05
// EXPECT: mean_ok_2 = true
let var_ok_2 = abs(v2 - 0.36363636363636365) < 0.06
// EXPECT: var_ok_2 = true

let rh = ppl.rhat(ch1, ch2)
let rhat_ok = rh < 1.01
// EXPECT: rhat_ok = true

// ess(hmc) = 4536.47 vs ess(mh) = 900.95 at the same length on the same
// posterior under the same user key.
let es_h = ppl.ess(ch1)
let es_m = ppl.ess(cm)
let ess_floor_ok = es_h > 2500.0
// EXPECT: ess_floor_ok = true
let hmc_beats_mh = es_h > es_m
// EXPECT: hmc_beats_mh = true

// Determinism at acceptance scale: a third chain under key 1234 reproduces
// tail states to the last bit (the 102/115 idiom).
let ch3 = ppl.hmc(logpost, 0.0, 4096, 0.25, 4, 1234)
let same_key_bitexact = abs(ch1(4095) - ch3(4095)) + abs(ch1(2048) - ch3(2048)) + abs(ch1(513) - ch3(513)) < 1.0e-300
// EXPECT: same_key_bitexact = true
