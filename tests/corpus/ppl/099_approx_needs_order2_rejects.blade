import ppl as ppl
// An order-1 tower has no kappa_2 for the expansion to standardize on --
// refused with steering (carry order >= 2) rather than inventing a scale.
// The runtime cousin, kappa_2 <= 0 on a quasi-distribution tower, is NOT
