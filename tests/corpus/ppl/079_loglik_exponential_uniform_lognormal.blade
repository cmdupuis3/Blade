// TEST: Loglik Exponential Uniform Lognormal
import ppl as ppl
// The remaining wave-1 logliks, both shape-derivation paths:
//   exponential over an ANNOTATED sample vector: n·log(rate) - rate·Σx_i
//     = 4·log 2 - 2·5.
//   uniform: the on-support constant -n·log(b-a) — the data drops out
//     entirely (no loop is emitted).
//   lognormal over a COMPUTED (un-annotated method_for) source, the
//     computedShapeOf path: C = [1, 2], pinned against the sum of the
//     077 pointwise values.
type BIdx = Idx<4>
let B: Array<Float64 like BIdx> = [0.5, 1.0, 1.5, 2.0]
let lle = ppl.loglik(exponential(2.0), B)
let llu = ppl.loglik(uniform(0.0, 4.0), B)
type CIdx = Idx<2>
let C = method_for(range<CIdx>) <@> lambda(i) -> 1.0 + 1.0 * i |> compute
let lln = ppl.loglik(lognormal(0.0, 1.0), C)
// EXPECT: lle = -7.22741127776022
// EXPECT: llu = -5.54517744447956
// EXPECT: lln = -2.77125075392839
