// TEST: MH Log-Posterior Arity (rejects)
// ERROR: BL5100
// ERROR-CONTAINS: this wave samples a SCALAR latent
import ppl as ppl
// A two-parameter model is refused: mh samples a scalar latent, so the
// log-posterior must be Float -> Float (extra structure belongs in
// module-level data arrays the body reads).
function lp2(x: Float64, y: Float64) -> Float64 = 0.0 - x * x - y * y
let c = ppl.mh(lp2, 0.0, 64, 1.0, 7)
