// TEST: parallel kernel calls a nullary callback that writes a capture (rejects)
// ERROR: BL4005 @ 10:1
// ERROR-CONTAINS: a parallel kernel (`where omp` / cuda) writes storage captured from outside it
// Gap G41, Codex review W2F-7 finding 24, the writing twin of loops/506: the
// nullary callback's only candidate writes the captured G.
let mut G = [0.0]
function bump() -> Float64 = {
    G(0) = G(0) + 1.0
    G(0)
}
function launch(f: () -> Float64) = method_for(0..2) <@> lambda(i) where omp(i: 1) -> f() + Float64(i) |> compute
let r = launch(bump)
