let g = [[1.0, 2.0], [3.0, 4.0]]
function f() -> Float32 = {
    let v = g(0)
    let w = (v, 1)[0]
    let v = 0
    let g = 0
    w(0) = 9.0
    w(0)
}
let r = f()
