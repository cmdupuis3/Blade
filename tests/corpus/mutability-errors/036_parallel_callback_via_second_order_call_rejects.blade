// TEST: parallel callback supplied through a second-order call (rejects)
// ERROR: BL4005 @ 15:1
// ERROR-CONTAINS: a parallel kernel (`where omp` / cuda) writes storage captured from outside it
// Gap G41, Codex review W2F-7 finding 25: `launch` is called directly with a
// pure callback, and INDIRECTLY -- `via` calls its callback parameter `h`
// (whose only candidate is `launch`) with `bump`, which writes G. The
// callback table is a fixpoint over indirect calls: `h(f)` propagates via's
// `f` candidates into launch's `f`, so launch's kernel sees `bump` too.
type I = Idx<2>
let mut G = [0.0]
function ident(v: Float64) -> Float64 = v
function bump(v: Float64) -> Float64 = {
    G(0) = G(0) + 1.0
    G(0)
}
function launch(f: (Float64) -> Float64) -> Array<Float64 like I> = method_for(range<I>) <@> lambda(i) where omp(i: 1) -> f(Float64(i)) |> compute
function via(h: ((Float64) -> Float64) -> Array<Float64 like I>, f: (Float64) -> Float64) -> Array<Float64 like I> = h(f)
let a = launch(ident)
let b = via(launch, bump)
