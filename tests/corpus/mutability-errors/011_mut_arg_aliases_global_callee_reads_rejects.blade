// TEST: a mut argument that is a global the callee reads directly (rejects)
// ERROR: BL4005
// Passing one binding to two parameters is refused (functions/145). Passing a
// module-level `x` to a `mut` parameter of a function that ALSO reads `x` by
// name is the same aliasing (N16): `bump` writes a(0) and then reads x(0),
// which is the same cell, so the read would see the write.
let mut x = Float64([1.0, 2.0])
function bump(a: mut Array<Float64 like Idx<2>>) -> Float64 = {
    a(0) = 5.0
    x(0)
}
let r = bump(x)
