// TEST: reduction join over an ALIAS of a writing deferred map (rejects)
// ERROR: BL4005 @ 8:1
// ERROR-CONTAINS: a leg of this join writes a captured binding
// Gap G43 (Codex review of W2-F, blocker 3): mutability-errors/014 with the
// legs naming `alias`, a let alias of the writing map -- the alias is the
// same deferred computation, evaluated where the legs read it.
type I = Idx<4>
let mut G = [0]
let r = {
    let m = method_for(range<I>) <@> lambda(i) -> { G(0) = G(0) + 1; G(0) }
    let alias = m
    let (s, t) = object_for(<&!>) <@> (reduce(alias, (+)), reduce(alias, (+)))
    s * 1000 + t
}