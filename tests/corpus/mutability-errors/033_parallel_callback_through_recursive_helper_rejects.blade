// TEST: parallel callback forwarded through a recursive helper (rejects)
// ERROR: BL4005 @ 12:1
// ERROR-CONTAINS: a parallel kernel (`where omp` / cuda) writes storage captured from outside it
// Gap G41, Codex review W2F-6 finding 23: the kernel hands its callback to a
// self-recursive helper that finally calls it; the only candidate writes G.
// A cycle through a callback is joined like any other.
let mut G = Float64([0.0])
function bump(v: Int64) -> Float64 = {
    G(0) = G(0) + 1.0
    G(0)
}
function recur(f: (Int64) -> Float64, n: Int64) -> Float64 = if n == 0 then f(0) else recur(f, n - 1)
function launch(g: (Int64) -> Float64) = method_for(0..2) <@> lambda(i) where omp(i: 1) -> recur(g, 3) |> compute
let r = launch(bump)