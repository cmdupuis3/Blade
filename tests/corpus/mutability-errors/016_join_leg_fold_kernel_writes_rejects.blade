let mut G = [0.0]
let x = [1.0, 2.0, 3.0]
let r = {
    let (s, t) = object_for(<&!>) <@> (reduce(x, lambda(a, b) -> { G(0) = G(0) + 1.0; a + b }, 0.0), reduce(method_for(x) <@> lambda(v) -> v + G(0), (+)))
    s * 100.0 + t
}