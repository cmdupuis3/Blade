// TEST: parallel callback supplied as a writing lambda through a second-order call (rejects)
// ERROR: BL4005 @ 9:1
// ERROR-CONTAINS: a parallel kernel (`where omp` / cuda) writes storage captured from outside it
// Gap G41, Codex review W2F-7 finding 25: mutability-errors/036 with the
// writer spelled as a lambda argument of the indirect call (a lambda is
// lifted to a callable, then propagated like a named one).
type I = Idx<2>
let mut G = [0.0]
function ident(v: Float64) -> Float64 = v
function launch(f: (Float64) -> Float64) -> Array<Float64 like I> = method_for(range<I>) <@> lambda(i) where omp(i: 1) -> f(Float64(i)) |> compute
function via(h: ((Float64) -> Float64) -> Array<Float64 like I>, f: (Float64) -> Float64) -> Array<Float64 like I> = h(f)
let a = launch(ident)
let b = via(launch, lambda(v) -> {
    G(0) = G(0) + v
    G(0)
})
