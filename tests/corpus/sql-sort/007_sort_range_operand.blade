// TEST: Sort Range Operand
// `sort(range<I>, key)` and `sort(lo..hi, key)` -- the argsort spelling the
// idiom ladder prefers (no materialized iota) -- used to be refused by the
// C++ lane (BL7001: no rule for IRRange in expression position) and gated by
// the interpreter. With BLADE_SORT_FORM on (default) the C++ lane sorts the
// range's iota IN PLACE as the output (rule `sort-form v1`, identity source);
// off, it materializes the iota into a scratch source first. Same values.
// Ties keep input order; an offset range sorts its own values lo + i.
type R = Idx<7>
let k: Array<Float64 like R> = [3.0, 1.0, 2.0, 1.0, 0.5, 3.0, 2.0]
let b: Array<Float64 like R> = [10.0, 11.0, 12.0, 13.0, 14.0, 15.0, 16.0]
let perm = sort(range<R>, lambda(i) -> k(i))
let sk = method_for(perm) <@> lambda(i) -> k(i) |> compute
let sb = method_for(perm) <@> lambda(i) -> b(i) |> compute
let off = sort(2..9, lambda(v) -> 9 - v % 3)
let anon = sort(0..5, lambda(v) -> v * v - 4 * v)
// EXPECT: perm = [4, 1, 3, 2, 6, 0, 5]
// EXPECT: sk = [0.5, 1.0, 1.0, 2.0, 2.0, 3.0, 3.0]
// EXPECT: sb = [14.0, 11.0, 13.0, 12.0, 16.0, 10.0, 15.0]
// EXPECT: off = [2, 5, 8, 4, 7, 3, 6]
// EXPECT: anon = [2, 1, 3, 0, 4]
