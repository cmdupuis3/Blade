// TEST: Sort Float32 Keys
// Float32 keys, cached in their own width by rule `sort-form v1` (the key is
// total over the range operand); a NaN key still orders first and ties keep
// input order.
type R = Idx<5>
let z: Float32 = 0.0
let f: Array<Float32 like R> = [2.5, 1.5, z / z, 1.5, -3.0]
let p = sort(range<R>, lambda(i) -> f(i))
let g: Array<Float32 like R> = [2.5, 1.5, 0.25, 1.5, -3.0]
let w = sort(g, lambda(x) -> -x)
// EXPECT: p = [2, 4, 1, 3, 0]
// EXPECT: w = [2.5, 1.5, 1.5, 0.25, -3.0]
