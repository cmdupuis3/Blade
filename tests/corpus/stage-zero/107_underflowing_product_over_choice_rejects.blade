// TEST: A Product By A Literal Below One Over An Uncomputed Choice Is Refused (rejects)
// ERROR: BL4022 @ 15:9
// ERROR-CONTAINS: is not a stage that provably keeps zero cells zero and non-zero cells non-zero
// ============================================================================
// The owner's decision of 2026-11-24 (gap G335, formalism 10.4): a stage over an uncomputed guard or
// choice whose two readings can differ does not compile.
// The cell that breaks it: 1e-300 * 1e-300 underflows to 0.0, so the uncomputed choice takes the right
// side (9e-300) where the computed choice kept 1e-300 and staged it to 0.0. A product keeps zero
// cells only for |c| >= 1.
// ============================================================================
type I = Idx<3>
let cf: Array<Float64 like I> = [1.5, 0.0, -2.0]
let cf2: Array<Float64 like I> = [9.0, 4.0, 3.0]
let tiny: Array<Float64 like I> = [1e-300, 0.0, 2.0]
let scale = lambda(z: Float64) -> z * 1e-300
let r = scale <$> (tiny <|> cf2) |> compute
