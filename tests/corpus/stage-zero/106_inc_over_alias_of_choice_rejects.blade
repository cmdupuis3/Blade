// TEST: A Stage Over A Top-Level Alias Of An Uncomputed Choice Is Refused (rejects)
// ERROR: BL4022 @ 14:9
// ERROR-CONTAINS: is not a stage that provably keeps zero cells zero and non-zero cells non-zero
// ============================================================================
// The owner's decision of 2026-11-24 (gap G335, formalism 10.4): a stage over an uncomputed guard or
// choice whose two readings can differ does not compile.
// `ch2` is the same uncomputed choice as `ch` (one alias class): the alias changes nothing.
// ============================================================================
type I = Idx<3>
let cf: Array<Float64 like I> = [1.5, 0.0, -2.0]
let cf2: Array<Float64 like I> = [9.0, 4.0, 3.0]
let inc = lambda(z: Float64) -> z + 1.0
let ch = cf <|> cf2
let ch2 = ch
let r = inc <$> ch2 |> compute
