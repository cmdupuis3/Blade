// TEST: A Stage That Maps The Zero To One Over An Inline Guard With A Run-Time Condition Is Refused (rejects)
// ERROR: BL4022 @ 14:9
// ERROR-CONTAINS: not to the zero of its result
// ============================================================================
// The owner's decision of 2026-11-24 (gap G335, formalism 10.4): a stage over an uncomputed guard or
// choice whose two readings can differ does not compile.
// The condition is decided at run time (cf(0) > 9.0 is false here); the stage cannot depend on it:
// inc(0.0) = 1.0 would show wherever the guard is false.
// ============================================================================
type I = Idx<3>
let cf: Array<Float64 like I> = [1.5, 0.0, -2.0]
let cf2: Array<Float64 like I> = [9.0, 4.0, 3.0]
let inc = lambda(z: Float64) -> z + 1.0
let flag = cf(0) > 9.0
let r = inc <$> guard(flag, cf) |> compute
