// TEST: The Outer Stage Of A Stack Over A Guard Is Judged On Its Own (rejects)
// ERROR: BL4022 @ 15:9
// ERROR-CONTAINS: not to the zero of its result
// ============================================================================
// The owner's decision of 2026-11-24 (gap G335, formalism 10.4): a stage over an uncomputed guard or
// choice whose two readings can differ does not compile.
// The inner `dbl <$> g` is accepted (dbl(0.0) = 0.0); the outer `inc` is a stage over the same guard
// and maps 0.0 to 1.0.
// ============================================================================
type I = Idx<3>
let cf: Array<Float64 like I> = [1.5, 0.0, -2.0]
let cf2: Array<Float64 like I> = [9.0, 4.0, 3.0]
let dbl = lambda(z: Float64) -> z * 2.0
let inc = lambda(z: Float64) -> z + 1.0
let g = guard(false, cf)
let r = inc <$> (dbl <$> g) |> compute
