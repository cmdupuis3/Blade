// TEST: Spectra fft2: 3x5 field takes the Bluestein path on both axes
// Neither axis is a power of two, so both passes take Bluestein's chirp-z
// DFT, batched over the other axis -- the same per-axis contract as the
// 1-D fft (F6). Pins from spectra/OracleDump.fs (dotnet run --project
// oracles/spectra), re-derived for Bluestein and again for the packed
// real-input transform.
import spectra as sp
let x: Array<Float64 like Idx<3>, Idx<5>> = [[-1.0, -0.75, -0.5, -0.25, 0.0], [0.25, 0.5, 0.75, 1.0, 1.25], [1.5, 1.75, 2.0, 2.25, 2.5]]
let X = sp.fft2(x)
// EXPECT: X = [(11.250000000000004, -2.2204460492503131E-16), (-1.8749999999999996, 2.5807161008834498), (-1.875, 0.6092244304366996), (-1.875, -0.6092244304366996), (-1.8749999999999996, -2.5807161008834498), (-9.3750000000000036, 5.4126587736527423), (5.6619139401592016E-16, 1.3070624354684418E-16), (1.0361858077867568E-16, 1.2781121328114134E-16), (-1.6308189096419721E-16, -1.0596222381820062E-15), (3.0677013383044846E-16, -6.8990386904863111E-16), (-9.3749999999999964, -5.4126587736527485), (3.0677013383044846E-16, 6.8990386904863111E-16), (-1.6308189096419721E-16, 1.0596222381820062E-15), (1.0361858077867568E-16, -1.2781121328114134E-16), (5.6619139401592016E-16, -1.3070624354684418E-16)]
