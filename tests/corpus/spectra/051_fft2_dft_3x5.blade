// TEST: Spectra fft2: 3x5 field takes the Bluestein path on both axes
// Neither axis is a power of two, so both passes take Bluestein's chirp-z
// DFT, batched over the other axis -- the same per-axis contract as the
// 1-D fft (F6). Pins from spectra/OracleDump.fs (dotnet run --project
// oracles/spectra), re-derived for Bluestein.
import spectra as sp
let x: Array<Float64 like Idx<3>, Idx<5>> = [[-1.0, -0.75, -0.5, -0.25, 0.0], [0.25, 0.5, 0.75, 1.0, 1.25], [1.5, 1.75, 2.0, 2.25, 2.5]]
let X = sp.fft2(x)
// EXPECT: X = [(11.250000000000004, 4.4408920985006262E-16), (-1.8750000000000002, 2.5807161008834498), (-1.8749999999999996, 0.60922443043669872), (-1.8750000000000009, -0.60922443043669938), (-1.8749999999999996, -2.5807161008834507), (-9.3750000000000036, 5.4126587736527387), (3.8719103320275476E-16, 1.0160593711772884E-15), (-1.9702179481915454E-16, 7.9207560061401624E-16), (7.2399078926660037E-16, 6.3175438729890807E-17), (-5.2479456070168819E-17, 1.1170363341848219E-15), (-9.3749999999999947, -5.4126587736527476), (-3.6281524367422243E-16, 1.0725036456542975E-15), (-1.3333355467752211E-16, 5.6400739844277777E-16), (-2.6567072901952114E-16, 9.042444105957358E-16), (-1.3351852336672493E-15, -1.2988199194794576E-16)]
