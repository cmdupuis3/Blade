// TEST: Spectra fft result through a named let, a tuple projection and an alias
// #62: each spelling carries the generated routine's result shape to ifft;
// the three round trips agree bitwise.
import spectra as sp
let x: Array<Float64 like Idx<8>> = [0.5, -1.25, 2.0, 0.75, -0.5, 1.5, -2.25, 3.0]
let X = sp.fft(x)
let y1 = sp.ifft(X)
let pair = (sp.fft(x), x)
let y2 = sp.ifft(pair[0])
let Xa = X
let y3 = sp.ifft(Xa)
let d = (y1(3) - y2(3)) + (y1(5) - y3(5))
// EXPECT: d = 0.0
let y0 = y1(0)
// EXPECT: y0 = 0.5