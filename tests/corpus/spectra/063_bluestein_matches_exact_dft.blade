// TEST: the non-power-of-two fft agrees with the exact DFT
// Every n that is not a power of two takes Bluestein's chirp-z algorithm
// (F6: it replaced the O(n^2) table DFT): two radix-2 FFTs of length m >= 2n-1
// and a baked kernel spectrum. Its rounding differs from the table DFT's, so
// the non-power-of-two pins were re-derived; this test justifies them against
// the exact DFT summed term by term (cos/sin at run time), independently of
// the oracle: n = 12 (m = 32), n = 7 (a prime, m = 16), n = 100 (m = 256), the
// inverse round trip, and a 3 x 5 fft2 (Bluestein on BOTH axes: the batched
// row pass and the strided column pass) against the exact 2-D DFT.
import spectra as sp
let tau = 6.283185307179586
type N = Idx<12>
let x: Array<Float64 like N> = [0.3, -1.2, 2.5, 0.0, 1.1, -0.7, 3.3, 0.9, -2.2, 1.6, 0.4, -0.1]
let X = sp.fft(x)
let re12 = reduce(method_for(range<N>, range<N>) <@> lambda(k, j) -> x(j) * cos(tau * Float64((Int64(k) * Int64(j)) % 12) / 12.0) |> compute, (+))
let im12 = reduce(method_for(range<N>, range<N>) <@> lambda(k, j) -> 0.0 - x(j) * sin(tau * Float64((Int64(k) * Int64(j)) % 12) / 12.0) |> compute, (+))
let err12 = reduce(method_for(range<N>) <@> lambda(k) -> abs(real(X(k)) - re12(k)) + abs(imag(X(k)) - im12(k)) |> compute, lambda(a, b) -> if a > b then a else b)
let ok12 = err12 < 1.0e-12
type P = Idx<7>
let y: Array<Float64 like P> = [1.0, -0.5, 0.25, 2.0, -3.0, 0.75, 1.5]
let Y = sp.fft(y)
let re7 = reduce(method_for(range<P>, range<P>) <@> lambda(k, j) -> y(j) * cos(tau * Float64((Int64(k) * Int64(j)) % 7) / 7.0) |> compute, (+))
let im7 = reduce(method_for(range<P>, range<P>) <@> lambda(k, j) -> 0.0 - y(j) * sin(tau * Float64((Int64(k) * Int64(j)) % 7) / 7.0) |> compute, (+))
let err7 = reduce(method_for(range<P>) <@> lambda(k) -> abs(real(Y(k)) - re7(k)) + abs(imag(Y(k)) - im7(k)) |> compute, lambda(a, b) -> if a > b then a else b)
let ok7 = err7 < 1.0e-12
let Y2: Array<Complex128 like P> = Y
let yb = sp.ifft(Y2)
let errInv = reduce(method_for(range<P>) <@> lambda(i) -> abs(yb(i) - y(i)) |> compute, lambda(a, b) -> if a > b then a else b)
let okInv = errInv < 1.0e-12
type H = Idx<100>
let h: Array<Float64 like H> = method_for(range<H>) <@> lambda(i) -> sin(0.37 * Float64(i)) + 0.25 * cos(1.3 * Float64(i)) |> compute
let Hs = sp.fft(h)
let re100 = reduce(method_for(range<H>, range<H>) <@> lambda(k, j) -> h(j) * cos(tau * Float64((Int64(k) * Int64(j)) % 100) / 100.0) |> compute, (+))
let im100 = reduce(method_for(range<H>, range<H>) <@> lambda(k, j) -> 0.0 - h(j) * sin(tau * Float64((Int64(k) * Int64(j)) % 100) / 100.0) |> compute, (+))
let err100 = reduce(method_for(range<H>) <@> lambda(k) -> abs(real(Hs(k)) - re100(k)) + abs(imag(Hs(k)) - im100(k)) |> compute, lambda(a, b) -> if a > b then a else b)
let ok100 = err100 < 1.0e-11
let f: Array<Float64 like Idx<3>, Idx<5>> = [[-1.0, -0.75, -0.5, 0.125, 2.0], [0.25, 3.5, 0.75, 1.0, -1.25], [1.5, 1.75, -2.0, 2.25, 0.5]]
let F2 = sp.fft2(f)
let re2 = reduce(method_for(range<Idx<3>>, range<Idx<5>>, range<Idx<3>>, range<Idx<5>>) <@> lambda(k, l, i, j) -> f(i, j) * cos(tau * (Float64((Int64(k) * Int64(i)) % 3) / 3.0 + Float64((Int64(l) * Int64(j)) % 5) / 5.0)) |> compute, (+), axes = 2)
let im2 = reduce(method_for(range<Idx<3>>, range<Idx<5>>, range<Idx<3>>, range<Idx<5>>) <@> lambda(k, l, i, j) -> 0.0 - f(i, j) * sin(tau * (Float64((Int64(k) * Int64(i)) % 3) / 3.0 + Float64((Int64(l) * Int64(j)) % 5) / 5.0)) |> compute, (+), axes = 2)
let err2 = reduce(method_for(range<Idx<3>>, range<Idx<5>>) <@> lambda(k, l) -> abs(real(F2(k, l)) - re2(k, l)) + abs(imag(F2(k, l)) - im2(k, l)) |> compute, (+), axes = 2)
let ok2 = err2 < 1.0e-12
// EXPECT: ok12 = true
// EXPECT: ok7 = true
// EXPECT: okInv = true
// EXPECT: ok100 = true
// EXPECT: ok2 = true
