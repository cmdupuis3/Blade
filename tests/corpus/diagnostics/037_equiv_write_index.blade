// TEST: Diag Equiv Write Index (diag)
// ERROR: BL4008 @ 7:7
// ERROR-CONTAINS: raw indexing into an l>0
import ml as ml
let static S = [(0, 0, 2), (1, 1, 1)]
function bad(k: Array<Int like IrrepsIdx<S>>) where ml.equiv(O3) -> Float = {
  let mut acc: Array<Float like Idx<3>> = [0.0, 0.0, 0.0]
  acc(k(2)) = 1.0
  acc(0)
}
