// TEST: Producer-input legs judge captures transitively and admit no named view
// ============================================================================
// Dominance at the producer is judged through every callee a leg's seed or
// kernel names (Optimize.producerEpilogueLegAdmission, W2-4 review finding
// 1). late1 / late2: `seed_fn` / `g` capture `c`, bound BETWEEN the producer
// and the legs -- the sibling pass already refuses to join them (a call to a
// capturing nested function is outside its total whitelist), so nothing
// rides; the admission's transitive closure is the second line of defence.
// early1 / early2: the seed and the kernel call MODULE functions that capture
// nothing -- the legs ride, the callee evaluated at the chain's start. view: a
// named VIEW of another array as the shared operand is not admitted (v1 rides
// fresh operands only). Values are the as-written ones in every case.
// ============================================================================
type Ix = Idx<1003>
type R = Idx<3>
function inputs(m: Int64) -> Array<Float64 like Ix> = {
    method_for(range<Ix>) <@> lambda(i) -> Float64(Int64(i) % m) |> compute
}
function seed_top(z: Float64) -> Float64 = z + 1.0
function g_top(b: Float64) -> Float64 = 1.0 * b - 0.25 * b
let (late1, l1t) = {
    let x = inputs(7)
    let y = inputs(5)
    let y2 = method_for(zip(x, y)) <@> lambda(u, v) -> u + v |> compute
    let s = reduce(method_for(y2) <@> lambda(w) -> w * w, lambda(p, q) -> p + q, 0.0)
    let c = x((1 : Ix)) + 1.0
    function seed_fn(z: Float64) -> Float64 = z + c
    (s, reduce(x, (+), seed_fn(0.0)) + 3.0 * reduce(y, (+), seed_fn(0.5)))
}
let (early1, e1t) = {
    let x = inputs(7)
    let y = inputs(5)
    let y2 = method_for(zip(x, y)) <@> lambda(u, v) -> u + v |> compute
    let s = reduce(method_for(y2) <@> lambda(w) -> w * w, lambda(p, q) -> p + q, 0.0)
    (s, reduce(x, (+), seed_top(0.0)) + 3.0 * reduce(y, (+), seed_top(0.5)))
}
let (late2, l2t) = {
    let x = inputs(9)
    let y = inputs(4)
    let y2 = method_for(zip(x, y)) <@> lambda(u, v) -> u - v |> compute
    let s = reduce(method_for(y2) <@> lambda(w) -> w, lambda(p, q) -> p + q, 0.0)
    let c = x((2 : Ix)) + 1.0
    function g(b: Float64) -> Float64 = c * b
    (s, reduce(x, lambda(a, b) -> a + g(b), 0.0) + reduce(y, lambda(a, b) -> a + g(b), 0.0))
}
let (early2, e2t) = {
    let x = inputs(9)
    let y = inputs(4)
    let y2 = method_for(zip(x, y)) <@> lambda(u, v) -> u - v |> compute
    let s = reduce(method_for(y2) <@> lambda(w) -> w, lambda(p, q) -> p + q, 0.0)
    (s, reduce(x, lambda(a, b) -> a + g_top(b), 0.0) + reduce(y, lambda(a, b) -> a + g_top(b), 0.0))
}
let (view, vt) = {
    let m = method_for(range<R, Ix>) <@> lambda(r, i) -> Float64((Int64(r) + 2) * (Int64(i) % 6)) |> compute
    let xv = m((1 : R))
    let y = inputs(5)
    let y2 = method_for(zip(xv, y)) <@> lambda(u, v) -> u + v |> compute
    let s = reduce(method_for(y2) <@> lambda(w) -> w * w, lambda(p, q) -> p + q, 0.0)
    (s, reduce(xv, (+)) + reduce(y, (+)))
}
// EXPECT: late1 = 31021.0
// EXPECT: l1t = 9022.5
// EXPECT: early1 = 31021.0
// EXPECT: e1t = 9018.5
// EXPECT: late2 = 2499.0
// EXPECT: l2t = 16515.0
// EXPECT: early2 = 2499.0
// EXPECT: e2t = 4128.75
// EXPECT: view = 118700.0
// EXPECT: vt = 9518.0
