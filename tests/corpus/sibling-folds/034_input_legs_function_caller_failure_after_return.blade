// TEST: A function caller releases the inlined callee's pools before a later failure (aborts)
// `driver` inlines `kernel` (non-atom return `s + 1.0`) for its input legs, then
// divides by zero AFTER the call and its input sums. The as-written kernel had
// released y2 at its return; the return-boundary event sits after the
// evaluated return and before driver's next statement, so y2 is released
// before the failing binding in both lanes (W2-4 third review hole 3). BL8013
// fires at its own line (line 20 once the harness drops the TEST line).
type Ix = Idx<1003>
function inputs(m: Int64) -> Array<Float64 like Ix> = {
    method_for(range<Ix>) <@> lambda(i) -> Float64(Int64(i) % m) |> compute
}
function kernel(x: Array<Float64 like Ix>, y: Array<Float64 like Ix>) -> Float64 = {
    let y2 = method_for(zip(x, y)) <@> lambda(u, v) -> 2.0 * u + v |> compute
    let s = reduce(method_for(y2) <@> lambda(w) -> w * w, lambda(p, q) -> p + q, 0.0)
    s + 1.0
}
function driver(x: Array<Float64 like Ix>, y: Array<Float64 like Ix>) -> Float64 = {
    let k = kernel(x, y)
    let t = reduce(x, (+)) + reduce(y, (+))
    let z0 = Int64(floor(x((0 : Ix))))
    let boom = 10 / z0
    k + t + Float64(boom)
}
let r = driver(inputs(7), inputs(5))
// ABORT: BL8013
