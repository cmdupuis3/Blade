// TEST: Genuine tuple returning calls retain the LLVM inline tuple ABI
type Ix = Idx<37>
function inputs() -> Array<Float64 like Ix> = {
    method_for(range<Ix>) <@> lambda(i) -> Float64(i) |> compute
}
function member_pair(x: Array<Float64 like Ix>) -> (Float64, Float64) = {
    let s = reduce(x, (+))
    let q = reduce(method_for(x) <@> lambda(v) -> v * v, lambda(a, b) -> a + b, 0.0)
    (s, q)
}
let (s, q) = {
    let x = inputs()
    member_pair(x)
}
// EXPECT: s = 666.0
// EXPECT: q = 16206.0
