// TEST: A callee that renames an array inside a scalar branch is not inlined for the input legs
// ============================================================================
// 036's rename moved into an if-arm of a SCALAR let: the let's type is a
// plain Float64, but its evaluation binds an array alias the LLVM lane would
// copy into an unlisted pool. The kept inline's admission judges the whole
// EVALUATION (every nested let, arm, tuple, projection and call by its own
// type -- W2-4 fifth review NEW 1): epilogue-legs declines, the call is not
// retained for A7c, and the legs keep their joined pass. As-written values.
// ============================================================================
type Ix = Idx<1003>
function inputs(m: Int64) -> Array<Float64 like Ix> = {
    method_for(range<Ix>) <@> lambda(i) -> Float64(Int64(i) % m) |> compute
}
function kernel(x: Array<Float64 like Ix>, y: Array<Float64 like Ix>) -> Float64 = {
    let y2 = method_for(zip(x, y)) <@> lambda(u, v) -> 2.0 * u + v |> compute
    let s = reduce(method_for(y2) <@> lambda(w) -> w * w, lambda(p, q) -> p + q, 0.0)
    let extra = if s > 0.0 then {
        let spare = x
        Float64(extents(spare))
    } else 0.0
    s + extra
}
let (checksum, input_checksum) = {
    let x = inputs(7)
    let y = inputs(5)
    (kernel(x, y), reduce(x, (+)) + reduce(y, (+)))
}
// EXPECT: checksum = 83068.0
// EXPECT: input_checksum = 5007.0
