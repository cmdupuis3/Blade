// TEST: Licensed producer-input legs keep their own licence
// ============================================================================
// Legs whose fold kernels carry their OWN reorder licence -- `where comm` in
// the first region, `where omp` in the second. Riding the producer's loop,
// a licensed leg in a licensed build is its own K-lane state (C++) / its own
// fast-math chain (LLVM), never another leg's licence or the map's; under
// BLADE_FP_REPRO=1 it is the strict chain. A `where omp` leg in a build that
// emits threads keeps its joined pass (riding the serial producer would drop
// its team): the epilogue-legs record says so. Integer-valued data: the pins
// hold under every association.
// ============================================================================
type Ix = Idx<1003>
function inputs(m: Int64) -> Array<Float64 like Ix> = {
    method_for(range<Ix>) <@> lambda(i) -> Float64(Int64(i) % m) |> compute
}
function kernel(x: Array<Float64 like Ix>, y: Array<Float64 like Ix>) -> Float64 = {
    let y2 = method_for(zip(x, y)) <@> lambda(u, v) -> u + v |> compute
    let s = reduce(method_for(y2) <@> lambda(w) -> w * w, lambda(p, q) -> p + q, 0.0)
    s
}
let (c1, c2) = {
    let x = inputs(13)
    let y = inputs(9)
    (kernel(x, y), reduce(x, lambda(p, q) where comm(p, q) -> p + q, 1.0) + 2.0 * reduce(y, lambda(p, q) where comm(p, q) -> p + q, 0.0))
}
let (o1, o2) = {
    let x = inputs(6)
    let y = inputs(4)
    (kernel(x, y), reduce(x, lambda(p, q) where omp -> p + q, 0.0) + 2.0 * reduce(y, lambda(p, q) where omp -> p + q, 0.0))
}
// EXPECT: c1 = 120663.0
// EXPECT: c2 = 14012.0
// EXPECT: o1 = 20696.0
// EXPECT: o2 = 5511.0
