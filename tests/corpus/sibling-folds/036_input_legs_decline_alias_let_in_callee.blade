// TEST: A callee that renames an array is not inlined for the input legs
// ============================================================================
// kernel is 019's, plus `let spare = x` and a return reading its extent. The
// LLVM lane copies such a rename into a pool of its own, which the inline's
// return-boundary event would not name; the kept inline admits only callees
// whose every let is a forced rank-1 dense map (owned, released at the
// boundary) or holds no storage (W2-4 fourth review NEW 1). epilogue-legs
// declines `callee let spare is not an owned allocation form`, the call
// stays, and the legs keep their joined pass. Values are the as-written ones.
// ============================================================================
type Ix = Idx<1003>
function inputs(m: Int64) -> Array<Float64 like Ix> = {
    method_for(range<Ix>) <@> lambda(i) -> Float64(Int64(i) % m) |> compute
}
function kernel(x: Array<Float64 like Ix>, y: Array<Float64 like Ix>) -> Float64 = {
    let y2 = method_for(zip(x, y)) <@> lambda(u, v) -> 2.0 * u + v |> compute
    let s = reduce(method_for(y2) <@> lambda(w) -> w * w, lambda(p, q) -> p + q, 0.0)
    let spare = x
    s + Float64(extents(spare))
}
let (checksum, input_checksum) = {
    let x = inputs(7)
    let y = inputs(5)
    (kernel(x, y), reduce(x, (+)) + reduce(y, (+)))
}
// EXPECT: checksum = 83068.0
// EXPECT: input_checksum = 5007.0
