// TEST: A String literal inside a Float64 let's evaluation is not inlined for the input legs
// ============================================================================
// `let t = ("..", 1.0)[1]` is a Float64 let, but its evaluation BUILDS a String
// (a std::string owns heap storage in the C++ lane): the kept inline judges
// every leaf of a non-owned unit, so a String literal anywhere in it declines
// `evaluates a String literal` (W2-4 sixth review NEW 2) and the call is not
// retained for A7c. Values are the as-written ones.
// ============================================================================
type Ix = Idx<1003>
function inputs(m: Int64) -> Array<Float64 like Ix> = {
    method_for(range<Ix>) <@> lambda(i) -> Float64(Int64(i) % m) |> compute
}
function kernel(x: Array<Float64 like Ix>, y: Array<Float64 like Ix>) -> Float64 = {
    let y2 = method_for(zip(x, y)) <@> lambda(u, v) -> 2.0 * u + v |> compute
    let s = reduce(method_for(y2) <@> lambda(w) -> w * w, lambda(p, q) -> p + q, 0.0)
    let t = ("a label long enough to leave any small-string buffer, past sixty chars", Float64(1.0))[1]
    s + t
}
let (checksum, input_checksum) = {
    let x = inputs(7)
    let y = inputs(5)
    (kernel(x, y), reduce(x, (+)) + reduce(y, (+)))
}
// EXPECT: checksum = 82066.0
// EXPECT: input_checksum = 5007.0
