// TEST: Standalone unseeded sum keeps -0.0; seeded folds keep their seed's sign
// ============================================================================
// The round-2 probe: over an all-negative-zero array the standalone unseeded
// `reduce(z, (+))` is -0.0, a +0.0-seeded fold is 0.0, and a join leg seeded
// -0.0 stays -0.0. The sibling-fold rewrite must not widen the divergence
// between those spellings: it seeds the legs it builds with -0.0
// (tests/corpus/sibling-folds/003), and leaves the surface join's own rule
// untouched. Top-level bindings are separate regions, so no rewrite fires
// here. QUOTED pins: they compare the printed sign.
//
// Changes from the probe as first written, so that BOTH lanes print the same
// text in the default build (`blade test llvm` compares it):
//   * the seeded folds use `radd`, a `where repro` kernel -- serial in every
//     lane. With a licensed (+) kernel the sign of a zero sum belongs to the
//     licensed form: the LLVM lane's `nsz` may drop a +0.0 addend and the C++
//     join's `omp simd reduction` lanes start at +0.0 (both true on the
//     4136f0b5 compiler);
//   * the surface join's implicit +0.0 seed for an unseeded leg (`j_surface`
//     in the probe) is pinned by an EMISSION needle instead
//     (tests/OptimizeTests.fs, sibling_folds_surface_join_keeps_plus_zero_seed):
//     its printed value is a licensed zero sum and differs by lane.
// ============================================================================
type R = Idx<3>

function radd(p: Float64, q: Float64) where repro -> Float64 = p + q

let z: Array<Float64 like R> = [-0.0, -0.0, -0.0]
let unseeded = reduce(z, (+))
let seeded_pos = reduce(z, radd, 0.0)
let (j_neg, j_dummy) = object_for(<&!>) <@> (reduce(z, radd, -0.0), reduce(z, lambda(p, v) -> p + 2.0 * v, 0.0))
// EXPECT: unseeded = "-0.0"
// EXPECT: seeded_pos = "0.0"
// EXPECT: j_neg = "-0.0"
// EXPECT: j_dummy = "0.0"
