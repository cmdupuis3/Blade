// TEST: Recursive Array Inline Lagged Slice Arithmetic
// ============================================================================
// A rank-2 inductive slice may combine lagged ROW reads with bare elementwise
// operators — no helper function, no `method_for(zip(..)) <@> .. |> compute`
// detour. The two spellings are the same computation, so this file pins them
// against each other value-for-value.
//
// The shape that used to break: an OUT-OF-PREFIX-guarded read. Formalism 7.5
// resolves `prefix(n - 3)` at n < 3 to a zero slice, which TypeCheck spells as
// a SELECT over the clamped row read (`if n - 3 >= 0 then <row> else <zeros>`).
// Used elementwise, that select lands directly in a loop form's array slot,
// where codegen's auto-materialize knows only the mask/intersect/union/unique
// inline forms — so the nest read an `arr0` it never declared and the emitted
// C++ did not compile. An UNGUARDED lag (`prefix(n - 1)`, provably inside the
// prefix) never went through the select and always worked, so the guarded and
// unguarded arms below must both stay green.
// ============================================================================
type Step = Idx<6>
type C = Idx<3>

// --- the reference spelling: same arithmetic through an explicit helper -----
function blend(p: Array<Float like C>, q: Array<Float like C>) -> Array<Float like C> =
    (method_for(zip(p, q)) <@> lambda(x, y) -> 0.5 * x + 0.5 * y) |> compute

let rec viahelper: Array<Float like Step, C> =
    match viahelper with
    | zero -> zero
    | zero :: s -> zero :: [1.0, 2.0, 3.0]
    | prefix :: n -> prefix :: blend(prefix(n - 1), prefix(n - 3))
// EXPECT: viahelper = [1, 2, 3, 0.5, 1, 1.5, 0.25, 0.5, 0.75, 0.625, 1.25, 1.875, 0.5625, 1.125, 1.6875, 0.40625, 0.8125, 1.21875]

// --- the direct spelling: two lagged reads, one guarded, combined inline ----
let rec inlined: Array<Float like Step, C> =
    match inlined with
    | zero -> zero
    | zero :: s -> zero :: [1.0, 2.0, 3.0]
    | prefix :: n -> prefix :: 0.5 * prefix(n - 1) + 0.5 * prefix(n - 3)
// EXPECT: inlined = [1, 2, 3, 0.5, 1, 1.5, 0.25, 0.5, 0.75, 0.625, 1.25, 1.875, 0.5625, 1.125, 1.6875, 0.40625, 0.8125, 1.21875]

// --- the minimal trigger: ONE guarded read, scaled -------------------------
// Rows 1, 2, 4 and 5 read before the prefix and are zero by 7.5; row 3 is the
// first real halving of the seed.
let rec lone: Array<Float like Step, C> =
    match lone with
    | zero -> zero
    | zero :: s -> zero :: [1.0, 2.0, 3.0]
    | prefix :: n -> prefix :: 0.5 * prefix(n - 3)
// EXPECT: lone = [1, 2, 3, 0, 0, 0, 0, 0, 0, 0.5, 1, 1.5, 0, 0, 0, 0, 0, 0]

// --- both reads UNGUARDED: `prefix(0)` is inside the prefix at every step ---
// No select is formed here, so this arm pins the path that always worked.
let rec unguarded: Array<Float like Step, C> =
    match unguarded with
    | zero -> zero
    | zero :: s -> zero :: [1.0, 2.0, 3.0]
    | prefix :: n -> prefix :: 0.5 * prefix(n - 1) + 0.5 * prefix(0)
// EXPECT: unguarded = [1, 2, 3, 1, 2, 3, 1, 2, 3, 1, 2, 3, 1, 2, 3, 1, 2, 3]
