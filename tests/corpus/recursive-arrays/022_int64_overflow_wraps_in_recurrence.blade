// TEST: int64 overflow wraps inside a recurrence
// ============================================================================
// Powers of 3 in Int64, carried by a recursive array past 2^63. For each
// entry, `grew` records whether multiplying by 3 increased the value. Under
// wrapping arithmetic (both lanes) the answer is false exactly where the
// product wraps from positive to negative; a compiler assuming signed
// overflow cannot happen may rewrite `3 x > x` as `x > 0`, which is true
// there.
// ============================================================================
type Step = Idx<44>
let rec p: Array<Int64 like Step> =
    match p with
    | zero -> zero
    | zero :: s -> zero :: 1
    | prefix :: n -> prefix :: prefix(n - 1) * 3
let grew = method_for(range<Step>) <@> lambda(k) -> if p(k) * 3 > p(k) then 1 else 0
let p39 = p((39 : Step))
let p40 = p((40 : Step))
let g39 = grew((39 : Step))
let g40 = grew((40 : Step))
let n_grew = reduce(grew, (+))
// EXPECT: p39 = 4052555153018976267
// EXPECT: p40 = -6289078614652622815
// EXPECT: g39 = 0
// EXPECT: g40 = 1
// EXPECT: n_grew = 41
