// to reach a user-visible message through a two-step alias chain.
// REJECT-AT: lower
let static crystal = [2, 2, 0, 0, 3, 0, 0, 0]
type CrystalIdx = TreeIdx<crystal>
type Aliased = CrystalIdx

function f(t: Array<Float64 like Aliased>) -> Float64 = { 1.0 }
