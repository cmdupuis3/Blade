// TEST: Compound Over A Named Mask Of A Longer Run-Time-Shaped Array Checks Its Extents (aborts)
// Gap G283: the let-bound mask form of sql-masks/063 (the compaction-fusion arms read the mask's count).
// ABORT: BL8011
type S = Idx<5>
let src: Array<Float64 like S> = [0.1, 0.9, 0.2, 0.8, 0.7]
let c5 = compound(src, mask(src, lambda(v) -> v > 0.0))
let c3 = compound(src, mask(src, lambda(v) -> v > 0.5))
let a = Float64(0..extents(c5)) |> compute
let b = Float64(0..extents(c3)) |> compute
let keep = mask(a, lambda(v) -> v > 0.5)
let y = compound(b, keep)
let n = extents(y)