// TEST: Compound Over Run-Time-Shaped Operands Of Equal Extent
// Gap G283: the accepted twin of sql-masks/063-064 -- the same shapes, equal at run time.
type S = Idx<5>
let src: Array<Float64 like S> = [0.1, 0.9, 0.2, 0.8, 0.7]
let c5 = compound(src, mask(src, lambda(v) -> v > 0.0))
let c3 = compound(src, mask(src, lambda(v) -> v > 0.5))
let a = Float64(0..extents(c5)) |> compute
let b = Float64(0..extents(c3)) |> compute
let b2 = Float64(0..extents(c5)) * 10.0 |> compute
let y = compound(b2, mask(a, lambda(v) -> v > 0.5))
let keep = mask(a, lambda(v) -> v > 2.5)
let z = compound(b2, keep)
let n = extents(y)
let m = extents(z)
// EXPECT: y = [10.0, 20.0, 30.0, 40.0]
// EXPECT: z = [30.0, 40.0]
// EXPECT: n = 4
// EXPECT: m = 2