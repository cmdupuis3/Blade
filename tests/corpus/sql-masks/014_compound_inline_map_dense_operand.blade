// TEST: Compound Inline Map Dense Operand
// ----------------------------------------------------------------------------
// Round-3 defect D-B1: the DENSE operand of compound(dense, mask) written in
// place as an UNFORCED map -- the equijoin shape, a pair pool built inline
// from two outer products. The constructor emitted the computed operand
// through the ordinary let path, which DEFERS a map (only a
// `// matched__dense = <deferred computation>` comment), and discarded the
// context that recorded it: the scatter then read `matched__dense`, which was
// never declared (BL9002 in the C++ lane; the interpreter computed it). The
// temporary is now forced like a let-bound deferred operand. The forced
// spelling `(...) |> compute` is the control (015).
// ----------------------------------------------------------------------------
type LeftRow = Idx<5>
type RightRow = Idx<4>
let left_key: Array<Int64 like LeftRow> = [1, 2, 1, 5, 2]
let left_amount: Array<Int64 like LeftRow> = [10, 20, 30, 40, 50]
let right_key: Array<Int64 like RightRow> = [1, 1, 3, 2]
let right_amount: Array<Int64 like RightRow> = [1, 2, 4, 8]

// rank 2: both pair pools inline; the matching (l, r) pairs in lex order are
// (0,0) (0,1) (1,3) (2,0) (2,1) (4,3) -> 10*1, 10*2, 20*8, 30*1, 30*2, 50*8
let matched = compound(method_for(left_amount, right_amount) <@> lambda(l, r) -> l * r, mask(method_for(left_key, right_key) <@> lambda(l, r) -> l == r, lambda(e) -> e))
let match_count = extents(matched)
let total = reduce(matched, (+), 0)
// EXPECT: matched = [10, 20, 160, 30, 60, 400]
// EXPECT: match_count = 6
// EXPECT: total = 680

// rank 1: a single-operand map inline, the mask a stored array
let doubled = compound(method_for(left_amount) <@> lambda(v) -> v * 2, mask(left_key, lambda(k) -> k == 1))
let doubled_total = reduce(doubled, (+), 0)
// EXPECT: doubled = [20, 60]
// EXPECT: doubled_total = 80
