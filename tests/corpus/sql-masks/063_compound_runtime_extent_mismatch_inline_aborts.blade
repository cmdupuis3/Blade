// TEST: Compound Over An Inline Mask Of A Longer Run-Time-Shaped Array Checks Its Extents (aborts)
// Gap G283 (floor round, lane B): a (5 cells) and b (3 cells) are shaped at run time, so the
// checker's index identity has no literal to compare. The scatter walks the mask's grid and read
// b past its end (a garbage cell, exit 0); every lane now compares the dense operand's extent with
// the mask's before the first cell.
// ABORT: BL8011
type S = Idx<5>
let src: Array<Float64 like S> = [0.1, 0.9, 0.2, 0.8, 0.7]
let c5 = compound(src, mask(src, lambda(v) -> v > 0.0))
let c3 = compound(src, mask(src, lambda(v) -> v > 0.5))
let a = Float64(0..extents(c5)) |> compute
let b = Float64(0..extents(c3)) |> compute
let y = compound(b, mask(a, lambda(v) -> v > 0.5))
let n = extents(y)