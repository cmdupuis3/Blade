// TEST: a reduction join whose leg seed is a block
// Gap G274 (floor round, lane c, F9): IRLift wraps the block's statements
// around the seed pack, which used to hide the join encoding from the C++
// lane (an internal-looking BL7004). The pack is evaluated once, after the
// capture prelude, and each leg seeds from its projection.
// BORROW (2026-11-23): the write below would be refused (BL4005, formalism 10.2) while an uncomputed
// map over it (p, q) is still used: the legs are computed first (the old pins, 24.0 / 14.0, folded the written x).
let mut x: Array<Float64 like Idx<2>> = [1.0, 2.0]
let p = method_for(x) <@> lambda(v) -> v * 2.0 |> compute
let q = method_for(x) <@> lambda(v) -> v + 1.0 |> compute
let (s1, s2) = object_for(<&!>) <@> (reduce(p, (+), { x(0) = 10.0; Float64(0) }), reduce(q, (+)))
// EXPECT: x = [10.0, 2.0]
// EXPECT: s1 = 6.0
// EXPECT: s2 = 5.0
