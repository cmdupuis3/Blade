// TEST: Default Referencing Required Param
// The auto_levels(z) pattern: a default may reference the REQUIRED params,
// and sees the CALLER's evaluated argument value. The desugar binds each
// referenced supplied argument exactly once (temp then param-named alias in
// a block), so `view(z + 1.0)` evaluates the argument in caller scope even
// though the caller's own `z` collides with the parameter name. Repeated
// and nested calls exercise per-call-site uniqueness of the desugar block.
function auto(z: Float64) -> Float64 = z * 10.0
function view(z: Float64, lo: Float64 = auto(z), hi: Float64 = z + 1.0) -> Float64 = z + lo + hi
let z: Float64 = 7.0
let d1 = view(z + 1.0)
let d2 = view(z)
let d3 = view(view(2.0))
// EXPECT: d1 = 97.0
// EXPECT: d2 = 85.0
// EXPECT: d3 = 301.0
