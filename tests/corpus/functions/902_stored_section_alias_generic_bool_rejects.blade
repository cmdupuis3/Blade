// TEST: An Alias Of A Stored Section Applied To Generic Bool Cells Is Refused (rejects)
// ERROR: BL3001 @ 15:15
// ERROR-CONTAINS: applies `+` to a value of its generic parameter type, and this call makes that type Bool
// ============================================================================
// R11: functions/901 through a `let g = f` alias of the section.
// ============================================================================
// Since G288 (a) (floor round) a section bound to a name IS its lambda,
// lambda(x, y) -> x + y, so the generic call judgment refuses the Bool
// (struct) instance at the call.
// ============================================================================
function outer(b) = {
    let f = (+)
    let g = f
    method_for(b) <@> lambda(v) -> g(v, v) |> compute
}
let r = outer([true, false])