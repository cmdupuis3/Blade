// TEST: A Body Read In An Untaken If Arm Forces Nothing
// ============================================================================
// Gap G239, round 4 wave 10 (lane C, C1): inside a FUNCTION body a deferred
// module map is forced AT EACH READ POSITION, in evaluation order (formalism
// 10.2) -- an untaken read forces nothing and the evaluation count is
// observable. The compiled lanes forced it once per body statement, before
// the statement; a read whose order that cannot reproduce is now a call of a
// one-statement helper and the statement spine is put in evaluation order
// (Lowering.splitDeferredBodyReadsModule).
// ============================================================================
type A = Array<Float64 like Idx<1>>
let mut backing: A = [-1.0]
let forcing = method_for(backing) <@> lambda(e) -> Int64(floor(sqrt(e)))
// the failing map is read only in the untaken arm: nothing fails
function f(x: Float64) -> Int64 = { let a = if x > 0.0 then forcing(0) else 1; a }
let r = f(-2.0)
// EXPECT: r = 1
