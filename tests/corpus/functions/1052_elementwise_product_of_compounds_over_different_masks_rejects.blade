// TEST: An Elementwise Product Of Compounds Over Different Masks Is Refused (rejects)
// Gap G265 (d) (round 4 wave 10 lane d; the lead ruling): `left * right` is the zip of its
// operands, so two compounds over different mask bindings (equal cardinality, 3 and 3) are refused
// as their zip is -- BL3016 -- instead of pairing unrelated cells by position.
// ERROR: BL3016
type I = Idx<6>
let x: Array<Int64 like I> = [1, 2, 3, 4, 5, 6]
let left = compound(x, mask(x, lambda(v) -> v <= 3))
let right = compound(x, mask(x, lambda(v) -> v > 3))
let m = left * right |> compute
