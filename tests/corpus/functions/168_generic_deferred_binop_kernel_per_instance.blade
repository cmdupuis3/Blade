// TEST: A generic body's elementwise binop computes in each instance's element type
// ============================================================================
// Lowering's deferred-binop kernel (`a * b` over two array parameters) took a
// Float64 default for the generic element, so an Int64 instance multiplied in
// double -- an exact product past 2^53 lost its low bits, and g++ refused the
// narrowing back to int64 -- and a Float32 instance computed in double too.
// The kernel now keeps the element variable and is specialized per instance.
// ============================================================================
function mul3(a: T^1, b: T^1) = reduce(a * b, (+))
// 3037000499^2 = 9223372030926249001 is exact in Int64 but not in Float64
// (the nearest double is 9223372030926248960).
let ri = mul3([3037000499, 2, 5], [3037000499, 3, 7])
// EXPECT: ri = 9223372030926249042
let rs = mul3([3, 4], [5, 6])
// EXPECT: rs = 39
let xf = [0.1, 0.7, 1.3, 2.9]
let yf = [0.3, 1.1, 0.2, 3.7]
let rf = mul3(xf, yf)
// EXPECT: rf = 11.79
let rf_resid = rf - 11.79
// EXPECT: rf_resid = 1.77635683940025e-15
let rf_same = rf == reduce(xf * yf, (+))
// EXPECT: rf_same = true
let x32: Array<Float32 like Idx<3>> = [0.1, 0.7, 1.3]
let y32: Array<Float32 like Idx<3>> = [0.3, 1.1, 0.2]
let r32 = mul3(x32, y32)
// EXPECT: r32 = 1.05999994277954
let r32_same = r32 == reduce(x32 * y32, (+))
// EXPECT: r32_same = true
