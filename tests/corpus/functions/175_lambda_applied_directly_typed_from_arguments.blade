// TEST: A lambda applied directly is typed from its arguments
// ============================================================================
// `(lambda(f, x) -> f(x))(idg, 2.0)` died BL6001 with `idg` unspecialized:
// the lambda's body was checked while `f` was still an open variable, and
// applying an open variable decides nothing -- `f(x)` may be a call or an
// array read -- so the body's result was a fresh variable no use ever closed.
// An ARRAY in the same position fared no better: `(lambda(a) -> a)(xs)` had
// its parameter defaulted to a scalar and the call refused (BL3001).
//
// A lambda literal applied in place has exactly one call site, so its
// unannotated parameters that receive a function or an array take the
// argument's type before the body is checked, as `let f = g in ...` would.
// (A NAMED declaration does not learn from its calls -- functions/040.)
// ============================================================================
function idg(x: T) -> T = x
function sq(x: Float64) -> Float64 = x * x
let xs = [1.5, 2.5, 3.5]

// A generic function argument, specialized at the use the body makes.
let r1 = (lambda(f, x) -> f(x))(idg, 2.0)
// EXPECT: r1 = 2.0
let r2 = (lambda(f, x) -> f(x))(idg, 7)
// EXPECT: r2 = 7.0
// A non-generic function argument (worked before; the control).
let r3 = (lambda(f, x) -> f(x))(sq, 3.0)
// EXPECT: r3 = 9.0
// A block-local alias of the generic function, passed the same way.
let r4 = {
    let g = idg
    (lambda(f, x) -> f(x))(g, 2.5)
}
// EXPECT: r4 = 2.5
// An ARRAY in the same position is still an array read.
let r5 = (lambda(f, x) -> f(x))(xs, 1)
// EXPECT: r5 = 2.5
let r6 = (lambda(a) -> a)(xs)
// EXPECT: r6 = [1.5, 2.5, 3.5]
let r7 = (lambda(a, k) -> reduce(a, (+)) * k)(xs, 2.0)
// EXPECT: r7 = 15.0
