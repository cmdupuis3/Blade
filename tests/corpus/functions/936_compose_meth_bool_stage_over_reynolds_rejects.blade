// TEST: A Bool-Valued Method-Composition Stage Over A reynolds Map Is Refused (rejects)
// ERROR: BL3001 @ 11:38
// ERROR-CONTAINS: stage over a reynolds(..) map runs inside the symmetrized kernel
// ============================================================================
// R11: `@>>` composes the right stage's kernel into the symmetrized one, so
// the SUMMED terms were `positive`'s Bools: base printed
// `r = [[true, true], [true, true]]`.
// ============================================================================
let a: Array<Float64 like Idx<2>> = [1.0, 2.0]
let b: Array<Float64 like Idx<2>> = [3.0, 4.0]
let g = lambda(x, y) -> x * y
let positive = lambda(z: Float64) -> z > 0.0
let products = a [*] b |> compute
let right = method_for(products) <@> positive
let r = ((method_for(a, b) <@> reynolds(g)) @>> right) |> compute
