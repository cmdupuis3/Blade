// TEST: closures stored in an array and a tuple, called after the frame
// The closures are built inside `table` / `pair` and stored before they are
// returned; each keeps its own copy of the captured parameter.
function table(a: Float64) = [lambda(x: Float64) -> x + a, lambda(x: Float64) -> x - a]
function pair(a: Float64) = (lambda(x: Float64) -> x * a, 2.0 * a)
let fs = table(10.0)
let (m, twice) = pair(4.0)
let r1 = fs(0)(1.0)
let r2 = fs(1)(1.0)
let r3 = m(0.5) + twice
// EXPECT: twice = 8.0
// EXPECT: r1 = 11.0
// EXPECT: r2 = -9.0
// EXPECT: r3 = 10.0
