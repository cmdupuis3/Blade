// TEST: A comparison over two generic variables at different ranks is refused (rejects)
// ERROR: BL3999 @ 7:24
// ============================================================================
// `a > b` over `a: T, b: U` meets the two variables as the arithmetic twin
// does, so a rank-1 and a rank-2 array -- which share no elementwise shape --
// are refused at the call instead of reaching a body that co-iterates them.
function gt(a: T, b: U) = a > b
let g = gt([1.0, 5.0], [[2.0, 4.0], [3.0, 1.0]])
