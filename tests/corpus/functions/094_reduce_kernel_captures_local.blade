// TEST: Reduce Kernel Captures A Function Local
// ----------------------------------------------------------------------------
// A BINARY fold kernel that reads a binding of the enclosing FUNCTION frame.
// The compiled lane forwards `w` through the kernel's capture list and prints
// 11; the interpreter resolved the same kernel with an EMPTY capture map and
// died on the unbound id, because `evalCall` chains a callable's frame to the
// module-global scope only. A function-frame local is invisible from there.
//
// The differential gate is the point of this file: the two lanes disagreeing on
// a three-element fold is exactly the drift `blade test interp functions`
// exists to catch, and it needs a capture that is NOT module-global to see it.
// ----------------------------------------------------------------------------
function wsum(xs: T^1) -> T^0 = {
    let w = 2.0
    reduce(xs, lambda(p, q) -> p + w * q)
}
let A = [1.0, 2.0, 3.0]
let out = wsum(A)
// ((1 + 2*2) + 2*3) = 11
// EXPECT: out = 11
