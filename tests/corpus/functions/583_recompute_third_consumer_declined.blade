// TEST: Recompute Selection Declines A Third Consumer
// ============================================================================
// x is read by THREE statements. The family prices 2..8 consumers (PM05,
// round 4 wave 3; it was bounded to two): recomputing the 2-op producer for
// two more consumers adds work +12 against traffic -6, so the model keeps
// x's pool (`materialized -- recompute not dominant`), written once and read
// three times. Values: x = [3, 5, 7], s = 15,
// q = 83, m = 105.
function stats(a: T^1) -> T^0 = {
    let x = method_for(a) <@> lambda(v) -> v * 2.0 + 1.0 |> compute
    let s = reduce(x, (+))
    let q = reduce(x, lambda(p, r) -> p + r * r, 0.0)
    let m = reduce(x, (*))
    s + q + m
}
let a = Float64([1.0, 2.0, 3.0])
let t = stats(a)
// EXPECT: t = 203.0
