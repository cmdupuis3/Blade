// TEST: A one-parameter lambda against a two-argument function type (rejects)
// ERROR: BL3001 @ 7:13
// ============================================================================
// The slot takes two arguments; the lambda one. (Before `(A, B) -> C` meant
// two slots, one parameter was the only count the slot admitted: it was ONE
// tuple slot. functions/241 is the one-slot form of this refusal.)
function ap2(f: (Float64^1, Float64) -> Float64, x: Float64^1, s: Float64) = f(x, s)
let r = ap2(lambda(v) -> reduce(v, (+)), [1.0, 2.0], 3.0)
