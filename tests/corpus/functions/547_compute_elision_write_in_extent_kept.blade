// TEST: Compute Elision Keeps The Snapshot Across A Write In An Extent
// ============================================================================
// The write between the compute and its fold hides in a TYPE: y's range bound
// `0..bump(a)` calls a function that writes `a(0) = 100` through its `mut`
// parameter. x read `a` at its compute, [1, 2, 3] -> sum of v + 1 = 9; an
// elided x would read the written `a` at the fold (108). BLADE_COMPUTE_ELIDE
// audits the extents a statement's types carry like its value and declines
// ("an intervening statement may write"). 9 + (1 + 2 + 3) = 15.
function bump(a: mut Array<Int64 like Idx<3>>) -> Int64 = {
    a(0) = 100
    3
}
function f() -> Int64 = {
    let mut a = [1, 2, 3]
    let x = method_for(a) <@> lambda(v) -> v + 1 |> compute
    let y = method_for(0..bump(a)) <@> lambda(v) -> v + 1 |> compute
    let s = reduce(x, (+), 0)
    s + reduce(y, (+), 0)
}
let t = f()
// EXPECT: t = 15
