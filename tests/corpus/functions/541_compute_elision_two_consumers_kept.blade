// TEST: Compute Elision Declines Two Consumers
// ============================================================================
// A `|> compute` with TWO readers keeps its pool (BLADE_COMPUTE_ELIDE
// declines: "more than one reader"): eliding it would evaluate the producer
// once per consumer. Values pinned; the plan record and the kept allocation
// are asserted by `blade test optimize` (compute-elision cases).
function sum_and_product(a: T^1) -> T^0 = {
    let x = method_for(a) <@> lambda(v) -> v + 1.0 |> compute
    reduce(x, (+)) * reduce(x, (*))
}
let a = Float64([1.0, 2.0, 3.0])
let p = sum_and_product(a)
// EXPECT: p = 216.0
