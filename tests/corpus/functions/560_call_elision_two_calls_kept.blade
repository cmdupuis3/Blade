// TEST: Call Elision Keeps Several Calls In One Statement
// ============================================================================
// v1 jointly lowers a statement's ONLY call: a consumer with two calls
// (`prep(A) + prep(B)`, a fold whose seed is a call) declines "several calls
// in one statement" and every call keeps its materialized return.
function prep(a: T^1) -> T^1 = { method_for(a) <@> lambda(v) -> v * 2.0 |> compute }
function first(a: T^1) -> T^0 = { a(0) }
let A = Float64([1.0, 2.0, 3.0])
let B = Float64([10.0, 20.0, 30.0])
let y = prep(A) + prep(B)
let s = reduce(prep(A), (+), first(B))
// EXPECT: y = [22.0, 44.0, 66.0]
// EXPECT: s = 22.0
