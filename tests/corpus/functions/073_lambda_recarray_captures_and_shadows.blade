// TEST: Lambda Recursive-Array Capture And Shadowing
// ----------------------------------------------------------------------------
// `ExprRecArray` was dropped by the same `collectFreeVars` catch-all as 070,
// and it is the one added arm that BINDS rather than merely recursing, so it
// is pinned in both directions:
//
//  CAPTURE   the inductive slice reads block-local `c`, which reaches the
//            lambda only through the recursive-array arms. Dropped, the lifted
//            kernel emits a dangling VarId.
//  SHADOWING `prefix` and `n` are ALSO outer bindings here. Inside the arms
//            they are the definition's own binders (PrefixVar / StepVar), so
//            they must NOT be reported free -- otherwise the lambda captures
//            the outer Float64 `n` / `prefix` in place of the ordinals. The
//            outer two are read again after the lambda, so a mix-up changes
//            the result rather than hiding.
//            (`q` is likewise self-reference, not capture.)
//
// This is why the arm cannot just union its sub-expressions the way the
// reference walker `RecFusion.countVarOcc` does -- that one deliberately
// ignores shadowing; a capture analysis may not.
let out = {
    let c = 3.0
    let n = 100.0
    let prefix = 500.0
    let k = lambda(i: Int) -> {
        let rec q: Array<Float like Idx<4>> =
            match q with
            | zero -> zero
            | zero :: s -> zero :: 1.0
            | prefix :: n -> prefix :: prefix(n - 1) * c
        q(i)
    }
    // q = [1, 3, 9, 27] -> q(3) = 27, plus the untouched outer 100 and 500.
    k(3) + n + prefix
}
// EXPECT: out = 627
