// TEST: Body Reads In Evaluation Order Keep Their Values
// ============================================================================
// Gap G239, round 4 wave 10 (lane C, C1): inside a FUNCTION body a deferred
// module map is forced AT EACH READ POSITION, in evaluation order (formalism
// 10.2) -- an untaken read forces nothing and the evaluation count is
// observable. The compiled lanes forced it once per body statement, before
// the statement; a read whose order that cannot reproduce is now a call of a
// one-statement helper and the statement spine is put in evaluation order
// (Lowering.splitDeferredBodyReadsModule).
// ============================================================================
type A = Array<Float64 like Idx<1>>
let mut backing: A = [4.0]
let forcing = method_for(backing) <@> lambda(e) -> Int64(floor(sqrt(e)))
let mut cnt: Int64 = 0
function bump2() -> Int64 = { cnt = cnt + 1; 0 }
// cnt is read before the callee writes it, and after
function f() -> Int64 = { let a = cnt * 100 + bump2() + forcing(0) + cnt * 10; a }
function h(z: Int64) -> (Int64, Int64) = ((10 / z) + forcing(0), 0)
function g(z: Int64) -> Int64 = { let (u, v) = h(z); u + v }
function k7(z: Int64) -> Int64 = { let k = 10 / z; let a = if k > 1 then forcing(0) * k else (100 / z) + forcing(0); a }
function q5() -> Float64 = if forcing(0) > 0 then sqrt(reduce(backing * backing, (+))) else 0.0
let r1 = f()
let (a, b) = h(5)
let r2 = g(2)
let r3 = k7(5)
let r4 = k7(20)
let r5 = q5()
// EXPECT: r1 = 12
// EXPECT: a = 4
// EXPECT: r2 = 7
// EXPECT: r3 = 4
// EXPECT: r4 = 7
// EXPECT: r5 = 4.0
