// TEST: Main Local Self Recursion
// A self-recursive function that also reads a module binding, so it is
// main-local: emitted inside main() as
//     std::function<double(double)> countdown = [&](double n) -> double {
//         return ((n <= 0.0) ? K : (n + countdown((n - 1.0))));
//     };
// That idiom is legal precisely because `[&]` binds the declarator by
// reference and the name is in scope by the time the body runs -- a
// main-local needs no forward declaration to call ITSELF.
//
// The pin matters because main-locality has no forward declarations at all,
// so it is order-sensitive by construction; this fixes the one recursive
// shape that IS legal. The mutual case, which is not, is pinned by 060.
let K = 1.0
function countdown(n: Float64) -> Float64 = if n <= 0.0 then K else n + countdown(n - 1.0)
let r = countdown(4.0)
// 4 + 3 + 2 + 1 + K
// EXPECT: r = 11
