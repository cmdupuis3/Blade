// TEST: A let-bound lambda's arrow parameter at two element types and two kinds
// ============================================================================
// Before, the first use bound the lambda's parameter: `head(iv)` made it an
// Int64 array and `head([1.5, 2.5])` was refused. Used only by application,
// the binding is checked as the equivalent `function` declaration
// (functions/219): the arrow parameter -- and the element read from it -- is
// generic, one body per instance.
let iv = [4, 5, 6]
let head = lambda(c) -> c(0)
let h1 = head(iv)
// EXPECT: h1 = 4
let h2 = head([1.5, 2.5])
// EXPECT: h2 = 1.5
let h3 = head(lambda(i) -> i + 7)
// EXPECT: h3 = 7

// A parameter used only as the subscript is generic with it.
let pick = lambda(c, i) -> c(i)
let p1 = pick([1.0, 2.0, 3.0], 2)
// EXPECT: p1 = 3.0
let p2 = pick(lambda(k) -> Float64(k) * 3.0, 2)
// EXPECT: p2 = 6.0

// Applied to its own result: a function, at a Float64 and at an Int64.
let twice = lambda(f, x) -> f(f(x))
let t1 = twice(lambda(y) -> y * 2.0, 3.0)
// EXPECT: t1 = 12.0
let t2 = twice(lambda(y) -> y + 1, 3)
// EXPECT: t2 = 5
