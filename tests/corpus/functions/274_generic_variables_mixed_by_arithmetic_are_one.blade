// TEST: Two generic variables mixed by arithmetic are one variable
// ============================================================================
// `x + y` over `x: T, y: U` answered `T`, so `add(1, 2.5)` typed the Float64
// sum as an Int64 (g++ refused the narrowing, BL9002). There is no promotion
// type in a signature (formalism 2.4): where two variables would mix, the
// signature names one, and the caller converts. So arithmetic between two
// bare generic variables -- declared or unannotated -- makes them one, and
// its arguments agree exactly: two different argument types are refused,
// literals included (functions/275, 401-405); the caller converts.
// ============================================================================
function add(x: T, y: U) = x + y
let s: Float64 = add(2.5, Float64(1))
let si: Int64 = add(Int64(3), Int64(4))
// EXPECT: s = 3.5
// EXPECT: si = 7

function addu(x, y) = x + y
let u: Float64 = addu(Float64(2.5), Float64(1.0))
let ui: Int64 = addu(Int64(3), Int64(4))
let ua = addu(Float64([1.0, 2.0]), Float64([0.5, 0.5]))
// EXPECT: u = 3.5
// EXPECT: ui = 7
// EXPECT: ua = [1.5, 2.5]

// NOT `^`: its exponent is polymorphic (formalism 2.4) and never shares
// the base's variable -- an integer power of a Float64 base squares out in
// the base's type (functions/500-505).
function pw(x, n) = x ^ n
let p1: Int64 = pw(Int64(2), Int64(10))
let p2: Float64 = pw(Float64(2.0), Int64(3))
// EXPECT: p1 = 1024
// EXPECT: p2 = 8.0
