// TEST: A Callee Of A Kernel Reads A Deferred Module Map
// ============================================================================
// Gap G190 (d), round 4 wave 8 (lane C, C2), the lead's side bug (i): a
// function that reads a DEFERRED module map, called from a kernel inside a
// function body, is emitted at namespace scope (the kernel captures an
// enclosing parameter), forces the map privately in its body, and the map's
// own input `forcing` must then be nameable there too (the S0 hoist follows a
// demanded deferred map to its inputs). It was a C++ BL9002 (`forcing` not
// declared); the LLVM lane and the interpreter print r = -1.0.
// ============================================================================
type A = Array<Float64 like Idx<1>>
function identity(a: A) -> A = a
let mut backing: A = [2.0]
let forcing = identity(backing)
let delayed = method_for(forcing)
    <@> lambda(v) -> 1 / Int64(floor(v))
function k(x: Float64) -> Float64 = {
    let unused = Float64(delayed(0))
    x
}
function f(x: Float64, w: A) -> Float64 = {
    let ys = method_for(range<Idx<3>>)
        <@> lambda(i) -> k(x) |> compute
    reduce(ys, (+)) - 2.0 * w(0)
}
let r = f(Float64(1.0), identity(backing))
// EXPECT: r = -1.0