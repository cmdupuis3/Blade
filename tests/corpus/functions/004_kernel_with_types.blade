// TEST: Kernel With Types
// Kernel with explicit param types — exercises inline annotation syntax
// on lambda params. Body produces rank-2 outer product M[i][j] = a[i] * b[j],
// hence the rank-2 return type.
function vectorDot(a: Array<Float64 like Idx<n>>, b: Array<Float64 like Idx<n>>)
  -> Array<Float64 like Idx<n>, Idx<n>> =
  method_for(a, b) <@> lambda(x: Float64, y: Float64) -> x * y |> compute
// Called, so the annotated params are actually instantiated rather than only
// parsed. HAND DERIVATION (a = [1, 2, 3], b = [4, 5, 6]):
//   M(i, j) = a(i) * b(j), printed flat row-major (rank-2 results print flat):
//     row i=0:  1*4, 1*5, 1*6  =  4,  5,  6
//     row i=1:  2*4, 2*5, 2*6  =  8, 10, 12
//     row i=2:  3*4, 3*5, 3*6  = 12, 15, 18
let a = [1.0, 2.0, 3.0]
let b = [4.0, 5.0, 6.0]
let M = vectorDot(a, b)
// EXPECT: M = [4, 5, 6, 8, 10, 12, 12, 15, 18]
