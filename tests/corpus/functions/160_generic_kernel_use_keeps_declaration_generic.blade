// TEST: A generic function used as a kernel stays generic
// ============================================================================
// The named-function kernel wrapper `lambda(__k) -> mean(__k)` pinned its
// parameters to the DECLARATION's own type variables, and its body call's
// open argument fell back to the declared return: the kernel use over
// Float64 rows bound `mean` itself to Float64, so `mean(int_row)` after it
// was a BL3001 against `Array<Float64 ..>` (and a call before it died in
// g++ against the one emitted `double mean(Array<double,1>)`). The wrapper
// now pins an instantiated copy, and an open monomorphic argument meets its
// parameter's copy (the HM application rule), so the call has its own
// instance and the declaration stays open for monomorphization.
// ============================================================================
function imean(row: T^1) -> T^0 = reduce(row, (+)) / extents(row)
let xi = [1, 2, 4]
let a = imean(xi)
// EXPECT: a = 2
let B = [[1.0, 2.0, 3.0], [2.0, 4.0, 6.0]]
let rowmeans = method_for(B) <@> imean |> compute
// EXPECT: rowmeans = [2, 4]
let c = imean(xi)
// EXPECT: c = 2
let d = imean([1.5, 2.0])
// EXPECT: d = 1.75
