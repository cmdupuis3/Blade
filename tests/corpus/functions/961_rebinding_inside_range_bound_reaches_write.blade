// TEST: a rebinding inside a range bound restores a view before the write (rejects)
// ERROR: BL4005 @ 9:1
// ERROR-CONTAINS: a captured binding may be written only when it was declared `let mut`
// REJECT-AT: lower
// R12 (deep review; Codex review of the fix, class closure): the range bound
// runs `v = g(1)` after `v = [5.0, 6.0]` and before the store, so the store
// writes the captured plain `g`: a name rebound inside an expression a type
// carries is not flow-tracked.
let g = [[1.0, 2.0], [3.0, 4.0]]
function f() -> Float32 = {
    let v = g(0)
    v = [5.0, 6.0]
    let y = method_for(0..{ v = g(1); 2 })
        <@> lambda(i) -> i |> compute
    v(0) = 9.0
    v(0) + Float32(reduce(y, (+), 0))
}
let r = f()
