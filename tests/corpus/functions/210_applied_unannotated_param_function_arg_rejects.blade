// TEST: A function passed where the body subscripts the parameter (rejects)
// ERROR: BL3001 @ 10:15
// ============================================================================
// `c(0)` applies `c` to an index, and an unannotated parameter is
// monomorphic: one emitted body, so it is an array OR a function, not both.
// An index-like application reads as the array (dimensional currying). A
// function of an index is refused at the argument rather than lowered to a
// subscript of a closure. Annotate `c: (Int64) -> Float64` to take one.
let g = lambda(i) -> 10.0 * Float64(i)
function first(c) = c(0) + 1.0
let d = first(g)