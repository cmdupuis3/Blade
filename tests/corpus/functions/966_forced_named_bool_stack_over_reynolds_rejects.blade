// TEST: Forcing A Named Bool Wrapper Stack Over A reynolds Map Is Refused (rejects)
// ERROR: BL3001 @ 11:38
// ERROR-CONTAINS: stage over a reynolds(..) map runs inside the symmetrized kernel
// ============================================================================
// R11: `flags` is a deferred stack (not computed where it is bound); its
// forcing use `flags |> compute` runs `positive` inside the symmetrized
// kernel, whose terms are summed. Accepted on base.
// ============================================================================
let a: Array<Float64 like Idx<2>> = [1.0, 2.0]
let b: Array<Float64 like Idx<2>> = [3.0, 4.0]
let g = lambda(x, y) -> x * y
let positive = lambda(z: Float64) -> z > 0.0
let flags = positive <$> (method_for(a, b) <@> reynolds(g))
let r = flags |> compute
