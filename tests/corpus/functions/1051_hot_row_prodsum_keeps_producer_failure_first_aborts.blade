// TEST: A Row Fold Of A Possibly Failing prodsum Keeps The Producer's Later Failure First (aborts)
// Gap G265 (round 4 wave 10 lane d; Codex design review): the producer fails at its row 1
// (1 / (1 - 1)); the hot-row schedule ran row 0's prodsum(row, b) first and reported its BL8011.
// The two-pass form completes the producer first, so the producer's BL8013 is the outcome, in
// every lane (the schedule now declines a may-fail row kernel behind a producer that may fail).
// ABORT: BL8013
type I = Idx<6>
let x: Array<Int64 like I> = [1, 2, 3, 4, 5, 6]
let ca = compound(x, mask(x, lambda(v) -> v > 1))
let cb = compound(x, mask(x, lambda(v) -> v > 3))
let a = Float64(0..extents(ca)) |> compute
let b = Float64(0..extents(cb)) |> compute
let P = method_for(0..4, a) <@> lambda(i, v) -> v + Float64(1 / (Int64(i) - 1)) |> compute
let s = reduce(method_for(P) <@> lambda(row: T^1) -> prodsum(row, b), (+), 0.0)
