// TEST: A let-bound lambda whose open parameter its body used as a value meets an array slot (rejects)
// ERROR: BL3001 @ 8:12
// ============================================================================
// `v * 2.0` was typed at the binding with `v` open, as one value; the body is
// not re-typed, so `v` is not made an array here (it used to be, reaching g++
// with an array returned as a double, BL9002). Annotate `v`.
function ap(f: (Float64^1) -> Float64, x: Float64^1) = f(x)
let g = lambda(v) -> v * 2.0
let r = ap(g, [1.0, 2.0])
