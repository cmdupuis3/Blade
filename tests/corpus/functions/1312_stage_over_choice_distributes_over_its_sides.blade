// TEST: A Stage Over A Choice Distributes Over Its Sides (G318)
// Lane z (borrow round, 2026-11-24; gap G335, formalism 10.4): a `<$>` stage that moves a zero is refused
// over an uncomputed guard or choice (BL4022): r1, r3, r7, r8 and r9 write the stage on EACH SIDE of the
// choice -- the distribution itself, with the laws' cells unchanged (r3 still tests a complex result
// against the complex zero, G318); r2, r4, r5 keep `dbl` over the uncomputed choice, which the rule accepts.
// r7 was the strict borrow oracle's one NO-WRITES line.
// Found while reading lane o's G317 (borrow round, lane x, gap G327): a `<$>` stage over a guard whose body
// is not one map application was DROPPED in the C++ lane -- a same-type stage silently (`dbl <$> guard(true,
// cf)` printed cf), a type-changing one as a BL9002 (G317). The stage now takes the law's form (formalism
// 10.1, 10.4 left zero): `f <$> guard(p, c)` is `guard(p, f <$> c)` -- the staged cells where p holds, the
// zero of the RESULT where it does not (f is never applied to a zero cell).
// Over a choice the stage distributes (formalism 10.4, left distribution): `f <$> (a <|> b)` is
// `(f <$> a) <|> (f <$> b)`, the cell test on the stage's RESULT; for a complex result that test is against the
// complex zero (it was `!= 0`, BL9002, G318). A guard of a choice is the guard of the choice's value.
type I = Idx<3>
let cf: Array<Float64 like I> = [1.5, 0.0, -2.0]
let cf2: Array<Float64 like I> = [9.0, 4.0, 3.0]
let dbl = lambda(z: Float64) -> z * 2.0
let positive = lambda(z: Float64) -> z > 0.0
let shift = lambda(z: Float64) -> z - 1.5
let inc = lambda(z: Float64) -> z + 1.0
let cpx = lambda(z: Float64) -> complex(z, 1.0)
let ch = cf <|> cf2
let r1 = (positive <$> cf) <|> (positive <$> cf2) |> compute
let r2 = dbl <$> (cf <|> cf2) |> compute
let r3 = (cpx <$> cf) <|> (cpx <$> cf2) |> compute
let r4 = dbl <$> guard(true, cf <|> cf2) |> compute
let r5 = dbl <$> (guard(false, cf) <|> cf2) |> compute
let r6 = guard(false, ch) |> compute
let r7 = guard(true, (positive <$> cf) <|> (positive <$> cf2)) |> compute
let r8 = (shift <$> cf) <|> (shift <$> cf2) |> compute
let r9 = (inc <$> cf) <|> (inc <$> cf2) |> compute
// EXPECT: r1 = [true, true, true]
// EXPECT: r2 = [3.0, 8.0, -4.0]
// EXPECT: r4 = [3.0, 8.0, -4.0]
// EXPECT: r5 = [18.0, 8.0, 6.0]
// EXPECT: r6 = [0.0, 0.0, 0.0]
// EXPECT: r7 = [true, true, true]
// EXPECT: r8 = [7.5, -1.5, -3.5]
// EXPECT: r9 = [2.5, 1.0, -1.0]
