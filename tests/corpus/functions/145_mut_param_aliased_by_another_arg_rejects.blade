// TEST: Binding passed to a mut parameter and another parameter (rejects)
// ERROR: BL4005
// ERROR-CONTAINS: same binding 'x'
// ============================================================================
// The Fortran no-alias rule. `f(x, x)` hands the callee two names for one
// buffer, one of them writable: after `a(0) = 5.0`, the read `b(0)` sees 5, so
// the result depends on the order the body happens to read and write in. Write
// permission (formalism 2.7) was checked per argument; the aliasing between
// arguments was not.
function f(a: mut Array<Float like Idx<2>>, b: mut Array<Float like Idx<2>>) -> Float = {
    a(0) = 5.0
    b(0) = a(0) + 1.0
    a(0)
}
let mut x = [1.0, 2.0]
let v = f(x, x)
