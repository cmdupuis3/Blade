// TEST: A Bool-Valued Functor Wrapper Over An Inline-Computed reynolds Map Computes
// EXPECT: r = [[true, true], [true, true]]
// ============================================================================
// R11 accepted twin of functions/935: the inner `|> compute` is materialized
// (lifted to its own binding), so the wrapper maps over stored numbers.
// ============================================================================
let a: Array<Float64 like Idx<2>> = [1.0, 2.0]
let b: Array<Float64 like Idx<2>> = [3.0, 4.0]
let g = lambda(x, y) -> x * y
let positive = lambda(z: Float64) -> z > 0.0
let r = positive <$> ((method_for(a, b) <@> reynolds(g)) |> compute) |> compute
