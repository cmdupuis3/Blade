// TEST: Call Elision Keeps An OMP Callee
// ============================================================================
// A callee that requests a parallel strategy (`where omp` on the function or
// on its map kernel) keeps its own route: BLADE_CALL_ELIDE declines, the call
// and its return pool stay.
function par(xs: Float64^1) where omp(xs: 1) = {
    xs <@> lambda(x) where omp(x: 1) -> x * 3.0 |> compute
}
function kpar(xs: Float64^1) -> Float64^1 = {
    method_for(xs) <@> lambda(x) where omp(x: 1) -> x + 1.0 |> compute
}
let A = [1.0, 2.0, 3.0, 4.0]
let s = reduce(par(A), (+))
let t = reduce(kpar(A), (+))
// EXPECT: s = 30.0
// EXPECT: t = 14.0
