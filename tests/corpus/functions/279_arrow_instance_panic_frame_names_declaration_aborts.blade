// TEST: A panic inside an arrow parameter's array instance names the declaration (aborts)
// ABORT: BL8006
// ABORT: at walk
// ABORT: at outer
// ============================================================================
// `outer(A)` and the `walk(m, 5)` inside it are calls of ARRAY INSTANCES
// (formalism 4.3), emitted under internal names (`walk__arrow1`,
// `outer__arrow1`). An instance is the same declaration as its origin, not a
// second one, so the out-of-range read's frame trace names `walk` and `outer`
// -- the names the program wrote -- in both lanes. (A pin is a substring;
// `blade test cli` asserts the frame lines are exactly `at walk` / `at outer`.)
type L = Idx<3>
let A: Array<Float64 like L> = [1.0, 2.0, 3.0]
function walk(c, n: Int64) -> Float64 = if n == 0 then c(0) else c(n) + walk(c, n - 1)
function outer(m: T^1) = walk(m, 5)
let s = outer(A)
