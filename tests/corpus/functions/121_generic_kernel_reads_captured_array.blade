// TEST: Generic Kernel Reads Captured Array
// ============================================================================
// A kernel that READS A CAPTURED GENERIC ARRAY parameter -- the resampling
// shape `stdlib/plot.blade`'s decimation ladder is built from:
//
//     function f(a: Array<T like Idx<n>>, na: Int64) -> Array<T like Half> =
//         (method_for(range<Half>) <@> lambda(k) -> a((k * na) / 4)) |> compute
//
// The body types as the signature var `T` (unresolved on purpose --
// monomorphization fills it per call site), and the map's OUTPUT element
// type must stay `T` too. It did not: the deduction fell back to the
// ITERATED array's element type, and the iteration here is a `range<Half>`,
// whose elements are `Nat<Half>` -- so the result was typed as the LOOP
// INDEX rather than as what the kernel reads. The map then answered with
// index values, and any element-type demand on it (json_array's, a
// declared return) refused or mis-specialized.
//
// The pin is that ONE function serves three element types and each keeps
// its own: the Int64 row is the sharp one, because the workaround for this
// bug was a trailing `* 1.0` in the kernel, which silently turned an
// integer grid into floating point (a documented wart of plot.blade's
// decimation, removed with the fix).
//
// Every sample is an ORIGINAL datum at an evenly strided position -- index
// k reads (k * na) / 4 -- so the values also pin that no conversion or
// interpolation happens on the way out.
// ============================================================================
type Half = Idx<4>
type Src = Idx<8>
function stride2(a: Array<T like Idx<n>>, na: Int64) -> Array<T like Half> =
    (method_for(range<Half>) <@> lambda(k) -> a((k * na) / 4)) |> compute
let f64: Array<Float64 like Src> = [0.5, 1.5, 2.5, 3.5, 4.5, 5.5, 6.5, 7.5]
let i64: Array<Int64 like Src> = [10, 20, 30, 40, 50, 60, 70, 80]
let f32: Array<Float32 like Src> = [0.25, 1.25, 2.25, 3.25, 4.25, 5.25, 6.25, 7.25]
let df = stride2(f64, 8)
let di = stride2(i64, 8)
let ds = stride2(f32, 8)
// EXPECT: df = [0.5, 2.5, 4.5, 6.5]
// EXPECT: di = [10, 30, 50, 70]
// EXPECT: ds = [0.25, 2.25, 4.25, 6.25]
