// TEST: A Stage That Moves A Zero Over An Uncomputed Guarded Choice Is Refused (rejects)
// ERROR: BL4022 @ 27:10
// ERROR-CONTAINS: is refused: its result would depend on whether the
// Lane z (borrow round, 2026-11-24; gap G335, formalism 10.4): a `<$>` stage that moves a zero is refused
// over an uncomputed guard or choice (BL4022). This test's SUBJECT was that refused reading (the laws
// for stages that move a zero), so it is a (rejects) probe now; the laws' cells are spelled with the stage
// INSIDE (stage-zero/004) and the leaves of a guarded choice are kept with a stage the rule accepts
// (stage-zero/005 n8, n9).
// The laws' values these lines pinned: a1 [2.5, 1.0, -1.0]; a2 [7.5, -1.5, -3.5]; a3 [true, true, true]; a4 [0.0, 0.0, 0.0]; a5 [false, false, false]; a6 [2.5, 1.0, -1.0]; a7 [7.5, -1.5, -3.5].
// ============================================================================
// Borrow round, lane o (the lead's law review of lane x's stage rework):
// formalism 10.4's left distribution, `f <$> guard(p, c) = guard(p, f <$> c)`
// and `f <$> (a <|> b) = (f <$> a) <|> (f <$> b)` -- the choice tests the
// STAGE's cells, a false guard is the stage type's zero. The stages here do NOT
// preserve zero (z + 1.0, z - 1.5, z > 0.0), so the as-written reading (map the
// stage over the materialized choice) differs: inc <$> guard(true, cf <|> cf2)
// is [2.5, 1.0, -1.0], not [2.5, 5.0, -1.0]. Leaves: stored, computed, an
// uncomputed map. Pins by hand from the laws.
// ============================================================================
type I = Idx<3>
let cf: Array<Float64 like I> = [1.5, 0.0, -2.0]
let cf2: Array<Float64 like I> = [9.0, 4.0, 3.0]
let inc = lambda(z: Float64) -> z + 1.0
let sub = lambda(z: Float64) -> z - 1.5
let pos = lambda(z: Float64) -> z > 0.0
let m = method_for(cf) <@> lambda(v) -> v
let c = m |> compute
let a1 = inc <$> guard(true, cf <|> cf2) |> compute
let a2 = sub <$> guard(true, cf <|> cf2) |> compute
let a3 = pos <$> guard(true, cf <|> cf2) |> compute
let a4 = inc <$> guard(false, cf <|> cf2) |> compute
let a5 = pos <$> guard(false, cf <|> cf2) |> compute
let a6 = inc <$> guard(true, c <|> cf2) |> compute
let a7 = sub <$> guard(true, m <|> cf2) |> compute
