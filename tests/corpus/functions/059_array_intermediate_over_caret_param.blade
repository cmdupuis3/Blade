// TEST: Array Intermediate Over Caret Param
// ============================================================================
// docs/plan-kernel-body-materialization.md stage S1 (M-B), in the ONE position
// where the fix is observable end to end today: a FUNCTION body, which codegen
// already emits as a real statement scope (genFuncBodyScoped). The kernel-body
// twin of this program types identically now but still dies at codegen until
// S2 routes the loop through the lifted callable -- see
// loops/117_kernel_body_array_intermediate.
//
// This is `examples/lswosa.blade`'s `hanning`, cut down to the seam. `s_sub` is
// a caret-shorthand `U^1` parameter, i.e. an arity-constrained inference VAR,
// not an IRTArray. The elementwise binop's array-producing arms are gated on an
// operand RESOLVING to an array, so `s_sub * w` fell to the SCALAR arm, the
// function's return type came out `Float64`, and the caller's `reduce(sw, (+))`
// refused with "reduce() requires an array as first argument" -- a type error
// about a value that is plainly an array. In the full file the same refusal
// surfaced one call later as "the parameter component is declared
// Array<Float64 like Idx<__inferred_n>> (rank 1) but the argument component is
// Float64 (rank 0)".
//
// The demand that fixes it is the one every array INTRINSIC already issues
// (requireArrayArgMinRank); the binop seam simply did not issue it. Note this
// is not a guess about the shape: Unify's arity invariant already refuses to
// bind an arity-1 var to anything but a rank-1 array, so the demand only
// decides WHEN the shape appears.
//
// Values are the taper itself, so a regression in the ELEMENT type (rather than
// the rank) shows up too: w_i = alpha - beta*cos(2*pi*t_i/span) with
// alpha = 0.53836, beta = 0.46164, span = 8, then sw_i = s_i*w_i/sqrt(scale)
// and scale = prodsum(w,w)/4.
// ============================================================================
let two_pi = 6.283185307179586

function taper(ts_sub: Tuple<T^1, U^1>, lower: T, upper: T) = {
    let t_sub, s_sub = ts_sub
    let alpha = 0.53836
    let beta = 1.0 - alpha
    let span = upper - lower
    let w = (t_sub <@> lambda(t) -> alpha - beta * cos(two_pi * t / span)) |> compute
    let scale = prodsum(w, w) / extents(w)
    (s_sub * w / sqrt(scale)) |> compute
}

let ts: Array<Float like Idx<4>> = [1.0, 2.0, 3.0, 4.0]
let ss: Array<Float like Idx<4>> = [1.0, 0.5, 0.25, 0.125]

let sw = taper((ts, ss), 0.0, 8.0)
// EXPECT: sw = [0.293711798006901, 0.373051878450875, 0.29962392894915, 0.173235325084922]

// The consumer that used to refuse: an array intrinsic over the array-valued
// return of a function whose body materialized it from a caret-shorthand param.
let tot = reduce(sw, (+))
// EXPECT: tot = 1.13962293049185
