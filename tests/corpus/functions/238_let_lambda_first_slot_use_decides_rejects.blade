// TEST: A let-bound lambda's parameter bound by a declared slot stays an array (rejects)
// ERROR: BL3001 @ 8:12
// ============================================================================
// The lambda is one body: its first use, against `(Float64^1) -> Float64`,
// made `v` an array, so a later scalar argument is refused.
function ap(f: (Float64^1) -> Float64, x: Float64^1) = f(x)
let h = lambda(v) -> v(0) + v(2)
let k1 = ap(h, [1.0, 2.0, 3.0])
let k3 = h(4.0)
