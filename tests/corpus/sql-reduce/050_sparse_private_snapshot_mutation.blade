// TEST: C05 census private sparse residual snapshot across parent mutation
let static K = [(4, 1), (0, 3), (2, 1), (1, 0), (0, 1)]
let vals: Array<Float64 like Idx<5>> = [4.0, 9.0, 2.0, 8.0, 3.0]
let mut S = sparse(vals, K)
function snapshot(p: mut Array<Float64 like SparseIdx<K>>) -> Float64 = {
    let residual = p((_, 1))
    p((4, 1)) = 99.0
    reduce(residual, lambda(a: Float64, b: Float64) -> a * 10.0 + b, 7.0)
}
let total = snapshot(S)
let after = S((4, 1))
// EXPECT: total = 7423.0
// EXPECT: after = 99.0
