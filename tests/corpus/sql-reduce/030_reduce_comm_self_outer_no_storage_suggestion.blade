// TEST: Reduce Over A Commutative Self Outer Product Suggests No Storage Pin
// A kernel that deduces commutative over (A, A) earns the BL4010 confirm-and-
// pin STORAGE suggestion when its output is materialized (symmetry/028). The
// same apply consumed DIRECTLY by `reduce` -- a lone leaf, a <&!> tree, an
// arity-polymorphic pack kernel -- is folded, never stored: there is no dense
// output to compact, and following the suggestion (`where comm`) is refused
// outright (reduce over a compact computation, BL3999). So no BL4010 fires
// here; WARN pins are strict, so any BL4010 on these lines fails the test.
// The folds still visit the FULL square: every ordered pair counts.
function packprod(a: Poly<T^0>) -> T^0 = {
    match arity(a) with
    | 1 -> { let head :: tail = a
             head }
    | _ -> { let head :: tail = a
             head * packprod(tail) }
}
let A = [1.0, 2.0, 3.0, 4.0]
// full fold of the all-pairs product: (sum A)^2
let pairprod = reduce(method_for(A, A) <@> lambda(a, b) -> a * b, (+), axes = 2)
// one <&!>-fused sweep, two commutative leaves over the named loop object
let L = method_for(A, A)
let (pairsum, pairprod2) = reduce((L <@> lambda(a, b) -> a + b) <&!> (L <@> lambda(a, b) -> a * b), (+))
// the default partial fold (innermost axis): row i is 4 a_i + sum A
let rowsums = reduce(method_for(A, A) <@> lambda(a, b) -> a + b, (+))
// an arity-polymorphic pack kernel deduced commutative at every arity
let packsum = reduce(object_for(packprod) <@> (A, A), (+), axes = 2)
// EXPECT: pairprod = 100.0
// EXPECT: pairsum = 80.0
// EXPECT: pairprod2 = 100.0
// EXPECT: rowsums = [14.0, 18.0, 22.0, 26.0]
// EXPECT: packsum = 100.0
