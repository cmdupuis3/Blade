// TEST: Fnbody Setops Returned
// ----------------------------------------------------------------------------
// Return-extent ABI (see index-types/242) for the DATA-DEPENDENT family. Where
// gram/transpose/stack can have every extent pinned by their operands' index
// records, intersect / union / unique size their result from a counting pass,
// so their extents table can never be a compile-time constant -- these are the
// forms that exercise the heap arm of the companion-extents rule, and the
// scope-exit `delete[]` that comes with owning one.
//
// A frame-local table here did not merely print garbage: the cardinality read
// back as an enormous number and the first consumer to size an allocation off
// it aborted with std::bad_alloc (BL8005).
// ----------------------------------------------------------------------------
type P = Idx<5>
type Q = Idx<4>
type U = Idx<9>

function isect(x: Array<Int64 like P>, y: Array<Int64 like Q>) -> Array<Int64 like P> = {
    let r = intersect(x, y)
    r
}

function uni(x: Array<Int64 like P>, y: Array<Int64 like Q>) -> Array<Int64 like U> = {
    let r = union(x, y)
    r
}

function uniq(x: Array<Int64 like P>) -> Array<Int64 like P> = {
    let r = unique(x)
    r
}

let p: Array<Int64 like P> = [1, 2, 3, 4, 5]
let q: Array<Int64 like Q> = [3, 4, 6, 7]
let dup: Array<Int64 like P> = [3, 1, 3, 2, 1]
let i1 = isect(p, q)
let u1 = uni(p, q)
let n1 = uniq(dup)
// EXPECT: i1 = [3, 4]
// EXPECT: u1 = [1, 2, 3, 4, 5, 6, 7]
// EXPECT: n1 = [3, 1, 2]
