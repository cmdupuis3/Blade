// TEST: float literals the double cannot hold keep their Float64 meaning
// ============================================================================
// R19 (lane a2) refuses a float literal whose spelling its double cannot hold
// where a Float32 is fixed (033-039). A Float64 context is NOT judged (review
// item R32 is open): `1e400` is inf and `1e-400` is 0.0 there, as before. An
// unannotated one DEFAULTS to Float64 (formalism 2.4, read on the spelling: a
// magnitude past FLT_MAX / a nonzero value whose Float32 rounding is zero),
// which c64 / d64 pin. A literal SPELLED as zero still fits a Float32.
// ============================================================================
let b: Float64 = 1e400
let a: Float64 = 1e-400
let c = 1e400
let d = 1e-400
let c64: Float64 = c
let d64: Float64 = d
let b_is_inf = b > 1.0e308
let c_is_inf = c64 > 1.0e308
let e: Float32 = 0.0
let f: Float32 = 0e0
let g: Float32 = -0.0
// EXPECT: a = 0.0
// EXPECT: d = 0.0
// EXPECT: d64 = 0.0
// EXPECT: b_is_inf = true
// EXPECT: c_is_inf = true
// EXPECT: e = 0.0
// EXPECT: f = 0.0
// EXPECT: g = -0.0
