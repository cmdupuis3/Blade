// TEST: Unique Of Dense Selection Control
// ----------------------------------------------------------------------------
// The control for 009 (round-3 D-B2): the same selected keys held in a DENSE
// array, the operand form unique() always walked by `.extents[0]`. Its
// distinct labels, in first-occurrence order, must equal 009's.
// ----------------------------------------------------------------------------
let selected_customer = Int64([3, 1, 3, 1, 3])
let labels = unique(selected_customer)
// EXPECT: labels = [3, 1]
