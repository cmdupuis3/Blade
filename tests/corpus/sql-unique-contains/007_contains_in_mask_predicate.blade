// TEST: Contains In Mask Predicate
// contains used inside a mask predicate — the canonical semijoin idiom.
// Membership hoisting (Optimize.planMembershipHoist) builds ONE search
// structure over B right before the mask and probes it per row, dropping
// the inner cost from O(|A|·|B|) to O(|A|+|B|). The result is identical
// to the per-row scan — this test guards correctness across the hoist.
let A = Int64([1, 2, 3, 4, 5, 6])
let B = Int64([2, 4, 6, 8])
let in_B = compound(A, mask(A, lambda(x) -> contains(B, x)))
// coordinates {1, 3, 5} = 2, 4, 6
let n = extents(in_B)
let x1 = in_B(1)
let x5 = in_B(5)
// EXPECT: n = 3
// EXPECT: x1 = 2
// EXPECT: x5 = 6
