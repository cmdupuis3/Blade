// TEST: AD Recursive Array, Checkpoints Decline An Array Literal Of Closures Over The Gradient Buffer
import ad as ad
// ============================================================================
// PM40 (rule `ad-checkpoint v1`, opt-in) DECLINES: `functions` is an
// UNANNOTATED array literal whose element is a closure capturing the
// gradient buffer `backing`; a copy of the literal is shallow, so the replay
// would read the buffer after the reverse sweep wrote it (Codex class-closure
// review of the wave-6 snapshot, round 1: admitted, dx 87296 instead of
// 64944). Every leaf of a literal target must be a proved scalar.
// s = [1, 3, 11, 123, 15131]; ds4/dx = 64944.
// ============================================================================
type A = Array<Float64 like Idx<1>>
function identity(a: A) -> A = a
let mut backing: A = [2.0]
function factory(a: A) -> (Int64 -> Float64) =
    lambda(i: Int64) -> a(i)
let functions = [factory(backing)]
function step(p: Float64) -> Float64 = {
    let forcing = functions(0)
    p * p + forcing(0)
}
function f(x: Float64, w: A) -> Float64 = {
    let rec s: Array<Float64 like Idx<5>> =
        match s with
        | zero -> zero
        | zero :: n -> zero :: x
        | prefix :: n -> prefix :: step(prefix(n - 1))
    s(4) + w(0)
}
let (value, dx) = ad.grad(f)(Float64(1.0), identity(backing), backing)
// EXPECT: value = 15133.0
// EXPECT: dx = 64944.0
