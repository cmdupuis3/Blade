// TEST: AD Replay Prune Keeps A Dead lgamma Whose Argument The Reverse Sweep Moved (rejects)
import ad as ad
// ROUND 4 WAVE 8 (G190 (c), lead decision): the gradient buffer here shares
// storage with an array the derivative reads (identity(..) beside the
// buffer, or a module alias of it), which is now REFUSED at lowering in every
// lane (BL4005); the program stays as the refusal witness of its shape.
// ============================================================================
// ad-replay-prune v1 (opt-in) KEEPS `let unused = lgamma(forcing(0))`:
// lgamma PANICS (BL8008) on a non-positive argument, and `forcing` is the
// gradient buffer, which the reverse sweep drives from 2 to 0 before the
// replay of the kernel body runs (Codex design review of the wave-6 typed
// grammar: the pruned build printed a value). The program fails as written,
// with and without the prune.
// ============================================================================
type A = Array<Float64 like Idx<1>>
function identity(a: A) -> A = a
let mut backing: A = [2.0]
let forcing = identity(backing)
function k(x: Float64) -> Float64 = {
    let unused = lgamma(forcing(0))
    x
}
function f(x: Float64, w: A) -> Float64 = {
    let ys = method_for(range<Idx<3>>)
        <@> lambda(i) -> k(x) |> compute
    reduce(ys, (+)) - 2.0 * w(0)
}
let r = ad.grad(f)(Float64(1.0), identity(backing), backing)
// ERROR: BL4005
// ERROR-CONTAINS: is passed to a mut parameter, but its storage also reaches the callee
// REJECT-AT: lower
