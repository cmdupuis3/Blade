// TEST: AD Recursive Array, Checkpoints Snapshot A Module Array Bound By A User Function Named Like An Intrinsic, Fresh Buffer
import ad as ad
// ============================================================================
// PM40 (rule `ad-checkpoint v1`, opt-in): the fresh-buffer twin of ad/061
// (round 4 wave 9, lane A, A1). The user `function sin` shadows the
// intrinsic and returns the module array `src`; `forcing = sin(1.0)` is a
// user-function result of a plain dense type (never the storage-free
// intrinsic), SNAPSHOTTED before the forward loop. The buffer is fresh: one
// sharing `src` is refused since round 4 wave 8 (G190 (c), ad/061).
// s = [1, 3, 11, 123, 15131]; ds4/dx = 64944.
// ============================================================================
type A = Array<Float64 like Idx<1>>
let src: A = [2.0]
function sin(a: Float64) -> A = src
let forcing = sin(1.0)
function f(x: Float64, w: A) -> Float64 = {
    let rec s: Array<Float64 like Idx<5>> =
        match s with
        | zero -> zero
        | zero :: n -> zero :: x
        | prefix :: n -> prefix :: prefix(n - 1) * prefix(n - 1) + forcing(0)
    s(4) + w(0)
}
let w0: A = [4.0]
let mut dw: A = [0.0]
let (value, dx) = ad.grad(f)(Float64(1.0), w0, dw)
// EXPECT: value = 15135.0
// EXPECT: dx = 64944.0
// EXPECT: dw = [1.0]
