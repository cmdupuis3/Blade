// TEST: AD Recursive Array, Checkpoints Decline A Module Array That May Alias A Gradient Buffer
import ad as ad
// ============================================================================
// PM40 (rule `ad-checkpoint v1`) DECLINES: the step reads the module binding
// `forcing`, a plain `let` whose value is a call (`identity(backing)`) and
// so may be the storage of the `let mut` passed below AS the gradient
// buffer. The reverse sweep adds the loss's d/dw into that buffer before a
// replay would read `forcing` again, so a replayed trajectory could differ
// from the first run's; the full tape is kept (its stored predecessors are
// the first run's). (Codex review of J1, round 1: the witness.)
// s = [1, 3, 11, 123, 15131]; ds4/dx = 2 s3 * 2 s2 * 2 s1 * 2 s0 = 64944.
// ============================================================================
type A = Array<Float64 like Idx<1>>
function identity(a: A) -> A = a
let mut backing: A = [2.0]
let forcing = identity(backing)
function f(x: Float64, w: A) -> Float64 = {
    let rec s: Array<Float64 like Idx<5>> =
        match s with
        | zero -> zero
        | zero :: n -> zero :: x
        | prefix :: n -> prefix :: prefix(n - 1) * prefix(n - 1) + forcing(0)
    s(4) + w(0)
}
let (value, dx) = ad.grad(f)(Float64(1.0), identity(backing), backing)
// EXPECT: value = 15133.0
// EXPECT: dx = 64944.0
