// TEST: AD Recursive Array, Checkpoints Decline An Uneven Nested Literal Aliasing The Gradient Buffer
import ad as ad
// ============================================================================
// PM40 (rule `ad-checkpoint v1`, opt-in) DECLINES: `forcing` is an UNANNOTATED
// nested literal with rows of unequal length, so it is RAGGED storage, and
// `let mut` does not deep-copy a ragged array -- a snapshot would share the
// gradient buffer `backing` (Codex class-closure review under rule R0, round
// 4 wave 6 round 2: admitted, dx 87296 instead of 64944). A literal target
// must be rectangular as well as scalar at every leaf.
// s = [1, 3, 11, 123, 15131]; ds4/dx = 64944.
// ============================================================================
type A = Array<Float64 like Idx<2>, RaggedIdx<_>>
function identity(a: A) -> A = a
let forcing = [[(2.0: Float64)], [(4.0: Float64), (5.0: Float64)]]
let mut backing = identity(forcing)
function f(x: Float64, w: A) -> Float64 = {
    let rec s: Array<Float64 like Idx<5>> =
        match s with
        | zero -> zero
        | zero :: n -> zero :: x
        | prefix :: n -> prefix :: prefix(n - 1) * prefix(n - 1) + forcing(0, 0)
    s(4) + w(0, 0)
}
let (value, dx) = ad.grad(f)(Float64(1.0), identity(backing), backing)
// EXPECT: value = 15133.0
// EXPECT: dx = 64944.0
