// TEST: AD Recursive Array, Checkpoints Decline A Row View Of A Module Array Named Like An Intrinsic, Fresh Buffer
import ad as ad
// ============================================================================
// PM40 (rule `ad-checkpoint v1`, opt-in) DECLINES: the fresh-buffer twin of
// ad/063 (round 4 wave 9, lane A, A1). `sin` is a module ARRAY, so
// `forcing = sin(0)` is a row VIEW (a value binding shadows the intrinsic
// name), and a subscript is not a stored form the snapshot copies; the full
// tape runs (`blade test access` pins "its value is not a stored form"). The
// buffer is fresh: one sharing the row is refused since round 4 wave 8
// (G190 (c), ad/063). s = [1, 3, 11, 123, 15131]; ds4/dx = 64944.
// ============================================================================
type A = Array<Float64 like Idx<1>>
let sin: Array<Float64 like Idx<1>, Idx<1>> = [[2.0]]
let forcing = sin(0)
function f(x: Float64, w: A) -> Float64 = {
    let rec s: Array<Float64 like Idx<5>> =
        match s with
        | zero -> zero
        | zero :: n -> zero :: x
        | prefix :: n -> prefix :: prefix(n - 1) * prefix(n - 1) + forcing(0)
    s(4) + w(0)
}
let w0: A = [4.0]
let mut dw: A = [0.0]
let (value, dx) = ad.grad(f)(Float64(1.0), w0, dw)
// EXPECT: value = 15135.0
// EXPECT: dx = 64944.0
// EXPECT: dw = [1.0]
