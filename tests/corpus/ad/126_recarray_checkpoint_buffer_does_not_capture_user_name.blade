// TEST: AD Recursive Array, The Checkpoint Buffer Does Not Capture A Module Array Spelled Like It
import ad as ad
// ============================================================================
// PM40 (rule `ad-checkpoint v1`, opt-in): round 4 wave 9, lane A (A3, the
// class-closure review, Codex continuation 5a8b7b7d). The checkpoint buffer
// was minted `__ck4` from a counter alone, so the module array `__ck4` the
// step reads was SHADOWED by it under BLADE_AD_CHECKPOINT=2 (value 677.0,
// dx 4160.0 against the full tape 15131.0, 64944.0). Synthesized names now
// skip every spelling the program uses; `blade test access` runs this
// program checkpointed against the full tape, raw bits.
// s = [1, 3, 11, 123, 15131]; ds4/dx = 2 s3 * 2 s2 * 2 s1 * 2 s0 = 64944.
// ============================================================================
let __ck4: Array<Float64 like Idx<1>> = [2.0]
function f(x: Float64) -> Float64 = {
    let rec s: Array<Float64 like Idx<5>> =
        match s with
        | zero -> zero
        | zero :: n -> zero :: x
        | prefix :: n -> prefix ::
            prefix(n - 1) * prefix(n - 1) + __ck4(0)
    s(4)
}
let (value, dx) = ad.grad(f)(Float64(1.0))
// EXPECT: value = 15131.0
// EXPECT: dx = 64944.0
