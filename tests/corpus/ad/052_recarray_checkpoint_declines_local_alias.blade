// TEST: AD Recursive Array, Checkpoints Decline A Local Alias Of A Module Array
import ad as ad
// ============================================================================
// PM40 (rule `ad-checkpoint v1`, opt-in) DECLINES: the step reads the LOCAL
// `local_forcing`, an alias of the module binding `forcing` that may be the
// storage of the gradient buffer `backing` (ad/050). The admission judges a
// forward local through the names its value reads, so the alias is the
// module array itself (Codex review of J1, round 2, finding 2).
// s = [1, 3, 11, 123, 15131]; ds4/dx = 64944.
// ============================================================================
type A = Array<Float64 like Idx<1>>
function identity(a: A) -> A = a
let mut backing: A = [2.0]
let forcing = identity(backing)
function f(x: Float64, w: A) -> Float64 = {
    let local_forcing = forcing
    let rec s: Array<Float64 like Idx<5>> =
        match s with
        | zero -> zero
        | zero :: n -> zero :: x
        | prefix :: n -> prefix :: prefix(n - 1) * prefix(n - 1) + local_forcing(0)
    s(4) + w(0)
}
let (value, dx) = ad.grad(f)(Float64(1.0), identity(backing), backing)
// EXPECT: value = 15133.0
// EXPECT: dx = 64944.0
