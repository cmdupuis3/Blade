// TEST: AD Recursive Array, Checkpoints Decline An Array Literal Of Tuples Holding An Array, Fresh Buffer
import ad as ad
// ============================================================================
// PM40 (rule `ad-checkpoint v1`, opt-in) DECLINES: the fresh-buffer twin of
// ad/066 (round 4 wave 9, lane A, A1). `tuples` is an unannotated literal of
// tuples whose first member is an array; its copy would be shallow, so the
// full tape runs (`blade test access` pins "an array literal element is not
// a proved scalar"). The buffer is fresh: one held by the tuple is refused
// since round 4 wave 8 (G190 (c), ad/066).
// s = [1, 3, 11, 123, 15131]; ds4/dx = 64944.
// ============================================================================
type A = Array<Float64 like Idx<1>>
let src: A = [2.0]
let tuples = [(src, 0)]
function step(p: Float64) -> Float64 = {
    let slot = tuples(0)
    let forcing = slot[0]
    p * p + forcing(0)
}
function f(x: Float64, w: A) -> Float64 = {
    let rec s: Array<Float64 like Idx<5>> =
        match s with
        | zero -> zero
        | zero :: n -> zero :: x
        | prefix :: n -> prefix :: step(prefix(n - 1))
    s(4) + w(0)
}
let w0: A = [4.0]
let mut dw: A = [0.0]
let (value, dx) = ad.grad(f)(Float64(1.0), w0, dw)
// EXPECT: value = 15135.0
// EXPECT: dx = 64944.0
// EXPECT: dw = [1.0]
