// TEST: AD Recursive Array, Checkpoints Decline A Step Reading An Array Out Of A Tuple Parameter (rejects)
import ad as ad
// ROUND 4 WAVE 8 (G190 (c), lead decision): the gradient buffer here shares
// storage with an array the derivative reads (identity(..) beside the
// buffer, or a module alias of it), which is now REFUSED at lowering in every
// lane (BL4005); the program stays as the refusal witness of its shape.
// ============================================================================
// PM40 (rule `ad-checkpoint v1`, opt-in) DECLINES: the tuple parameter `p`
// carries `identity(backing)`, the gradient buffer, and the step reads it
// through the local `forcing = p[0]`. A parameter is a scalar only when its
// type is positively a scalar (Codex design review of the wave-6 snapshot,
// finding 1: the tuple was taken for a scalar and the checkpointed dx was
// 87296); a projection is not a stored form the snapshot copies.
// s = [1, 3, 11, 123, 15131]; ds4/dx = 64944.
// ============================================================================
type A = Array<Float64 like Idx<1>>
function identity(a: A) -> A = a
let mut backing: A = [2.0]
function f(x: Float64, w: A, p: (A, Int64)) -> Float64 = {
    let forcing = p[0]
    let rec s: Array<Float64 like Idx<5>> =
        match s with
        | zero -> zero
        | zero :: n -> zero :: x
        | prefix :: n -> prefix :: prefix(n - 1) * prefix(n - 1) + forcing(0)
    s(4) + w(0)
}
let (value, dx) = ad.grad(f)(Float64(1.0), identity(backing), (identity(backing), Int64(0)), backing)
// ERROR: BL4005
// ERROR-CONTAINS: is passed to a mut parameter, but its storage also reaches the callee
// REJECT-AT: lower
