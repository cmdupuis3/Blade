// TEST: AD Recursive Array, Checkpoints Decline An Array Literal Whose Element Is Not A Proved Scalar, Fresh Buffer
import ad as ad
// ============================================================================
// PM40 (rule `ad-checkpoint v1`, opt-in) DECLINES: the fresh-buffer twin of
// ad/065 (round 4 wave 9, lane A, A1). A literal is a snapshot target only
// when every LEAF is a proved scalar; `vals = [src(0)]` holds a subscript,
// which is not, so the full tape runs (`blade test access` pins "an array
// literal element is not a proved scalar"). ad/065's own leaf -- a CLOSURE
// over the buffer -- is refused beside any mut argument since round 4 wave 8
// (G190 (c) / G240 (3), ad/104), so the rule is reached through a subscript.
// The step is a helper the AD normalizer inlines.
// s = [1, 3, 11, 123, 15131]; ds4/dx = 64944.
// ============================================================================
type A = Array<Float64 like Idx<1>>
let src: A = [2.0]
let vals = [src(0)]
function step(p: Float64) -> Float64 = p * p + vals(0)
function f(x: Float64, w: A) -> Float64 = {
    let rec s: Array<Float64 like Idx<5>> =
        match s with
        | zero -> zero
        | zero :: n -> zero :: x
        | prefix :: n -> prefix :: step(prefix(n - 1))
    s(4) + w(0)
}
let w0: A = [4.0]
let mut dw: A = [0.0]
let (value, dx) = ad.grad(f)(Float64(1.0), w0, dw)
// EXPECT: value = 15135.0
// EXPECT: dx = 64944.0
// EXPECT: dw = [1.0]
