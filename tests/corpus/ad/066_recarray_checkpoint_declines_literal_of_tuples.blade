// TEST: AD Recursive Array, Checkpoints Decline An Array Literal Of Tuples Holding The Gradient Buffer
import ad as ad
// ============================================================================
// PM40 (rule `ad-checkpoint v1`, opt-in) DECLINES: `tuples` is an unannotated
// array literal of tuples whose first member is the gradient buffer; its
// copy is shallow (Codex class-closure review of the wave-6 snapshot, round
// 1: admitted, dx 87296). s = [1, 3, 11, 123, 15131]; ds4/dx = 64944.
// ============================================================================
type A = Array<Float64 like Idx<1>>
function identity(a: A) -> A = a
let mut backing: A = [2.0]
let tuples = [(identity(backing), 0)]
function step(p: Float64) -> Float64 = {
    let slot = tuples(0)
    let forcing = slot[0]
    p * p + forcing(0)
}
function f(x: Float64, w: A) -> Float64 = {
    let rec s: Array<Float64 like Idx<5>> =
        match s with
        | zero -> zero
        | zero :: n -> zero :: x
        | prefix :: n -> prefix :: step(prefix(n - 1))
    s(4) + w(0)
}
let (value, dx) = ad.grad(f)(Float64(1.0), identity(backing), backing)
// EXPECT: value = 15133.0
// EXPECT: dx = 64944.0
