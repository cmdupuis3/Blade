// TEST: AD Recursive Array, Checkpoints Decline A Module Value Bound To A Call With No Declared Plain Dense Return
import ad as ad
// ============================================================================
// PM40 (rule `ad-checkpoint v1`, opt-in) DECLINES: the fresh-buffer twin of
// ad/064 (round 4 wave 9, lane A, A1). A user-function result is a snapshot
// target only when the function DECLARES a plain dense array return (a
// closure or a ragged array would keep shared storage); `make` declares no
// return type, so the full tape runs (`blade test access` pins "the call of
// 'make' does not return a plain dense array"). ad/064's own shape -- a
// CLOSURE result the step applies -- is refused beside any mut argument
// since round 4 wave 8 (G190 (c) / G240 (3): an untraced function value,
// ad/103), so this decline is reached through the undeclared return.
// s = [1, 3, 11, 123, 15131]; ds4/dx = 64944.
// ============================================================================
type A = Array<Float64 like Idx<1>>
let src: A = [2.0]
function make(a: A) = a
let forcing = make(src)
function f(x: Float64, w: A) -> Float64 = {
    let rec s: Array<Float64 like Idx<5>> =
        match s with
        | zero -> zero
        | zero :: n -> zero :: x
        | prefix :: n -> prefix :: prefix(n - 1) * prefix(n - 1) + forcing(0)
    s(4) + w(0)
}
let w0: A = [4.0]
let mut dw: A = [0.0]
let (value, dx) = ad.grad(f)(Float64(1.0), w0, dw)
// EXPECT: value = 15135.0
// EXPECT: dx = 64944.0
// EXPECT: dw = [1.0]
