// TEST: AD Recursive Array, Checkpoints Snapshot A Module Array Bound By A User Function Named Like An Intrinsic
import ad as ad
// ============================================================================
// PM40 (rule `ad-checkpoint v1`, opt-in, round 4 wave 6 snapshot, gap G162):
// the user `function sin` shadows the intrinsic and returns the gradient
// buffer `backing` itself (Codex review of J1, wave 5 round 3: it was read
// as the storage-free intrinsic). `forcing = sin(1.0)` is a user-function
// result of a plain dense type, copied before the forward loop; only the
// replay reads the copy. s = [1, 3, 11, 123, 15131]; ds4/dx = 64944.
// ============================================================================
type A = Array<Float64 like Idx<1>>
function identity(a: A) -> A = a
let mut backing: A = [2.0]
function sin(a: Float64) -> A = backing
let forcing = sin(1.0)
function f(x: Float64, w: A) -> Float64 = {
    let rec s: Array<Float64 like Idx<5>> =
        match s with
        | zero -> zero
        | zero :: n -> zero :: x
        | prefix :: n -> prefix :: prefix(n - 1) * prefix(n - 1) + forcing(0)
    s(4) + w(0)
}
let (value, dx) = ad.grad(f)(Float64(1.0), identity(backing), backing)
// EXPECT: value = 15133.0
// EXPECT: dx = 64944.0
