// TEST: AD Recursive Array, Checkpoints Decline A Destructured Module Component Beside A Fresh Buffer
import ad as ad
// ============================================================================
// PM40 (rule `ad-checkpoint v1`, opt-in) DECLINES: the fresh-buffer twin of
// ad/053 (round 4 wave 9, lane A, A1). `forcing = hidden`, and `hidden` is a
// component of a destructuring binding, which records no value a storage
// proof could read, so the replay-input snapshot cannot be proved a fresh
// plain dense copy; the full tape runs (`blade test access` pins the decline
// "the module value 'hidden' records no value"). The buffer is fresh: one
// sharing `hidden` is refused since round 4 wave 8 (G190 (c), ad/053).
// s = [1, 3, 11, 123, 15131]; ds4/dx = 64944.
// ============================================================================
type A = Array<Float64 like Idx<1>>
function identity(a: A) -> A = a
let src: A = [2.0]
let (hidden, marker) = (identity(src), 0)
let forcing = hidden
function f(x: Float64, w: A) -> Float64 = {
    let rec s: Array<Float64 like Idx<5>> =
        match s with
        | zero -> zero
        | zero :: n -> zero :: x
        | prefix :: n -> prefix :: prefix(n - 1) * prefix(n - 1) + forcing(0)
    s(4) + w(0)
}
let w0: A = [4.0]
let mut dw: A = [0.0]
let (value, dx) = ad.grad(f)(Float64(1.0), w0, dw)
// EXPECT: value = 15135.0
// EXPECT: dx = 64944.0
// EXPECT: dw = [1.0]
