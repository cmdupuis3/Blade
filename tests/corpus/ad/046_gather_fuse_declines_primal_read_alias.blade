// TEST: AD Gather Fuse Declines Primal Read Alias (rejects)
import ad as ad
// ROUND 4 WAVE 8 (G190 (c), lead decision): the gradient buffer here shares
// storage with an array the derivative reads (identity(..) beside the
// buffer, or a module alias of it), which is now REFUSED at lowering in every
// lane (BL4005); the program stays as the refusal witness of its shape.
// ============================================================================
// `ad-gather-fuse` DECLINES a stencil whose taps read the PRIMAL (a product of
// neighbours): a caller may pass the primal and its gradient buffer as ONE
// array (`identity(a)` and `a`), and interleaving the taps per cell would let
// a tap read a cell an earlier tap already updated (Codex review round 1: the
// fused form left [3, 8, 15, 19]). Declined, the per-tap passes run, as
// written: tap +1 over every cell, then tap 0, each reading what the earlier
// pass left.
// ============================================================================
type H = Idx<4>

function f(x: Array<Float64 like H>) -> Float64 = {
    let d = method_for(halo<H, [0, 1]>) <@> lambda(w) -> x(w(0)) * x(w(1)) |> compute
    reduce(d, (+))
}

function identity(x: Array<Float64 like H>) -> Array<Float64 like H> = x

let mut a: Array<Float64 like H> = [1.0, 2.0, 3.0, 4.0]
let z = ad.grad(f)(identity(a), a)
// ERROR: BL4005
// ERROR-CONTAINS: is passed to a mut parameter, but its storage also reaches the callee
// REJECT-AT: lower
