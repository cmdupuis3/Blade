// TEST: AD Recursive Array, Checkpoints Decline A Step Reading An Array Out Of A Tuple Parameter, Fresh Buffer
import ad as ad
// ============================================================================
// PM40 (rule `ad-checkpoint v1`, opt-in) DECLINES: the fresh-buffer twin of
// ad/062 (round 4 wave 9, lane A, A1). The step reads `forcing = p[0]`, an
// array carried by the TUPLE parameter `p`; a parameter is a scalar only
// when its type is positively one, and a projection is not a stored form
// the snapshot copies, so the full tape runs (`blade test access` pins "its
// value is not a stored form"). The buffer is fresh: one sharing the tuple
// member is refused since round 4 wave 8 (G190 (c), ad/062).
// s = [1, 3, 11, 123, 15131]; ds4/dx = 64944.
// ============================================================================
type A = Array<Float64 like Idx<1>>
let src: A = [2.0]
function f(x: Float64, w: A, p: (A, Int64)) -> Float64 = {
    let forcing = p[0]
    let rec s: Array<Float64 like Idx<5>> =
        match s with
        | zero -> zero
        | zero :: n -> zero :: x
        | prefix :: n -> prefix :: prefix(n - 1) * prefix(n - 1) + forcing(0)
    s(4) + w(0)
}
let w0: A = [4.0]
let mut dw: A = [0.0]
let (value, dx) = ad.grad(f)(Float64(1.0), w0, (src, Int64(0)), dw)
// EXPECT: value = 15135.0
// EXPECT: dx = 64944.0
// EXPECT: dw = [1.0]
