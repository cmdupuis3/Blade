// TEST: AD Recursive Array, Checkpoints Snapshot A Fresh Module Array A Later Mut Binding Aliases
import ad as ad
// ============================================================================
// PM40 (rule `ad-checkpoint v1`, opt-in): `forcing` is a FRESH array literal,
// and the later `let mut backing = identity(forcing)` may be its very
// storage, passed as the gradient buffer. The replay reads a copy of
// `forcing` taken before the forward loop, so the buffer write the reverse
// sweep makes first is not seen (round 4 wave 6, gap G162; Codex review of
// J1, round 2, finding 1).
// s = [1, 3, 11, 123, 15131]; ds4/dx = 2 s3 * 2 s2 * 2 s1 * 2 s0 = 64944.
// ============================================================================
type A = Array<Float64 like Idx<1>>
function identity(a: A) -> A = a
let forcing: A = [2.0]
let mut backing = identity(forcing)
function f(x: Float64, w: A) -> Float64 = {
    let rec s: Array<Float64 like Idx<5>> =
        match s with
        | zero -> zero
        | zero :: n -> zero :: x
        | prefix :: n -> prefix :: prefix(n - 1) * prefix(n - 1) + forcing(0)
    s(4) + w(0)
}
let (value, dx) = ad.grad(f)(Float64(1.0), identity(backing), backing)
// EXPECT: value = 15133.0
// EXPECT: dx = 64944.0
