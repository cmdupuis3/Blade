// TEST: AD Recursive Array, Checkpoints Decline A Module Array Bound Through A Destructured Component
import ad as ad
// ============================================================================
// PM40 (rule `ad-checkpoint v1`, opt-in) DECLINES: `forcing = hidden`, and
// `hidden` is a component of a destructuring binding, which records no value
// a storage proof could read (it is `identity(backing)`, the gradient
// buffer). An unknown name fails the proof (Codex review of J1, round 2,
// finding 3: it used to pass).
// s = [1, 3, 11, 123, 15131]; ds4/dx = 64944.
// ============================================================================
type A = Array<Float64 like Idx<1>>
function identity(a: A) -> A = a
let mut backing: A = [2.0]
let (hidden, marker) = (identity(backing), 0)
let forcing = hidden
function f(x: Float64, w: A) -> Float64 = {
    let rec s: Array<Float64 like Idx<5>> =
        match s with
        | zero -> zero
        | zero :: n -> zero :: x
        | prefix :: n -> prefix :: prefix(n - 1) * prefix(n - 1) + forcing(0)
    s(4) + w(0)
}
let (value, dx) = ad.grad(f)(Float64(1.0), identity(backing), backing)
// EXPECT: value = 15133.0
// EXPECT: dx = 64944.0
