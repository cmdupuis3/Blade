// TEST: AD Replay Prune Keeps A Dead lgamma Beside A Fresh Buffer
import ad as ad
// ============================================================================
// ad-replay-prune v1 (opt-in): the fresh-buffer twin of ad/068 (round 4 wave
// 9, lane A, A1). The replayed `let unused = lgamma(forcing(0))` is dead but
// lgamma PANICS (BL8008) on a non-positive argument, so the prune KEEPS it,
// while the trap-free dead `let spare = x * 2.0` is dropped; `blade test
// access` pins the decision. ad/068's trap needed the buffer to share
// `forcing`, refused since round 4 wave 8 (G190 (c), BL4005).
// f = 3 x - 2 w0, df/dx = 3, df/dw0 = -2.
// ============================================================================
type A = Array<Float64 like Idx<1>>
function identity(a: A) -> A = a
let src: A = [2.0]
let forcing = identity(src)
function k(x: Float64) -> Float64 = {
    let unused = lgamma(forcing(0))
    let spare = x * 2.0
    x
}
function f(x: Float64, w: A) -> Float64 = {
    let ys = method_for(range<Idx<3>>)
        <@> lambda(i) -> k(x) |> compute
    reduce(ys, (+)) - 2.0 * w(0)
}
let w0: A = [4.0]
let mut dw: A = [0.0]
let r = ad.grad(f)(Float64(1.0), w0, dw)
// EXPECT: r = (-5.0, 3.0)
// EXPECT: dw = [-2.0]
