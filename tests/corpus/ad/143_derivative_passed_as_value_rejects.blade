// TEST: A Derivative Passed As A Function Value Is Refused (rejects)
import ad as ad
// ============================================================================
// Gap G250 (1) / (3), round 4 wave 9 (lane C, C2): `ad.grad(f)` takes its
// gradient buffer as a `mut` parameter; handed to a function-typed parameter
// the buffer write was never judged against what the step reads. Refused
// (BL4005, every lane); the direct `ad.grad(f)(x, w, dw)` call is judged as
// before.
// ============================================================================
type A = Array<Float64 like Idx<2>>
function f(x: Float64, w: A) -> Float64 = x * w(0) + w(1)
function run(h: (Float64, A, A) -> (Float64, Float64), w: A, dw: A) -> Float64 = h(Float64(1.0), w, dw)[0]
let w0: A = [1.0, 2.0]
let mut dw: A = [0.0, 0.0]
let r = run(ad.grad(f), w0, dw)
// ERROR: BL4005
// ERROR-CONTAINS: has a mut parameter and is used here as a VALUE
// REJECT-AT: lower