// TEST: AD Recursive Array, Checkpoints Snapshot A Module Array A Parameter Default Hands On, Fresh Buffer
import ad as ad
// ============================================================================
// PM40 (rule `ad-checkpoint v1`, opt-in): the fresh-buffer twin of ad/060
// (round 4 wave 9, lane A, A1). `identity()` returns its DEFAULT argument,
// the module array `forcing`, which the step reads; `other` holds that
// result but is NOT passed as the gradient buffer (a buffer sharing
// `forcing` is refused since round 4 wave 8, G190 (c), ad/060). The step's
// read of `forcing` (a literal) is SNAPSHOTTED before the forward loop.
// s = [1, 3, 11, 123, 15131]; ds4/dx = 64944.
// ============================================================================
type A = Array<Float64 like Idx<1>>
let forcing: A = [2.0]
function identity(a: A = forcing) -> A = a
let other = identity()
function f(x: Float64, w: A) -> Float64 = {
    let rec s: Array<Float64 like Idx<5>> =
        match s with
        | zero -> zero
        | zero :: n -> zero :: x
        | prefix :: n -> prefix :: prefix(n - 1) * prefix(n - 1) + forcing(0)
    s(4) + w(0)
}
let w0: A = [4.0]
let mut dw: A = [0.0]
let (value, dx) = ad.grad(f)(Float64(1.0), w0, dw)
// EXPECT: value = 15135.0
// EXPECT: dx = 64944.0
// EXPECT: dw = [1.0]
// EXPECT: other = [2.0]
