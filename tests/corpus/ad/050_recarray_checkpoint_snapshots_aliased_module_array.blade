// TEST: AD Recursive Array, Checkpoints Snapshot A Module Array That Aliases A Gradient Buffer
import ad as ad
// ============================================================================
// PM40 (rule `ad-checkpoint v1`, opt-in): the step reads the module binding
// `forcing`, a plain `let` whose value is a call (`identity(backing)`) and so
// IS the storage of the `let mut` passed below AS the gradient buffer. The
// reverse sweep adds the loss's d/dw into that buffer before the replay
// runs; the replay reads a COPY of `forcing` taken before the forward loop
// (round 4 wave 6, gap G162; it declined in wave 5), so it replays the first
// run's trajectory. (Codex review of J1, round 1: the witness.)
// s = [1, 3, 11, 123, 15131]; ds4/dx = 2 s3 * 2 s2 * 2 s1 * 2 s0 = 64944.
// ============================================================================
type A = Array<Float64 like Idx<1>>
function identity(a: A) -> A = a
let mut backing: A = [2.0]
let forcing = identity(backing)
function f(x: Float64, w: A) -> Float64 = {
    let rec s: Array<Float64 like Idx<5>> =
        match s with
        | zero -> zero
        | zero :: n -> zero :: x
        | prefix :: n -> prefix :: prefix(n - 1) * prefix(n - 1) + forcing(0)
    s(4) + w(0)
}
let (value, dx) = ad.grad(f)(Float64(1.0), identity(backing), backing)
// EXPECT: value = 15133.0
// EXPECT: dx = 64944.0
