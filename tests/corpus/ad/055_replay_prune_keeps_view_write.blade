// TEST: AD Replay Prune Keeps A Write Through A Loop-Local View
import ad as ad
// ============================================================================
// ad-replay-prune v1 KEEPS the replayed `v(1) += 1`: `v` is a loop-local VIEW
// of `d`, and the adjoint of the earlier `t` (after the loop in the reverse
// sweep) reads d(0, 1) -- so the replay's write is observed (Codex review of
// PM59, wave 5 round 1: dropping it gave dx = 5.0). Element writes are never
// dropped; only loop-local lets and whole assignments of fresh locals with a
// trap-free value are.
// ============================================================================
// R12 (deep review): `touch` used to take `d` as a NON-`mut` parameter and write
// it through the view -- now BL4005 (functions/955-956 keep that shape as
// refusal witnesses), and a `mut` parameter is not inlinable by AD (BL5500) --
// so `d` is a module-level `let mut` that `touch` captures: the same view
// write, the same statement in the replayed loop, the same values.
type D = Array<Int32 like Idx<1>, Idx<2>>
let mut d: D = [[1, 1]]   // `mut`: `touch` writes it through a view -- a captured binding is writable only as `let mut` (D9, formalism 2.7)
function touch(x: Float64) -> Float64 = {
    let mut v = d(0)
    v(1) += 1
    x
}
function f(x: Float64) -> Float64 = {
    let t = x * Float64(d(0, 1))
    let ys = method_for(range<Idx<2>>)
        <@> lambda(i) -> touch(x) |> compute
    t + reduce(ys, (+))
}
let (value, dx) = ad.grad(f)(Float64(2.0))
// EXPECT: value = 6.0
// EXPECT: dx = 7.0
