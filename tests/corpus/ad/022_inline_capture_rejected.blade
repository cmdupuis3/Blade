// TEST: AD Inline Rename Capture (rejects)
// ERROR: BL5500
// ERROR-CONTAINS: inlining would rename 'p' to 'y'
import ad as ad
// ============================================================================
// Inlining binds a callee parameter by RENAMING it to the caller's variable:
// `helper(y, arr)` renames `p` to `y`. But helper's own kernel binds `y`, and
// the renamed `p` inside that kernel would be captured by it. Refused rather
// than silently read as the kernel's element.
//
// The refusal needs the occurrence test to be shadowing-aware in BOTH
// directions: it must fire here, where `p` occurs free under the colliding
// binder, and must NOT fire when the kernel merely reuses the name.
// ============================================================================
type I = Idx<3>
function helper(p: Float, arr: Array<Float like I>) -> Float = {
    let scaled = method_for(arr) <@> lambda(y: Float) -> y * p |> compute
    reduce(scaled, (+))
}
function loss(y: Float, arr: Array<Float like I>) -> Float = helper(y, arr)
let (lv, dly) = ad.grad(loss)(2.0, [1.0, 2.0, 3.0])
