// TEST: AD Recursive Array, Checkpoints Snapshot A Local Alias Of A Module Array Beside A Fresh Buffer
import ad as ad
// ============================================================================
// PM40 (rule `ad-checkpoint v1`, opt-in): the fresh-buffer twin of ad/052
// (round 4 wave 9, lane A, A1). The step reads the LOCAL `local_forcing`, an
// alias of the module array `forcing`; the admission judges the alias
// transitively and SNAPSHOTS the local itself before the forward loop (only
// the replay reads the copy). The buffer is fresh: a buffer sharing
// `forcing` is refused since round 4 wave 8 (G190 (c), BL4005, ad/052).
// s = [1, 3, 11, 123, 15131]; ds4/dx = 64944.
// ============================================================================
type A = Array<Float64 like Idx<1>>
function identity(a: A) -> A = a
let src: A = [2.0]
let forcing = identity(src)
function f(x: Float64, w: A) -> Float64 = {
    let local_forcing = forcing
    let rec s: Array<Float64 like Idx<5>> =
        match s with
        | zero -> zero
        | zero :: n -> zero :: x
        | prefix :: n -> prefix :: prefix(n - 1) * prefix(n - 1) + local_forcing(0)
    s(4) + w(0)
}
let w0: A = [4.0]
let mut dw: A = [0.0]
let (value, dx) = ad.grad(f)(Float64(1.0), w0, dw)
// EXPECT: value = 15135.0
// EXPECT: dx = 64944.0
// EXPECT: dw = [1.0]
