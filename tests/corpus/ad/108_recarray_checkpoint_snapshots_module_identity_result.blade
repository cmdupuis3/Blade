// TEST: AD Recursive Array, Checkpoints Snapshot A Module Array Bound To A Call Result
import ad as ad
// ============================================================================
// PM40 (rule `ad-checkpoint v1`, opt-in): the fresh-buffer twin of ad/050
// (round 4 wave 9, lane A, A1). The step reads the module binding `forcing`,
// a plain `let` whose value is a user-function result (`identity(src)`), and
// the function has a gradient buffer. Since round 4 wave 8 a buffer sharing
// that storage is refused (G190 (c), BL4005: ad/050 is the refusal witness),
// so the buffer here is a FRESH array; the admission still SNAPSHOTS
// `forcing` (a plain dense call result) before the forward loop and only the
// replay reads the copy. `blade test access` pins the decision and compares
// the checkpointed gradient with the full tape bit for bit.
// s = [1, 3, 11, 123, 15131]; ds4/dx = 2 s3 * 2 s2 * 2 s1 * 2 s0 = 64944.
// ============================================================================
type A = Array<Float64 like Idx<1>>
function identity(a: A) -> A = a
let src: A = [2.0]
let forcing = identity(src)
function f(x: Float64, w: A) -> Float64 = {
    let rec s: Array<Float64 like Idx<5>> =
        match s with
        | zero -> zero
        | zero :: n -> zero :: x
        | prefix :: n -> prefix :: prefix(n - 1) * prefix(n - 1) + forcing(0)
    s(4) + w(0)
}
let w0: A = [4.0]
let mut dw: A = [0.0]
let (value, dx) = ad.grad(f)(Float64(1.0), w0, dw)
// EXPECT: value = 15135.0
// EXPECT: dx = 64944.0
// EXPECT: dw = [1.0]
