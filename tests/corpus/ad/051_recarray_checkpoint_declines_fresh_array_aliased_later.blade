// TEST: AD Recursive Array, Checkpoints Decline A Fresh Module Array A Later Mut Binding Aliases
import ad as ad
// ============================================================================
// PM40 (rule `ad-checkpoint v1`, opt-in) DECLINES: `forcing` is a FRESH
// array literal, but the later `let mut backing = identity(forcing)` may be
// its very storage, and `backing` is passed as the gradient buffer. The
// reverse sweep would add d/dw into it before a replay reads `forcing(0)`.
// A fresh value is not enough: no declaration other than the differentiated
// function may name the array (Codex review of J1, round 2, finding 1).
// s = [1, 3, 11, 123, 15131]; ds4/dx = 2 s3 * 2 s2 * 2 s1 * 2 s0 = 64944.
// ============================================================================
type A = Array<Float64 like Idx<1>>
function identity(a: A) -> A = a
let forcing: A = [2.0]
let mut backing = identity(forcing)
function f(x: Float64, w: A) -> Float64 = {
    let rec s: Array<Float64 like Idx<5>> =
        match s with
        | zero -> zero
        | zero :: n -> zero :: x
        | prefix :: n -> prefix :: prefix(n - 1) * prefix(n - 1) + forcing(0)
    s(4) + w(0)
}
let (value, dx) = ad.grad(f)(Float64(1.0), identity(backing), backing)
// EXPECT: value = 15133.0
// EXPECT: dx = 64944.0
