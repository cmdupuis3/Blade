// TEST: AD Recursive Array, Checkpoints Decline A Row View Of A Module Array Named Like An Intrinsic (rejects)
import ad as ad
// ROUND 4 WAVE 8 (G190 (c), lead decision): the gradient buffer here shares
// storage with an array the derivative reads (identity(..) beside the
// buffer, or a module alias of it), which is now REFUSED at lowering in every
// lane (BL4005); the program stays as the refusal witness of its shape.
// ============================================================================
// PM40 (rule `ad-checkpoint v1`, opt-in) DECLINES: `sin` is a module ARRAY,
// so `sin(0)` is a row view, and `backing = identity(forcing)` makes it the
// gradient buffer. A value binding shadows the intrinsic name (Codex design
// review of the wave-6 snapshot, finding 2: it passed as a scalar constant
// and the checkpointed dx was 87296); a subscript is not a stored form the
// snapshot copies. s = [1, 3, 11, 123, 15131]; ds4/dx = 64944.
// ============================================================================
type A = Array<Float64 like Idx<1>>
function identity(a: A) -> A = a
let sin: Array<Float64 like Idx<1>, Idx<1>> = [[2.0]]
let forcing = sin(0)
let mut backing = identity(forcing)
function f(x: Float64, w: A) -> Float64 = {
    let rec s: Array<Float64 like Idx<5>> =
        match s with
        | zero -> zero
        | zero :: n -> zero :: x
        | prefix :: n -> prefix :: prefix(n - 1) * prefix(n - 1) + forcing(0)
    s(4) + w(0)
}
let (value, dx) = ad.grad(f)(Float64(1.0), identity(backing), backing)
