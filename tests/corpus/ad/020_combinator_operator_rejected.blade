// TEST: AD combinator operator rejected (rejects)
// The operator spelling (`<&!>`) is an ordinary BinOp and used to slip past
// the fragment walk whenever both operands were plain names, dying much
// later in the adjoint with a generic "unsupported expression form" that
// never said the word combinator. It now refuses up front, by name.
// ERROR: BL5500
// ERROR-CONTAINS: combinator operators
import ad as ad

function f(a: Array<Float like Idx<3>>, b: Array<Float like Idx<3>>) -> Float = {
    let c = a <&!> b
    reduce(a, (+))
}

let mut da = [0.0, 0.0, 0.0]
let mut db = [0.0, 0.0, 0.0]
let fv = ad.grad(f)([1.0, 2.0, 3.0], [1.0, 1.0, 1.0], da, db)
fv
