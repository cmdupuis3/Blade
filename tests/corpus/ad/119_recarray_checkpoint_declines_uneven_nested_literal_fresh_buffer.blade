// TEST: AD Recursive Array, Checkpoints Decline An Uneven Nested Literal, Fresh Buffer
import ad as ad
// ============================================================================
// PM40 (rule `ad-checkpoint v1`, opt-in) DECLINES: the fresh-buffer twin of
// ad/075 (round 4 wave 9, lane A, A1). `forcing` is an UNANNOTATED nested
// literal with rows of unequal length -- RAGGED storage, which `let mut`
// does not deep-copy -- so it is no snapshot target and the full tape runs
// (`blade test access` pins "not rectangular"). The buffer is a fresh ragged
// array: one sharing `forcing` is refused since round 4 wave 8 (G190 (c),
// ad/075). s = [1, 3, 11, 123, 15131]; ds4/dx = 64944.
// ============================================================================
type A = Array<Float64 like Idx<2>, RaggedIdx<_>>
let forcing = [[(2.0: Float64)], [(4.0: Float64), (5.0: Float64)]]
function f(x: Float64, w: A) -> Float64 = {
    let rec s: Array<Float64 like Idx<5>> =
        match s with
        | zero -> zero
        | zero :: n -> zero :: x
        | prefix :: n -> prefix :: prefix(n - 1) * prefix(n - 1) + forcing(0, 0)
    s(4) + w(0, 0)
}
let w0 = [[(4.0: Float64)], [(0.0: Float64), (0.0: Float64)]]
let mut dw = [[(0.0: Float64)], [(0.0: Float64), (0.0: Float64)]]
let (value, dx) = ad.grad(f)(Float64(1.0), w0, dw)
// EXPECT: value = 15135.0
// EXPECT: dx = 64944.0
// EXPECT: dw = [[1.0], [0.0, 0.0]]
