// TEST: Int Literal Float Widening
// F#-style type-directed widening: an int LITERAL in an explicitly
// float-typed position adopts the float type (let x: Float64 = 3 is
// 3.0; complex(1, 0) is complex(1.0, 0.0)). Only literals widen -- an
// int-typed VALUE in a float position still rejects (index-types/127).
let a: Float64 = 3
let b: Float32 = 2
let z = complex(1, 0)
let s = a + 0.5
// EXPECT: a = 3
// EXPECT: b = 2
// EXPECT: z = (1,0)
// EXPECT: s = 3.5
