// TEST: a block lambda keeps its non-numeric argument's type
// ============================================================================
// R10 remainder (the numbers-only rule, formalism 2.4): a block lambda's
// parameter its body leaves open is BOUND by a direct call's argument -- a Bool,
// a String, a struct, a sum-type value, an index value -- as a numeric one always
// was. It used to stay open, fall to zonk's Float64 default, and the call
// converted the argument silently. On the base
// `idl(true)` printed `1.0` and `idl("a")` died in g++.
// ============================================================================
struct P {
    a: Float64
}
let b = {
    let idl = lambda(x) -> x
    idl(true)
}
// EXPECT: b = true
let s = {
    let idl = lambda(x) -> x
    idl("a")
}
// EXPECT: s = "a"
let p = {
    let idl = lambda(x) -> x
    idl(P { a = 1.5 })
}
// EXPECT: p = P { a = 1.5 }
let n = {
    let twice = lambda(x) -> x + x
    twice(Int64(true))
}
// EXPECT: n = 2
let o = {
    let lt = lambda(x) -> x < false
    lt(true)
}
// EXPECT: o = false
