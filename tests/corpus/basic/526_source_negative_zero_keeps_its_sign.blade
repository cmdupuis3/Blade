// TEST: A source `-zero` keeps its negation, real and complex, concrete and generic
// The unseeded-fold identity (gap G74) is a DEDICATED mark on a synthesized
// seed, never a rewrite of source syntax: `-zero` is the negation of the
// typed zero wherever the program writes it, so its components carry the
// sign -- (-0.0, -0.0) for a complex, -0.0 for a real -- through a concrete
// binding and a generic instance alike (the reciprocals pin the signs).
let z: Complex128 = -zero
let zr = 1.0 / real(z)
let zi = 1.0 / imag(z)
let f: Float64 = -zero
let fr = 1.0 / f
function nzero(x: T) -> T = -zero
let g = nzero(complex(1.0, 1.0))
let gr = 1.0 / real(g)
let gi = 1.0 / imag(g)
let hr = 1.0 / nzero(2.0)
// EXPECT: zr = "-inf"
// EXPECT: zi = "-inf"
// EXPECT: fr = "-inf"
// EXPECT: gr = "-inf"
// EXPECT: gi = "-inf"
// EXPECT: hr = "-inf"
