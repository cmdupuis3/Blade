// TEST: Float32 Literal Width Adoption
// ============================================================================
// Bare float literals are width-polymorphic: beside a Float32 operand the
// literal adopts Float32 instead of dragging the op to Float64, so
// `a * 1.0` on a Float32 array stays Float32. LITERALS only: a Float64
// VARIABLE beside a Float32 operand is refused (formalism 2.4 converts
// nothing implicitly), so `wide` below converts the Float32 cell to Float64
// explicitly.
//
// The pinned values are the proof of width: 0.1 is not representable in
// float32, so a Float32 result widened to Float64 shows the f32-rounded
// quantity (`sw`: 0.349999994039536) while a promoted Float64 result prints
// clean halves and tenths (a Float32 itself prints its 6 significant digits,
// round 6 rule 8). The negated-literal spelling (`* -2.0`) rides the same
// adaptation (the unary node is rebuilt with its inner literal).
// ============================================================================
type I2 = Idx<2>
let a: Array<Float32 like I2> = [0.1, 0.25]
let b = a * 1.0
let s = reduce(b, (+))
let neg = a * -2.0
let sn = reduce(neg, (+))
let sw = Float64(s)
let sc = a((0 : I2)) * 0.5
let w: Float64 = 1.0
let wide = Float64(a((1 : I2))) * w
// EXPECT: b = [0.1, 0.25]
// EXPECT: s = 0.35
// EXPECT: sw = 0.349999994039536
// EXPECT: neg = [-0.2, -0.5]
// EXPECT: sn = -0.7
// EXPECT: sc = 0.05
// EXPECT: wide = 0.25
