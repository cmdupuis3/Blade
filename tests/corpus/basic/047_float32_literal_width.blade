// TEST: Float32 Literal Width Adoption
// ============================================================================
// Bare float literals are width-polymorphic: beside a Float32 operand the
// literal adopts Float32 instead of dragging the op to Float64, so
// `a * 1.0` on a Float32 array stays Float32 -- exactly as `a * 2` (an
// Int64 literal) always has. LITERALS only: a Float64 VARIABLE beside a
// Float32 operand still promotes to Float64 (`wide` below).
//
// The pinned values are the proof of width: 0.1 is not representable in
// float32, so a Float32 result prints the f32-rounded quantity
// (0.100000001490116) while a promoted Float64 result prints clean halves
// and tenths. The negated-literal spelling (`* -2.0`) rides the same
// adaptation (the unary node is rebuilt with its inner literal).
// ============================================================================
type I2 = Idx<2>
let a: Array<Float32 like I2> = [0.1, 0.25]
let b = a * 1.0
let s = reduce(b, (+))
let neg = a * -2.0
let sn = reduce(neg, (+))
let sc = a((0 : I2)) * 0.5
let w = 1.0
let wide = a((1 : I2)) * w
// EXPECT: b = [0.100000001490116, 0.25]
// EXPECT: s = 0.349999994039536
// EXPECT: neg = [-0.200000002980232, -0.5]
// EXPECT: sn = -0.699999988079071
// EXPECT: sc = 0.0500000007450581
// EXPECT: wide = 0.25
