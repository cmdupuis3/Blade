// TEST: Anon Range Runtime Bound
// A bound known only at run time (a parameter, a plain `let`) leaves the
// range's extent UNKNOWN in its type and is read from the bounds when the
// range runs. The type used to claim a literal 0 instead, so these were
// silently EMPTY (`doubled_len` was 0, `ks` printed []) or refused as
// statically empty (`iota_sum`, BL3007). In the compiled lane a virtual range
// has no C++ object, so a runtime extent or start is evaluated once into a
// small holder ahead of the loop nest that reads it.
function iota_sum(n: Int64) -> Int64 = reduce(0..n, (+))
function doubled_len(n: Int64) -> Int64 = {
    let ys = method_for(0..n) <@> lambda(i) -> i * 2 |> compute
    extents(ys)
}
function half_sum(lo: Int64, hi: Int64) -> Float64 = {
    let xs = 0.5 * Float64(lo..hi)
    reduce(xs, (+))
}
function span(lo: Int64, hi: Int64) -> Int64 = extents(lo..hi)
let s = iota_sum(5)
let d = doubled_len(4)
let h = half_sum(2, 6)
let w = span(3, 10)
let k = 4
let ks = Float64(1..k)
// EXPECT: s = 10
// EXPECT: d = 4
// EXPECT: h = 7.0
// EXPECT: w = 7
// EXPECT: k = 4
// EXPECT: ks = [1.0, 2.0, 3.0]
