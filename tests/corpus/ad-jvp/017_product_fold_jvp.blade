// TEST: JVP Product Fold (non-additive, forward only)
// reduce(w, (*)) is refused by grad (additive-only); forward pairs the
// fold: t_acc = t_acc*w(k) + acc*t_w(k) BEFORE acc = acc*w(k) -- the
// product rule, locally, no tape. f([2,3,4]) = 24; dw = [12, 8, 6].
import ad as ad

function f(w: Array<Float like Idx<3>>) -> Float = reduce(w, (*))

let (j0, t0) = ad.jvp(f)([2.0, 3.0, 4.0], [1.0, 0.0, 0.0])
let (j1, t1) = ad.jvp(f)([2.0, 3.0, 4.0], [0.0, 1.0, 0.0])
let (j2, t2) = ad.jvp(f)([2.0, 3.0, 4.0], [0.0, 0.0, 1.0])
// EXPECT: j0 = 24
// EXPECT: t0 = 12
// EXPECT: t1 = 8
// EXPECT: t2 = 6
