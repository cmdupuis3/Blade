// TEST: JVP Gather Via Foreign Key (grad agreement)
// Mirror of ad/012's territory: data-dependent reads through a module-scope
// Int table. The forward tangent of a gather is the SAME gather over the
// tangent array (reverse mode's adjoint is a scatter -- different code path,
// which is what makes this mirror load-bearing).
// s(n) = s(n-1) + w(idx(n)) with idx = [0, 2, 0, 1]:
// s = [0, w2, w2+w0, w2+w0+w1]; reduce = 3*w2 + 2*w0 + w1.
// At w = [1, 2, 3]: primal 13; dw = [2, 1, 3].
import ad as ad

let idx = [0, 2, 0, 1]

function f(w: Array<Float like Idx<3>>) -> Float = {
    let rec s: Array<Float like Idx<4>> =
        match s with
        | zero -> zero
        | zero :: n -> zero :: 0.0
        | prefix :: n -> prefix :: prefix(n - 1) + w(idx(n))
    reduce(s, (+))
}

let mut dw = [0.0, 0.0, 0.0]
let gv = ad.grad(f)([1.0, 2.0, 3.0], dw)
let (j0, t0) = ad.jvp(f)([1.0, 2.0, 3.0], [1.0, 0.0, 0.0])
let (j1, t1) = ad.jvp(f)([1.0, 2.0, 3.0], [0.0, 1.0, 0.0])
let (j2, t2) = ad.jvp(f)([1.0, 2.0, 3.0], [0.0, 0.0, 1.0])
let r0 = t0 - dw(0)
let r1 = t1 - dw(1)
let r2 = t2 - dw(2)
// EXPECT: gv = 13
// EXPECT: j0 = 13
// EXPECT: t0 = 2
// EXPECT: t1 = 1
// EXPECT: t2 = 3
// EXPECT: r0 = 0
// EXPECT: r1 = 0
// EXPECT: r2 = 0
