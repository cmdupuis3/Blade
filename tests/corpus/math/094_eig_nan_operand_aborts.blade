// TEST: Math eig: a NaN operand panics BL8008 (aborts)
// The Francis QR iteration runs a FIXED budget and used to return whatever it
// held when the budget ran out -- for a NaN operand, a NaN "result" printed as
// if it were a decomposition. Its convergence is now checked once the budget
// is spent, and an unconverged run is the BL8008 panic in every lane (the
// code the LAPACK route raises on a non-zero info; its message also says
// "did not converge").
import math as m
let bad = 0.0 / 0.0
let S: Array<Float64 like Idx<3>, Idx<3>> = [[2.0, 1.0, 0.0], [1.0, bad, 1.0], [0.0, 1.0, 2.0]]
let (RE, IM) = m.eig(S)
// ABORT: error[BL8008]
// ABORT: did not converge
