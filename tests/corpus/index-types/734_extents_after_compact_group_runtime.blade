// TEST: Extents Of An Array With A Run-Time Plain Slot Before And After A Compact Group
// Gap G295 (floor round, lane B, F4b): `extents` lowers to one read per RECORD, and the stored
// extents table is by PHYSICAL axis (a SymIdx<2, 3> group spans two), so for Q over
// (SymIdx<2, 3>, a run-time plain slot of 5) the C++ lane and the interpreter read the group's
// second axis: f = (3, 3). Every lane now maps a record to its physical axis. A plain slot
// BEFORE the group was already right (e).
type S = Idx<5>
let src: Array<Float64 like S> = [0.1, 0.9, 0.2, 0.8, 0.7]
let c5 = compound(src, mask(src, lambda(v) -> v > 0.0))
let c3 = compound(src, mask(src, lambda(v) -> v > 0.5))
type J = Idx<3>
let base: Array<Float64 like J> = [1.0, 2.0, 3.0]
let M = method_for(base, base) <@> lambda(x, y) where comm(x, y) -> x * y |> compute
let v = Float64(0..extents(c5)) * 2.0 |> compute
let P = method_for(v, M) <@> lambda(x, m) -> x * m |> compute
let Q = method_for(M, v) <@> lambda(m, x) -> x * m |> compute
let e = extents(P)
let f = extents(Q)
let q = Q(1, 2, 4)
// EXPECT: e = (5, 3)
// EXPECT: f = (3, 5)
// EXPECT: q = 48.0
