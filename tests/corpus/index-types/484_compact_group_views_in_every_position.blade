// TEST: Compact Group Views In Function Bodies, Beside Axes, And Of Deferred Arrays
// ============================================================================
// The view is the same value wherever it is formed: inside a function body,
// returned from a function, behind two consumed axes, with a plain axis after
// the group, of a comm-kernel result, and of a DEFERRED (uncomputed) array.
// ============================================================================
type S = SymIdx<2, 3>
let T: Array<Float64 like Idx<2>, S> = method_for(range<Idx<2>, S>) <@> lambda(r, i, j) -> Float64(r * 100 + i * 10 + j) |> compute
function row_of(t: Array<Float64 like Idx<2>, S>, r: Nat<Idx<2>>) -> Array<Float64 like S> = t(r)
function corner_sum(t: Array<Float64 like Idx<2>, S>) -> Float64 = {
    let v = t(1)
    v(2, 0) + v(0, 2) + v(1, 1)
}
let rv = row_of(T, 1)
let a = rv(2, 0)
let cs = corner_sum(T)
let r0 = T(0)
let doubled = method_for(r0) <@> lambda(x) -> x * 2.0 |> compute
let W: Array<Float64 like Idx<2>, S, Idx<2>> = method_for(range<Idx<2>, S, Idx<2>>) <@> lambda(r, i, j, k) -> Float64(r * 1000 + i * 100 + j * 10 + k) |> compute
let wrow = W(1)
let w1 = wrow(0, 2, 1)
let w2 = wrow(2, 0, 1)
let U: Array<Float64 like Idx<2>, Idx<2>, S> = method_for(range<Idx<2>, Idx<2>, S>) <@> lambda(q, r, i, j) -> Float64(q * 1000 + r * 100 + i * 10 + j) |> compute
let urow = U(1, 0)
let u1 = urow(0, 2)
let u2 = urow(2, 0)
let A = [1.0, 2.0, 3.0]
let B = [10.0, 20.0]
let P = method_for(B, A, A) <@> (lambda(b, x, y) where comm(x, y) -> b * x * y) |> compute
let prow = P(1)
let p1 = prow(0, 2)
let p2 = prow(2, 0)
let D = method_for(range<Idx<2>, S>) <@> lambda(r, i, j) -> Float64(r * 100 + i * 10 + j)
let drow = D(1)
let d1 = drow(0, 2)
let d2 = drow(2, 0)
// EXPECT: rv = [[100.0, 101.0, 102.0], [110.0, 111.0], [120.0]]
// EXPECT: a = 102.0
// EXPECT: cs = 314.0
// EXPECT: doubled = [[0.0, 2.0, 4.0], [20.0, 22.0], [40.0]]
// EXPECT: w1 = 1021.0
// EXPECT: w2 = 1021.0
// EXPECT: urow = [[1000.0, 1001.0, 1002.0], [1010.0, 1011.0], [1020.0]]
// EXPECT: u1 = 1002.0
// EXPECT: u2 = 1002.0
// EXPECT: prow = [[20.0, 40.0, 60.0], [80.0, 120.0], [180.0]]
// EXPECT: p1 = 60.0
// EXPECT: p2 = 60.0
// EXPECT: d1 = 102.0
// EXPECT: d2 = 102.0
