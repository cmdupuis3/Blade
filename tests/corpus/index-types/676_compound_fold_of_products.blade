// TEST: The fold of products over compound selections -- the way out R13 names
// ============================================================================
// R13 (deep review): prodsum walks each operand as a dense rank-1 buffer.
// Over a compound selection or a sparse array -- tabulated storage, at any
// element type and in any position -- it was a g++ rejection (BL9002) after
// `check` said OK. It is refused in the type checker, keyed on the operand's
// STORAGE class (prodsumUnbuiltStorage), naming the fold that is built.
// ============================================================================
// The accepted twin of 669-673: `reduce(a * b, (+))` over the same storage,
// at every element type the refusal covers.
type K = Idx<4>
let codes: Array<Int64 like K> = [100, 200, 300, 400]
let keep = mask(codes, lambda(c) -> c > 150)
let ia: Array<Int64 like K> = [1, 2, 3, 4]
let ib: Array<Int64 like K> = [5, 6, 7, 8]
let fa: Array<Float64 like K> = [1.0, 2.0, 3.0, 4.0]
let fb: Array<Float64 like K> = [5.0, 6.0, 7.0, 8.0]
let ga: Array<Float32 like K> = [1.0, 2.0, 3.0, 4.0]
let gb: Array<Float32 like K> = [5.0, 6.0, 7.0, 8.0]
let za: Array<Complex128 like K> = [complex(1.0, 0.0), complex(2.0, 1.0), complex(3.0, 0.0), complex(4.0, -1.0)]
let zb: Array<Complex128 like K> = [complex(5.0, 0.0), complex(6.0, 0.0), complex(7.0, 1.0), complex(8.0, 0.0)]
let ci = compound(ia, keep)
let cj = compound(ib, keep)
let cf = compound(fa, keep)
let cg = compound(fb, keep)
let ch = compound(ga, keep)
let ck = compound(gb, keep)
let cz = compound(za, keep)
let cw = compound(zb, keep)
let si = reduce(ci * cj, (+))
let sf = reduce(cf * cg, (+))
let sf3 = reduce(cf * cg * cf, (+))
let sg = reduce(ch * ck, (+))
let sz = reduce(cz * cw, (+))
// EXPECT: si = 65
// EXPECT: sf = 65.0
// EXPECT: sf3 = 215.0
// EXPECT: sg = 65.0
// EXPECT: sz = (65.0,1.0)