// TEST: Guarded index arithmetic that stays in range
// The in-range twin of 289: a forward difference with its own edge test.
// The read u(i + 1) is guarded (it is a position), and every position it
// sees is inside X, so the guard never fires and the values are unchanged.
type X = Idx<5>
let u: Array<Float64 like X> = [1.0, 2.0, 4.0, 7.0, 11.0]
let d = method_for(range<X>) <@> lambda(i) -> if i < 4 then u(i + 1) - u(i) else 0.0 |> compute
// EXPECT: d = [1.0, 2.0, 3.0, 4.0, 0.0]
