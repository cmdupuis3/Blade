// TEST: Compound Trailing Wildcard (rejects)
// ERROR: BL4003
// The prefix-pin wildcard form B((0, _)) on a compound WITH a trailing dim
// rejects like any other wildcard/tuple form since the flat-subscript
// conversion; partial reads (including trailing-block gathers) moved to
// SparseIdx.
type Lat = Idx<2>
type Lon = Idx<3>
type T = Idx<2>
let dense: Array<Float64 like Lat, Lon, T> = [
    [[0.0, 1.0], [10.0, 11.0], [20.0, 21.0]],
    [[30.0, 31.0], [40.0, 41.0], [50.0, 51.0]]]
let m: Array<Bool like Lat, Lon> = [[true, false, true], [true, true, false]]
let B = compound(dense, m)
let w = B((0, _))
// EXPECT: typecheck failure - wildcard reads on a compound axis moved to SparseIdx.
