// TEST: Sparse Index Over-Supplied (rejects)
// ERROR: BL4003
// A rank-2 sparse axis takes at most a 2-tuple (SparseOverSupplied).
let static K = [(2, 1), (0, 3)]
let S = method_for(range<SparseIdx<K>>) <@> lambda(i, j) -> i * 10 + j |> compute
let r = S((0, 3, 5))
// EXPECT: typecheck failure — 3-tuple into a rank-2 sparse axis.
