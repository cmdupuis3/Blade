let a: Array<Float64 like Idx<2>, SymIdx<2, 3>> = method_for(range<Idx<2>, SymIdx<2, 3>>) <@> lambda(i, j, k) -> Float64(i + j + k) |> compute
let ks: Array<Int64 like Idx<2>> = [1, 5]
let k0 = ks(0)
let fine = a(k0, 0, 1)
let k1 = ks(1)
let r = a(k1, 0, 1)
