// TEST: An index-typed array computed by arithmetic proves nothing (aborts)
// `shifted = method_for(range<X>) <@> lambda(i) -> i + 1` is typed
// Array<Nat<X> like X>, but its elements are positions: X's last index plus
// one. Reading u through them is guarded, whatever their type says -- the
// guard trusts a closed list of proofs, not types.
// ABORT: index out of bounds
type X = Idx<4>
let u: Array<Float64 like X> = [1.0, 2.0, 3.0, 4.0]
let shifted = method_for(range<X>) <@> lambda(i) -> i + 1 |> compute
let v = method_for(range<X>) <@> lambda(j) -> u(shifted(j)) |> compute
