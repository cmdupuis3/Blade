// TEST: Transpose Symmetric Alias Written
// The transposed name is written: the read-only alias plan declines (`ST` is
// assigned) and the copy keeps S intact.
let A = [1.0, 2.0, 3.0]
let L = method_for(A, A)
let g = lambda(x, y) where comm(x, y) -> 2.0 * x + y
let S = L <@> reynolds(g) |> compute
let ST = transpose(S, [0, 1])
ST(0, 1) = 100.0
// EXPECT: S = [6.0, 9.0, 12.0, 12.0, 15.0, 18.0]
// EXPECT: ST = [6.0, 100.0, 12.0, 12.0, 15.0, 18.0]