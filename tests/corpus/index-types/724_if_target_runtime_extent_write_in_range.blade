// TEST: In-Range Writes Through An If Of Run-Time-Shaped Arrays
// Gap G208 (1): the accepted twin of index-types/722-723 -- the checked writes land in the
// selected array.
type S = Idx<5>
let src: Array<Float64 like S> = [0.1, 0.9, 0.2, 0.8, 0.7]
let c5 = compound(src, mask(src, lambda(v) -> v > 0.0))
let c3 = compound(src, mask(src, lambda(v) -> v > 0.5))
function f(c: Bool, k: Int64, a: mut Float64^1, b: mut Float64^1) -> Float64 = {
    (if c then a else b)(k) = 99.0
    a(0)
}
let mut a = Float64(0..extents(c5)) |> compute
let mut b = Float64(0..extents(c3)) |> compute
let k = extents(b) - 1
(if extents(a) > 2 then a else b)(k) = 7.0
let r = f(false, k, a, b)
// EXPECT: a = [0.0, 1.0, 7.0, 3.0, 4.0]
// EXPECT: b = [0.0, 1.0, 99.0]
// EXPECT: r = 0.0