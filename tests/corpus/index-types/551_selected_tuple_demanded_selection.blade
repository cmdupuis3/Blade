// TEST: Selected tuple retains a demanded printed and keyed selected array
let x = [-2.0, 0.0, 1.0, 3.0, -1.0, 2.0]
let keep = mask(x, lambda(v) -> v > 0.0)
let y = compound(x, keep)
let result = (reduce(y, (+), 7.0), reduce(y, lambda(a, b) -> a * 10.0 + b, -2.0))
let sample = y(2)
// EXPECT: y = [1.0, 3.0, 2.0]
// EXPECT: result = (13.0, -1868.0)
// EXPECT: sample = 1.0
