// TEST: AntisymIdx Iteration
// AntisymIdx iteration uses STRICT i < j bounds: for n=4 the canonical cells
// are (0,1),(0,2),(0,3),(1,2),(1,3),(2,3) = C(4,2) = 6 elements — not the
// inclusive i <= j SymIdx form (10 elements). Producer: same-array
// reynolds(g, Antisymmetric), the only antisym-storage constructor today; the
// wrapped kernel carries the `comm` iteration license (cf. symmetry/019).
// g = x - y is itself antisymmetric, so the signed sum doubles it:
// reynolds(g, Anti)(x, y) = (x - y) - (y - x) = 2*(x - y).
let A = [1.0, 2.0, 3.0, 4.0]
let L = method_for(A, A)
let g = lambda(x, y) where comm(x, y) -> x - y
let result = L <@> reynolds(g, Antisymmetric) |> compute
// Strict pairs i < j over A = [1,2,3,4], value 2*(A[i]-A[j]):
// (0,1)=-2 (0,2)=-4 (0,3)=-6 (1,2)=-2 (1,3)=-4 (2,3)=-2
// EXPECT: result = [-2.0, -4.0, -6.0, -2.0, -4.0, -2.0]
