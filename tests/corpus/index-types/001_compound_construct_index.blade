// TEST: Compound Construct + Index
// compound(dense, mask): source-level compound construction (P5) + FLAT
// full-tuple indexing, validated end-to-end against the dense source. A
// compound axis consumes k flat positional subscripts like SymIdx — B(0, 0),
// not the retired tuple form B((0, 0)). The dense array and the bool mask
// share NAMED index types (Lat, Lon), so compoundViewType's identity check
// matches them by tag even though each annotation reference gets a fresh Id.
// Mask pattern: (0,0)=T (1,0)=T (1,1)=T, (0,1)=F -> cardinality 3.
// B(0, 0) is present, so it must equal dense[0][0] = 10.0.
type Lat = Idx<2>
type Lon = Idx<2>
let dense: Array<Float64 like Lat, Lon> = [[10.0, 20.0], [30.0, 40.0]]
let m: Array<Bool like Lat, Lon> = [[true, false], [true, true]]
let B = compound(dense, m)
let x = B(0, 0)
// EXPECT: x = 10
