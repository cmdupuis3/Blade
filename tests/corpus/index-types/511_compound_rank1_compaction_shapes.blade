// TEST: Rank-1 compound compaction: all-true, alternating, singleton and tail masks
// `compound(dense, mask)` over ONE dense axis takes the COMPACTION
// representation (bench gap G9; `blade plan` says `[compound v1] ... applied
// [representation: rank-1 compaction ...]`): a count pass, a branchless
// kept-position fill and a gather by position -- no hash node per kept cell.
// The kept ORDER is the source order in every lane; a keyed read `S(k)` is a
// binary search over the kept positions; `extents` is the kept count. The
// LLVM lane emits the same count / fill / gather in IR (it used to refuse
// every compound). Integer data, exact pins.
type I = Idx<7>
let a: Array<Int64 like I> = [5, 1, 4, 1, 3, 9, 2]
// all true: the compound is the array, every key its own position
let all_m = mask(a, lambda(v) -> v > 0)
let all = compound(a, all_m)
// EXPECT: all = [5, 1, 4, 1, 3, 9, 2]
let all_n = extents(all)
// EXPECT: all_n = 7
let all_k6 = all(6)
// EXPECT: all_k6 = 2
// alternating: even positions kept (values 5, 4, 3, 2)
let alt_m: Array<Bool like I> = [true, false, true, false, true, false, true]
let alt = compound(a, alt_m)
// EXPECT: alt = [5, 4, 3, 2]
let alt_n = extents(alt)
// EXPECT: alt_n = 4
let alt_k0 = alt(0)
let alt_k4 = alt(4)
let alt_k6 = alt(6)
// EXPECT: alt_k0 = 5
// EXPECT: alt_k4 = 3
// EXPECT: alt_k6 = 2
let alt_sum = reduce(alt, (+))
// EXPECT: alt_sum = 14
// singleton: one kept cell in the middle
let one = compound(a, mask(a, lambda(v) -> v == 9))
// EXPECT: one = [9]
let one_n = extents(one)
// EXPECT: one_n = 1
let one_k5 = one(5)
// EXPECT: one_k5 = 9
// head and tail: the first cell alone, the last cell alone, both ends
let head = compound(a, mask(a, lambda(v) -> v == 5))
// EXPECT: head = [5]
let head_k0 = head(0)
// EXPECT: head_k0 = 5
let tail_m: Array<Bool like I> = [false, false, false, false, false, false, true]
let tail = compound(a, tail_m)
// EXPECT: tail = [2]
let tail_k6 = tail(6)
// EXPECT: tail_k6 = 2
let ends_m: Array<Bool like I> = [true, false, false, false, false, false, true]
let ends = compound(a, ends_m)
// EXPECT: ends = [5, 2]
let ends_sum = reduce(ends, (+))
// EXPECT: ends_sum = 7
// a map over a compound keeps the compound (same kept positions): keyed reads
// address the SOURCE position, and extents is still the kept count
let alt2 = method_for(alt) <@> lambda(v) -> v * 10 |> compute
// EXPECT: alt2 = [50, 40, 30, 20]
let alt2_k4 = alt2(4)
// EXPECT: alt2_k4 = 30
let alt_sq = alt * alt
// EXPECT: alt_sq = [25, 16, 9, 4]
let alt_sq_sum = reduce(alt_sq, (+))
// EXPECT: alt_sq_sum = 54
let alt2_n = extents(alt2)
// EXPECT: alt2_n = 4
