// TEST: Compact Rank Disagreement (rejects)
// The symmetry class alone cannot carry rank: SymIdx<2,4> and SymIdx<3,4>
// are BOTH SymSymmetric, so the symmetry test passes and only the component
// rank separates them (2 vs 3 dimensions of the emitted Array<double,N>).
// Guards the other half of 134 — there the wildcard SymNone let a rank-1
// axis through; here both sides are genuinely compact and still disagree.
let A: Array<Float64 like SymIdx<2, 4>> = fill_random(10)
function widen(x: Array<Float64 like SymIdx<2, 4>>) -> Array<Float64 like SymIdx<3, 4>> = x
let r = widen(A)
// EXPECT: typecheck failure — SymIdx<2,4> spans 2 components, SymIdx<3,4> spans 3.
