// TEST: Match arm literal of the wrong length (rejects)
// ERROR: BL3007
// ============================================================================
// Checked against an expected type, every arm gets checkExpr's verdict -- here
// the array-literal length check (BL3007), exactly as the same literal gets
// outside a match. checkMatch used to swallow that error and retry with a
// lenient unify that ignores extents, so the program type-checked and died
// later (BL7001).
let n = 0
let x: Array<Float64 like Idx<3>> = match n with
    | 0 -> [1.0, 2.0]
    | _ -> [1.0, 2.0, 3.0]
let v = x(2)
