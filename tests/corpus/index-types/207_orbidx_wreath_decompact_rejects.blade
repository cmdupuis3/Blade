// TEST: OrbIdx Wreath Decompact (rejects)
// ERROR: BL4003
// decompact is a FISSION of one compact group into a freed axis plus a residual
// group of the SAME class. For a wreath that is not even well defined without
// saying which LEVEL is being peeled, and the residual of a level-2 peel is not
// a wreath class of the same shape. The generic fission code would build
// `{ ix with Rank = a }` -- a wreath record whose Rank no longer matches the
// product of its level list, an internally inconsistent type that every
// downstream cell count would then read differently.
//
// Unchanged by the allocator/nest work: producing a wreath pool and taking one
// apart are different problems, and only the first is done.
let A = [1.0, 2.0, 3.0]
let g = lambda(x, y) where comm(x, y) -> x * y
let S = method_for(A, A) <@> g |> compute
let h = lambda(p, q) where comm(p, q) -> p + q
let W = method_for(S, S) <@> h |> compute
let d = decompact(W, 1)
// EXPECT: typecheck failure — decompacting a wreath class is not defined per level.
