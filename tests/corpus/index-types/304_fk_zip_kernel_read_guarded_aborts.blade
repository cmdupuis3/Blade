// TEST: A co-iterated foreign-key cell is guarded too (aborts)
// The zip spelling of 302: the key column is one of two co-iterated operands.
// ABORT: index out of bounds
type StationIdx = Idx<4>
type RegionIdx = Idx<3>
let station_region: Array<Nat<RegionIdx> like StationIdx> = [0, 2, -1, 1]
let region_weight: Array<Float64 like RegionIdx> = [1.0, 0.5, 2.0]
let values: Array<Float64 like StationIdx> = [10.0, 20.0, 30.0, 40.0]
let w = method_for(zip(station_region, values)) <@> lambda(r, v) -> v * region_weight(r) |> compute
