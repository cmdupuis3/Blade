// TEST: Compaction fusion v2: two compounds over one mask keep their own gathers
// A mask feeding SEVERAL compounds is a shared selection (T4c, not built):
// the mask's in-pass count serves the last compound (fused; under the opt-in
// `gather` its mask-site gather declines: `keep` feeds 2 compounds), the
// first keeps its separate passes (`blade plan` says so), and each builds its
// own compact buffer and index. They agree cell for cell, by key and by fold; as-written values.
type Ix = Idx<11>
let x = method_for(range<Ix>) <@> lambda(i) -> Float64((Int64(i) * 4) % 11) |> compute
let keep = mask(x, lambda(v) -> v > 4.5)
let y1 = compound(x, keep)
// EXPECT: y1 = [8.0, 5.0, 9.0, 6.0, 10.0, 7.0]
let y2 = compound(x, keep)
// EXPECT: y2 = [8.0, 5.0, 9.0, 6.0, 10.0, 7.0]
let s1 = reduce(y1 * y1, (+))
// EXPECT: s1 = 355.0
let s2 = reduce(y2 * y2, (+))
// EXPECT: s2 = 355.0
let k1 = y1(2)
// EXPECT: k1 = 8.0
let k2 = y2(10)
// EXPECT: k2 = 7.0
