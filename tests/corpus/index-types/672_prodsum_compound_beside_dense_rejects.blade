// TEST: prodsum with a compound as its second operand is refused (rejects)
// ERROR: BL4003 @ 16:20
// ERROR-CONTAINS: stored as a compound selection
// ============================================================================
// R13 (deep review): prodsum walks each operand as a dense rank-1 buffer.
// Over a compound selection or a sparse array -- tabulated storage, at any
// element type and in any position -- it was a g++ rejection (BL9002) after
// `check` said OK. It is refused in the type checker, keyed on the operand's
// STORAGE class (prodsumUnbuiltStorage), naming the fold that is built.
// ============================================================================
type K = Idx<4>
let codes: Array<Int64 like K> = [100, 200, 300, 400]
let keep = mask(codes, lambda(c) -> c > 150)
let da: Array<Float32 like K> = [1.0, 2.0, 3.0, 4.0]
let a = compound(da, keep)
let d: Array<Float32 like Idx<3>> = [1.0, 1.0, 1.0]
let r = prodsum(d, a)