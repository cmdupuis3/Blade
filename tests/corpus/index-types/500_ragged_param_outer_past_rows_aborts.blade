// TEST: A ragged parameter read with its row past the rows aborts (aborts)
// ============================================================================
// The same check inside a function over a ragged parameter.
function at(A: Array<Float64 like Idx<3>, RaggedIdx<_>>, i: Int64, j: Int64) -> Float64 = A(i, j)
