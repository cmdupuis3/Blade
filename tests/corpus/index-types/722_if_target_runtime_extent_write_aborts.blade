// TEST: A Write Through An If Of Run-Time-Shaped Arrays Checks Its Position (aborts)
// Gap G208 (1) (floor round, lane B, F4): an assignment target whose array is an `if` of
// arrays with run-time extents was never bound (a temporary is no lvalue), so its position
// was not checked and the C++ lane wrote past the end of `a` (exit 0). The target is now
// checked against the SELECTED array's extent, read through the same pure selection.
// ABORT: BL8006
type S = Idx<5>
let src: Array<Float64 like S> = [0.1, 0.9, 0.2, 0.8, 0.7]
let c5 = compound(src, mask(src, lambda(v) -> v > 0.0))
let c3 = compound(src, mask(src, lambda(v) -> v > 0.5))
let mut a = Float64(0..extents(c5)) |> compute
let mut b = Float64(0..extents(c3)) |> compute
let c = extents(a) > 2
let k = extents(a) + 1
(if c then a else b)(k) = 99.0