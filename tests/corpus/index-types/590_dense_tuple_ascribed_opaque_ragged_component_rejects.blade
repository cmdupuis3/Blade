type R = Array<Float64 like RaggedIdx<_>>
let d: Array<Float64 like Idx<2>> = [1.0, 2.0]
let p = ((d, 1) : (R, Int64))
function f(a: R) -> Float64 = reduce(a, (+))
let s = f(p[0])
// ERROR: BL4003
