// TEST: Compaction fusion: one compaction pass and the y * y fold over y's buffer
// The bench maskagg chain (`blade plan`: `[compaction-fusion v1] y: applied`,
// `[compaction-fusion v1] checksum: applied`): the count of `keep` is taken in
// its own mask pass, the kept-position fill and the value gather are ONE
// branchless pass, and `reduce(y * y, (+))` folds y's compact buffer with no
// square pool -- the K-lane self-dot when licensed, the unseeded serial chain
// (fed inside the compaction pass, block by block) under BLADE_FP_REPRO=1.
// n = 1003 spans four 256-cell blocks. Integer-valued data: every sum exact.
type Ix = Idx<1003>
let x = method_for(range<Ix>) <@> lambda(i) -> Float64((Int64(i) * 37) % 11) - 4.0 |> compute
let keep = mask(x, lambda(v) -> v > 1.0)
let y = compound(x, keep)
let m = extents(y)
// EXPECT: m = 455
let checksum = reduce(y * y, (+)) + Float64(extents(y))
// EXPECT: checksum = 8645.0
// a second fold over the same compound, in statement position
let sq_only = reduce(y * y, (+))
// EXPECT: sq_only = 8190.0
let ysum = reduce(y, (+))
// EXPECT: ysum = 1820.0
// keyed reads still address SOURCE positions (the table the pass filled)
let first = y(2)
// EXPECT: first = 4.0
let late = y(1000)
// EXPECT: late = 3.0
