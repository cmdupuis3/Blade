// TEST: Compound Partial All Free (rejects)
// ERROR: BL4003
// All coordinates free pins nothing - and since the flat-subscript
// conversion, ANY wildcard/tuple form on a compound axis rejects with the
// SparseIdx-pointing message (partial reads moved there wholesale).
type Lat = Idx<2>
type Lon = Idx<3>
let dense: Array<Float64 like Lat, Lon> = [[10.0, 20.0, 30.0], [40.0, 50.0, 60.0]]
let m: Array<Bool like Lat, Lon> = [[true, false, true], [true, true, false]]
let B = compound(dense, m)
let r = B((_, _))
// EXPECT: typecheck failure - wildcard reads on a compound axis moved to SparseIdx.
