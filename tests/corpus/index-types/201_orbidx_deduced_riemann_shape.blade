// TEST: OrbIdx Deduced Riemann Shape
// MIXED CHARACTER, deduced: `OrbIdx<[(2,-),(2,+)], 4>` -- antisymmetric within
// a block, symmetric between blocks. docs/plan-orbit-index-types.md §3 calls
// this the sharpest mixed case and §1 calls it the second gap ("no spelling at
// all"); it is what `RiemannIdx` would have been.
//
// The inner block comes from `reynolds(g, Antisymmetric)`, which produces a
// genuine AntisymIdx<2,4> (strict simplex, C(4,2) = 6 cells, g(x,y) - g(y,x) =
// x - y). The OUTER level is the comm tie over the repeated B, contributing
// (2,+). §4's fold: 4 -> C(4,2) = 6 -> C(7,2) = 21, exactly the 21 components
// docs/formalism.md §3.4 states for n = 4.
//
// Note WHICH reynolds earns what: the wrapper owns the INNER class (it made B
// antisymmetric) and earns no tie of its own -- 203 pins that. The tie here is
// the comm clause on `h`, over two occurrences of an already-compact B.
let A = [1.0, 2.0, 3.0, 4.0]
let g = lambda(x, y) where comm(x, y) -> 2.0 * x + y
let B = method_for(A, A) <@> reynolds(g, Antisymmetric) |> compute
let h = lambda(p, q) where comm(p, q) -> p + q
let R = method_for(B, B) <@> h |> compute
// EXPECT: B = [-1, -2, -3, -1, -2, -1]
// EXPECT: R = [-2, -3, -4, -2, -3, -2, -4, -5, -3, -4, -3, -6, -4, -5, -4, -2, -3, -2, -4, -3, -2]
