// TEST: Transpose Symmetric Source Written
// `S` is written AFTER `let ST = transpose(S, [0, 1])`: the alias would
// show the write, so the read-only alias plan declines (`S` is assigned) and
// ST keeps its own copy of the packed pool, independent of S.
let A = Float64([1.0, 2.0, 3.0])
let L = method_for(A, A)
let g = lambda(x, y) where comm(x, y) -> 2.0 * x + y
let S = L <@> reynolds(g) |> compute
let ST = transpose(S, [0, 1])
S(0, 1) = 100.0
// EXPECT: S = [6.0, 100.0, 12.0, 12.0, 15.0, 18.0]
// EXPECT: ST = [6.0, 9.0, 12.0, 12.0, 15.0, 18.0]