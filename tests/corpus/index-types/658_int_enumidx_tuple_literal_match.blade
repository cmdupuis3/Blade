// TEST: A literal pattern against an R component of a tuple names a key
// ============================================================================
// R3: outside a generic body the checker knows the component's type, so the
// literal is folded to the key's position (the twin of index-types/657).
// ============================================================================
type R = EnumIdx<[300, 100, 200]>
let codes: Array<R like Idx<3>> = [100, 200, 300]
let t = (codes(0), Float64(1.0))
let w = match t with
    | (100, _) -> 1
    | _ -> 0
// EXPECT: w = 1
