// TEST: Compaction fusion T4c: a companion over a different index space is refused (rejects)
// `c` has the same extent as `x` but its own named index type: `keep` does
// not cover a prefix of `c`'s index space, so `compound(c, keep)` is refused
// at typecheck -- a selection is never shared across index spaces.
type Ix = Idx<11>
type Jx = Idx<11>
let x = method_for(range<Ix>) <@> lambda(i) -> Float64((Int64(i) * 4) % 11) |> compute
let c = method_for(range<Jx>) <@> lambda(i) -> Int64(i) * 10 |> compute
let keep = mask(x, lambda(v) -> v > 4.5)
let y1 = compound(x, keep)
let y2 = compound(c, keep)
// ERROR: BL3999 @ 10:22
