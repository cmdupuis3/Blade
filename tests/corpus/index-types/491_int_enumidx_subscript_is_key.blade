// TEST: An integer EnumIdx subscript is a key
// ============================================================================
// The D2 ruling: a subscript into an integer-valued EnumIdx slot is a KEY,
// read at that key's position, like a string label. `w(200)` was emitted as
// `w[200]` -- past the end, no check -- and a computed key was guarded as a
// position 0..2, so every real key panicked. A literal key folds to its
// ordinal at compile time; a computed key (foreign-key data, a plain Int64)
// is looked up among the keys at run time; a value of type R (an iteration
// index of `range<R>`, a cell of an R array) is a key already represented as
// its position and is read directly (index-types/501).
// ============================================================================
type R = EnumIdx<[100, 200, 300]>
let w: Array<Float64 like R> = [1.0, 2.0, 3.0]
let u = w(200)
// EXPECT: u = 2.0
let codes: Array<R like Idx<4>> = [300, 100, 200, 300]
let g = method_for(codes) <@> lambda(c) -> w(c) |> compute
// EXPECT: g = [3.0, 1.0, 2.0, 3.0]
let c0 = codes(0)
let h = w(c0)
// EXPECT: h = 3.0
let k = 100 + 200
let v = w(k)
// EXPECT: v = 3.0
let t = method_for(range<R>) <@> lambda(r) -> w(r) * 10.0 |> compute
// EXPECT: t = [10.0, 20.0, 30.0]
// A `Nat<R>` parameter receiving a cell of an R array reads that key's
// position, not past the buffer.
function get(r: Nat<R>) -> Float64 = w(r)
let gk = get(codes(0))
// EXPECT: gk = 3.0
// Writes are keyed too.
let mut wm: Array<Float64 like R> = [1.0, 2.0, 3.0]
wm(200) = 9.0
wm(k) = 7.0
// EXPECT: wm = [1.0, 9.0, 7.0]
type N = EnumIdx<[-1, 3]>
let z: Array<Int64 like N> = [7, 8]
let zm = z(-1)
// EXPECT: zm = 7
let z3 = z(3)
// EXPECT: z3 = 8
