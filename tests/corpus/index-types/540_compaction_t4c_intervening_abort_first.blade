let c2 = method_for(range<Ix>) <@> lambda(i) -> Float64(Int64(i) * 2) |> compute
let keep = mask(x, lambda(v) -> v > 5000.0)
let y1 = compound(x, keep)
let boom = 10 / extents(y1)
let y2 = compound(c2, keep)
let checksum = reduce(y2 * y2, (+))
