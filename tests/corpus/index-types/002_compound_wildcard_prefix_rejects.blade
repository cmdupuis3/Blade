// TEST: Compound Wildcard Prefix (rejects)
// ERROR: BL4003
// Wildcard/partial reads were removed from CompoundIdx with the flat-subscript
// conversion: a compound axis takes k flat positional subscripts (B(i, j)),
// and pinning a prefix while freeing the rest (the old B((0, _)) window) is a
// SparseIdx feature now (S((0, _)) gathers the matches). The tuple-with-
// wildcard spelling rejects at typecheck with the SparseIdx-pointing message.
type Lat = Idx<2>
type Lon = Idx<3>
let dense: Array<Float64 like Lat, Lon> = [[10.0, 20.0, 30.0], [40.0, 50.0, 60.0]]
let m: Array<Bool like Lat, Lon> = [[true, false, true], [true, true, false]]
let B = compound(dense, m)
let r = B((0, _))
// EXPECT: typecheck failure - wildcard reads on a compound axis moved to SparseIdx.
