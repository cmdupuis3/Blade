// TEST: Compaction fusion T4c: the mask read between its companions declines the shared selection
// `k0` reads `keep` between the first and the last companion, so the shared
// selection declines (`blade plan`: `the shared selection (T4c) declined:
// `k0` (between `keep` and `y2`) reads `keep` ...`) and each compound keeps
// its own passes and index. Every value is the as-written program's.
type Ix = Idx<11>
let x = method_for(range<Ix>) <@> lambda(i) -> Float64((Int64(i) * 4) % 11) |> compute
let c2 = method_for(range<Ix>) <@> lambda(i) -> Int64(i) * 10 |> compute
let keep = mask(x, lambda(v) -> v > 4.5)
let y1 = compound(x, keep)
// EXPECT: y1 = [8.0, 5.0, 9.0, 6.0, 10.0, 7.0]
let k0 = keep(2)
// EXPECT: k0 = true
let y2 = compound(c2, keep)
// EXPECT: y2 = [20, 40, 50, 70, 80, 100]
let k2 = y2(10)
// EXPECT: k2 = 100
