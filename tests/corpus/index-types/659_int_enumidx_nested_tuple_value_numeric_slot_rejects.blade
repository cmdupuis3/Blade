// TEST: A nested tuple value holding R that meets a numeric component is refused (rejects)
// ERROR: BL4003
// ERROR-CONTAINS: spell the key in the tuple
// ============================================================================
// R3, a defect closed (Codex review round 3): the tuple VALUE `t` holds a
// value of R two levels down, and `g`'s parameter has an Int64 there; the
// call handed the POSITION over (g returned 1 for the key 100). A tuple
// literal argument is observed component by component; a tuple VALUE cannot
// be, so it is refused at any depth.
// ============================================================================
type R = EnumIdx<[300, 100, 200]>
let codes: Array<R like Idx<3>> = [100, 200, 300]
function g(t: ((Int64, Float64), Float64)) -> Int64 = t[0][0]
let t = ((codes(0), Float64(1.0)), Float64(2.0))
let v = g(t)
