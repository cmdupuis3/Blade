// TEST: Dense matrix rows reaching an opaque RaggedIdx kernel parameter are refused (rejects)
// ============================================================================
// Gap G190 (a), the ARGUMENT case (round 4 wave 8, lane C, C3): the opaque
// `RaggedIdx<_>` is the type of a row PEELED from a ragged parent. A dense
// array reaching a parameter of that type -- a call argument, a kernel
// parameter fed a dense slice, an ascription -- has no ragged parent to stand
// for: the interpreter read it as a plain array and printed a value, the C++
// lane could not convert it (BL9002 at g++). Refused at lowering in every
// lane with BL4003, like the literal itself (index-types/579-581).
// ============================================================================
function f(a: Array<Float64 like RaggedIdx<_>>) -> Float64 = reduce(a, (+))
let xs: Array<Float64 like Idx<2>, Idx<2>> = [[1.0, 2.0], [3.0, 4.0]]
let s = method_for(xs) <@> f |> compute
// ERROR: BL4003 @ 12:20
// ERROR-CONTAINS: a dense array slice reaches a kernel parameter
// REJECT-AT: lower
