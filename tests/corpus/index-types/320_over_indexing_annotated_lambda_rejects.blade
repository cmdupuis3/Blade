// TEST: Over-Indexing An Annotated Lambda Parameter Is Refused (rejects)
// ERROR: BL3002 @ 8:38
// ============================================================================
// index-types/319 through a lambda whose parameter is annotated `Float64^1`:
// the same refusal, at the first excess subscript.
// ============================================================================
type I = Idx<3>
let a: Array<Float64 like I> = [1.0, 2.0, 3.0]
let f = lambda(r: Float64^1) -> r(0, 1)
let y = f(a)
