// TEST: Transpose Antisym Unchanged
// An antisymmetric transpose negates into a fresh pool, and two of them
// negate twice: transpose-normal-form v1 leaves both (recorded as declines);
// the values are the per-class actions' (strict canonicals, no diagonal).
// anti = reynolds(2x + y, Antisymmetric) over [1, 2, 3]: -1 -2 / -1.
let A = Float64([1.0, 2.0, 3.0])
let L = method_for(A, A)
let g = lambda(x, y) where comm(x, y) -> 2.0 * x + y
let anti = L <@> reynolds(g, Antisymmetric) |> compute
let result = transpose(anti, [0, 1])
let back = transpose(transpose(anti, [0, 1]), [0, 1])
// EXPECT: anti = [-1.0, -2.0, -1.0]
// EXPECT: result = [1.0, 2.0, 1.0]
// EXPECT: back = [-1.0, -2.0, -1.0]