// TEST: Compound Trailing Row Flat
// Flat full-tuple reads on a compound with a trailing regular dim: B(0, 2)
// resolves the compound axis to one present cell and leaves the trailing dim
// free - the contiguous trailing-row sub-view (Compound::row) - while
// B(1, 1, 0) supplies the trailing index too, yielding the scalar. (The old
// trailing-wildcard spelling B((0,2), _) is gone with the tuple form.)
// Mask: (0,0)=T (0,2)=T (1,0)=T (1,1)=T; rows are the T-blocks of dense.
type Lat = Idx<2>
type Lon = Idx<3>
type T = Idx<2>
let dense: Array<Float64 like Lat, Lon, T> = [
    [[0.0, 1.0], [10.0, 11.0], [20.0, 21.0]],
    [[30.0, 31.0], [40.0, 41.0], [50.0, 51.0]]]
let m: Array<Bool like Lat, Lon> = [[true, false, true], [true, true, false]]
let B = compound(dense, m)
let r = B(0, 2)
let x = r((1 : T))
let y = B(1, 1, (0 : T))
// EXPECT: x = 21
// EXPECT: y = 40
