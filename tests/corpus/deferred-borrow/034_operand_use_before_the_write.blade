// TEST: borrow a use in an earlier operand than the write is accepted
// seen is used (copied) before bump writes cnt, and nothing uses seen afterwards.
type I = Idx<1>
let mut cnt: Array<Int64 like I> = [10]
let mut other: Array<Int64 like I> = [5]
function bump(c: mut Array<Int64 like I>) -> Int64 = {
    c(0) = c(0) + 1
    c(0)
}
function h1(a: Array<Int64 like I>) -> Int64 = a(0)
let seen = method_for(cnt) <@> lambda(v) -> v
let r = h1(seen |> compute) + bump(cnt)
// EXPECT: r = 21
// EXPECT: cnt = [11]
