// TEST: borrow an earlier array-literal element writes what a later element's map reads (rejects)
// An array literal's elements are evaluated left to right.
type I = Idx<1>
let mut cnt: Array<Int64 like I> = [10]
let mut other: Array<Int64 like I> = [5]
function bump(c: mut Array<Int64 like I>) -> Int64 = {
    c(0) = c(0) + 1
    c(0)
}
function h1(a: Array<Int64 like I>) -> Int64 = a(0)
let seen = method_for(cnt) <@> lambda(v) -> v
let t = [bump(cnt), h1(seen |> compute)]
// ERROR: BL4005 @ 11:10
