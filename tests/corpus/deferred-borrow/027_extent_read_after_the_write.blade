// TEST: borrow an extent read after the write is no use
// R8: extents(g) of a statically shaped map reads its type and evaluates
// nothing, so it is not a use; and g is only folded (a fold fuses and does not
// make it print), so the write follows g's last use.
let mut x: Array<Float64 like Idx<3>> = [1.0, 2.0, 3.0]
let g = method_for(x) <@> lambda(v) -> v * 2.0
let s = reduce(g, (+))
x(0) = 5.0
let n = extents(g)
// EXPECT: s = 12.0
// EXPECT: n = 3
