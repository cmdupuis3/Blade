// TEST: borrow a compute copy of a co-iteration forces its named leg (rejects)
type I = Idx<3>
let mut y: Array<Float64 like I> = [2.0, 0.0, 1.0]
let g2 = method_for(y) <@> lambda(v) -> v + 1.0
let h = method_for(zip(g2, y)) <@> lambda(a, b) -> a + b
let c = h |> compute
y(2) = 9.0
// ERROR: BL4005 @ 6:1
