// TEST: borrow a write through a tuple member (rejects)
// pair holds views of m's rows; row = pair[0] reaches m, so row(1) = 9.0
// writes the storage g reads, and g is used after it.
let mut m: Array<Float64 like Idx<2>, Idx<2>> = [[1.0, 2.0], [3.0, 4.0]]
let g = method_for(m) <@> lambda(v) -> v + 1.0
let a = g(0, 0)
let pair = (m(0), m(1))
let row = pair[0]
row(1) = 9.0
let b = g(0, 1)
// ERROR: BL4005 @ 8:1