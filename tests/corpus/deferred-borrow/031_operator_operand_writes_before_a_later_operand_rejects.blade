// TEST: borrow an earlier operator operand writes what a later operand's map reads (rejects)
// One statement orders its parts: the left operand bump(cnt) writes cnt, then the right operand's explicit
// `seen |> compute` uses seen, an uncomputed map over cnt.
type I = Idx<1>
let mut cnt: Array<Int64 like I> = [10]
let mut other: Array<Int64 like I> = [5]
function bump(c: mut Array<Int64 like I>) -> Int64 = {
    c(0) = c(0) + 1
    c(0)
}
function h1(a: Array<Int64 like I>) -> Int64 = a(0)
let seen = method_for(cnt) <@> lambda(v) -> v
let r = bump(cnt) + h1(seen |> compute)
// ERROR: BL4005 @ 12:9
