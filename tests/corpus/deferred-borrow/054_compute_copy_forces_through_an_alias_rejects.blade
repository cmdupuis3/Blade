// TEST: borrow a compute copy forces a named operand reached through an alias (rejects)
type I = Idx<3>
let mut y: Array<Float64 like I> = [2.0, 0.0, 1.0]
let g2 = method_for(y) <@> lambda(v) -> v + 1.0
let g3 = g2
let g5 = method_for(g3) <@> lambda(a) -> a * 3.0
let c = g5 |> compute
y(2) = 9.0
// ERROR: BL4005 @ 7:1
