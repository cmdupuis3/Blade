// TEST: borrow a function folding the map, the write after its last call, is accepted
type I = Idx<3>
let mut x: Array<Float64 like I> = [1.0, 2.0, 3.0]
let g = method_for(x) <@> lambda(v) -> v * 2.0
function f() -> Float64 = reduce(g, (+))
let s = f()
x(0) = 5.0
let x0 = x(0)
// EXPECT: s = 12.0
// EXPECT: x0 = 5.0
