// TEST: borrow an earlier tuple member writes what a later member's map reads (rejects)
// A tuple's members are evaluated left to right at its construction.
type I = Idx<1>
let mut cnt: Array<Int64 like I> = [10]
let mut other: Array<Int64 like I> = [5]
function bump(c: mut Array<Int64 like I>) -> Int64 = {
    c(0) = c(0) + 1
    c(0)
}
function h1(a: Array<Int64 like I>) -> Int64 = a(0)
let seen = method_for(cnt) <@> lambda(v) -> v
let t = (bump(cnt), seen |> compute)
// ERROR: BL4005 @ 11:10
