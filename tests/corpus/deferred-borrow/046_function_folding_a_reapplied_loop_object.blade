// TEST: borrow a function folding a re-applied loop object is accepted
// The recipe spelling: the loop object reads x when it is applied, inside each call.
type I = Idx<3>
let mut x: Array<Float64 like I> = [1.0, 2.0, 3.0]
let dbl = object_for(lambda(v: Float64) -> v * 2.0)
function f() -> Float64 = reduce(dbl <@> x, (+))
let s0 = f()
x(0) = 5.0
let s = f()
// EXPECT: s0 = 12.0
// EXPECT: s = 20.0
