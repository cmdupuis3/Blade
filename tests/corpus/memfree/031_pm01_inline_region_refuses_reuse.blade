// TEST: PM01 inline lifetime region refuses later scratch donation
// Like sibling-folds/037, kernel's input legs invite a retained inline.
// A01 must release its owned producer before the caller's three-stage chain.
// The whole event-bearing driver deliberately declines scratch reuse.
type Ix = Idx<7>
function inputs(a: Float64) -> Array<Float64 like Ix> = {
    method_for(range<Ix>) <@> lambda(i) -> a + Float64(i) |> compute
}
function kernel(x: Array<Float64 like Ix>, y: Array<Float64 like Ix>) -> Float64 = {
    let local = method_for(zip(x, y)) <@> lambda(a, b) -> a + b |> compute
    let s = reduce(method_for(local) <@> lambda(v) -> v * v, lambda(a, b) -> a + b, 0.0)
    s
}
function region_chain(x: Array<Float64 like Ix>, y: Array<Float64 like Ix>) -> (Array<Float64 like Ix>, Float64, Float64, Float64, Float64, Float64) = {
    let k = kernel(x, y)
    let t = reduce(x, (+)) + reduce(y, (+))
    let p = x + (k + t) |> compute
    let s1 = reduce(p, (+))
    let q = p + s1 |> compute
    let s2 = reduce(q, (+))
    let r = q + s2 |> compute
    let s3 = reduce(r, (+))
    (r, k, t, s1, s2, s3)
}
let (final, k, t, s1, s2, s3) = region_chain(inputs(0.0), inputs(1.0))
// EXPECT: final = [32445.0, 32446.0, 32447.0, 32448.0, 32449.0, 32450.0, 32451.0]
// EXPECT: k = 455.0
// EXPECT: t = 49.0
// EXPECT: s1 = 3549.0
// EXPECT: s2 = 28392.0
// EXPECT: s3 = 227136.0
