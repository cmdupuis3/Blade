// TEST: Memfree Mut Whole Array Rebind Clean
// ============================================================================
// Free-hazard guard: the ELIGIBLE case for turning a whole-array mut rebind
// into a copy-into-place (so the staging buffer is allocated once instead of
// once per step). STG is written only by `STG = t` from inside the step
// function; it is never aliased, never viewed, never passed anywhere. Under
// rebind semantics the old STG buffer is dropped each step and t escapes;
// under copy-into-place t's elements are copied into the single STG buffer
// and t is freed at the epilogue. The two are OBSERVATIONALLY IDENTICAL here,
// which is exactly what these pins assert: STG after the loop holds the LAST
// step's values either way, and the scalars read out of it agree.
// ============================================================================
type C = Idx<4>
type Steps = Idx<5>
let mut STG = method_for(range<C>) <@> lambda(i) -> 0.0 * Float64(i) |> compute
function stepf(n: Int64) -> Float = {
    let t = method_for(range<C>) <@> lambda(i) -> Float64(i) + 2.0 * Float64(n) |> compute
    STG = t
    reduce(t, (+)) * 0.5
}
let rec acc: Array<Float like Steps> =
    match acc with
    | zero -> zero
    | zero :: s -> zero :: 0.0
    | prefix :: n -> prefix :: prefix(n - 1) + stepf(n)
let sfinal = acc((4 : Steps))
let sread = STG((2 : C))
let stotal = reduce(STG, (+))
// EXPECT: STG = [8.0, 9.0, 10.0, 11.0]
// EXPECT: acc = [0.0, 7.0, 18.0, 33.0, 52.0]
// EXPECT: sfinal = 52.0
// EXPECT: sread = 10.0
// EXPECT: stotal = 38.0
