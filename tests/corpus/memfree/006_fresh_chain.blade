// TEST: Memfree Fresh Array Through Nested Calls
// ============================================================================
// Free-hazard guard: gmake returns a computed array (FreshPool — escapes g's
// epilogue); fchain holds TWO escaped results live at once, combines them into
// a local intermediate (freeable), and returns a fresh combination. g's
// epilogue must not free its return; fchain's epilogue must free a, b, c but
// not its own return.
// ============================================================================
type C = Idx<4>
type Steps = Idx<5>
function gmake(n: Int64) -> Array<Float like C> = method_for(range<C>) <@> lambda(i) -> 1.0 * i + Float64(n) |> compute
function fchain(u: Array<Float like C>, n: Int64) -> Array<Float like C> = {
    let a = gmake(n)
    let b = gmake(n + 1)
    let c = a + b
    u * 0.5 + 0.25 * c
}
let rec traj: Array<Float like Steps, C> =
    match traj with
    | zero -> zero
    | zero :: s -> zero :: [1.0, 2.0, 3.0, 4.0]
    | prefix :: n -> prefix :: fchain(prefix(n - 1), n)
let fin = traj((4 : Steps))
let mass = reduce(fin, (+))
// EXPECT: traj = [1, 2, 3, 4, 1.25, 2.25, 3.25, 4.25, 1.875, 2.875, 3.875, 4.875, 2.6875, 3.6875, 4.6875, 5.6875, 3.59375, 4.59375, 5.59375, 6.59375]
// EXPECT: fin = [3.59375, 4.59375, 5.59375, 6.59375]
// EXPECT: mass = 20.375
