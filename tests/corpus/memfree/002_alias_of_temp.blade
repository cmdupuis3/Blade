// TEST: Memfree Alias Of Iteration Temp
// ============================================================================
// Free-hazard guard: `let b = a` where a is a per-step temp — b is an ALIAS
// (same pool). The temp must be freed exactly once, and only after the last
// read through EITHER name. sa - sb is identically 0, so any corruption or
// premature free shows as a nonzero drift in the trajectory.
// ============================================================================
type C = Idx<4>
type Steps = Idx<6>
function bump(u: Array<Float like C>, n: Int64) -> Array<Float like C> = {
    let a = method_for(range<C>) <@> lambda(i) -> 1.0 * i + Float64(n) |> compute
    let b = a
    let sa = reduce(a, (+))
    let sb = reduce(b, (+))
    u + 0.25 * b
}
let rec traj: Array<Float like Steps, C> =
    match traj with
    | zero -> zero
    | zero :: s -> zero :: [1.0, 2.0, 3.0, 4.0]
    | prefix :: n -> prefix :: bump(prefix(n - 1), n)
let fin = traj((5 : Steps))
let mass = reduce(fin, (+))
// EXPECT: traj = [1, 2, 3, 4, 1.25, 2.5, 3.75, 5, 1.75, 3.25, 4.75, 6.25, 2.5, 4.25, 6, 7.75, 3.5, 5.5, 7.5, 9.5, 4.75, 7, 9.25, 11.5]
// EXPECT: fin = [4.75, 7, 9.25, 11.5]
// EXPECT: mass = 32.5
