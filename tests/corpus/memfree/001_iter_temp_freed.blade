// TEST: Memfree Iteration Temp Freed
// ============================================================================
// Free-hazard guard: a per-iteration combinator temp (t) is created inside the
// step function, consumed (s, and again AFTER s via 0.5 * t — ordering guard),
// and discarded. Scope-exit frees must reclaim it at function epilogue without
// disturbing the value carried into the trajectory.
// ============================================================================
type C = Idx<4>
type Steps = Idx<6>
function bump(u: Array<Float like C>, n: Int64) -> Array<Float like C> = {
    let t = method_for(range<C>) <@> lambda(i) -> 1.0 * i + 1.0 * n |> compute
    let s = reduce(t, (+))
    u + 0.5 * t
}
let rec traj: Array<Float like Steps, C> =
    match traj with
    | zero -> zero
    | zero :: s -> zero :: [1.0, 2.0, 3.0, 4.0]
    | prefix :: n -> prefix :: bump(prefix(n - 1), n)
let fin = traj((5 : Steps))
let mass = reduce(fin, (+))
// EXPECT: traj = [1, 2, 3, 4, 1.5, 3, 4.5, 6, 2.5, 4.5, 6.5, 8.5, 4, 6.5, 9, 11.5, 6, 9, 12, 15, 8.5, 12, 15.5, 19]
// EXPECT: fin = [8.5, 12, 15.5, 19]
// EXPECT: mass = 55
