// TEST: Memfree Symmetric Packed Temp Per Step
// ============================================================================
// Free-hazard guard: a symmetric (packed triangular) per-step temp — freeing
// must walk the PACKED skeleton (same SYMM template args as the allocation),
// not the dense one. sym0 pins the packed layout outside the loop as well.
// ============================================================================
type C = Idx<4>
type Steps = Idx<5>
let SRC = method_for(range<C>) <@> lambda(i) -> 1.0 * i + 1.0 |> compute
let symk = lambda(x, y) where comm(x, y) -> x * y
function symfold(n: Int64) -> Float = {
    let S = method_for(SRC, SRC) <@> symk |> compute
    S((0 : C), (1 : C)) + S((3 : C), (2 : C)) + S((2 : C), (2 : C)) + 1.0 * n
}
let sym0 = symfold(0)
let rec acc: Array<Float like Steps> =
    match acc with
    | zero -> zero
    | zero :: s -> zero :: 0.0
    | prefix :: n -> prefix :: prefix(n - 1) + symfold(n) * 0.001
let sfinal = acc((4 : Steps))
// EXPECT: SRC = [1, 2, 3, 4]
// EXPECT: sym0 = 23
// EXPECT: acc = [0, 0.024, 0.049, 0.075, 0.102]
// EXPECT: sfinal = 0.102
