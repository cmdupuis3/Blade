// TEST: Memfree Stack Return And Cell Filled Result
// ============================================================================
// Free-hazard guard for the two return shapes examples/09_qg_atmosphere leaked
// per time step (4.1 GB over its run), in one small recursion:
//
//   1. `step` returns `stack(un, vn, u)`. The statement-shaped return arm copies
//      every source into a FRESH `__retN` pool before the frame's frees, so the
//      sources (the computed `un`, `vn`) must be freed, and the stacked state
//      is the CALLER's to free (it used to be "not fresh", so the time loop
//      copied it into the ring and dropped it every step). `u` is a view of
//      the argument and must NOT be freed.
//   2. `fill` builds its result cell by cell (`let mut out = ...; out(i) =
//      ...; out`), as the spectra transforms now do: element stores make no
//      second name for the pool, so the result is fresh and its caller frees
//      it. `sp.ifft2(sp.fft2(..))` runs the real transforms on the same path.
//
// `step` writes the top-level `checksum`, so it is emitted as a main-local
// lambda, exactly like 09's `bstep`. The values are master's (the fix moves no
// data); `blade test memfree` and the memcheck census are the free evidence.
// ============================================================================
import spectra as sp

type C = Idx<4>
type R = Idx<4>
type S = Idx<3>
type T = Idx<120>

let mut checksum: Float64 = 0.0

function fill(w: Array<Float like C>) -> Array<Float like C> = {
    let mut out = method_for(range<C>) <@> lambda(i) -> 0.0 |> compute
    out((0 : C)) = w((0 : C)) * 0.5
    out((1 : C)) = w((1 : C)) * 0.5 + 0.25
    out((2 : C)) = w((2 : C)) * 0.5
    out((3 : C)) = w((3 : C)) * 0.5 - 0.25
    out
}

function smooth(f: Array<Float like R, C>) -> Array<Float like R, C> = {
    let spec: Array<Complex128 like R, C> = sp.fft2(f)
    sp.ifft2(spec)
}

function step(n: Int64, st: Array<Float like S, C>) -> Array<Float like S, C> = {
    let u = st((0 : S))
    let v = st((1 : S))
    let un = fill(u + 0.1 * v)
    let vn = v - 0.1 * u |> compute
    checksum = checksum + reduce(un, (+))
    stack(un, vn, u)
}

let field0: Array<Float like R, C> = [[1.0, 2.0, 3.0, 4.0], [0.5, 0.25, 0.0, -1.0], [2.0, 2.0, 2.0, 2.0], [-1.0, 0.0, 1.0, 0.0]]
let u0: Array<Float like C> = [1.0, 2.0, 3.0, 4.0]
let v0: Array<Float like C> = [0.5, -0.5, 0.5, -0.5]
let z0: Array<Float like C> = [0.0, 0.0, 0.0, 0.0]
function seed(u: Array<Float like C>) -> Array<Float like S, C> = stack(u, v0, z0)

let final = {
    let rec traj: Array<Float like T, S, C> =
        match traj with
        | zero -> zero
        | zero :: s -> zero :: seed(u0)
        | prefix :: n -> prefix :: step(n, prefix(n - 1))
    traj((119 : T))
}

let round_trip = reduce(smooth(field0), (+), axes = 2)
let final_checksum = checksum
// EXPECT: checksum = -3.91323573707422
// EXPECT: final = [[0.00909614098213656, 0.125809256250763, -0.00345928399258732, -0.194223238113931], [0.08910426457331, -3.76759372169425, -0.0338865631826779, 3.09742188152368], [0.00918995594746744, 0.127106816505891, -0.00349496204644242, -0.196226400376466]]
// EXPECT: round_trip = 17.75
// EXPECT: final_checksum = -3.91323573707422
