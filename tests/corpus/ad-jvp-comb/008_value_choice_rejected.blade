// TEST: JVP C1 Value-Keyed Choice Rejected (rejects)
// `<|>` picks per cell by testing the PRIMAL's value against zero, so the
// output jumps at the switching set -- discontinuous, not merely
// non-smooth, and no subgradient approximates it. Worse, the naive rule
// would branch on the TANGENT's zero test and silently return the wrong
// leg. Its storage-keyed sibling `<|:>` IS differentiable (006); the
// distinction is the whole point of having both.
// ERROR: BL5501
// ERROR-CONTAINS: combinator operators
import ad as ad

function f(a: Array<Float like Idx<2>>, b: Array<Float like Idx<2>>) -> Float = {
    let ch = a <|> b |> compute
    ch(0) + ch(1)
}

let (v, t) = ad.jvp(f)([1.0, 0.0], [9.0, 8.0], [1.0, 0.0], [0.0, 1.0])
v
