// TEST: C6 Reverse Flows Through Sequence And Replicate
// `sequence` and `replicate` differentiated FORWARD long before they
// differentiated backward: the structural dims table knew neither shape, so
// grad refused the local outright while ad.jvp handled it. Both now have the
// reverse flow their shape asks for.
//
// `sequence(x, y)` is `stack(x, y)` under another name -- a leading axis of N
// over the member shape -- so the member peel is the same rule:
//   fseq = s(0,0)*3 + s(1,1)*5 at x = [1,2], y = [3,4]
//        = 1*3 + 4*5 = 23;  dx = [3, 0], dy = [0, 5].
//
// `replicate(n, body)` copies ONE body into every slot, so every slot's
// cotangent flows back into that same operand and the peels ACCUMULATE:
//   frep = r(0,0)*3 + r(1,1)*5 at x = [1,2] = 1*3 + 2*5 = 13; dx = [3, 5]
//          (distinct positions -- one term each)
//   facc = r(0,0)*3 + r(1,0)*7 at x = [1,2] = 1*3 + 1*7 = 10; dx = [10, 0]
//          (the SAME element through two slots -- 3 + 7 into one cell, which
//          is what distinguishes replicate's adjoint from sequence's)
import ad as ad

type I = Idx<2>

function fseq(x: Array<Float like I>, y: Array<Float like I>) -> Float = {
    let s = sequence(x, y) |> compute
    s(0, 0) * 3.0 + s(1, 1) * 5.0
}

function frep(x: Array<Float like I>) -> Float = {
    let r = replicate(2, x) |> compute
    r(0, 0) * 3.0 + r(1, 1) * 5.0
}

function facc(x: Array<Float like I>) -> Float = {
    let r = replicate(2, x) |> compute
    r(0, 0) * 3.0 + r(1, 0) * 7.0
}

// WARN: BL4003
let mut dx = [0.0, 0.0]
let mut dy = [0.0, 0.0]
let sv = ad.grad(fseq)([1.0, 2.0], [3.0, 4.0], dx, dy)
// EXPECT: sv = 23
// EXPECT: dx = [3, 0]
// EXPECT: dy = [0, 5]

let mut rx = [0.0, 0.0]
let rv = ad.grad(frep)([1.0, 2.0], rx)
// EXPECT: rv = 13
// EXPECT: rx = [3, 5]

let mut ax = [0.0, 0.0]
let av = ad.grad(facc)([1.0, 2.0], ax)
// EXPECT: av = 10
// EXPECT: ax = [10, 0]

// forward agreement: the tangent is the gradient contracted with the seed
let (js, ts) = ad.jvp(fseq)([1.0, 2.0], [3.0, 4.0], [1.0, 0.0], [0.0, 1.0])
let sresid = ts - (dx(0) + dy(1))
// EXPECT: js = 23
// EXPECT: sresid = 0
let (jr, tr) = ad.jvp(frep)([1.0, 2.0], [1.0, 1.0])
let rresid = tr - (rx(0) + rx(1))
// EXPECT: jr = 13
// EXPECT: rresid = 0
let (ja, ta) = ad.jvp(facc)([1.0, 2.0], [1.0, 0.0])
let aresid = ta - ax(0)
// EXPECT: ja = 10
// EXPECT: aresid = 0
