// TEST: Positional Keys With An Init And Group-Space Weights
// The weighted twin of 051, and the second of the two init contributions.
// Unweighted, the init adds `init * N` for a static N. WEIGHTED it adds
// `init * sum_g w_g` -- a reduce over the weight array, which is itself
// DIFFERENTIABLE, so the init's contribution has to land in the weight
// gradient too and not just in the primal.
//
// It does: dc is the per-group sums INCLUDING each group's init, so the empty
// group's weight gradient is exactly the init. The natural peel agrees to the
// bit (this consumption sums three group-space terms in the same order the
// lowered form's init term does, so there is no reassociation to absorb).
import ad as ad

type R = Idx<4>
type GK = Idx<3>

function loss(v: Array<Float64 like R>, pk: Array<GK like R>, cw: Array<Float64 like GK>) -> Float = {
    let gk = group_keys(pk)
    let g = group_by(v, gk)
    let m = method_for(g) <@> lambda(r: Array<Float64 like RaggedIdx<_>>) -> reduce(r, (+), 7.0) |> compute
    reduce(m * cw, (+))
}

let vv: Array<Float64 like R> = [10.0, 20.0, 30.0, 40.0]
// group 0 takes rows 1,3; group 1 takes NOTHING; group 2 takes rows 0,2
let sk: Array<GK like R> = [2, 0, 2, 0]
let c0: Array<Float64 like GK> = [2.0, 5.0, -1.0]

// the natural peel outside AD, re-read into a plain group-space array
let pgk = group_keys(sk)
let pg = group_by(vv, pgk)
let pm = method_for(pg) <@> lambda(r: Array<Float64 like RaggedIdx<_>>) -> reduce(r, (+), 7.0) |> compute
let pmd: Array<Float64 like GK> = [pm(0), pm(1), pm(2)]
let pL = reduce(pmd * c0, (+))
// EXPECT: pm = [67, 7, 47]
// EXPECT: pL = 122

// WARN: BL4003
let mut dv = [0.0, 0.0, 0.0, 0.0]
let mut dc = [0.0, 0.0, 0.0]
let gv = ad.grad(loss)(vv, sk, c0, dv, dc)
// EXPECT: gv = 122
let agree = gv - pL
// EXPECT: agree = 0
// each row carries its group's weight
// EXPECT: dv = [-1, 2, -1, 2]
// and each weight carries its group's seeded sum -- the EMPTY group's is the init
// EXPECT: dc = [67, 7, 47]
