// TEST: ML Join Of Reps Rejected (rejects)
// ERROR: BL4008
// The other half of 107: joining the REPRESENTATION values themselves is
// refused, exactly as packing them into a literal is -- the concatenation does
// not transform as the declared invariant output.
import ml as ml
let static S = [(0, 0, 1), (1, 1, 1)]
function bad(a: Array<Float64 like IrrepsIdx<S>>, b: Array<Float64 like IrrepsIdx<S>>) where ml.equiv(O3) -> Array<Float64 like Idx<8>> =
    join(a, b, 0)
