// TEST: ML Equiv Engine Nonhomogeneous
import ml as ml
// ============================================================================
// NONHOMOGENEOUS BODIES, AND THE CONSTANT OBLIGATION
// (retired transforms-as-types plan §7 stage 6b).
//
// Equivariance SPLITS PER DEGREE: if f = f₀ + f₁ + f₂ + … with f_d homogeneous
// of degree d in the representation components, then f(ρ·x) = ρ·f(x) holds iff
// it holds degree by degree, because ρ acts linearly and the degrees cannot
// mix. The engine gets this for free — it compares coefficients of individual
// monomials, and a monomial has one degree — so a hand-written body may mix a
// bias, a linear part and a quadratic part with no extra machinery.
//
// The DEGREE-ZERO row is the interesting one. f₀ is a constant vector, and the
// identity at degree 0 reads ρ(g)·f₀ = f₀ for every g: a constant summand must
// be FIXED BY THE WHOLE GROUP. Concretely: supported on trivial-label cells
// (the labels whose every generator matrix is the identity — never read off
// the NAME, per corpus 050) and unmoved by the component group. A constant in
// an E cell is not, and the engine names it as a constant rather than as an
// anonymous coefficient. That refusal is
// tests/corpus/diagnostics/023_equiv_engine_constant.blade; this file pins the
// side that PASSES.
// ============================================================================
// [A × 1, E × 1]: one trivial-label slot at offset 0, then the rotating plane
// at offsets 1 and 2.
let static SD = [("A", 1), ("E", 1)]

// A bias in the A cell, the identity on the E plane. Degree 0 + degree 1.
function biased(x: Array<Float like PgIrrepsIdx<C4, SD>>)
                where ml.equiv(C4) -> Array<Float like PgIrrepsIdx<C4, SD>> =
    [x(0) + 2.0, x(1), x(2)]

let b0 = biased([1.0, 3.0, 4.0])
// EXPECT: b0 = [3, 3, 4]
// ρ(r) fixes the A cell and rotates the E plane: (1, 3, 4) ↦ (1, −4, 3). The
// bias rides along untouched, which is what "trivial-label supported" means.
let b1 = biased([1.0, 0.0 - 4.0, 3.0])
// EXPECT: b1 = [3, -4, 3]

// --- THREE DEGREES AT ONCE --------------------------------------------------
// Degree 0: the A-cell bias. Degree 1: the E plane, scaled by an invariant.
// Degree 2: the squared norm of the E plane, which is an A-cell quantity.
// Every one of the three is separately equivariant, and the engine checks them
// as one polynomial without ever naming the splitting.
function graded(x: Array<Float like PgIrrepsIdx<C4, SD>>, s: Float)
                where ml.equiv(C4) -> Array<Float like PgIrrepsIdx<C4, SD>> = {
    let r2 = x(1) * x(1) + x(2) * x(2)
    [x(0) + r2 + 2.0, x(1) * s, x(2) * s]
}

// r² = 25, so the A cell is 1 + 25 + 2 = 28, and the E plane doubles.
let g0 = graded([1.0, 3.0, 4.0], 2.0)
// EXPECT: g0 = [28, 6, 8]
// ρ(r): (1, 3, 4) ↦ (1, −4, 3). The A cell is unmoved (28) and the plane is
// the rotation of (6, 8), i.e. (−8, 6).
let g1 = graded([1.0, 0.0 - 4.0, 3.0], 2.0)
// EXPECT: g1 = [28, -8, 6]

// --- A CONSTANT MAY ALSO BE AN INVARIANT ATOM -------------------------------
// The degree-0 obligation is about the GROUP ACTION, not about literals: an
// invariant parameter is a constant of the polynomial too, and it is equally
// legal in a trivial-label cell (and equally illegal in an E cell). Here the
// bias is `s` itself.
function biased_atom(x: Array<Float like PgIrrepsIdx<C4, SD>>, s: Float)
                     where ml.equiv(C4) -> Array<Float like PgIrrepsIdx<C4, SD>> =
    [x(0) + s, x(1), x(2)]

let p0 = biased_atom([1.0, 3.0, 4.0], 5.0)
// EXPECT: p0 = [6, 3, 4]
let p1 = biased_atom([1.0, 0.0 - 4.0, 3.0], 5.0)
// EXPECT: p1 = [6, -4, 3]
