// TEST: Writing Deferred Map Outside A Join
// Gaps G43 / G45. A deferred map whose kernel WRITES a captured `let mut`
// (legal: formalism 5.2, a serial body's write is an ordered side effect)
// that is NAMED is evaluated once, completely, at its definition, in every
// scope (formalism 10.2, last paragraph; G45): two folds of it -- in a block
// or at top level -- read the stored cells 1..4. (Before G45 a block or the
// top level ran the map once per fold, 36 / counter 8, while a function body
// forced it at its let, 20 / counter 4.) A map read ONLY by a join stays
// deferred for sharing and its writing legs are refused (BL4005,
// mutability-errors/014); forcing it first is the explicit spelling and joins
// over the stored cells.
type I = Idx<4>
let mut G1 = Int64([0])
let mut G2 = Int64([0])
let mut G3 = Int64([0])
// Two folds of a named writing map: one evaluation, at its let.
let r1 = {
    let m = method_for(range<I>) <@> lambda(i) -> { G1(0) = G1(0) + 1; G1(0) }
    let s = reduce(m, (+))
    let t = reduce(m, (+))
    s + t
}
let m2 = method_for(range<I>) <@> lambda(i) -> { G2(0) = G2(0) + 1; G2(0) }
let r2 = reduce(m2, (+)) + reduce(m2, (+))
// Forced first, then joined: one evaluation of the writing map.
let r3 = {
    let m = method_for(range<I>) <@> lambda(i) -> { G3(0) = G3(0) + 1; G3(0) } |> compute
    let (s, t) = object_for(<&!>) <@> (reduce(m, (+)), reduce(m, (+)))
    s * 1000 + t
}
// EXPECT: r1 = 20
// EXPECT: r2 = 20
// EXPECT: r3 = 10010
// EXPECT: G1 = [4]
// EXPECT: G2 = [4]
// EXPECT: G3 = [4]
// EXPECT: m2 = [1, 2, 3, 4]
