// TEST: Object For
// The let-bound former is APPLIED, so the binding is asserted to be a usable
// loop object and not merely a well-typed one. Two DISTINCT operand arrays,
// which also keeps the commutative-kernel storage warning (BL4010) out of the
// picture — that property has its own tests in arity/.
//
// HAND DERIVATION (A = [1, 2, 3], B = [4, 5, 6]):
//   object_for over two rank-1 operands is the Cartesian outer product, and a
//   rank-2 result prints flat row-major:
//     R(i, j) = A(i) * B(j)
//     row i=0:  1*4, 1*5, 1*6  =  4,  5,  6
//     row i=1:  2*4, 2*5, 2*6  =  8, 10, 12
//     row i=2:  3*4, 3*5, 3*6  = 12, 15, 18
let kernel = lambda(x: Float64, y: Float64) -> x * y
let O = object_for(kernel)
let A = [1.0, 2.0, 3.0]
let B = [4.0, 5.0, 6.0]
let R = O <@> (A, B) |> compute
// EXPECT: R = [4, 5, 6, 8, 10, 12, 12, 15, 18]
