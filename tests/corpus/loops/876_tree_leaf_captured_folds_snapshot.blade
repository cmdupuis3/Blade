// TEST: a fusion-tree leaf captured by another leaf folds its snapshot
// Gap G233, round 4 wave 10: the leaf q's kernel captures p, so the fold's
// prelude forces p ONCE under its own name (G214) before the seed writes x.
// The tree keeps the leaf NAME p and folds that snapshot (the stored-leaf
// traversal), not a fresh walk of p's producer over the written x (which
// every lane folded before: s = (24.0, 20.0)). q is not captured: its leaf
// walks the current x.
let mut x: Array<Float64 like Idx<2>> = [1.0, 2.0]
let p = method_for(x) <@> lambda(v) -> v * 2.0
let q = method_for(x) <@> lambda(v) -> v + p(1)
let s = reduce(p <&!> q, lambda(a, b) -> a + b, { x(0) = 10.0; Float64(0) })
let w = p(0)
// EXPECT: x = [10.0, 2.0]
// EXPECT: p = [2.0, 4.0]
// EXPECT: s = (6.0, 20.0)
// EXPECT: w = 2.0
