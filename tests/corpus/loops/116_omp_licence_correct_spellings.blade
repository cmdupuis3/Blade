// TEST: Omp Licence Correct Spellings (no diagnostic)
// ============================================================================
// The accept twin of `loops/115`. Both spellings below put the `omp` clause
// where the loop it governs actually is, so NEITHER may warn -- and this file
// deliberately carries no `// WARN:` pin, which is what turns that silence into
// an assertion (the runner fails on any unpinned warning; a pin in 115 would
// have licensed a stray one there, since warning pins are count-insensitive).
//
//   `outer` -- the loop is generated by this body, so the licence sits on that
//   loop's own kernel. The function signature says nothing about parallelism.
//
//   `twice` -- the clause IS on the signature, and correctly so: the nest is
//   built around `twice` by the caller's `object_for(twice) <@> (A)`, which is
//   precisely the external S-dim the clause licenses. The body builds no loop
//   over `a` at all, so there is nothing to confuse it with.
//
// Both emit a pragma (pinned as emitted text in `tests/OmpTests.fs`); values
// are what this lane checks, and a race would corrupt them.
// ============================================================================
let A = [1.0, 2.0, 3.0, 4.0]

function outer(xs: Float64^1) = {
    xs <@> lambda(x) where omp(x: 1) -> x * 3.0 |> compute
}
let good = outer(A)
// EXPECT: good = [3, 6, 9, 12]

function twice(a: Float64) where omp(a: 1) = a * 5.0
let ext = object_for(twice) <@> (A) |> compute
// EXPECT: ext = [5, 10, 15, 20]
