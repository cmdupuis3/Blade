let g = method_for(x) <@> lambda(v) -> v * 2.0
let g2 = g
g2 = y
let s = reduce(g2, (+))
// ERROR: BL4005 @ 14:1
// ERROR-CONTAINS: a write through `g2`, a deferred computation
