// TEST: a kept leaf of a nested fusion tree folds its snapshot
// Gap G233, round 4 wave 10 (Codex design review, class closure): the tree
// `p <&!> (q <&!> r)` keeps the leaf name p, captured by q's kernel, at any
// nesting depth; p folds the snapshot taken before the seed writes x, q and r
// walk the current x.
let mut x: Array<Float64 like Idx<2>> = [1.0, 2.0]
let p = method_for(x) <@> lambda(v) -> v * 2.0
let q = method_for(x) <@> lambda(v) -> v + p(1)
let r = method_for(x) <@> lambda(v) -> v + 2.0
let s = reduce(p <&!> (q <&!> r), (+), { x(0) = 10.0; Float64(0) })
let w = p(0)
// EXPECT: x = [10.0, 2.0]
// EXPECT: p = [2.0, 4.0]
// EXPECT: s = ((6.0, 20.0), 16.0)
// EXPECT: w = 2.0
