type A = Array<Int64 like Idx<2>>
function factory(z: Int64) -> ((Int64, Int64) -> Int64) = {
    let v = Int64(floor(sqrt(Float64(z) - 1.0)))
    lambda(a: Int64, b: Int64) -> a + b + v
}
function total(y: A, z: Int64) -> Int64 = reduce(y, factory(z), 8 / z)
let g: A = [1, 2]
let r = total(g, 0)
