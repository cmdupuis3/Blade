// TEST: Block View Of Deferred Map Write (rejects)
// ----------------------------------------------------------------------------
// Codex second look of W4-1, finding 1: loops/551 moved into a top-level
// BLOCK. A block let is assignable (MutableArrayLets), but `let row = m(0)` is
// a VIEW, not a copy -- every lane copies only a plain `let a = Z` -- so
// `row(1) = 9.0` writes the deferred map m. The provenance walk stops only at
// a proved copy, so it is refused at lowering in every lane (BL4005).
// ----------------------------------------------------------------------------
type Y = Idx<2>
type X = Idx<3>
let m = method_for(range<Y>, range<X>) <@> lambda(i, j) -> Float64(i) * 10.0 + Float64(j)
let r = {
    let row = m(0)
    row(1) = 9.0
    reduce(m, (+), axes = 2)
}
// ERROR: BL4005 @ 11:1
// ERROR-CONTAINS: a write through `m`, a deferred computation
// REJECT-AT: lower
