// TEST: Implicit Zip Co-iteration
// Stage-1 implicit formers: `zip(A, B) <@> kernel` synthesizes
// method_for(zip(A, B)) — the co-iteration (elementwise) form, NOT the outer
// product. The zip on the left routes through inferMethodFor's existing zip
// expansion, so shared-record checking is unchanged. Values match loops/014.
let A = [1.0, 2.0, 3.0]
let B = [4.0, 5.0, 6.0]
let result = zip(A, B) <@> lambda(a, b) -> a * b |> compute
// EXPECT: result = [4.0, 10.0, 18.0]
