// TEST: Halo Over Symmetric Source
// ============================================================================
// A dense halo window reading ROWS OF A SYMMETRIC (packed) array. S = x (x) x
// under `comm` is stored triangular, so S(i, w(k)) must be canonicalized
// (the smaller coordinate first) before it touches the packed pool. The
// sliding-window "halo carousel" used to take exactly this shape -- its gate
// kept it off plain dense sources only -- and seeded its ring with raw
// `S[i][ordinal]` subscripts into the PACKED row: wrong cells below the
// diagonal, reads past the row's end above it. The carousel is gone; the
// ordinary window read renders every offset.
//
// r(i, c) = x_i * (x_{c-1} + x_c + x_{c+1}) over the 5-cell interior.
// ============================================================================
type I = Idx<7>
let x: Array<Float like I> = [1.0, 2.0, 4.0, 7.0, 11.0, 16.0, 22.0]
let S = method_for(x, x) <@> lambda(a, b) where comm(a, b) -> a * b |> compute
let r = method_for(range<I>, halo<I, [-1, 0, 1]>) <@> lambda(i, w) -> S(i, w(-1)) + S(i, w(0)) + S(i, w(1)) |> compute
// EXPECT: r = [[7.0, 13.0, 22.0, 34.0, 49.0], [14.0, 26.0, 44.0, 68.0, 98.0], [28.0, 52.0, 88.0, 136.0, 196.0], [49.0, 91.0, 154.0, 238.0, 343.0], [77.0, 143.0, 242.0, 374.0, 539.0], [112.0, 208.0, 352.0, 544.0, 784.0], [154.0, 286.0, 484.0, 748.0, 1078.0]]
