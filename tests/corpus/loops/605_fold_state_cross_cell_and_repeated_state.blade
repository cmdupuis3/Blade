// TEST: Fold State In Place Cross Cell And Repeated State Reads
// ============================================================================
// PM14 controls on the STATE itself. `a + b * a(0)` reads the state at a
// FIXED cell: an in-place update would overwrite cell 0 before the later
// cells read it, so the arm must decline ("not pointwise") and keep the
// materialized step. `(a + b) * (a - b)` reads the state's own cell twice:
// admitted, both reads bound before the cell's store.
// ============================================================================
let g = (method_for(range<Idx<5>>) <@> lambda(r) ->
          (method_for(range<Idx<3>>) <@> lambda(c) -> Float64(r) * 0.25 + Float64(c) * 0.5 + 0.125)) |> compute
let cross = reduce(g, lambda(a: T^1, b: T^1) -> a + b * a(0))
let twice = reduce(g, lambda(a: T^1, b: T^1) -> (a + b) * (a - b))
// EXPECT: cross = [1.11282348632812, 2.16275024414062, 3.21267700195312]
// EXPECT: twice = [-0.875, -2.25, -2.122802734375]
