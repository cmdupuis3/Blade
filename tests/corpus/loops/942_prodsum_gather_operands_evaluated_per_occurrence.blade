// TEST: A prodsum Over Two Equal Gather Spellings Evaluates Each Occurrence
// Gap G265 (a) (round 4 wave 10 lane d; Codex diff review): an inline partial sparse read
// F((r, _)) is bound and freed around the fold; the binding was keyed by the gather's TEXT, so two
// equal spellings whose coordinate calls a writing function shared ONE gather (state = [1],
// s = 5.0). Every occurrence is bound in its operand position: rows 0 and 1, 1*3 + 2*4.
let static K = [(0, 0), (0, 1), (1, 0), (1, 1)]
let flat: Array<Float64 like Idx<4>> = [1.0, 2.0, 3.0, 4.0]
let F = sparse(flat, K)
function next(v: mut Array<Int64 like Idx<1>>) -> Int64 = {
    let n = v(0)
    v(0) += 1
    n
}
let mut state: Array<Int64 like Idx<1>> = [0]
let s = prodsum(F((next(state), _)), F((next(state), _)))
// EXPECT: state = [2]
// EXPECT: s = 11.0
