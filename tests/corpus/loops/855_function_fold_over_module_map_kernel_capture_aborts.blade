// TEST: a function-body fold over a module map with a capturing fold kernel (aborts)
// Gap G235 (b), round 4 wave 9: the fold over the module deferred map e has a kernel capturing d.
// A function body evaluates a deferred module map privately, per call (G75);
// a kernel capture of it is a forcing use where the kernel is formed, so d
// (a division by zero at cell 1) fails in every lane. The LLVM lane used to
// skip the capture in a function body and complete.
let x: Array<Int64 like Idx<3>> = [1, 0, 3]
let d = method_for(x) <@> lambda(v) -> 10 / v
let e = method_for(x) <@> lambda(v) -> v + 1
function m() -> Int64 = reduce(e, lambda(a, b) -> a + b + extents(d), 0)
let s = m()
