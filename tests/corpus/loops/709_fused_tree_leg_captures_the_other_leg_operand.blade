// TEST: Fused Tree Leg Captures The Other Leg Operand
// Gap G214 (round 4 wave 8): in a fused tree the first leaf reads the
// deferred map d as its operand and the second leaf kernel captures d. The
// capture forces d once under its own name for both legs, so w reads the
// snapshot after the write to x.
let mut x: Array<Float64 like Idx<3>> = [1.0, 2.0, 3.0]
let d = method_for(x) <@> lambda(v) -> v * 2.0
let (s1, s2) = reduce((method_for(d) <@> lambda(v) -> v) <&!> (method_for(x) <@> lambda(v) -> v + d(1)), (+))
x(0) = 10.0
let w = d(0)
// EXPECT: s1 = 12.0
// EXPECT: s2 = 18.0
// EXPECT: w = 2.0
// EXPECT: d = [2.0, 4.0, 6.0]
