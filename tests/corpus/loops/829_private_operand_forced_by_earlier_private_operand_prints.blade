// TEST: A Private Operand Forced While Materializing An Earlier One Prints
// Gap G243 (round 4 wave 9 lane d): the order-sensitive twin of loops/828 -- f is materialized
// FIRST and its input e, not yet a private value, is forced under its own name (e prints); the
// later operand e reads that array.
// EXPECT: e = [2, 3, 4, 5, 6]
// EXPECT: s = 50
type I = Idx<5>
let mut d: Array<Int64 like I> = [1, 2, 3, 4, 5]
let e = method_for(d) <@> lambda(a) -> a + 1
let f = method_for(e) <@> lambda(a) -> a + 2
let s = reduce(method_for(zip(f, e)) <@> lambda(a, b) -> a + b, (+))
