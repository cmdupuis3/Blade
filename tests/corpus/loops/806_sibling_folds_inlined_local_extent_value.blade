// TEST: Sibling Folds With An Inlined Local Extent Keep The Fold Value
// ============================================================================
// Gap G219, round 4 wave 9 (lane C, C5): the sibling-fold pass inlines a
// pure-total helper one level under FRESH ids; its leg totality judge read
// the module-wide fail-closed deferred classifier, built before the inline,
// so the inlined `let y = .. |> compute` looked like an imported (unseen)
// binder and the seed `Float64(extents(y))` declined the join (two
// traversals, the same value). The region's inlined lets now join the
// classifier's census: the legs join (blade test optimize pins the record).
// ============================================================================
type I = Idx<3>
type A = Array<Float64 like I>
let x: A = [0.5, 0.25, 0.125]
function helper(a: A) -> Float64 = {
    let y = method_for(a) <@> lambda(v: Float64) -> v * 4.0 |> compute
    reduce(a, (+), Float64(extents(y)) + y(0))
}
function f(a: A) -> (Float64, Float64) = (prodsum(a, a), helper(a))
let r = f(x)
// EXPECT: r = (0.328125, 5.875)