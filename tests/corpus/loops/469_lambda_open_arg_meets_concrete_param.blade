// TEST: a lambda's open parameter passed to a concrete parameter takes what the row brings
// The call `g(x)` inside a kernel lambda is judged while `x` is open; the
// row decides it afterwards, and the call is judged again then (loops/468
// is the refused case). An index row passes to an `Int64` parameter (an
// index is an integer position, loops/440), as does an Int64 row, and a
// let-bound lambda called with an integer.
type I = Idx<3>
function g(i: Int64) = i * 2
let a = method_for(range<I>) <@> lambda(x) -> g(x) |> compute
let b = method_for(Int64([4, 5])) <@> lambda(x) -> g(x) + 1 |> compute
let h = lambda(x) -> g(x)
let c = h(Int64(7))
// EXPECT: a = [0, 2, 4]
// EXPECT: b = [9, 11]
// EXPECT: c = 14
