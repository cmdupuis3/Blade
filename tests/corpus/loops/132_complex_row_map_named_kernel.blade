// TEST: Complex Row Map Named Kernel
// ============================================================================
// Complex-vs-Float64 parity for the row-typed map with a nested `<@>` in the
// fold body -- the lswosa per-frequency shape.
//
// `loopOperandArrayType` used to hard-default a still-open operand element to
// Float64 inside EVERY lambda body. For `g <@> lambda(row: T^1) -> reduce(row
// <@> sq, (+))` over a Complex128 grid, the inner map's operand snapshot then
// carried Float64 where the row's element var belonged, and the eta-expanded
// named kernel (param pinned Complex128) refused with BL3001 "expected
// Complex128, got Float64" at the OUTER apply -- while the byte-identical
// Float64 program compiled by coincidence. The unannotated-lambda spelling of
// the same kernel instead BOUND the row element to Float64 and died in g++
// reading `double` off a complex row.
//
// The premise behind the defaulting ("the snapshot is never revisited") died
// when Zonk gained the ApplyInfo.ArrayTypes walk: a polymorphic-marked element
// var kept open here is pinned by buildApplyInfo's kernel-param unification
// moments later and re-resolved at zonk. Values below are the closed forms:
// row r of g is complex(r+c, 1) for c in 0..2, sq(z) = z^2 sums to
// (3r^2+6r-1+2, ...) -- pinned numerically.
// ============================================================================
function sq(z: Complex128) = z * z
function pk(z: Complex128) = complex(real(z)^2 + imag(z)^2, 0.0)
let g = (method_for(range<Idx<4>>) <@> lambda(r) ->
          (method_for(range<Idx<3>>) <@> lambda(c) -> complex(1.0 * r + 1.0 * c, 1.0))) |> compute
// EXPECT: g = [[(0,1), (1,1), (2,1)], [(1,1), (2,1), (3,1)], [(2,1), (3,1), (4,1)], [(3,1), (4,1), (5,1)]]

// Eta-expanded named kernel, omp-licensed row map (the p_d repro).
let o1 = (g <@> lambda(row: T^1) where omp(row: 1) -> reduce(row <@> sq, (+))) |> compute
// EXPECT: o1 = [(2,6), (11,12), (26,18), (47,24)]

// Power-spectrum kernel (the p_e repro): |z|^2 as a complex with zero imag.
let o2 = (g <@> lambda(row: T^1) where omp(row: 1) -> reduce(row <@> pk, (+))) |> compute
// EXPECT: o2 = [(8,0), (17,0), (32,0), (53,0)]

// The unannotated-lambda spelling of the same kernel: previously passed check
// and failed in g++ with `double row____i0 = row[__i0]`.
let o3 = (g <@> lambda(row: T^1) -> reduce(row <@> lambda(z) -> z * z, (+))) |> compute
// EXPECT: o3 = [(2,6), (11,12), (26,18), (47,24)]

// Float64 twin stays exactly as it always was.
function sqf(x: Float64) = x * x
let h = (method_for(range<Idx<4>>) <@> lambda(r) ->
          (method_for(range<Idx<3>>) <@> lambda(c) -> 1.0 * r + 1.0 * c)) |> compute
let o4 = (h <@> lambda(row: T^1) where omp(row: 1) -> reduce(row <@> sqf, (+))) |> compute
// EXPECT: o4 = [5, 14, 29, 50]
