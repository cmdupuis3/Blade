// TEST: Fold Kernel Cell Capture Over Stored Operand
// Gap G214 (round 4 wave 8, Codex diff review round 1): the fold over the
// stored x captures the deferred d in its kernel; the capture forces d once
// under its own name before the fold, so w reads the snapshot after the write
// to x (the C++ lane did not compile this: BL9002).
let mut x: Array<Float64 like Idx<3>> = [1.0, 2.0, 3.0]
let d = method_for(x) <@> lambda(v) -> v * 2.0
let s = reduce(x, lambda(a, b) -> a + b + d(1), 0.0)
x(0) = 10.0
let w = d(0)
// EXPECT: s = 18.0
// EXPECT: w = 2.0
// EXPECT: d = [2.0, 4.0, 6.0]
