// TEST: A Failing Invariant After An Earlier Failure Point Is Not Hoisted (aborts)
// ABORT: BL8003
// ABORT: reduce: empty array, no reduction possible
// ============================================================================
// G152: per cell, the kernel evaluates its LEFT operand first -- a fold over
// the empty `z` with a user kernel, BL8003 at cell 0 -- and only then the
// invariant `6 / reduce(v, (+))`, which would fail too (v sums to 0, BL8013).
// Hoisting the division ahead of the nest made the program report BL8013
// instead. A value that may fail now moves only when nothing evaluated before
// it may fail first; this one stays in the kernel, and the first failure is
// the per-cell one with the hoist on or off.
type C = Idx<3>
let v: Array<Int64 like C> = [1, -1, 0]
let z = intersect(Int64([1, 2]), Int64([3]))
let h = method_for(v) <@> lambda(e) -> reduce(method_for(z) <@> lambda(x) -> x * e |> compute, lambda(a, b) -> a + b) + 6 / reduce(v, (+)) |> compute
