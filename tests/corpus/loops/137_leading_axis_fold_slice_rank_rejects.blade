// TEST: Leading Axis Fold Slice Rank Mismatch (rejects)
// ERROR: BL3999
// ERROR-CONTAINS: this kernel combines rank-2 slices
// A rank-2 operand's leading-axis slices have rank 1; a kernel demanding
// rank-2 slices names a fold that does not exist for this operand.
let g = (method_for(range<Idx<4>>) <@> lambda(r) ->
          (method_for(range<Idx<3>>) <@> lambda(c) -> 1.0 * r + 1.0 * c)) |> compute
let s = reduce(g, lambda(a: T^2, b: T^2) -> a + b)
