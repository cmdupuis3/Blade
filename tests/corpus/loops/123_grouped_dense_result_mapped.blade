// TEST: Grouped Dense Result Mapped
// ============================================================================
// The consumer half of loops/122, and `examples/lswosa.blade`'s
// `ls_e <@> mag2` shape: a grouped co-iteration produces a DENSE rank-2 grid
// (stage S3), the grid is transposed, and the result is mapped elementwise and
// folded. The whole chain -- group -> dense grid -> transpose -> map -> reduce
// -- is the pin, because each link was blocked by a different thing and they
// only became visible one at a time.
//
// WHAT WAS LIFTED, AND ON WHAT EVIDENCE. The standard-nest gate refused ANY
// operand carrying a ragged- or group-tagged axis, on the stated grounds that
// the nest "knows nothing about per-row lengths ... the placeholder inner
// extent". That reason is about STORAGE, and the two objects it conflates are
// not alike. A real `group_by` result is
//     size_t grouped_extents[2] = {gk__ngroups, 0};   // inner extent is ragged
//     Array<double*, 1> grouped = { new double*[gk__ngroups], grouped_extents };
//     for (__g) grouped[__g] = new double[__sz];      // rows differ in length
// -- a row-pointer table whose inner extent is a literal 0. Iterating it as a
// dense nest really would read that 0 as a bound. The grid THIS file builds is
//     size_t grid_extents[2] = {gk__ngroups, 2};
//     Array<complex<double>, 2> grid = { allocate<...>(grid_extents), ... };
// -- every extent real, every row the same length, one flat pool. The
// `__group_outer` tag on axis 0 records where the axis CAME FROM; it is not a
// claim about storage. So the gate now tests the per-row-VARYING axes
// (ragged-family and group-member) and admits a lone group-outer axis.
//
// THE REFUSAL STILL FIRES for the genuinely grouped shape:
// sql-group-by/020_groupby_elementwise_rejects maps a `group_by` result
// directly and is refused by a DIFFERENT gate (tryRaggedPeel's
// `outputIsGroupShaped` arm, "elementwise map over a group_by result"), which
// this change does not touch. That file staying red-by-design is half of what
// this file asserts; they are the two sides of the same discrimination.
//
// group 0 = rows 0,2 -> a [1,3], b [10,30] -> prodsum = 1*10 + 3*30 = 100
// group 1 = rows 1,3 -> a [2,4], b [20,40] -> prodsum = 2*20 + 4*40 = 200
// grid row k = (fs * prodsum_k, fs); mag2(z) = re^2 + im^2; reduce folds the
// innermost axis, so `s` is one cell per FREQUENCY after the transpose.
// ============================================================================
let region = [0, 1, 0, 1]
let a = [1.0, 2.0, 3.0, 4.0]
let b = [10.0, 20.0, 30.0, 40.0]
let fs: Array<Float64 like Idx<2>> = [1.0, 2.0]

function mag2(z: Complex128) = real(z)^2 + imag(z)^2

let gk = group_keys(region)
let ga = group_by(a, gk)
let gb = group_by(b, gk)

let grid = method_for(zip(ga, gb)) <@> lambda(ra: Array<Float64 like RaggedIdx<_>>, rb: Array<Float64 like RaggedIdx<_>>) -> {
    (fs <@> lambda(x) -> complex(x * prodsum(ra, rb), x)) |> compute
} |> compute

let tg = transpose(grid, [0, 1])
let m = (tg <@> mag2) |> compute
let s = reduce(m, (+))

// EXPECT: grid = [(100, 1), (200, 2), (200, 1), (400, 2)]
// EXPECT: tg = [(100, 1), (200, 1), (200, 2), (400, 2)]
// 100^2+1, 200^2+1, 200^2+4, 400^2+4
// EXPECT: m = [10001, 40001, 40004, 160004]
// EXPECT: s = [50002, 200008]
