// TEST: a fused tree's seed that writes and reads a deferred map runs once
// Gap G277: the seed bumps cnt and reads g(1) (a deferred map forced before the
// fold); its one value 21.0 seeds both leaves.
let mut cnt: Array<Float64 like Idx<1>> = [0.0]
let x: Array<Float64 like Idx<2>> = [1.0, 2.0]
let g = method_for(x) <@> lambda(v) -> v * 10.0
let p = method_for(x) <@> lambda(v) -> v * 2.0
let q = method_for(x) <@> lambda(v) -> v + 1.0
let s = reduce(p <&!> q, (+), { cnt(0) = cnt(0) + 1.0; g(1) + cnt(0) })
// EXPECT: cnt = [1.0]
// EXPECT: g = [10.0, 20.0]
// EXPECT: s = (27.0, 26.0)
