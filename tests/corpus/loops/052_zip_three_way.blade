// TEST: Zip Three-Way
// Three-way zip — co-iteration over three arrays
let A = Float64([1.0, 2.0, 3.0])
let B = Float64([10.0, 20.0, 30.0])
let C = Float64([100.0, 200.0, 300.0])
let L = method_for(zip(A, B, C))
let f = lambda(a, b, c) -> a + b + c
let result = L <@> f |> compute
// EXPECT: result = [111.0, 222.0, 333.0]
