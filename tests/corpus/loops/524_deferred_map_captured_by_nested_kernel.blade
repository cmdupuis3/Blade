// TEST: Deferred Map Captured By Nested Kernel
// The G41 row's nested-kernel probe (Codex review W2F-3 finding 13): a
// deferred map read inside a kernel NESTED in another kernel's fold. The
// outer fold's kernel closes over it, so the fused fold forwards it BY NAME
// at every call; the C++ lane emitted it as a `// <deferred computation>`
// comment and g++ refused the program (BL9002 "'g' was not declared"), and
// inside the kernel's own body a second forcing spelled the producer's
// module-level inputs. Now the fused fold materializes a deferred capture
// before the loop, like an operand, and a function body reads its captures
// as the stored arrays they are.
//   total : a pure deferred map, rank 1 (sum_i sum_j g(j) * i = 3)
//   tsym  : a pure deferred map over a symmetric (comm) array, read through
//           both orientations (1 + 2 + 2 + 3); the walk is regrouped as an
//           orbit-class fold, and gs is printed in every lane (gap G49: the
//           LLVM lane's orbit fold left it off the print list)
//   tw    : the Codex probe -- a WRITING map over the symmetric array; named,
//           so it is evaluated once at its definition over its three stored
//           cells (counter 3; G45) and the walk reads 1 + 2 + 2 + 3
type I = Idx<2>
let x = method_for(range<I>) <@> lambda(i) -> Float64(i) |> compute
let g = method_for(x) <@> lambda(v: Float64) -> v + 1.0
let total = reduce(method_for(range<I>) <@> lambda(i) -> reduce(method_for(range<I>) <@> lambda(j) -> g(j) * Float64(i), (+), 0.0), (+), 0.0)
let g0 = method_for(x, x) <@> lambda(a: Float64, b: Float64) where comm(a, b) -> a + b |> compute
let gs = method_for(g0) <@> lambda(v: Float64) -> v + 1.0
let tsym = reduce(method_for(range<I>) <@> lambda(i) -> reduce(method_for(range<I>) <@> lambda(j) -> gs(i, j), (+), 0.0), (+), 0.0)
let mut G = Float64([0.0])
let gw = method_for(g0) <@> lambda(v: Float64) -> {
    G(0) = G(0) + 1.0
    G(0)
}
let tw = reduce(method_for(range<I>) <@> lambda(i) -> reduce(method_for(range<I>) <@> lambda(j) -> gw(i, j), (+), 0.0), (+), 0.0)
let seen = G(0)
// EXPECT: total = 3.0
// EXPECT: gs = [[1.0, 2.0], [3.0]]
// EXPECT: tsym = 8.0
// EXPECT: tw = 8.0
// EXPECT: seen = 3.0
// EXPECT: G = [3.0]
