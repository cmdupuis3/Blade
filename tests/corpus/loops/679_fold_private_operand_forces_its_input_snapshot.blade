// TEST: Fold Private Operand Forces Its Input Snapshot
// Gap G199 (round 4 wave 7): a fold over q (a deferred map of the deferred
// map p of the deferred map d) evaluates p PRIVATELY, and that evaluation
// forces d under its own name: d holds its cells from the fold on, so the
// later write to x does not change the read z or the print of d. The LLVM
// lane fused the whole chain and reran d after the write (z = 20.0).
let mut x: Array<Float64 like Idx<3>> = [1.0, 2.0, 3.0]
let d = method_for(x) <@> lambda(v) -> v * 2.0
let p = method_for(d) <@> lambda(v) -> v + 1.0
let q = method_for(p) <@> lambda(v) -> v * v
let r = reduce(q, (+), 0.0)
x(0) = 10.0
let z = d(0)
// EXPECT: r = 83.0
// EXPECT: z = 2.0
// EXPECT: d = [2.0, 4.0, 6.0]
