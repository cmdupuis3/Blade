// TEST: a fused tree's shared seed is evaluated once, before the leaves
// Gap G277 (floor round, lane c): reduce(p <&!> q, k, s) has ONE seed and one
// accumulator per leaf. The seed runs once -- here it bumps x(0) once, to 2.0 --
// and both leaves start from its value and fold the written x. Both compiled
// lanes used to spell the seed once per leaf: x = [3.0, 2.0], s = (10.0, 7.0).
// BORROW (2026-11-23): a seed writing x, which the uncomputed leaves read, is refused (BL4005,
// formalism 10.2), so the seed now bumps a counter no leaf reads: n = [1.0] is the one evaluation
// (the old pins folded the written x).
let x: Array<Float64 like Idx<2>> = [1.0, 2.0]
let mut n: Array<Float64 like Idx<1>> = [0.0]
let p = method_for(x) <@> lambda(v) -> v * 2.0
let q = method_for(x) <@> lambda(v) -> v + 1.0
let s = reduce(p <&!> q, (+), { n(0) = n(0) + 1.0; Float64(0) })
// EXPECT: x = [1.0, 2.0]
// EXPECT: n = [1.0]
// EXPECT: s = (6.0, 5.0)
