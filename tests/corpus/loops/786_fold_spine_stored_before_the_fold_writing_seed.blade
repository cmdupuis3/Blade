// TEST: Fold Spine Stored Before The Fold Writing Seed
// Gap G235 (a), round 4 wave 9 (Codex design review): an earlier statement
// already forced the spine p (warm), so p is stored when the fold begins; the
// fold reads the stored p, not a fresh walk over the x the seed writes: 21.0.
let mut x: Array<Float64 like Idx<3>> = [1.0, 2.0, 3.0]
let p = method_for(x) <@> lambda(v) -> v * 2.0
let warm = p(0)
let q = method_for(p) <@> lambda(v) -> v + 1.0
let s = reduce(p, lambda(a, b) -> a + b + Float64(extents(q)), { x(0) = 10.0; Float64(0) })
let w = p(0)
// EXPECT: warm = 2.0
// EXPECT: s = 21.0
// EXPECT: w = 2.0