// TEST: Match Pattern Bound View Write (rejects)
// ----------------------------------------------------------------------------
// Gap G60(a), finding 2's pattern-bound alias: `match pair with | (a, b) -> a`
// binds a to the tuple's first component, a row view of the deferred map m.
// The walk follows a pattern variable to its scrutinee along the pattern's
// path: the write is refused at lowering in every lane (BL4005; the C++ lane
// used to fail at g++, BL9002).
// ----------------------------------------------------------------------------
type Y = Idx<2>
type X = Idx<3>
let m = method_for(range<Y>, range<X>) <@> lambda(i, j) -> Float64(i) * 10.0 + Float64(j)
let pair = (m(0), m(1))
let row = match pair with
    | (a, b) -> a
row(1) = 9.0
let s = reduce(m, (+), axes = 2)
// ERROR: BL4005 @ 14:1
// ERROR-CONTAINS: a write through `m`, a deferred computation
// REJECT-AT: lower
