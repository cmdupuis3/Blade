// TEST: a seed reading a kept leaf that a private operand's capture stores
// Gap G233, round 4 wave 10 (wave-end fable review, MINOR): the leaf p is kept
// because the kernel of r -- the private operand of the leaf q -- captures it,
// and the SEED reads p(0). The compiled lane took the seed-read route, found
// no leaf stored yet (p is stored only when r is evaluated, at the operand
// stage) and refused the program (BL7004); it now falls through to the
// ordinary route: r evaluated privately (forcing p under its own name), the
// seed's reads, then p folded from its snapshot. The interpreter's value, in
// every lane.
let mut x: Array<Float64 like Idx<2>> = [1.0, 2.0]
let p = method_for(x) <@> lambda(v) -> v * 2.0
let r = method_for(x) <@> lambda(v) -> v + p(1)
let q = method_for(r) <@> lambda(v) -> v + 1.0
let s = reduce(p <&!> q, (+), { let t = p(0); x(0) = 10.0; t })
let w = p(0)
// EXPECT: x = [10.0, 2.0]
// EXPECT: p = [2.0, 4.0]
// EXPECT: s = (8.0, 15.0)
// EXPECT: w = 2.0
