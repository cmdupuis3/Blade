// TEST: Block Fold Spine Forced By Capture Writing Seed
// Gap G235 (a), round 4 wave 9: the loops/780 shape inside a top-level block
// (a block of main has the module-level deferred protocol): the captured q
// forces the spine p before the traversal and the fold reads that snapshot
// after the seed writes x: 1 + 12 + 9 = 22.0 (every lane printed 40.0).
let mut x: Array<Float64 like Idx<3>> = [1.0, 2.0, 3.0]
let p = method_for(x) <@> lambda(v) -> v * 2.0
let q = method_for(p) <@> lambda(v) -> v + 1.0
let s = { let z: Float64 = 1.0; reduce(p, lambda(a, b) -> a + b + Float64(extents(q)), { x(0) = 10.0; z }) }
let w = p(0)
// EXPECT: s = 22.0
// EXPECT: w = 2.0