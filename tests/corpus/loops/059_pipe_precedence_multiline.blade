// TEST: Pipe Precedence Multiline
// Multiline combinator chain: operators on new lines trigger implicit continuation
let A = [1.0, 2.0, 3.0]
let B = [4.0, 5.0, 6.0]
let result = method_for(A, B)
    <@> lambda(x, y) -> x + y
    |> compute
// EXPECT: result = [5.0, 6.0, 7.0, 6.0, 7.0, 8.0, 7.0, 8.0, 9.0]
