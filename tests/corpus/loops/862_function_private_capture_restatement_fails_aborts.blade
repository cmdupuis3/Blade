// TEST: a function-body private map re-forced after its input is written (aborts)
// Gap G235 (b), round 4 wave 9 (Codex diff review round 1): the failing twin
// of loops/861. The second statement's capture re-evaluates d over the written
// x (x(0) = 0), so d fails (BL8013) there in every lane; a pool kept from the
// first statement would hide the failure.
let mut x: Array<Int64 like Idx<3>> = [1, 2, 3]
let d = method_for(x) <@> lambda(v) -> 10 / v
function f() -> Int64 = {
    let a = reduce(x, lambda(a, b) -> a + b + extents(d), 0)
    x(0) = 0
    let b = reduce(x, lambda(a, b) -> a + b + d(1), 0)
    a + b
}
let s = f()
