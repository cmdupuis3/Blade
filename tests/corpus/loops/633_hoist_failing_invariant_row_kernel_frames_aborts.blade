// TEST: Hoisted Failing Invariant Of A Row Kernel Keeps Its Frame (aborts)
// ABORT: BL8013
// ABORT: integer division by zero
// ============================================================================
// G151: a rank-raising row kernel is CALLED per row by the compiled lanes.
// Its `let s = 6 / reduce(v, (+))` (v sums to 0) is hoisted out of the row
// map and still fails under the row kernel's frame there.
type R = Idx<3>
type C = Idx<3>
let M: Array<Int64 like R, C> = [[1, 2, 3], [-1, 0, 1], [5, 5, 5]]
let v: Array<Int64 like C> = [1, -1, 0]
let h = method_for(M) <@> lambda(r: Array<Int64 like C>) -> { let s = 6 / reduce(v, (+)); r * s } |> compute
