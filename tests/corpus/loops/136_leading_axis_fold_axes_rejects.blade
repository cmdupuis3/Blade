// TEST: Leading Axis Fold Axes Clash (rejects)
// ERROR: BL3999
// ERROR-CONTAINS: an array-valued kernel folds the LEADING axis
// `axes = n` counts INNERMOST axes; an array-valued kernel folds the LEADING
// axis. The two cannot combine, and silently preferring either reading would
// make the other's programs wrong -- refuse and steer.
let g = (method_for(range<Idx<4>>) <@> lambda(r) ->
          (method_for(range<Idx<3>>) <@> lambda(c) -> Float64(r) + Float64(c))) |> compute
let s = reduce(g, lambda(a: T^1, b: T^1) -> a + b, axes = 1)
