// TEST: Lgamma Before If Force (rejects)
// ----------------------------------------------------------------------------
// Gap G77, the thirteenth Codex look of W4B-A: `lgamma` (and `digamma`) are
// Blade's own series and panic BL8008 outside x > 0 (formalism 2.4), so a
// call to it before the condition's force of g is a possible first failure:
// the C++ pre-pass would force g first, the interpreter reach lgamma first.
// Refused at lowering in every lane (BL6002).
// ----------------------------------------------------------------------------
type Row = Idx<1>
let z: Array<Int64 like Row> = [0]
let g = method_for(z) <@> lambda(v) -> 10 / (v + 1)
let r = {
    let t = lgamma(0.0)
    if g(0) > 0 then Float64(g(0)) + t else t
}
// ERROR: BL6002 @ 11:1
// ERROR-CONTAINS: whose arm forces the deferred computation `g`
// REJECT-AT: lower
