// TEST: Refold After Write Reads The Snapshot
// Gap G199: the first fold over q forces d under its own name (p is
// evaluated privately); after x(1) is written the second fold evaluates p
// again -- over the stored d -- and so does the later read of p.
let mut x: Array<Float64 like Idx<3>> = [1.0, 2.0, 3.0]
let d = method_for(x) <@> lambda(v) -> v * 2.0
let p = method_for(d) <@> lambda(v) -> v + 1.0
let q = method_for(p) <@> lambda(v) -> v * v
let w = reduce(q, (+), 0.0)
x(1) = 50.0
let w2 = reduce(q, (+), 0.0)
let z = p(1)
// EXPECT: w = 83.0
// EXPECT: w2 = 83.0
// EXPECT: z = 5.0
