// TEST: A Fold Reads Its Private Operand Before A Leaf Map That Writes Its Input
// Gap G207 (iii) (round 4 wave 8 lane d; Codex diff review round 4): the
// consuming map writes `d`; the total private operand `e` over `d` is
// evaluated before the traversal in every lane (the LLVM lane used to keep
// it fused and read the written cell): (2 + 1) + (3 + 1) + (4 + 1).
// EXPECT: s = 12
type I = Idx<3>
let mut d: Array<Int64 like I> = [1, 2, 3]
let e = method_for(d) <@> lambda(a) -> a + 1
let s = reduce(method_for(e) <@> lambda(a) -> {
    d((1 : I)) = 9
    a + 1
}, (+), 0)
