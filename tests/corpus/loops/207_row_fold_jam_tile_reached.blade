// TEST: row folds and row-map prodsums at a row count the jammed tile reaches
// tryGenRowFoldJamNest (CodeGenLoopNest.fs) folds R rows per tile, one
// accumulator per row, then runs the leftover rows through a scalar
// remainder. 13 rows: a one-stream fold jams at R = 6 (two tiles, one
// remainder row), a two-stream `zip` prodsum at R = 4 (three tiles, one
// remainder row) -- so every shape below executes BOTH bodies. Values are
// dyadic, so the interpreter differential compares them byte for byte; the
// bitwise claim on full-mantissa operands (vs the un-jammed IIFE text) is the
// measurement recorded at the emitter.
type R = Idx<13>
type C = Idx<5>
let A: Array<Float64 like R, C> = [[0.25, 1.75, 3.25, 4.75, 0.75], [3.75, 5.25, 1.25, 2.75, 4.25], [1.75, 3.25, 4.75, 0.75, 2.25], [5.25, 1.25, 2.75, 4.25, 0.25], [3.25, 4.75, 0.75, 2.25, 3.75], [1.25, 2.75, 4.25, 0.25, 1.75], [4.75, 0.75, 2.25, 3.75, 5.25], [2.75, 4.25, 0.25, 1.75, 3.25], [0.75, 2.25, 3.75, 5.25, 1.25], [4.25, 0.25, 1.75, 3.25, 4.75], [2.25, 3.75, 5.25, 1.25, 2.75], [0.25, 1.75, 3.25, 4.75, 0.75], [3.75, 5.25, 1.25, 2.75, 4.25]]
let B: Array<Float64 like R, C> = [[-0.5, -0.25, 0.0, 0.25, 0.5], [0.75, 1.0, 1.25, 1.5, -0.5], [-0.25, 0.0, 0.25, 0.5, 0.75], [1.0, 1.25, 1.5, -0.5, -0.25], [0.0, 0.25, 0.5, 0.75, 1.0], [1.25, 1.5, -0.5, -0.25, 0.0], [0.25, 0.5, 0.75, 1.0, 1.25], [1.5, -0.5, -0.25, 0.0, 0.25], [0.5, 0.75, 1.0, 1.25, 1.5], [-0.5, -0.25, 0.0, 0.25, 0.5], [0.75, 1.0, 1.25, 1.5, -0.5], [-0.25, 0.0, 0.25, 0.5, 0.75], [1.0, 1.25, 1.5, -0.5, -0.25]]
let Ai: Array<Int64 like R, C> = [[-4, 1, 6, 11, -1], [-1, 4, 9, -3, 2], [2, 7, 12, 0, 5], [5, 10, -2, 3, 8], [8, -4, 1, 6, 11], [11, -1, 4, 9, -3], [-3, 2, 7, 12, 0], [0, 5, 10, -2, 3], [3, 8, -4, 1, 6], [6, 11, -1, 4, 9], [9, -3, 2, 7, 12], [12, 0, 5, 10, -2], [-2, 3, 8, -4, 1]]
let x: Array<Float64 like C> = [1.5, -0.5, 2.0, 0.25, -1.0]
let rows = reduce(A, (+))
let rows_init = reduce(A, (+), 1.5)
let rows_int = reduce(Ai, (+))
let y = method_for(A) <@> lambda(row) -> prodsum(row, x) |> compute
let z = method_for(zip(A, B)) <@> lambda(a, b) -> prodsum(a, b) |> compute
function row_sums(m: T^2) -> T^1 = reduce(m, (+))
let rs = row_sums(B)
// EXPECT: rows = [10.75, 17.25, 12.75, 13.75, 14.75, 10.25, 16.75, 12.25, 13.25, 14.25, 15.25, 10.75, 17.25]
// EXPECT: rows_init = [12.25, 18.75, 14.25, 15.25, 16.25, 11.75, 18.25, 13.75, 14.75, 15.75, 16.75, 12.25, 18.75]
// EXPECT: rows_int = [13, 11, 26, 24, 22, 20, 18, 16, 14, 29, 27, 25, 6]
// EXPECT: y = [6.4375, 1.9375, 8.4375, 13.5625, 0.8125, 7.3125, 6.9375, -0.3125, 7.5625, 5.8125, 9.5625, 6.4375, 1.9375]
// EXPECT: z = [1, 11.625, 2.8125, 8.75, 7, 3.5, 13.5625, 2.75, 14.25, 1, 12.5, 3.6875, 9.75]
// EXPECT: rs = [0, 4, 1.25, 3, 2.5, 2, 3.75, 1, 5, 0, 4, 1.25, 3]
