// TEST: Compute
// BL4010: f deduces comm over (A, A); storage stays DENSE, which is what the
// full 3x3 EXPECT below pins.
// WARN: BL4010
let A = [1.0, 2.0, 3.0]
let L = method_for(A, A)
let f = lambda(x, y) -> x * y
let result = L <@> f |> compute
// result is 3x3 matrix: [[1*1, 1*2, 1*3], [2*1, 2*2, 2*3], [3*1, 3*2, 3*3]]
// EXPECT: result = [1, 2, 3, 2, 4, 6, 3, 6, 9]
