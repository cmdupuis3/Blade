// TEST: Cell Epilogue Keeps The Original Failure Order (aborts)
// Round-2 cell epilogues, B1: the fold's partial is computed early (behind the
// producer's stores), but its SEED and the combine stay at the consumer's own
// site, so a failure between the producer and the fold is still reported
// before a failure in the seed. Here both fail: `bad` divides by zero (BL8013
// "integer division by zero") and the seed `Float64(1 % d)` takes a modulo by
// zero (BL8013 "integer modulo by zero"). The original program reports the
// division; so must every fused form (P1 / Path B chunks: the seed is
// evaluated at the consumer; P2: a non-literal seed declines the epilogue).
// ABORT: integer division by zero
type Ix = Idx<1003>

function kernel(x: Array<Float64 like Ix>, y: Array<Float64 like Ix>, d: Int64) -> Float64 = {
    let y2 = method_for(zip(x, y)) <@> lambda(u, v) where omp(u: 1) -> 1.5 * u + v |> compute
    let bad = 7 / d
    let s = reduce(method_for(y2) <@> lambda(w) -> w * w, lambda(p, q) where omp -> p + q, Float64(1 % d))
    s + Float64(bad)
}

function inputs(m: Int64) -> Array<Float64 like Ix> = {
    method_for(range<Ix>) <@> lambda(i) -> Float64(Int64(i) % m) |> compute
}

let r = kernel(inputs(7), inputs(5), 0)
