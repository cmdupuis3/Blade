// TEST: Loop Object Reuse
let A = [1.0, 2.0, 3.0]
let B = [4.0, 5.0, 6.0]
let L = method_for(A, B)
let sum = lambda(x, y) -> x + y
let prod = lambda(x, y) -> x * y
let sumResult = L <@> sum |> compute
let prodResult = L <@> prod |> compute
// EXPECT: sumResult = [5.0, 6.0, 7.0, 6.0, 7.0, 8.0, 7.0, 8.0, 9.0]
// EXPECT: prodResult = [4.0, 5.0, 6.0, 8.0, 10.0, 12.0, 12.0, 15.0, 18.0]
