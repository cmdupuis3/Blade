// TEST: Fold Private Operand Kept Without Capture
// Gap G214 (round 4 wave 8), the no-capture twin of loops/705: nothing but
// the leaf names the deferred operand d, so the fold evaluates it PRIVATELY
// (blade plan: deferred-capture-force declined) and d stays deferred: the
// read w after the write to x evaluates it again, over the new x.
let mut x: Array<Float64 like Idx<3>> = [1.0, 2.0, 3.0]
let d = method_for(x) <@> lambda(v) -> v * 2.0
let p = method_for(d) <@> lambda(v) -> v + 1.0
let s = reduce(p, (+), 0.0)
x(0) = 10.0
let w = d(0)
// EXPECT: s = 15.0
// EXPECT: w = 20.0
