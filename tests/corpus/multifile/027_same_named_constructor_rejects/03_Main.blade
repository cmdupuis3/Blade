// TEST: Two modules declaring one variant constructor (rejects)
// MODULE: Main
// ERROR: BL2010 @ 12:9
// ERROR-CONTAINS: the imported modules declare more than one -- `A.Red`, `B.Red`
// ============================================================================
// Each module's constructors are its own (D11: A's `Red` is `A.Red`, emitted
// `A__Red`), so A and B may both declare `Red` -- but a bare `Red` in main,
// which imports both and declares none, cannot say which one it means. The
// use is refused, naming the qualified spellings (multifile/029 and /033 show
// the qualified and the type-directed forms).
module Main
import A
import B
let c = Red
