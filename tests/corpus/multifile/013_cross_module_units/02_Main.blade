// TEST: Cross-module unit export
// MODULE: Main
module Main
import Units

/// The imported `newton` really is kg*m/s^2, not an opaque base unit: the
/// product below is only well-typed if the exponent vectors agree.
Unit accel = meter / second^2

let mass: Float64<kilogram> = 2.0
let a: Float64<accel> = 3.0
let force: Float64<newton> = mass * a
let extra: Float64<newton> = 4.0
let total = force + extra
// EXPECT: force = 6.0
// EXPECT: total = 10.0

/// Derived-on-derived: joule = newton*meter crosses the boundary too.
let d: Float64<meter> = 5.0
let work: Float64<joule> = force * d
// EXPECT: work = 30.0

/// A reciprocal unit, and the dimensionless product that proves it.
let f: Float64<hertz> = 2.0
let t: Float64<second> = 3.0
let cycles = f * t
// EXPECT: cycles = 6.0
