// TEST: An imported compound read inside a random fill's key keeps its kept positions
// MODULE: Data
// The importing module reads `Data.y(0)` inside `r.uniform`'s KEY, which
// lives in a side table (the binding's value is a placeholder). The foreign
// demand Data's census receives is collected by the same module traversal the
// census walks, side-table operands included (W1-4 review finding 1), so the
// table is built and the keyed read binary-searches it (12345 at position 0).
module Data

let x = [12345, -3, 4]
let keep = mask(x, lambda(v) -> v > 0)
let y = compound(x, keep)
let ysum = reduce(y, (+))