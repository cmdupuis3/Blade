// TEST: Two modules each declaring struct P and constructor Red link
// MODULE: A
module A
struct P { x: Float64 }
type Color = Red | Green
function mk(v: Float64) -> P = P { x = v }
function fx(p: P) -> Float64 = p.x
function isRed(c: Color) -> Bool = match c with
    | Red -> true
    | Green -> false
