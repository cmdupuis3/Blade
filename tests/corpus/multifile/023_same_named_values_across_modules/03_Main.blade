// TEST: Same-named values across modules and main
// MODULE: Main
// ============================================================================
// Modules were not namespaced in the one C++ translation unit every program
// compiles to: `Util.scale + Util2.scale` passed the checker and died in g++
// as "redeclaration of double scale", and so did a main-module `scale` beside
// an imported one. Worse was the silent case: inside a main function whose
// PARAMETER is named `scale`, the imported global `scale` was shadowed, so
// `Util.scale` read the parameter. A non-main module's members are now
// qualified (`Util.scale`, emitted `Util__scale`), and they print under that
// name too.
module Main
import Util
import Util2

let c = Util.scale + Util2.scale
// EXPECT: c = 9.0

let scale = 5.0
let d = Util.scale + scale
// EXPECT: d = 7.0

function f(scale: Float64) -> Float64 = scale + Util.scale
let e = f(1.0)
// EXPECT: e = 3.0

// The imported bindings print qualified, so they never collide with main's.
// EXPECT: Util.scale = 2.0
// EXPECT: Util2.scale = 7.0
// EXPECT: scale = 5.0
