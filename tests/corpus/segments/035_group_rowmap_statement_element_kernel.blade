// TEST: Group Row Map With A Statement-Shaped Element Kernel
// G90: an ELEMENT kernel whose body builds and folds a local map (a block, not
// an expression) runs as a call of its lifted callable per cell, which owns
// and frees its local array: h(e) = (e + 0) + (e + 1) = 2e + 1.
type I = Idx<7>
type CI = Chunked<I, 3>
type K = Idx<2>
let a: Array<Float64 like I> = Float64(0..7) |> compute
let seg = segments(CI)
let g = group_by(a, seg)
let h = method_for(g) <@> lambda(e: Float64) -> {
    let t = method_for(range<K>) <@> lambda(k) -> e + Float64(k) |> compute
    reduce(t, (+))
} |> compute
let b = ungroup(h, CI)
// EXPECT: b = [1.0, 3.0, 5.0, 7.0, 9.0, 11.0, 13.0]
