// TEST: Group Row Map Returning Another Row (rejects)
// ERROR: BL3027
// G90: a per-group map keeps the member axis only when its result is as long
// as its group. `g(0)` is a row of the SAME grouping -- its type carries the
// same member axis -- but it is group 0's row in every group, so the type
// checker's closed grammar (an element kernel, or the row as an elementwise
// expression of itself and scalars) refuses it, instead of reassembling runs
// of the wrong length.
type I = Idx<7>
type CI = Chunked<I, 3>
let a: Array<Float64 like I> = Float64(0..7) |> compute
let seg = segments(CI)
let g = group_by(a, seg)
let h = method_for(g) <@> lambda(r) -> g(0) * 2.0 |> compute
