// TEST: A Write Hidden In An Extent Keeps The Structural Group's Snapshot
// The write to the source hides in a TYPE: m's range bound `0..bump(a)`
// calls a function that writes `a(0) = 100` through its `mut` parameter
// (gap G89). The never-written closure reads the extents a statement's types
// carry, so the view declines and g keeps the values it grouped.
function bump(v: mut Array<Int64 like Idx<6>>) -> Int64 = {
    v(0) = 100
    3
}
type I = Idx<6>
type CI = Chunked<I, 4>
let mut a: Array<Int64 like I> = [1, 2, 3, 4, 5, 6]
let seg = segments(CI)
let g = group_by(a, seg)
let m = method_for(0..bump(a)) <@> lambda(v) -> v + 1 |> compute
let sums = method_for(g) <@> lambda(r) -> reduce(r, (+)) |> compute
// EXPECT: sums = [10, 11]
// EXPECT: a = [100, 2, 3, 4, 5, 6]
// EXPECT: m = [1, 2, 3]