// TEST: Group Row Map Per-Group Normalization
// G90: the feature's motivating shape -- each run centred on its own mean,
// a ROW kernel (`r` is the group's row) whose result is an elementwise
// expression of the row and scalars (a fold, a count, a captured scale), so
// the type checker proves it as long as its group. Runs [0,3) [3,6) [6,9)
// [9,11) of 0, 2, 4, ...: means 2, 8, 14, 19 (exact, so the pins are exact).
type I = Idx<11>
type CI = Chunked<I, 3>
let a: Array<Float64 like I> = Float64(0..11) * 2.0 |> compute
let scale: Float64 = 3.0
let seg = segments(CI)
let g = group_by(a, seg)
let h = method_for(g) <@> lambda(r) -> (r - reduce(r, (+)) / Float64(extents(r))) * scale |> compute
let b = ungroup(h, CI)
// EXPECT: b = [-6.0, 0.0, 6.0, -6.0, 0.0, 6.0, -6.0, 0.0, 6.0, -3.0, 3.0]
let row_sums = method_for(h) <@> lambda(r) -> reduce(r, (+)) |> compute
// EXPECT: row_sums = [0.0, 0.0, 0.0, 0.0]
