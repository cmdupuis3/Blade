// TEST: Group Row Map Of A Group Row Map
// G90: a per-group map's result keeps its grouping, so a second per-group
// map reads it like a group_by result (transitively derived outer slot), and
// `ungroup(h2)` restores the axis. group-rowmap v1 shares only one level (the
// second map's operand is not a group_by binding): its ungroup copies.
type I = Idx<8>
type CI = Chunked<I, 3>
let a: Array<Int64 like I> = [1, 2, 3, 4, 5, 6, 7, 8]
let seg = segments(CI)
let g = group_by(a, seg)
let h = method_for(g) <@> lambda(r) -> r - reduce(r, (+)) |> compute
let h2 = method_for(h) <@> lambda(e) -> e * 10 |> compute
let b = ungroup(h2)
// EXPECT: h = [[-5, -4, -3], [-11, -10, -9], [-8, -7]]
// EXPECT: b = [-50, -40, -30, -110, -100, -90, -80, -70]
