// TEST: Closed-Form Domain: A Materialized Band Fills By The Nest, Reads By Key
// `|> compute` materializes the domain: the fill DRIVES the affine nest (the
// cell counter is the storage offset, no unhash per cell), and the array
// keeps a sparse key view of the same lex enumeration for keyed reads
// `R((i, j))`. A non-commutative fold over it pins the storage order: lex,
// row by row, j ascending inside the band -- the order the streamed fold of
// the same map visits, so the two folds agree.
let static n = 9
let static w = 2

static struct Band {
    i: Int<min=0, max=n-1>,
    j: Int<min=0, max=n-1>
} where abs(i - j) <= w

let R = method_for(range<Band>) <@> lambda(i, j) -> i * 10 + j |> compute
let total = reduce(R, (+))
// EXPECT: total = 1716
let ord = reduce(R, lambda(a, b) -> (a * 3 + b) % 1000003, 0)
// EXPECT: ord = 217095
let streamed = reduce(method_for(range<Band>) <@> lambda(i, j) -> i * 10 + j, lambda(a, b) -> (a * 3 + b) % 1000003, 0)
// EXPECT: streamed = 217095
let corner = R((8, 6))
// EXPECT: corner = 86
let diag = R((4, 4))
// EXPECT: diag = 44
let edge = R((0, 2))
// EXPECT: edge = 2
