// TEST: Closed-Form Domain: A Band Fold Streams The Affine Nest
// The style guide's spelling, verbatim: `Int<min=0, max=n-1>` fields with a
// `let static` extent and half-width (a static integer in a conjunct is the
// literal it folds to, so the Int32 fields meet no Int64 operand), and a fold
// written straight over the map. The fold never builds an array or a key
// table: `blade plan` reports `[domain-enum v1] ... closed-form affine nest
// (2 level(s): i in [0, 12], j in [max(0, i - 3), min(12, i + 3)]) ...
// consumer: streamed fold`, and the C++ is two nested `for`s whose inner
// bounds are affine in i -- the Fortran `do j = max(1, i-w), min(n, i+w)`.
// Cells visited: n(2w+1) - w(w+1) = 13*7 - 12 = 79, never the 169-cell box.
let static n = 13
let static w = 3
type Pts = Idx<n>

static struct Band {
    i: Int<min=0, max=n-1>,
    j: Int<min=0, max=n-1>
} where abs(i - j) <= w

let x = 0.5 + 0.25 * Float64(0..n)
let static CARD = idx_card(Band)
// EXPECT: CARD = 79
let cells = reduce(method_for(range<Band>) <@> lambda(i, j) -> 1, (+))
// EXPECT: cells = 79
let weighted = reduce(method_for(range<Band>) <@> lambda(i, j) -> x((i : Pts)) * x((j : Pts)) / Float64(1 + abs(i - j)), (+))
// EXPECT: weighted = 175.458333333333
let lexsum = reduce(method_for(range<Band>) <@> lambda(i, j) -> i * 100 + j, (+))
// EXPECT: lexsum = 47874
