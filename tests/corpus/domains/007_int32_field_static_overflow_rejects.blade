// TEST: Closed-Form Domain: A Static Bound Past Int32 Needs An Int64 Field (rejects)
// ERROR: BL4001
// ERROR-CONTAINS: does not fit the Int32 field type
// A `let static` integer in a conjunct is typed as the literal it folds to,
// so `Int<min=0, max=n-1>` (Int32 fields) accepts a static n -- but the
// conversion is CHECKED: 3,000,000,000 does not fit Int32, so the
// declaration is refused (BL4001) with the fix -- `Int64<min=0, max=big>`
// fields. The follow-on BL3028 at `range<Wide>` is the struct's absence.
let static big = 3000000000

static struct Wide {
    i: Int<min=0, max=big>,
    j: Int<min=0, max=4>
} where i - j <= 2

let R = method_for(range<Wide>) <@> lambda(i, j) -> i + j |> compute
