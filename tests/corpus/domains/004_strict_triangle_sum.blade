// TEST: Closed-Form Domain: The Strict Triangle i < j
// `i < j` is one difference constraint (`i - j <= -1`): Fourier-Motzkin
// projection gives the outer field the range [0, n - 2] (row n - 1 has no
// completion) and the inner one [i + 1, n - 1] -- the strict simplex,
// n(n-1)/2 cells, as an affine nest over field VALUES (not the packed
// storage coordinates `range<AntisymIdx>` hands its kernel).
let static n: Int64 = 17
type P = Idx<n>

static struct Pair {
    i: Int32<min=0, max=n-1>,
    j: Int32<min=0, max=n-1>
} where i < j

let a = 1.0 + 0.5 * Float64(0..n)
let static CARD = idx_card(Pair)
// EXPECT: CARD = 136
let pairs = reduce(method_for(range<Pair>) <@> lambda(i, j) -> Int64(1), (+))
// EXPECT: pairs = 136
let cross = reduce(method_for(range<Pair>) <@> lambda(i, j) -> a((i : P)) * a((j : P)), (+))
// EXPECT: cross = 3349.0
let gaps = reduce(method_for(range<Pair>) <@> lambda(i, j) -> j - i, (+))
// EXPECT: gaps = 816
let T = method_for(range<Pair>) <@> lambda(i, j) -> i * 100 + j |> compute
let first = T((0, 1))
// EXPECT: first = 1
let last = T((15, 16))
// EXPECT: last = 1516
