// TEST: Closed-Form Domain: A Licensed Fold Kernel Vectorizes The Inner Field
// A `where omp` fold kernel licenses reordering the sum; over a closed-form
// domain the C++ lane spends it as `omp simd reduction` on the INNERMOST
// field's run (contiguous, affine-bounded), the outer field staying a plain
// loop -- the affine nest carries no counter on this path, which keeps the
// inner loop in OpenMP canonical form. The value is pinned at the suite's
// 1e-9 relative tolerance, so it reads the same under any association.
let static n = 101
let static w = 4
type Pts = Idx<n>

static struct Band {
    i: Int<min=0, max=n-1>,
    j: Int<min=0, max=n-1>
} where abs(i - j) <= w

let x = 1.0 + 0.001 * Float64(0..n)
let s = reduce(method_for(range<Band>) <@> lambda(i, j) -> x((i : Pts)) * x((j : Pts)), lambda(p, q) where omp -> p + q, 0.0)
// EXPECT: s = 980.84418
