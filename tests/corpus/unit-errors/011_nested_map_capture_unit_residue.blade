Unit second
Unit day = 86400 * second
let ts: Array<Float<day> like Idx<3>> = [1.0, 2.0, 3.0]
let fs: Array<Float<1/day> like Idx<2>> = [1.0, 2.0]
let out = fs <@> lambda(f) -> {
    let w = 2.0 * f
    let sn = (ts <@> lambda(t) -> sin(w * t * t)) |> compute
    reduce(sn, (+))
} |> compute
