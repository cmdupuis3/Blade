// TEST: Kernel Param Unit Alone Still Rejects
// ERROR: BL3006
// Guard for the #4 fix's deferral: a dimensioned kernel param with a
// DIMENSIONLESS capture leaves a 1/day residue on the cos argument, and the
// apply-site second pass must keep rejecting it exactly as before.
Unit second
Unit day = 86400 * second
let ws: Array<Float<1/day> like Idx<3>> = [1.0, 2.0, 3.0]
let c: Float64 = 2.0
let out = (ws <@> lambda(w) -> cos(w * c)) |> compute
