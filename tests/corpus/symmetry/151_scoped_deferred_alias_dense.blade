// TEST: Block And Function-Body Deferred Aliases Stay Dense (P0 Before-Case)
// P0 BEFORE-CASE (docs/plans/plan-identity-transpose-compute.md 2.1, 6 P0;
// formalism 10.2). Only a TOP-LEVEL alias of a pure deferred map joins its
// alias class (symmetry/146). An alias bound inside a block (`let b = g`) is
// a local assignable COPY -- binding it is a forcing use of g -- so
// `method_for(g, b)` holds two arrays and stays DENSE. A function body that
// names the module alias g2 is also kept dense: the identity rule is applied
// only at module level (fail closed; the body forces g and g2 privately). A
// WRITING map is computed at its definition (G45) and is no class root, so
// its alias is a copy and dense too. Later P1 steps may change the block and
// body cases; the writing-map case is a copy by contract. (The module-level
// read `first` is load-bearing for the C++ lane: a module alias read ONLY by
// a function body is BL9002 on master 94487a90, `g2` undeclared -- a
// pre-existing hole, not this test's subject.)
type I = Idx<3>
let x: Array<Float64 like I> = [1.0, 2.0, 3.0]
let g = method_for(x) <@> lambda(v) -> v * 2.0
let g2 = g
let first = g2((0 : I))
let blk = {
    let b = g
    method_for(g, b) <@> lambda(a, c) where comm(a, c) -> a * c |> compute
}
function body() = method_for(g, g2) <@> lambda(a, b) where comm(a, b) -> a * b |> compute
let fn = body()
let mut G = Int64([0])
let w = method_for(x) <@> lambda(v) -> { G(0) = G(0) + 1; v * 2.0 }
let w2 = w
let Pw = method_for(w, w2) <@> lambda(a, b) where comm(a, b) -> a * b |> compute
// EXPECT: first = 2.0
// EXPECT: blk =[[4.0, 8.0, 12.0], [8.0, 16.0, 24.0], [12.0, 24.0, 36.0]]
// EXPECT: fn = [[4.0, 8.0, 12.0], [8.0, 16.0, 24.0], [12.0, 24.0, 36.0]]
// EXPECT: Pw = [[4.0, 8.0, 12.0], [8.0, 16.0, 24.0], [12.0, 24.0, 36.0]]
// EXPECT: G = [3]
