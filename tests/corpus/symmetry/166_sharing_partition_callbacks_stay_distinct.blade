// TEST: Calls Through Callbacks And Recursive Helpers Keep The All-Distinct Partition
// docs/plans/plan-identity-transpose-compute.md section 2.2 (wave 2): the
// sharing partition is decided only where the callee is a RESOLVED,
// specializable declaration. A call through a callable PARAMETER
// (`via(k, x) = k(x, x)`) hides which declaration runs, so `via(f, A)` fails
// closed to today's all-distinct elaboration -- dense, even though one array
// fills both positions. A RECURSIVE identity-sensitive declaration is not
// specialized either (`blade plan`: `[sharing-partition v1] r: declined -- a
// recursive declaration`); its comm fold reads the same value either way.
type I = Idx<3>
let A: Array<Float64 like I> = [1.0, 2.0, 3.0]
function f(x: T^1, y: T^1) where comm(x, y) =
    method_for(x, y) <@> lambda(a, b) where comm(a, b) -> a * b |> compute
function via(k: (Float64^1, Float64^1) -> Float64^2, x: Float64^1) = k(x, x)
function r(x: T^1, y: T^1, n: Int64) -> T^0 =
    if n <= 0 then reduce(method_for(x, y) <@> lambda(a, b) where comm(a, b) -> a * b, (+), axes = 2) else r(x, y, n - 1)
let VA = via(f, A)
let RA = r(A, A, 2)
// EXPECT: VA = [[1.0, 2.0, 3.0], [2.0, 4.0, 6.0], [3.0, 6.0, 9.0]]
// EXPECT: RA = 36.0
