// TEST: Row-owned pull scatter: the intervening writer declines, a parameter pool is audited
// The pull form's five-party audit (Blade.Optimize.planOrbitPull + the
// emitter's callback-aware check). s3: `z = bump(u)` WRITES a cell of the pool
// between its materialization and the fold -- an intervening writer, so the
// pull declines (`blade plan`: `declined -- row-owned pull scatter not taken:
// `...` may write between ...`) and the walk's other strict forms run; every
// form reads the written cell (2.5 at (0, 1, 2)), as written. s4: the pool is
// a PARAMETER of `chk` (materialized by the caller: no producer in the
// function's scope, every statement of the body before the fold is
// intervening); the audit admits it and a threaded strict build pulls. The
// pins hold with BLADE_ORBIT_PULL on and off, under REPRO at every team size.
let static p = 97
type Var = Idx<p>
type Obs = Idx<2>
function radd(a: Float64, b: Float64) where repro -> Float64 = a + b
function bump(a: mut Array<Float64 like SymIdx<3, Var>>) -> Int64 = {
    a(0, 1, 2) = 2.5
    7
}
function chk(t: Array<Float64 like SymIdx<3, Var>>) -> Float64 = {
    let s = reduce(method_for(range<Var>) <@> lambda(i) -> reduce(method_for(range<Var>) <@> lambda(j) -> reduce(method_for(range<Var>) <@> lambda(k) -> abs(t(i, j, k)) - 0.25, radd, 0.5), (+)), lambda(u, v) where omp -> u + v, -0.0)
    s
}
let (s3, z, s4) = {
    let y = method_for(range<Var>, range<Obs>) <@> lambda(i, s) -> Float64((i * 5 + s * 2) % 9) * 0.29 - 0.7 / Float64(i + 2) |> compute
    let mut u = method_for(y, y, y) <@> lambda(a: Array<Float64 like Obs>, b: Array<Float64 like Obs>, c: Array<Float64 like Obs>) where comm(a, b, c) -> prodsum(a, b, c) |> compute
    let z = bump(u)
    let s3 = reduce(method_for(range<Var>) <@> lambda(i) -> reduce(method_for(range<Var>) <@> lambda(j) -> reduce(method_for(range<Var>) <@> lambda(k) -> u(i, j, k) * u(i, j, k), (+)), radd, 0.25), lambda(a, b) where omp -> a + b, 0.0)
    let s4 = chk(u)
    (s3, z, s4)
}
// EXPECT: s3 = 14833419.465158
// EXPECT: z = 7
// EXPECT: s4 = 2402256.08077923
