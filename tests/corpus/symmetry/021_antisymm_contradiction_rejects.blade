// TEST: Antisymm Contradiction (rejects)
// ERROR: BL4013
// The signed mirror of functions/028: `where anticomm(x, y)` declared on a
// body the deduction proves COMMUTATIVE under the swap (x * y). Strict-simplex
// storage would drop a diagonal that is genuinely nonzero (x*x) and hand back
// the negation for every mirrored read, so this is the same silent-corruption
// class the comm validator rejects, with the parities exchanged. PBottom
// bodies stay trusted — only the provable contradiction rejects.
let A = [1.0, 2.0, 3.0]
let bad = method_for(A, A) <@> lambda(x, y) where anticomm(x, y) -> x * y |> compute
