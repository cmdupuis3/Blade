// TEST: Orbit-class fold over rank-3 pools, weights 1 / 3 / 6
// SymIdx<3, p>: a canonical triple i <= j <= k stands for 1 logical cell when
// i = j = k, 3 when exactly two are equal, 6 when all differ; the three class
// sums combine by additions only, ((S1 + ((S3 + S3) + S3)) + (3 S6 + 3 S6))
// (src/OrbitFold.fs). The read may name the coordinates in any order
// (t(k, i, j)), and p = 2 has no all-distinct triple at all. A strict
// AntisymIdx<3> pool: 3 even orderings read +x and 3 odd ones -x, and the
// p^3 - 3! C(p, 3) cells with a repeated index read +0. Integer-valued cells.
let static p: Int64 = 7
let static n: Int64 = 4
type Var = Idx<p>
type Obs = Idx<n>
let x = method_for(range<Var>, range<Obs>) <@> lambda(i, s) -> Float64((i * 3 + s * 5) % 7) - 2.0 |> compute
let t = method_for(x, x, x) <@> lambda(a: Array<Float64 like Obs>, b: Array<Float64 like Obs>, c: Array<Float64 like Obs>) where comm(a, b, c) -> prodsum(a, b, c) |> compute
let ss = reduce(method_for(range<Var>) <@> lambda(i) -> reduce(method_for(range<Var>) <@> lambda(j) -> reduce(method_for(range<Var>) <@> lambda(k) -> t(i, j, k) * t(i, j, k), (+)), (+)), lambda(u, v) where omp -> u + v, 0.0)
let shifted = reduce(method_for(range<Var>) <@> lambda(i) -> reduce(method_for(range<Var>) <@> lambda(j) -> reduce(method_for(range<Var>) <@> lambda(k) -> t(k, i, j) + 1.0, (+)), (+)), (+))
let via_axes = reduce(t, (+), axes = 3)
type Two = Idx<2>
let y = method_for(range<Two>, range<Obs>) <@> lambda(i, s) -> Float64(i * 2 + s) - 1.0 |> compute
let u = method_for(y, y, y) <@> lambda(a: Array<Float64 like Obs>, b: Array<Float64 like Obs>, c: Array<Float64 like Obs>) where comm(a, b, c) -> prodsum(a, b, c) |> compute
let small = reduce(u, (+), axes = 3)
type I = Idx<4>
let B: Array<Float64 like I> = [1.0, 2.0, 4.0, 7.0]
let R3 = method_for(B, B, B) <@> lambda(a, b, c) where anticomm(a, b, c) -> (a - b) * (b - c) * (a - c) |> compute
let r3sq = reduce(method_for(range<I>) <@> lambda(i) -> reduce(method_for(range<I>) <@> lambda(j) -> reduce(method_for(range<I>) <@> lambda(k) -> R3(i, j, k) * R3(i, j, k) + 1.0, (+)), (+)), (+))
let r3sum = reduce(R3, (+), axes = 3)
// EXPECT: ss = 175616.0
// EXPECT: shifted = 1715.0
// EXPECT: via_axes = 1372.0
// EXPECT: small = 288.0
// 6 * (36 + 900 + 2916 + 900) = 28512 from the strict cells, + 64 ones.
// EXPECT: r3sq = 28576.0
// EXPECT: r3sum = 0.0
