// TEST: Two-Parameter Comm Helper Called On One Array Packs (P0 Before-Case, Plan 2.2)
// P0 BEFORE-CASE (docs/plans/plan-identity-transpose-compute.md section 0
// probe, 6 P0; review 2026-10-24 section 0), UPDATED by plan section 2.2
// (wave 2, P1 parameters: sharing-partition specialization). Extracting a
// comm outer product into a TWO-parameter helper used to lose the identity
// group: `f(A, A)` and `f(A, B)` shared ONE instance (IRMono.canonTypeKey
// ignores identity), both DENSE. Now f is identity-sensitive and specialized
// on the sharing partition of its arguments: `f(A, A)` is the instance over
// [0,0], packed exactly as the one-parameter helper `h(A)` --
// `method_for(x, x)` -- is (`PAA` was the dense 3x3 before wave 2). `PAB`
// packs too: a NEVER-WRITTEN stored copy `let B = A` is the same array
// (section 2.1, second step), so `f(A, B)` is the [0,0] instance as well.
type I = Idx<3>
let A: Array<Float64 like I> = [1.0, 2.0, 3.0]
let B = A
function f(x: T^1, y: T^1) where comm(x, y) =
    method_for(x, y) <@> lambda(a, b) where comm(a, b) -> a * b |> compute
function h(x: T^1) =
    method_for(x, x) <@> lambda(a, b) where comm(a, b) -> a * b |> compute
let PAA = f(A, A)
let PAB = f(A, B)
let HA = h(A)
// EXPECT: PAA = [[1.0, 2.0, 3.0], [4.0, 6.0], [9.0]]
// EXPECT: PAB = [[1.0, 2.0, 3.0], [4.0, 6.0], [9.0]]
// EXPECT: HA = [[1.0, 2.0, 3.0], [4.0, 6.0], [9.0]]
