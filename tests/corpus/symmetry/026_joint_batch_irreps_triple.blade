// TEST: Joint Product Symmetry: batch x IrrepsIdx, Three-Way
// ============================================================================
// 013's three-copy drill on a mixed plain x IrrepsIdx array (stage 4). Three
// copies of a 2 x IrrepsIdx<total_dim 2> feature matrix under a fully
// commutative kernel: joint SymIdx<3, 4> over the compound space (flat
// a = [1,2,3,4]); speedup 3! = 6, NOT (3!)^2 = 36 — per-dimension partnering
// stays refuted (per_dim_swap_not_symmetry) whatever the axes' index kinds are.
// C(4+3-1, 3) = C(6,3) = 20 canonical triples p1 <= p2 <= p3, lex order.
//
// spec = [(0,0,2)]: two l=0 blocks, total_dim = 2*1 = 2.
// ============================================================================
let static spec2 = [(0, 0, 2)]
let A: Array<Float64 like Idx<2>, IrrepsIdx<spec2>> = [[1.0, 2.0], [3.0, 4.0]]
let L = method_for(A, A, A)
let f = lambda(x, y, z) where comm(x, y, z) -> x * y * z
let result = L <@> f |> compute
// (000)1 (001)2 (002)3 (003)4 (011)4 (012)6 (013)8 (022)9 (023)12 (033)16
// (111)8 (112)12 (113)16 (122)18 (123)24 (133)32 (222)27 (223)36 (233)48 (333)64
// EXPECT: result = [1.0, 2.0, 3.0, 4.0, 4.0, 6.0, 8.0, 9.0, 12.0, 16.0, 8.0, 12.0, 16.0, 18.0, 24.0, 32.0, 27.0, 36.0, 48.0, 64.0]

// Twin: the flattened plain-Idx<4> computation. The fused compound axis IS this
// index space, so the two pins are the same list — byte for byte with 013's.
let Aflat: Array<Float64 like Idx<4>> = [1.0, 2.0, 3.0, 4.0]
let flat_sym = method_for(Aflat, Aflat, Aflat) <@> f |> compute
// EXPECT: flat_sym = [1.0, 2.0, 3.0, 4.0, 4.0, 6.0, 8.0, 9.0, 12.0, 16.0, 8.0, 12.0, 16.0, 18.0, 24.0, 32.0, 27.0, 36.0, 48.0, 64.0]

// Cell agreement against the dense 4x4x4 route, via a rank-2 dense stand-in for
// the pair part: the triple cell (1,2,3) is a[1]*a[2]*a[3] = 24, and every
// permutation of it folds to that one stored cell.
let c123 = result(1, 2, 3)
let c321 = result(3, 2, 1)
let c231 = result(2, 3, 1)
let cdiag = result(2, 2, 2)
// EXPECT: c123 = 24.0
// EXPECT: c321 = 24.0
// EXPECT: c231 = 24.0
// EXPECT: cdiag = 27.0
