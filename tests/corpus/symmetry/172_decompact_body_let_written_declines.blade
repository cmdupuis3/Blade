// TEST: Decompact Function Body Let Written Before The Host
// ============================================================================
// G167 (round 4 wave 6): a body-let pool WRITTEN between its let and the host
// (here through a `mut` parameter of a callee) is not read in place -- the
// interval audit (scheduleMayWriteIn) declines it and the decompaction reads
// the written cell, exactly as written. (The LLVM lane refuses the compact
// element write; the program runs in C++.)
// ============================================================================
type I = Idx<5>
let x = Float64(range<I>)
let S = method_for(x, x) <@> lambda(a, b) where comm(a, b) -> a * b + 1.0 |> compute

function poke(A: mut Array<Float64 like SymIdx<2, I>>) -> Float64 = {
    A(0, 0) = 100.0
    1.0
}
function written(Q: Array<Float64 like SymIdx<2, I>>) -> Array<Float64 like I> = {
    let mut P = Q * 2.0 |> compute
    let z = poke(P)
    reduce(decompact(P, 0), (+), 0.0)
}

// row 0 of 2 S is [2, 2, 2, 2, 2]: with P(0, 0) = 100 it sums to 108
let a4 = written(S)
// EXPECT: a4 = [108.0, 30.0, 50.0, 70.0, 90.0]
