// TEST: Output Type: Distinct Comm Groups
// Two distinct comm groups
let A = [1.0, 2.0, 3.0]
let B = [4.0, 5.0, 6.0]
let L = method_for(A, A, B, B)
let f = lambda(x, y, z, w) where comm(x, y), comm(z, w) -> x * y * z * w
let result = L <@> f |> compute
// SymIdx<2, 3> for A,A; SymIdx<2, 3> for B,B — two independent triangular pairs
// EXPECT: result = [16.0, 20.0, 24.0, 25.0, 30.0, 36.0, 32.0, 40.0, 48.0, 50.0, 60.0, 72.0, 48.0, 60.0, 72.0, 75.0, 90.0, 108.0, 64.0, 80.0, 96.0, 100.0, 120.0, 144.0, 96.0, 120.0, 144.0, 150.0, 180.0, 216.0, 144.0, 180.0, 216.0, 225.0, 270.0, 324.0]
