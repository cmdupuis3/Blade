// TEST: a declared comm on a float kernel serves permuted reads from the canonical evaluation
// THIS IS A LICENCE, NOT A BUG (formalism 5.2, "Symmetry deduction is
// exact-ring algebra"). `x + y + z` is commutative in the exact ring, so the
// declared comm(x, y, z) stands and the output is stored as a simplex: ONE
// evaluation per canonical (sorted) index tuple, which answers every
// permutation of it. Float `+` is not associative, so evaluating the body in
// a permuted order can differ: at (1, 2, 0) the body itself computes
// (1e16 + -1e16) + 1.0 = 1.0, while the stored canonical cell (0, 1, 2)
// computed (1.0 + 1e16) + -1e16 = 0.0 and serves both reads. Without the
// `where` clause no compact storage happens (dense, 1.0 at (1, 2, 0)), so
// the declaration is the licence -- as BLADE_FP_REASSOC licenses a
// reassociated fold.
let A = [1.0, 1.0e16, -1.0e16]
let R = method_for(A, A, A) <@> lambda(x, y, z) where comm(x, y, z) -> x + y + z |> compute
let canonical = R(0, 1, 2)
let permuted = R(1, 2, 0)
let body_in_permuted_order = 1.0e16 + -1.0e16 + 1.0
// EXPECT: canonical = 0.0
// EXPECT: permuted = 0.0
// EXPECT: body_in_permuted_order = 1.0
