// TEST: Compact row classes: a seed writing the producer the fold reads (rejects)
// Split from symmetry/131 (borrow round, 2026-11-23). The fold's cell body reads kw through an
// uncomputed map; the seed `poke(kw)` writes a cell of kw through a `mut` parameter while that map
// is still used by the traversal. Before the borrow rule the row-class schedule declined and the
// fold saw the written cell in source order (sw = 2002.0); the write is now refused (BL4005,
// formalism 10.2).
type Pts = Idx<19>
type Dim = Idx<2>
let pts = method_for(range<Pts>, range<Dim>) <@> lambda(i, d) -> Float64((Int64(i) * 5 + Int64(d) * 3) % 7) - 3.0 |> compute
let mut kw = method_for(pts, pts) <@> lambda(a: Array<Float64 like Dim>, b: Array<Float64 like Dim>) where comm(a, b) -> a((0 : Dim)) + b((0 : Dim)) |> compute
function poke(a: mut Array<Float64 like SymIdx<2, Pts>>) -> Float64 = {
    a(0, 1) = 1000.0
    0.0
}
let sw = reduce(method_for(range<Pts>) <@> lambda(i) -> reduce(method_for(range<Pts>) <@> lambda(j) -> kw(i, j), (+)), (+), poke(kw))
// ERROR: BL4005 @ 14:1
