// TEST: a non-adjacent repeat under comm stays dense in operand order
// WARN: BL4010
// Formalism 8.3: identity groups are runs of NEIGHBOURING identical
// arguments, so `(A, B, A)` is three singleton groups and `comm(x, y, z)`
// licenses nothing here. The result is the dense outer product in OPERAND
// order: result(i, j, k) = f(A_i, B_j, A_k). Until 2026-10-12 the compiler
// regrouped the repeats by name, emitted the nest (A, A, B), typed the result
// in that order, and `result(0, 1, 2)` read A0*A1*B2 = 24.0 (the dense value
// is A0*B1*A2 = 33.0); two cells the clause declares equal, (0,1,2) and
// (2,1,0), read 24.0 and 60.0. The BL4010 advises making the repeats adjacent.
let A = 1.0 + Float64(0..4)
let B = 10.0 + Float64(0..4)
let f = lambda(x, y, z) where comm(x, y, z) -> x * y * z
let result = method_for(A, B, A) <@> f |> compute
let r012 = result(0, 1, 2)
let r021 = result(0, 2, 1)
let r210 = result(2, 1, 0)
let r102 = result(1, 0, 2)
let total = reduce(result, (+), axes = 3)
// EXPECT: r012 = 33.0
// EXPECT: r021 = 24.0
// EXPECT: r210 = 33.0
// EXPECT: r102 = 60.0
// (sum A)^2 * (sum B) = 10 * 10 * 46: every one of the n^3 cells is stored
// EXPECT: total = 4600.0
