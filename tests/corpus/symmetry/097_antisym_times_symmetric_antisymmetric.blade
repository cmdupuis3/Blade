// TEST: Antisym times symmetric is antisymmetric (sign-character rule)
// The characters MULTIPLY: antisymmetric (-1) times symmetric (+1) is
// antisymmetric, in either operand order and under division by the symmetric
// operand. The two operands are stored over DIFFERENT records (strict vs
// inclusive simplex), so they cannot co-iterate; this used to refuse BL3999.
// The rule gathers the result over range<AntisymIdx<2, 3>>, reading each
// operand by logical subscript.
let A = Float64([1.0, 2.0, 4.0])
let R = method_for(A, A) <@> lambda(x, y) where anticomm(x, y) -> x - y |> compute
let Y = method_for(A, A) <@> lambda(x, y) where comm(x, y) -> x * y |> compute
let T = R * Y
let t01 = T(0, 1)
let t10 = T(1, 0)
let t11 = T(1, 1)
// EXPECT: T = [[-2.0, -12.0], [-16.0], []]
// EXPECT: t01 = -2.0
// EXPECT: t10 = 2.0
// EXPECT: t11 = 0.0
let U = Y * R
let u21 = U(2, 1)
// EXPECT: u21 = 16.0
let V = R / Y
let v01 = V(0, 1)
let v10 = V(1, 0)
// EXPECT: v01 = -0.5
// EXPECT: v10 = 0.5
// Three factors: (R * Y) is antisymmetric, times R is symmetric again.
let W = R * Y * R
let w10 = W(1, 0)
let w12 = W(1, 2)
// EXPECT: w10 = 2.0
// EXPECT: w12 = 32.0
