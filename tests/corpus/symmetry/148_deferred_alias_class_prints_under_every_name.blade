// TEST: Deferred Alias Class Prints Under Every Name Beside A Packed Product
// Printing is unchanged by the identity rule (formalism 10.2's print rule):
// the class {g, g2} is forced at module level (a positional read through the
// alias), so EVERY name prints the same cells, and the comm product over the
// class prints in its packed triangle shape (one row per canonical prefix),
// as `method_for(g, g)` does (docs/plans/plan-identity-transpose-compute.md
// 2.1). The class value is fixed at its first forcing event: the later input
// write changes neither name's printed cells nor the computed product.
type I = Idx<4>
let mut x: Array<Float64 like I> = [1.0, 2.0, 3.0, 4.0]
let g = method_for(x) <@> lambda(v) -> v + 1.0
let g2 = g
let first = g2((0 : I))
let P = method_for(g2, g) <@> lambda(a, b) where comm(a, b) -> a + b |> compute
x((0 : I)) = 100.0
// EXPECT: first = 2.0
// EXPECT: g = [2.0, 3.0, 4.0, 5.0]
// EXPECT: g2 = [2.0, 3.0, 4.0, 5.0]
// EXPECT: P = [[4.0, 5.0, 6.0, 7.0], [6.0, 7.0, 8.0], [8.0, 9.0], [10.0]]
// EXPECT: x = [100.0, 2.0, 3.0, 4.0]
