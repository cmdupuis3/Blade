// TEST: Output Type: Mixed (A,A,B)
// Mixed: (A, A, B) -> SymIdx<2, 3>, Idx<3>
let A = [1.0, 2.0, 3.0]
let B = [4.0, 5.0, 6.0]
let L = method_for(A, A, B)
let f = lambda(x, y, z) where comm(x, y, z) -> x * y * z
let result = L <@> f |> compute
