// TEST: comm on a provably non-commutative division (rejects)
// ERROR: BL4013
// `x / y` has no swap class, so the parity deduction answers PBottom -- the
// "no claim" that keeps an unprovable `comm` trusted. But this one is
// DISPROVABLE: at x = 2, y = 1 the body is 2 and swapped it is 0.5. Trusting
// the clause stored a triangle and answered r(2, 0) = 0.25 (true value 4).
// A concrete counterexample is a proof, so the clause is refused.
let A = [1.0, 2.0, 4.0]
let g = lambda(x, y) where comm(x, y) -> x / y
let r = method_for(A, A) <@> g |> compute
