// TEST: Reynolds Dedup Sees Contains
// Term dedup must key every node by its full structure UNDER the permutation.
// The old canonical key hashed an unlisted node (contains, reduce, prodsum,
// shift, ...) without the permutation's renaming, so g(x, y) and g(y, x)
// got the same key and merged into 2 * g(x, y).
// g(x, y) = [x in S]; reynolds(g)(x, y) = g(x, y) + g(y, x).
// A = [1, 2], B = [3, 5], S = {1, 5}:
//   (1,3): 1 + 0 = 1   (1,5): 1 + 1 = 2
//   (2,3): 0 + 0 = 0   (2,5): 0 + 1 = 1
let S = [1.0, 5.0]
let A = [1.0, 2.0]
let B = [3.0, 5.0]
let L = method_for(A, B)
let g = lambda(x, y) -> if contains(S, x) then 1.0 else 0.0
let result = L <@> reynolds(g) |> compute
// EXPECT: result = [[1.0, 2.0], [0.0, 1.0]]
