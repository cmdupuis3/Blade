// TEST: Named Function Omp
// `where omp(...)` written on a NAMED FUNCTION used as a kernel, rather than on
// a lambda. This spelling is the one the docs present as canonical, and it was
// silently serial for a long time: a bare named-function kernel is eta-expanded
// into a wrapper lambda built with no where-clause, so the clause was dropped
// on the way to lowering and no pragma was emitted (and no diagnostic — the
// generated C++ was byte-identical to a program that never asked for omp).
// Every other omp test in the corpus writes the clause on a lambda, which keeps
// it on the TypedLambdaInfo and never exercises the eta path.
//
// This file pins the VALUES; the pragma itself is pinned by the pure-codegen
// block (`blade test omp-pragma`), since a corpus EXPECT cannot see emitted C++.
// Both matter: parallelizing is only a fix if the results stay right.
let A = [1.0, 2.0, 3.0]
let B = [4.0, 5.0, 6.0]
function cov(a: Float64, b: Float64) where omp(a: 1) = a * b
let m = object_for(cov) <@> (A, B) |> compute
// Outer product, printed flat (2-D EXPECT parses but asserts nothing):
// row i is A[i] * B[j] for j in 0..2.
// EXPECT: m = [4.0, 5.0, 6.0, 8.0, 10.0, 12.0, 12.0, 15.0, 18.0]
