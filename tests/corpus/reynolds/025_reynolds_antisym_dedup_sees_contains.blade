// TEST: Reynolds Antisym Dedup Sees Contains
// Antisymmetric twin of 024: with the permutation-blind key the two terms
// carried opposite signs under ONE key and cancelled to a zero kernel.
// reynolds(g, Antisymmetric)(x, y) = g(x, y) - g(y, x), g(x, y) = [x in S].
//   (1,3): 1 - 0 = 1   (1,5): 1 - 1 = 0
//   (2,3): 0 - 0 = 0   (2,5): 0 - 1 = -1
let S = [1.0, 5.0]
let A = [1.0, 2.0]
let B = [3.0, 5.0]
let L = method_for(A, B)
let g = lambda(x, y) -> if contains(S, x) then 1.0 else 0.0
let result = L <@> reynolds(g, Antisymmetric) |> compute
// EXPECT: result = [[1.0, 0.0], [0.0, -1.0]]
