// TEST: whole-array assignment of an array literal or an elementwise expression
// `a = [3.0, x]` reached the back end as an inline array literal (BL7001) and
// `a = a * 2.0 + x` as an array-valued inline combinator (BL7004), inside a
// function body and at module level alike (F1). The right-hand side is now
// bound to a fresh temp first and then assigned, so a self-referential RHS
// (`a * 2.0 + x`, the swap `[a(1), a(0)]`) reads the OLD value throughout.
function lit(x: Float64) -> Float64 = {
    let mut a = Float64([1.0, 2.0])
    a = [3.0, x]
    a(0) + a(1)
}
function elem(x: Float64) -> Float64 = {
    let mut a = Float64([1.0, 2.0])
    a = a * 2.0 + x
    a(0) * 10.0 + a(1)
}
function swap() -> Float64 = {
    let mut a = Float64([1.0, 2.0])
    a = [a(1), a(0)]
    a(0) * 10.0 + a(1)
}
let r1 = lit(Float64(4.0))
let r2 = elem(Float64(1.0))
let r3 = swap()
let mut m = Float64([1.0, 2.0])
m = [3.0, 4.0]
let s1 = m(0) + m(1)
m = m * 2.0 + 1.0
let s2 = m(0) * 10.0 + m(1)
m = [m(1), m(0)]
let s3 = m(0) * 10.0 + m(1)
// EXPECT: r1 = 7.0
// EXPECT: r2 = 35.0
// EXPECT: r3 = 21.0
// EXPECT: s1 = 7.0
// EXPECT: s2 = 79.0
// EXPECT: s3 = 97.0
