// TEST: a parallel body may call a function that writes only its own locals
// The #17 refusal (mutability-errors/006-008) is about writes to bindings
// OUTSIDE the parallel body. `scaled` writes a `let mut` of its own, which is
// private to each call, so an `omp` kernel may call it; and the global writer
// `tally` keeps its write channel when called serially.
let mut g = [0.0]
function tally(x: Float64) -> Float64 = { g(0) = g(0) + x; x }
function scaled(x: Float64) -> Float64 = {
    let mut t = [x, x]
    t(1) = t(1) * 3.0
    t(0) + t(1)
}
let a = [1.0, 2.0, 3.0]
let r = a <@> lambda(x) where omp(x: 1) -> scaled(x) |> compute
let s = tally(4.0) + tally(1.0)
let g0 = g(0)
// EXPECT: r = [4.0, 8.0, 12.0]
// EXPECT: s = 5.0
// EXPECT: g0 = 5.0
