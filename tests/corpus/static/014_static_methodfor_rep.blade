// TEST: Static Method For Rep Tower
// static function rep(x, k) builds a staged k-tuple of array refs; splicing
// it into a static method_for yields the arity-k former (the unfold pass's
// uncurrying rule) — pinned against the plain method_for(A, A, A) spelling.
// WARN: BL4010
// x*y*z is commutative over three slots all fed by A, so the storage
// suggestion fires on both spellings. The claim here is that the staged and
// plain formers agree ELEMENTWISE over the full 27-cell dense cube, so
// `where comm` would compact both away from what the EXPECTs read.
static function rep(x, k) = if k == 1 then x else (x, rep(x, k - 1))
let A = [1.0, 2.0, 3.0]
let s3 = static method_for(rep(A, 3)) <@> lambda(x, y, z) -> x * y * z |> compute
let p3 = method_for(A, A, A) <@> lambda(x, y, z) -> x * y * z |> compute
// EXPECT: s3 = [1.0, 2.0, 3.0, 2.0, 4.0, 6.0, 3.0, 6.0, 9.0, 2.0, 4.0, 6.0, 4.0, 8.0, 12.0, 6.0, 12.0, 18.0, 3.0, 6.0, 9.0, 6.0, 12.0, 18.0, 9.0, 18.0, 27.0]
// EXPECT: p3 = [1.0, 2.0, 3.0, 2.0, 4.0, 6.0, 3.0, 6.0, 9.0, 2.0, 4.0, 6.0, 4.0, 8.0, 12.0, 6.0, 12.0, 18.0, 3.0, 6.0, 9.0, 6.0, 12.0, 18.0, 9.0, 18.0, 27.0]
