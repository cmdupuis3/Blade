// TEST: Bracketed Mixed
// Mixed bracketed operators in same expression
let A = Float64([1.0, 2.0])
let B = Float64([3.0, 4.0])
let C = Float64([5.0, 6.0])
// Outer products with different operators
let outer_mul = A [*] B
let outer_add = A [+] C
// EXPECT: outer_mul = [3.0, 4.0, 6.0, 8.0]
// EXPECT: outer_add = [6.0, 7.0, 7.0, 8.0]
