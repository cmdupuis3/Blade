// TEST: Named Infix
// Test named infix operator PARSING: a :name: b -> name(a, b)
// The applied forms -- a function, a lambda value, a section value, over
// scalars and arrays -- are bracketed/018 (and the refused twin 019).

// Verify the lexer recognizes :name: tokens
// and the parser desugars to function application

// For now, demonstrate with scalars (no function call needed)
let a: Float64 = 3.0
let b: Float64 = 4.0
let c = a + b

// (bracketed/018 calls named operators; this file pins the parse only)
// EXPECT: a = 3.0
// EXPECT: b = 4.0
// EXPECT: c = 7.0
