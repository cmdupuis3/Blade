// TEST: OpenMP Nested
// 3-way outer product: outermost loop gets OMP
let A = [1.0, 2.0, 3.0]
let B = [10.0, 20.0]
let C = [100.0, 200.0, 300.0]
let loop = method_for(A, B, C)
let kernel = lambda(a, b, c) -> a + b + c
let result = loop <@> kernel |> compute
// 3×2×3 = 18 elements
// EXPECT: result = [111.0, 211.0, 311.0, 121.0, 221.0, 321.0, 112.0, 212.0, 312.0, 122.0, 222.0, 322.0, 113.0, 213.0, 313.0, 123.0, 223.0, 323.0]
