// TEST: a cast of a SymIdx array keeps its symmetric storage
// ============================================================================
// A cast converts the element only: the comm kernel's packed (triangular)
// Int64 result stays packed through `Float64(...)` -- six stored cells, not
// nine -- concretely and through a generic body.
// ============================================================================
let a = [1, 2, 3]
let S = method_for(a, a) <@> lambda(x, y) where comm(x, y) -> x * y |> compute
// EXPECT: S = [1, 2, 3, 4, 6, 9]
let F = Float64(S)
// EXPECT: F = [1.0, 2.0, 3.0, 4.0, 6.0, 9.0]
function asf(x: T) = Float64(x)
let G = asf(S)
// EXPECT: G = [1.0, 2.0, 3.0, 4.0, 6.0, 9.0]
