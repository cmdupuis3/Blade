// TEST: an explicit conversion is the only numeric conversion
// ============================================================================
// Mixed-elem-type arithmetic used to promote (Int64 beside Float64 went to
// float, Float32 beside Float64 dragged the op wide) with a BL3020 warning.
// It is now an error (formalism 2.4; casts/520-531), so each mix converts
// explicitly, with the type in call position, and computes the same values.
// ============================================================================
let a: Int64 = 5
let w = 5.0 * Float64(a)
let s: Float32 = 1.5
let t: Float64 = 2.0
let u = Float64(s) * t
let clean = 5.0 * Float64(a)
// EXPECT: w = 25.0
// EXPECT: u = 3.0
// EXPECT: clean = 25.0
