// TEST: an elementwise float-to-int cast through floor keeps the shape
// ============================================================================
// `Int64(floor(A))` rounds and converts every cell in one kernel; the result
// is A's shape with an Int64 element.
// ============================================================================
let A = [[1.5, -2.5], [3.25, 4.75]]
let N = Int64(floor(A))
// EXPECT: N = [[1, -3], [3, 4]]
let v = Int64(ceil([0.5, 7.9]))
// EXPECT: v = [1, 8]
