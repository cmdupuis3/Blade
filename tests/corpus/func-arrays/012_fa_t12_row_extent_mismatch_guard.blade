// TEST: FA T12: computed-row extent mismatch (rejects)
// ERROR: BL3016
// ----------------------------------------------------------------------------
// T12: annotation-vs-actual extent mismatch on a computed row. unify does not
// compare extents, and this was the documented annotation laxity (plain
// `let B: Array<Float64 like Idx<5>> = Y1` passed too), so only the emitted
// per-row guard caught it at runtime ("array literal row [0] of 'M' has
// extent 4"). The shared static-extent refinement now runs at every checked
// position, the literal's rows included, and refuses it at compile time; the
// per-row runtime guard remains for rows whose extent is only known at run
// time.
let A = [1.0, 2.0, 3.0, 4.0]
let Y1 = method_for(A) <@> lambda(x) -> x - 2.5 |> compute
let M: Array<Float64 like Idx<2>, Idx<5>> = [Y1, Y1]
