// TEST: If Value Tuple Of Views Write (rejects)
// ----------------------------------------------------------------------------
// Gap G60(a) through an `if` VALUE: each arm is a tuple holding a row view
// of the deferred map m (the condition forces m first). The walk follows both
// arms along the projection path, so the write through `pair[0]` is a write
// through m: refused at lowering in every lane (BL4005).
// ----------------------------------------------------------------------------
type Y = Idx<2>
type X = Idx<3>
let m = method_for(range<Y>, range<X>) <@> lambda(i, j) -> Float64(i) * 10.0 + Float64(j)
let c = reduce(m(0), (+)) > 1.0
let pair = if c then (m(0), Float64(1.0)) else (m(1), Float64(2.0))
let row = pair[0]
row(1) = 9.0
let s = reduce(m, (+), axes = 2)
// ERROR: BL4005 @ 13:1
// ERROR-CONTAINS: a write through `m`, a deferred computation
// REJECT-AT: lower
