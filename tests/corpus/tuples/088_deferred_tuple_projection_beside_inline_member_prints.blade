// TEST: a projection of a named member of a deferred tuple with an inline member prints with the member
// Gap G111 (round 4 wave 5 lane c; Codex review round 3): `p` holds the named
// map `g` and an inline map; `v = p[0]` is `g` by substitution whatever the
// other member is, so it joins `g`'s alias class and prints when `g(0)`
// forces `g` at module level.
type I = Idx<3>
let a: Array<Float64 like I> = [1.0, 2.0, 3.0]
let g = method_for(a) <@> lambda(x) -> x * 2.0
let p = (g, method_for(a) <@> lambda(x) -> x + 10.0)
let v = p[0]
let first = g(0)
// EXPECT: g = [2.0, 4.0, 6.0]
// EXPECT: v = [2.0, 4.0, 6.0]
// EXPECT: first = 2.0
