// TEST: Local Nested Deferred Tuple Unused
// ----------------------------------------------------------------------------
// Codex third look of W4-1, finding 1 (a regression of 1dd8bc18, fixed): in a
// BLOCK, `let p = (g, g)` is a deferred tuple and `let q = (p, p)` -- every
// member a deferred tuple -- is one too, so neither evaluates anything and
// g's integer division by zero never runs: ok = 7 in every lane. The
// interpreter used to treat the block-local p (a tuple of suspensions) as a
// VALUE member and forced it through q, failing BL8013.
// ----------------------------------------------------------------------------
type Row = Idx<1>
let z: Array<Int64 like Row> = [0]
let g = method_for(z) <@> lambda(v) -> 1 / v
let ok = {
    let p = (g, g)
    let q = (p, p)
    Int64(7)
}
// EXPECT: ok = 7
