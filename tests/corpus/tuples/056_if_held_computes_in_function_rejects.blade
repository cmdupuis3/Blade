// TEST: If Held Computes In Function (rejects)
// ----------------------------------------------------------------------------
// Codex review of W4-1, finding 1: an `if` value selecting between computed
// arrays inside a FUNCTION body. The C++ lane built each arm inside an
// immediately-invoked lambda whose pools no frame could free -- a leak on
// every call. Refused at lowering in every lane (BL6002): compute the arrays
// before the `if` and select between the names.
// ----------------------------------------------------------------------------
type Row = Idx<3>
let x: Array<Float64 like Row> = [1.0, 2.0, 3.0]
function pick(c: Bool) -> Float64 = {
    let t = if c then (method_for(x) <@> lambda(v) -> v * 2.0 |> compute, 1.0) else (method_for(x) <@> lambda(v) -> v + 1.0 |> compute, 2.0)
    reduce(t[0], (+)) + t[1]
}
let r = pick(true)
// ERROR: BL6002 @ 10:1
// ERROR-CONTAINS: inside a function body, a lambda or a loop body
// REJECT-AT: lower
