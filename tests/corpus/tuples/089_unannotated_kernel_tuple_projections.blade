// TEST: Unannotated Kernels Project Tuple Cells At The Component's Type
// F2 (floor round): a lambda whose parameter is unannotated, applied to an
// array of tuples, takes the CELL type, and a literal projection `p[k]` in
// its body is that component's type. Master typed the projection as a fresh
// variable, so a map's output cells fell back to the tuple and R11's
// kernel-result judgment refused every map below (BL3001); a fold kernel
// building the next tuple state from projections was BL3020. Map,
// co-iteration, outer product, a fused fold over a map, a nested projection,
// a `<$>` wrapper, an `@>>` stage, a `>>@` pipeline, a tuple-state fold.
let ts = [(Float64(1.0), Int64(2)), (Float64(3.0), Int64(4))]
let ws = Float64([10.0, 20.0])
let firsts = (method_for(ts) <@> lambda(p) -> p[0]) |> compute
let seconds = (method_for(ts) <@> lambda(p) -> p[1] * 3) |> compute
let zs = (method_for(zip(ts, ws)) <@> lambda(p, w) -> p[0] + w) |> compute
let os = (method_for(ts, ws) <@> lambda(p, w) -> p[0] * w) |> compute
let total = reduce(method_for(ts) <@> lambda(p) -> p[0], (+))
let nest = [((Float64(1.0), Int64(2)), true), ((Float64(3.0), Int64(4)), false)]
let inner = (method_for(nest) <@> lambda(p) -> p[0][1]) |> compute
let wrapped = ((lambda(p) -> p[1]) <$> ts) |> compute
let L = method_for(ts)
let staged = ((L <@> lambda(p) -> p) @>> (L <@> lambda(p) -> p[0] * 2.0)) |> compute
let o = object_for(lambda(p) -> p) >>@ object_for(lambda(p) -> p[1] + 1)
let piped = (o <@> ts) |> compute
let state = reduce(ts, lambda(a, b) -> (a[0] + b[0], a[1] * b[1]))
// EXPECT: firsts = [1.0, 3.0]
// EXPECT: seconds = [6, 12]
// EXPECT: zs = [11.0, 23.0]
// EXPECT: os = [[10.0, 20.0], [30.0, 60.0]]
// EXPECT: total = 4.0
// EXPECT: inner = [2, 4]
// EXPECT: wrapped = [2, 4]
// EXPECT: staged = [2.0, 6.0]
// EXPECT: piped = [3, 5]
// EXPECT: state = (4.0, 8)