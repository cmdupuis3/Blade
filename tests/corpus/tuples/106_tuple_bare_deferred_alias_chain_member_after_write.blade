// TEST: Tuple Bare Deferred Alias Chain Member After Write
// ----------------------------------------------------------------------------
// Gap G304, the alias chain of length 2 held in a tuple: a copy, the class
// unprinted.
// ----------------------------------------------------------------------------
type Row = Idx<1>
let a: Array<Int64 like Row> = [1]
let mut cnt: Array<Int64 like Row> = [0]
let seen = method_for(a) <@> lambda(v) -> v * 10 + cnt(0)
let seen2 = seen
let good = method_for(a) <@> lambda(v) -> v + 1
function bump(c: mut Array<Int64 like Row>) -> Int64 = {
    c(0) = c(0) + 1
    c(0)
}
let seen3 = seen2
let t = (bump(cnt), seen3)
// EXPECT: t = (1, [11])
// EXPECT: cnt = [1]
