// TEST: Inlined Call Bare Deferred Before Failing Arg (aborts)
// ----------------------------------------------------------------------------
// Gap G57, the capturing (inlined) call path, reverse order: the bare
// deferred argument comes FIRST, so its division by zero (BL8013) fires at
// its own position, before the later checked cast (BL8006).
// ----------------------------------------------------------------------------
type Row = Idx<1>
let a: Array<Int64 like Row> = [1]
let z: Array<Int64 like Row> = [0]
let base: Array<Int64 like Row> = [100]
let bad = method_for(z) <@> lambda(v) -> 1 / v
let good = method_for(a) <@> lambda(v) -> v + 1
let h = lambda(p: Array<Int64 like Row>, k: Int64, q: Array<Int64 like Row>) -> k + p(0) + q(0) + base(0)
let r = h(bad, a((a(0) : Row)), good |> compute)
// ABORT: BL8013
// ABORT: integer division by zero
// ABORT: .blade:10
