// TEST: a top-level computed map whose kernel reads a projection of a wholly-deferred tuple
// Gap G111 (round 4 wave 5 lane c; formalism 10.2, the alias rule): the map's
// kernel captures `v = p[1]`, an alias of the deferred member `d2`; the capture
// forces the class, which prints under both names. `d1` is never forced.
type I = Idx<4>
let a: Array<Float64 like I> = [1.0, 2.0, 3.0, 4.0]
let d1 = method_for(a) <@> lambda(x) -> x * 2.0
let d2 = method_for(a) <@> lambda(x) -> x + 10.0
let p = (d1, d2)
let v = p[1]
let m = method_for(range<I>) <@> lambda(i) -> v(i) * 0.5 |> compute
// EXPECT: d2 = [11.0, 12.0, 13.0, 14.0]
// EXPECT: v = [11.0, 12.0, 13.0, 14.0]
// EXPECT: m = [5.5, 6.0, 6.5, 7.0]
