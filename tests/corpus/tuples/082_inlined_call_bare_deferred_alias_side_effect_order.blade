// TEST: Inlined Call Bare Deferred Alias Side Effect Order
// ----------------------------------------------------------------------------
// Gap G57, the capturing (inlined) call path, side-effect order: the first
// argument bumps a counter that a LATER bare deferred ALIAS's kernel reads,
// and the inlined body reads it again. Left to right, the bump runs first,
// then `seen2` is forced at its own position (so the class seen / seen2
// prints [11]), then the compute: r = 1 + 11 + 2 + cnt(0) = 15. The llvm
// lane used to refuse the call; tuples/065 is the out-of-line twin.
// ----------------------------------------------------------------------------
type Row = Idx<1>
let a: Array<Int64 like Row> = [1]
let mut cnt: Array<Int64 like Row> = [0]
let seen = method_for(a) <@> lambda(v) -> v * 10 + cnt(0)
let seen2 = seen
let good = method_for(a) <@> lambda(v) -> v + 1
function bump(c: mut Array<Int64 like Row>) -> Int64 = {
    c(0) = c(0) + 1
    c(0)
}
let h = lambda(k: Int64, p: Array<Int64 like Row>, q: Array<Int64 like Row>) -> k + p(0) + q(0) + cnt(0)
let r = h(bump(cnt), seen2, good |> compute)
// EXPECT: r = 15
// EXPECT: cnt = [1]
// EXPECT: seen = [11]
// EXPECT: seen2 = [11]
