// TEST: If Held Tuple Untaken Arm (aborts)
// ----------------------------------------------------------------------------
// Gap G59: the condition selects the ELSE arm, so the then-arm's failing
// compute (`boom`, BL8013) never runs; the else-arm's own compute is fine,
// and the program then fails at `bad`'s checked cast (BL8006) on the next
// line. Before, the C++ lane would have had to build both arms' producers
// ahead of the select.
// ----------------------------------------------------------------------------
type Row = Idx<1>
let a: Array<Int64 like Row> = [1]
let z: Array<Int64 like Row> = [0]
let boom = method_for(z) <@> lambda(v) -> 2 / v
let fine = method_for(a) <@> lambda(v) -> v * 7
let c = a(0) > 5
let t = if c then (boom |> compute, Int64(1)) else (fine |> compute, Int64(2))
let bad = a((a(0) : Row))
// ABORT: BL8006
// ABORT: outside Row
// ABORT: .blade:15
