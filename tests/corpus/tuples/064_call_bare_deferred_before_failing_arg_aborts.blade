// TEST: Call Bare Deferred Before Failing Arg (aborts)
// ----------------------------------------------------------------------------
// Finding 5's reverse order: the bare deferred argument comes FIRST, so its
// division by zero (BL8013) fires before the later checked cast (BL8006).
// ----------------------------------------------------------------------------
type Row = Idx<1>
let a: Array<Int64 like Row> = [1]
let z: Array<Int64 like Row> = [0]
let bad = method_for(z) <@> lambda(v) -> 1 / v
let good = method_for(a) <@> lambda(v) -> v + 1
function h(p: Array<Int64 like Row>, k: Int64, q: Array<Int64 like Row>) -> Int64 = k + p(0) + q(0)
let r = h(bad, a((a(0) : Row)), good |> compute)
// ABORT: BL8013
// ABORT: integer division by zero
// ABORT: .blade:8
