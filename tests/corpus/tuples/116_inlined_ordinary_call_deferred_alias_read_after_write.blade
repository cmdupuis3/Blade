// TEST: Inlined Ordinary Call Deferred Alias Read After Write
// ----------------------------------------------------------------------------
// Gap G304, the capturing (inlined) twin of tuples/115: r = 1 + 11 + cnt(0).
// ----------------------------------------------------------------------------
type Row = Idx<1>
let a: Array<Int64 like Row> = [1]
let mut cnt: Array<Int64 like Row> = [0]
let seen = method_for(a) <@> lambda(v) -> v * 10 + cnt(0)
let seen2 = seen
let good = method_for(a) <@> lambda(v) -> v + 1
function bump(c: mut Array<Int64 like Row>) -> Int64 = {
    c(0) = c(0) + 1
    c(0)
}
let h = lambda(k: Int64, s: Int64) -> k + s + cnt(0)
let r = h(bump(cnt), seen2(0))
// EXPECT: r = 13
// EXPECT: cnt = [1]
// EXPECT: seen = [11]
// EXPECT: seen2 = [11]
