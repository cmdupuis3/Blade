// TEST: projections of a wholly-deferred tuple print with their member once the member is forced
// Gap G111 (round 4 wave 5 lane c; Codex review round 1): `v = p[0]` and
// `sibling = p[1]` are both `g` by substitution, one alias class with it
// (formalism 10.2; IRLift.deferredAliasClasses). The positional read `g(0)`
// forces `g` at module level, so the class prints under every name.
type I = Idx<3>
let a: Array<Float64 like I> = [1.0, 2.0, 3.0]
let g = method_for(a) <@> lambda(x) -> x * 2.0
let p = (g, g)
let v = p[0]
let sibling = p[1]
let first = g(0)
// EXPECT: g = [2.0, 4.0, 6.0]
// EXPECT: v = [2.0, 4.0, 6.0]
// EXPECT: sibling = [2.0, 4.0, 6.0]
// EXPECT: first = 2.0
