// TEST: explicit array casts retain fixed width at inline call positions
function greater(a: T^0, b: T^0) = a > b
function add0(a: T^0, b: T^0) = a + b
let ints = greater(2, Int64([1, 5, 3]))
let floats = add0(0.5, Float64([1.0, 2.0]))
let bound = Float64([1.0, 2.0])
let bound_sum = reduce(bound, (+))
function tuple_sum(p: (Array<Float64 like Idx<2>>, Float64)) = reduce(p[0], (+)) + p[1]
let tuple_result = tuple_sum((Float64([1.0, 2.0]), 0.5))
let complex_bound = Complex128([complex(1.0, 2.0), complex(3.0, 4.0)])
let complex_sum = reduce(complex_bound, (+))
let complex_real = real(complex_sum)
let complex_imag = imag(complex_sum)
// EXPECT: ints = [true, false, false]
// EXPECT: floats = [1.5, 2.5]
// EXPECT: bound_sum = 3.0
// EXPECT: tuple_result = 3.5
// EXPECT: complex_real = 4.0
// EXPECT: complex_imag = 6.0
