// TEST: an Int64 tuple component handed to an Int32 component of a parameter (rejects)
// ============================================================================
// G275: the narrowing proof is judged component by component -- an Int64
// value not proven to fit Int32 would wrap (4294967296 is 0 in Int32).
// ============================================================================
function pair(p: (Int32, Float64)) -> Int32 = p[0]
let k: Int64 = 4294967296
let a: Float64 = 1.0
let y = pair((k, a))
// ERROR: BL3020
