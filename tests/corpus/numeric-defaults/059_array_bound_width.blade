// TEST: array element bounds use the declared cell width
// 0.1 rounds upward in Float32, past this valid Float64 cell.
type I = Idx<1>
let above_min: Array<Float64<min=0.1> like I> = [0.1000000005]
let below_max: Array<Float64<max=0.3> like I> = [0.2999999999]
let narrow: Array<Float32<min=0.1, max=0.3> like I> = [0.2]
let min_ok = above_min(0) > 0.1
let max_ok = below_max(0) < 0.3
let narrow_ok = narrow(0) == Float32(0.2)
// EXPECT: min_ok = true
// EXPECT: max_ok = true
// EXPECT: narrow_ok = true
