// TEST: a literal fold seed takes the width of the operand element
// ============================================================================
// Rule 5 (a fold seed is fixed by the fold): `reduce(xs, (+), 0.5)` over a
// Float64 array seeds a Float64 accumulator, on the rank-1 path and on the
// rank-2 full fold alike, so each result is a Float64 variable.
// ============================================================================
let xs = Float64([1.0, 2.0, 3.0])
let s = reduce(xs, (+), 0.5)
let s64: Float64 = s
type J = Idx<2>
type I = Idx<2>
let m: Array<Float64 like J, I> = [[1.0, 2.0], [3.0, 4.0]]
let t = reduce(m, (+), 0.5, axes = 2)
let t64: Float64 = t
// EXPECT: s64 = 6.5
// EXPECT: t64 = 10.5
