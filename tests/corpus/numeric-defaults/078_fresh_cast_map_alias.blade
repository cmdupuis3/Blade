// TEST: A cast map with hoisted literal operands retains fresh stored identity
// The literal contains variables, so its explicit cast is a forced map.
// Operand hoisting must not hide the newly allocated result from alias proof.
let seed: Float64 = 1.5
let original = Float64([seed, seed + 0.5])
let alias = original
let packed = method_for(original, alias) <@> lambda(a, b) where comm(a, b) -> a * b |> compute
// EXPECT: original = [1.5, 2.0]
// EXPECT: alias = [1.5, 2.0]
// EXPECT: packed = [[2.25, 3.0], [4.0]]

// The same root shape remains a copy when either name can be written.
let changed = Float64([seed])
let snapshot = changed
changed(0) = 9.0
// EXPECT: changed = [9.0]
// EXPECT: snapshot = [1.5]
