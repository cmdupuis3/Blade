// TEST: a literal beside an unannotated kernel parameter takes the operand's Float32 width
// Gap G110 (round 4 wave 4 lane A; formalism 2.4's partner rule): `v` is fixed
// by the map operand only at the apply site, and its literal partners follow
// it -- every map below is Float32 (it used to type Float64, so these
// annotations were BL3001 and `v * 2.0 * v` was BL3020: the Float64 `v * 2.0`
// met the Float32 `v`).
type I = Idx<4>
let x: Array<Float32 like I> = [1.0, 2.0, 3.0, 4.0]
let y: Array<Float32 like I> = method_for(x) <@> lambda(v) -> v * v + 1.0 |> compute
let z: Array<Float32 like I> = method_for(x) <@> lambda(v) -> 0.5 + v |> compute
let w: Array<Float32 like I> = method_for(x) <@> lambda(v) -> v * 2.0 * v |> compute
let s: Float32 = reduce(y, (+))
// EXPECT: y = [2.0, 5.0, 10.0, 17.0]
// EXPECT: z = [1.5, 2.5, 3.5, 4.5]
// EXPECT: w = [2.0, 8.0, 18.0, 32.0]
// EXPECT: s = 34.0
