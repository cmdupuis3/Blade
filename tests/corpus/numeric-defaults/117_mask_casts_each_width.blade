// TEST: a mask cast to each numeric width
// ============================================================================
// A Bool is not a number; it converts EXPLICITLY with a numeric cast (formalism
// 2.4; the owner's ruling of 2026-11-14): 1 or 0 (1.0 / 0.0), element by element
// over a Bool array, in every lane (C++, interpreter, LLVM, static evaluation).
// ============================================================================
let xs: Array<Float64 like Idx<3>> = [1.0, 2.0, 3.0]
let m = xs > 1.5
let a = Int32(m)
// EXPECT: a = [0, 1, 1]
let b = Int64(m)
// EXPECT: b = [0, 1, 1]
let c = Float32(m)
// EXPECT: c = [0.0, 1.0, 1.0]
let d = Float64(m)
// EXPECT: d = [0.0, 1.0, 1.0]
