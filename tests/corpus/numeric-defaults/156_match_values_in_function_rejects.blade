// TEST: match arms of Int32 and Int64 parameters in a function body (rejects)
// ============================================================================
// R29: one judgment for every join -- a literal that does not fit the other
// branch / arm is BL3020 at the literal; two concrete widths are BL3001.
// ============================================================================
function f(a: Int32, b: Int64) = match a with
    | 1 -> a
    | _ -> b
let r = f(3, 7)
// ERROR: BL3001 @ 7:12
