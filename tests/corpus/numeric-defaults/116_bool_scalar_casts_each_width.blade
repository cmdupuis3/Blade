// TEST: a Bool cast to each numeric width
// ============================================================================
// A Bool is not a number; it converts EXPLICITLY with a numeric cast (formalism
// 2.4; the owner's ruling of 2026-11-14): 1 or 0 (1.0 / 0.0), element by element
// over a Bool array, in every lane (C++, interpreter, LLVM, static evaluation).
// ============================================================================
let t = true
let f = false
let a = Int32(t)
// EXPECT: a = 1
let b = Int64(f)
// EXPECT: b = 0
let c = Float32(t)
// EXPECT: c = 1.0
let d = Float64(t)
// EXPECT: d = 1.0
let e = Int64(t) + 41
// EXPECT: e = 42
let g = Float64(1.5 > 2.5) + 0.5
// EXPECT: g = 0.5
