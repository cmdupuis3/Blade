// TEST: an Int64 static value past Int32 into a static function's Int32 parameter (rejects)
// ============================================================================
// R28: compile-time evaluation follows the width rules of its run-time twin
// (formalism 2.4: a `let static` value follows the same rules).
// ============================================================================
static function f(i: Int32) -> Int32 = i + 1
let static big = 5000000000
let static r = f(big)
// ERROR: BL3020 @ 7:18
