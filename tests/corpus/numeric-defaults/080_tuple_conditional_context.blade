// TEST: tuple expectations reach conditional branch literals
function range_wide(x: Float64) -> (Float64, Float64) =
    if x > 0.0 then (x, x) else (0.0, -1.0)
function nested(x: Int64) -> (Int64, (Float64, Float32)) =
    if x > 0 then (x, (0.1, 0.2)) else (0, (0.3, 0.4))
let lo, hi = range_wide(-1.0)
let i, pair = nested(1)
let wide_exact = pair[0] == Float64(0.1)
let narrow_exact = pair[1] == Float32(0.2)
// EXPECT: lo = 0.0
// EXPECT: hi = -1.0
// EXPECT: i = 1
// EXPECT: wide_exact = true
// EXPECT: narrow_exact = true
