// TEST: Staged recursion re-evaluates preserved numeric widths
// WARN: BL4010
static function rep(x, k) = if k == 1 then x else (x, rep(x, k - 1))
let a = Float64([1.0, 2.0])
let narrow = static method_for(rep(a, Int32(2))) <@> lambda(x, y) -> x - y |> compute
let wide = static method_for(rep(a, Int64(2))) <@> lambda(x, y) -> x - y |> compute
// EXPECT: narrow = [0.0, -1.0, 1.0, 0.0]
// EXPECT: wide = [0.0, -1.0, 1.0, 0.0]
