// TEST: Joined folds adapt each literal-only seed at its own element width
let a = Float64([1.0, 2.0, 3.0])
let b = Float64([2.0, 4.0, 6.0])
let (dot, sa, sb) = object_for(<&!>) <@> (
    reduce(method_for(zip(a, b)) <@> lambda(x, y) -> x * y, lambda(p, q) where omp -> p + q, 0.0),
    reduce(a, (+), -0.0),
    reduce(b, (+), -0.0))
let narrow = [3.0, 4.0, 5.0]
// Precision and zero-sign comparisons require the same serial association
// in every build; the three-leg licensed spelling above remains unchanged.
function add_wide(p: Float64, q: Float64) where repro -> Float64 = p + q
function add_narrow(p: Float32, q: Float32) where repro -> Float32 = p + q
let (wide_sum, narrow_sum) = object_for(<&!>) <@> (reduce(a, add_wide, 0.1 + 0.2), reduce(narrow, add_narrow, 0.1 + 0.2))
let wide_precise = wide_sum == reduce(a, add_wide, Float64(0.1) + Float64(0.2))
let narrow_precise = narrow_sum == reduce(narrow, add_narrow, Float32(0.1) + Float32(0.2))
let wide_zeros = Float64([-0.0, -0.0])
let narrow_zeros = [-0.0, -0.0]
let (zw, zn) = object_for(<&!>) <@> (reduce(wide_zeros, add_wide, -0.0), reduce(narrow_zeros, add_narrow, -0.0))
let negative_wide = 1.0 / zw < 0.0
let negative_narrow = 1.0 / zn < 0.0
// EXPECT: dot = 28.0
// EXPECT: sa = 6.0
// EXPECT: sb = 12.0
// EXPECT: wide_precise = true
// EXPECT: narrow_precise = true
// EXPECT: negative_wide = true
// EXPECT: negative_narrow = true
