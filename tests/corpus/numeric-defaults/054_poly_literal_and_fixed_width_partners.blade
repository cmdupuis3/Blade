// TEST: Poly numeric obligations accept matching fixed widths and adaptable literals
function mean(row: T^1) = Float64(reduce(row, (+))) / Float64(extents(row))
function centered_product(a: Poly<T^1>) where comm(a) -> T^1 = {
    match arity(a) with
    | 0 -> 1.0
    | _ -> let head :: tail = a; (head - mean(head)) * centered_product(tail)
}
let result = centered_product(Float64([1.0, 2.0, 3.0]), Float64([2.0, 4.0, 6.0]))
function shifted_product(a: Poly<T^1>) where comm(a) -> T^1 = {
    match arity(a) with
    | 0 -> 1.0
    | _ -> let head :: tail = a; (head - 1.0) * shifted_product(tail)
}
let narrow = shifted_product([1.0, 2.0, 3.0], [2.0, 4.0, 6.0])
let first: Float32 = narrow(0)
// EXPECT: result = [2.0, 0.0, 2.0]
// EXPECT: narrow = [0.0, 3.0, 10.0]
// EXPECT: first = 0.0

// The scalar base arm keeps the pack element width even though its typed
// result carries an array shape before arity specialization.
function weighted_product(a: Poly<T^1>) where comm(a) -> T^1 = {
    match arity(a) with
    | 0 -> 0.1
    | _ -> let head :: tail = a; head * weighted_product(tail)
}
let weighted = weighted_product([0.1], [0.1])
let base_width_matches = weighted(0) == Float32(0.1) * (Float32(0.1) * Float32(0.1))
// EXPECT: weighted = [0.001]
// EXPECT: base_width_matches = true
let weighted_wide = weighted_product(Float64([0.1]), Float64([0.1]))
let wide_base_matches = weighted_wide(0) == Float64(0.1) * (Float64(0.1) * Float64(0.1))
// EXPECT: weighted_wide = [0.001]
// EXPECT: wide_base_matches = true
