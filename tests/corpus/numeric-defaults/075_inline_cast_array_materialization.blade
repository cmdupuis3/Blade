// TEST: Inline cast arrays materialize for callable and caret specializations
function first(c) = c(0) + 1.0
function scaled(c) = first(c) * 2.0
let direct = scaled(Float64([1.0, 2.0]))
// EXPECT: direct = 4.0

let head = lambda(c) -> c(0)
let via_lambda = head(Float64([1.5, 2.5]))
let integer = head(Int64([3, 4]))
// EXPECT: via_lambda = 1.5
// EXPECT: integer = 3

function via_caret(m: T^1) = first(m)
let forwarded = via_caret(Float64([5.0, 6.0]))
// EXPECT: forwarded = 6.0

function sum_row(row: Array<Float64 like Idx<2>>) = reduce(row, (+))
let ordinary = sum_row(Float64([0.25, 0.5]))
// EXPECT: ordinary = 0.75

let complex_head = head(Complex128([complex(1.0, 2.0), complex(3.0, 4.0)]))
let real_part = real(complex_head)
let imag_part = imag(complex_head)
// EXPECT: real_part = 1.0
// EXPECT: imag_part = 2.0
