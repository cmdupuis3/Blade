// TEST: Poly Type
// Poly<T^r> type parsing
// (This declaration used to carry `where comm(args)`. Its body returns the
// FIRST operand, which is not commutative; the claim went unchecked until the
// per-arity pack witness (N2, arity/470), which now refuses it.)
function comoment(args: Poly<T^0>)
-> T^0
= args[0]

// A call site, so the signature is exercised end to end: args[0] of the pack.
let c = comoment(Float64(2.5), Float64(4.0))
// EXPECT: c = 2.5
