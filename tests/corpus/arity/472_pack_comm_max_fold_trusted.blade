// TEST: comm on a symmetric pack fold the template cannot prove stays accepted
// The all-arity template proves only an AC operator (+ * && ||); a max fold is
// symmetric but outside it. The per-arity witness (N2) unrolls it and finds no
// counterexample, so the claim keeps its triangular storage, and every read --
// both triangles -- is the true max.
function packmax(a: Poly<T^0>) where comm(a) -> T^0 = {
    match arity(a) with
    | 1 -> { let head :: tail = a
             head }
    | _ -> { let head :: tail = a
             if head > packmax(tail) then head else packmax(tail) }
}
let A = Float64([1.0, 5.0, 3.0])
let result = object_for(packmax) <@> (A, A) |> compute
let r02 = result(0, 2)
let r20 = result(2, 0)
let r12 = result(1, 2)
// EXPECT: r02 = 3.0
// EXPECT: r20 = 3.0
// EXPECT: r12 = 5.0
