// TEST: Pack Comm Suggestion (dense until pinned)
// WARN: BL4010
// The comm-LESS twin of arity/027: same arity-polymorphic product kernel,
// same (A, A) application, but no `where comm(a)` — so the output is the
// full DENSE 3x3 (9 cells), not the 6-cell triangle. Stage-3 late tier
// deduces the pack invariant at every arity via the AC-fold template
// (base g(head) = head, step g(head) * packprod(tail), * is assoc+comm)
// and emits the confirm-and-pin suggestion naming `where comm(a)` on
// `packprod` — observationally inert: values below are the dense proof.
function packprod(a: Poly<T^0>) -> T^0 = {
    match arity(a) with
    | 1 -> { let head :: tail = a
             head }
    | _ -> { let head :: tail = a
             head * packprod(tail) }
}
let A = [1.0, 2.0, 3.0]
let result = object_for(packprod) <@> (A, A) |> compute
// EXPECT: result = [1.0, 2.0, 3.0, 2.0, 4.0, 6.0, 3.0, 6.0, 9.0]
