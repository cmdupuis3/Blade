// TEST: a pack former over a range with a nonzero start that reads the pack is refused (rejects)
// Gap G223 (round 4 wave 8 lane d; Codex diff review round 2): the former is
// unrolled into one copy per PACK element at ordinals 0, 1, 2, so iterating
// `1..4` would read the wrong elements. Refused at lowering.
// ERROR: BL7004
// ERROR-CONTAINS: not the pack index
// REJECT-AT: lower
function polySum(args: Poly<Float64>) -> Float64 = {
    let terms = method_for(1..4) <@> lambda(k) -> args[k] |> compute
    reduce(terms, (+))
}
let result = polySum(10.0, 20.0, 30.0)
