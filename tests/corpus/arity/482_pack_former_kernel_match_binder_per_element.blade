// TEST: a pack former's kernel with a match pattern variable binds a fresh name per unrolled element
// Gap G115 second half (round 4 wave 5 lane c; G95's class): the former
// unrolls into one copy of the kernel body per pack element; G95 freshened the
// copies' `let` binders only, so a `match` arm's pattern variable kept one id
// across the copies. Every binder kind is now freshened per element.
//   terms = [10 * 2 + 1, 20 * 2 + 1, 30 * 2 + 1] = [21, 41, 61]; sum 123.
function polySum(args: Poly<T^0>) -> T^0 = {
    let terms = method_for(range<Idx<arity(args)>>) <@> lambda(k) -> {
        match args[k] * 2.0 with
        | y -> y + 1.0
    } |> compute
    reduce(terms, (+))
}
let result = polySum(10.0, 20.0, 30.0)
// EXPECT: result = 123.0
