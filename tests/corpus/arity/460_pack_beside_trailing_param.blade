// TEST: A Pack Beside A Trailing Parameter
// ============================================================================
// One `Poly` pack beside fixed parameters: the fixed parameters pin how many
// arguments are NOT the pack, so a direct call reads the pack off the count
// (formalism 8.2). As many arguments as parameters: the pack's place holds a
// parenthesized group, or a lone element (a one-element pack -- there is no
// 1-tuple to write). More: the surplus, written flat in the pack's place, is
// the pack. The flat and lone spellings used to reach monomorphization unread
// and fail IR validation (BL6001, "unresolved type variable").
// ============================================================================
function first_at(P: Poly<T^1>, k: Int64) = P[0](k)
function one_or(P: Poly<T^0>, fallback: T^0) -> T^0 = if arity(P) == 1 then P[0] else fallback
let x = Float64([1.0, 2.0, 3.0])
let y = Float64([4.0, 5.0, 6.0])
let flat = first_at(x, y, Int64(2))
let grouped = first_at((y, x), Int64(1))
let single = first_at(y, Int64(0))
let n1 = one_or(Float64(7.0), Float64(1.0))
let n2 = one_or(Float64(7.0), Float64(8.0), Float64(1.0))
// EXPECT: flat = 3.0
// EXPECT: grouped = 5.0
// EXPECT: single = 4.0
// EXPECT: n1 = 7.0
// EXPECT: n2 = 1.0
