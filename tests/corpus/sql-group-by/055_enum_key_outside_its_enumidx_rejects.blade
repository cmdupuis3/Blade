// TEST: An EnumIdx group key outside its declared list is refused (rejects)
// 999 is not one of LandType's keys. This test began as a run-time abort
// (the LLVM lane's select chain once dropped such a row into bucket 0
// silently). Since every value of an integer EnumIdx type is a KEY held as
// its position (formalism 3.10, the D2 rule), a literal outside the key list
// is refused at type-check time, and a computed one at its conversion
// (BL8006) -- so no lane's group_keys can meet an out-of-list key at run time.
// ERROR: BL4003
// ERROR-CONTAINS: is not a key of EnumIdx 'LandType'
type LandType = EnumIdx<[101, 205, 307]>
type StationIdx = Idx<6>
let codes: Array<LandType like StationIdx> = [101, 205, 999, 101, 205, 307]
let temps: Array<Float64 like StationIdx> = [20.0, 25.0, 30.0, 22.0, 27.0, 32.0]
let gk = group_keys(codes)
let grouped = group_by(temps, gk)
let sizes = extents(gk)
