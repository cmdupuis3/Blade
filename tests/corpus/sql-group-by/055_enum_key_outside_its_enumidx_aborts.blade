// TEST: An EnumIdx group key outside its declared list aborts (aborts)
// 999 is not one of LandType's keys. The C++ lane's bucket lookup and the
// interpreter's buildGroupKeys stop with the bounds code; the LLVM lane's
// select chain once dropped the row into bucket 0 silently.
// ABORT: a group_keys key outside its EnumIdx
type LandType = EnumIdx<[101, 205, 307]>
type StationIdx = Idx<6>
let codes: Array<LandType like StationIdx> = [101, 205, 999, 101, 205, 307]
let temps: Array<Float64 like StationIdx> = [20.0, 25.0, 30.0, 22.0, 27.0, 32.0]
let gk = group_keys(codes)
let grouped = group_by(temps, gk)
let sizes = extents(gk)
