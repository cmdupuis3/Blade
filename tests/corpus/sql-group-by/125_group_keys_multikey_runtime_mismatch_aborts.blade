// TEST: Group Keys Over Two Key Arrays Of Unequal Run-Time Extent Checks Them (aborts)
// Gap G283: the compound-key passes walk the first key's rows and read every component at each
// one, so a shorter second key was read past its end; every lane now compares them first.
// ABORT: BL8011
type S = Idx<5>
let src: Array<Float64 like S> = [0.1, 0.9, 0.2, 0.8, 0.7]
let c5 = compound(src, mask(src, lambda(v) -> v > 0.0))
let c3 = compound(src, mask(src, lambda(v) -> v > 0.5))
let a = Float64(0..extents(c5)) |> compute
let b = Float64(0..extents(c3)) |> compute
let ka = Int64(0..extents(c5)) |> compute
let kb = Int64(0..extents(c3)) |> compute
let gk = group_keys(ka, kb)
let g = group_by(a, gk)