// TEST: GroupBy Result Returned From A Function (rejects)
// ERROR: BL3017 @ 11:5
// ERROR-CONTAINS: the return value of function 'grp' cannot be a GROUPED value
// Deep review R7: a group_by result has no return ABI -- its rows are a
// table of pointers into the grouping's pool, and its row lengths live in
// the grouping's side state (`gk__offsets`, ...), which no signature
// carries. This passed `check` and died in g++ (BL9002, `Array<double*,1>`
// to `Array<double,2>`); it is now refused at the checker, at the returned
// expression. The twin that returns a per-group FOLD is 080.
function grp(t: Float64^1, c: Int64^1) = {
    let gk = group_keys(c)
    group_by(t, gk)
}
let region = Int64([0, 1, 2, 0, 1, 2])
let temps = Float64([20.0, 25.0, 30.0, 22.0, 27.0, 32.0])
let g = grp(temps, region)