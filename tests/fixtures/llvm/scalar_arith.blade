// Golden-pin source: scalar arithmetic, mixed int/float, a comparison.
// Small on purpose -- the pinned .ll beside this file is read by a human when
// it changes, so every instruction in it has to be accounted for.
let a: Int64 = 6
let b: Int64 = 7
let prod = a * b
let ratio: Float64 = 1.5 * 2.0
let flag = prod > 40
