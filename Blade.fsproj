<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Blade</RootNamespace>
    <!-- Ahead-of-time compile the IL when publishing a RID-specific image.
         Blade is a short-lived batch CLI: on a plain `dotnet build` image every
         invocation re-JITs an 11.5 MB assembly, and that JIT warm-up is most of
         the ~435 ms floor a trivial file pays (measured: `check` -32%, `emit`
         -43% with R2R, emitted C++ hash-identical, so this is packaging, not
         semantics).

         The RuntimeIdentifier CONDITION is load-bearing, not decoration.
         ReadyToRun requires a RID, and the SDK's RID inference reacts to a bare
         `PublishReadyToRun=true` by inferring one for `dotnet build` too, which
         silently relocates the dev binary from bin/Release/net7.0/Blade.exe to
         bin/Release/net7.0/win-x64/Blade.exe and breaks every consumer of the
         documented path. Gating on an explicitly supplied RID keeps the default
         build byte-for-byte where it was: `dotnet build -c Release` passes no
         RID, so this property never materializes.
         See docs/plan-compile-speed.md "Building for speed" for the command. -->
    <PublishReadyToRun Condition="'$(RuntimeIdentifier)' != ''">true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src/Runtime.fs" />
    <!-- Platform abstraction: the one module that knows how the host OS
         spells toolchain artifacts (exe/obj/shared-lib extensions, the MPI
         link line, libm's name, install-prefix library search). Dependency-
         free; consulted by LinAlgPatterns.fs, Build.fs and the interpreter's
         libm binding. See docs/plan-toolchain-packaging.md. -->
    <Compile Include="src/Platforms.fs" />
    <!-- blade.toolchain.json reader: env-first configuration lookup shared
         by every gate that used to read only process env (BLAS/LAPACK tiers,
         NETCDF_DIR, MSMPI_BIN). Written by the future `blade setup`. -->
    <Compile Include="src/Toolchain.fs" />
    <!-- Display frames: the {mime, data} rich-output wire format
         (Blade-REPL/docs/display-frames.md). Dependency-free string work, so
         it sits at the very front and is shared by everything that has to
         agree on the bytes: the display elaborator, TypeCheck's intrinsic,
         Interp (emission), CodeGen (its C++ mirror), and the REPL/serve
         session layer (extraction). -->
    <Compile Include="src/display/DisplayFrame.fs" />
    <Compile Include="src/Ast.fs" />
    <!-- Unified diagnostics: the Diagnostic record + BLxxxx registry +
         renderers. Needs only Ast.Span; every later phase constructs
         these directly. -->
    <Compile Include="src/Diagnostics.fs" />
    <Compile Include="src/Types.fs" />
    <!-- Env-gated compiler perf counters (docs/plan-compile-speed.md Stage 5).
         Dependency-free, and deliberately in FRONT of the pipeline: its two
         instrumented consumers (IR.fs and Unify.fs) sit ~175 entries apart in
         this list, so anything later than here is invisible to one of them. -->
    <Compile Include="src/PerfCounters.fs" />
    <Compile Include="src/Lexer.fs" />
    <Compile Include="src/Parser.fs" />
    <Compile Include="src/Grad.fs" />
    <!-- OrbIdx storage/indexing bijections (docs/plan-orbidx-bijections.md
         Phase 2, pure-function layer): the §4 checked cardinality fold, the §5
         canonicalizer, the §2 segment-peeled traversal stream, and the §3
         arithmetic rank/unrank pair. Deliberately dependency-free — FSharp.Core
         only, no Blade module is opened — so proofs/ scripts and external
         checkers can `#load` the file standalone. Sits here because IR.fs is
         its eventual consumer (the checked sibling of `binomI64`, IR.fs:2438),
         and nothing it needs compiles later. -->
    <Compile Include="src/OrbRank.fs" />
    <Compile Include="src/IR.fs" />
    <!-- Provider registry: the core<->provider seam (ProviderSpec records
         keyed by surface module name). Compiles after IR.fs and before the
         provider implementations that register into it. -->
    <Compile Include="src/providers/ProviderRegistry.fs" />
    <Compile Include="src/providers/NetcdfProvider.fs" />
    <Compile Include="src/providers/ZarrProvider.fs" />
    <Compile Include="src/providers/CsvProvider.fs" />
    <Compile Include="src/TypedAst.fs" />
    <Compile Include="src/Deduce.fs" />
    <!-- The generic half of an equivariance-family judgment (C3 stage 0,
         retired discipline-as-data design note): the structural walker arms whose
         soundness arguments quantify over ANY action. Must PRECEDE DeduceRep,
         which is its first instance. Same dependency set (Ast/Types/IR/
         TypedAst), nothing upward. -->
    <Compile Include="src/DisciplineKit.fs" />
    <Compile Include="src/DeduceRep.fs" />
    <Compile Include="src/StaticEval.fs" />
    <!-- Constrained records as index types — the SEMANTIC half: the static
         and index-eligibility fences, and the ENUMERATION reading of a
         struct's conjunct list (construction's reading stays in StaticEval /
         TypeCheck). Needs Ast + StaticEval only; must precede both
         StructIdxSpec.fs (its consumer) and TypeCheck.fs (which calls the
         static-struct fence from the struct registration arm). -->
    <Compile Include="src/StructIdxFence.fs" />
    <!-- Provider-backed statics bridge: registers the NetCDF compile-time
         data reader into StaticEval's provider hook (fold + provenance).
         Must follow both NetcdfProvider.fs and StaticEval.fs. -->
    <Compile Include="src/ProviderStatics.fs" />
    <!-- Constrained records as index types, stage C1 — the COUNTING half
         (retired constrained-index-types plan, §7). Box enumeration over the
         per-field inclusive bounds, the flat-filter vs arrow-heads
         certificate, and the `idx_card(R)` static builtin. A CORE feature,
         not an ml/ one: idx_card folds without `import ml`, so it registers
         into StaticEval's own builtin registry (the syntactic arm — its
         argument is a struct NAME, not a value). Needs Ast + StaticEval only;
         must precede TypeCheck.fs, which installs it. -->
    <Compile Include="src/StructIdxSpec.fs" />
    <!-- Staged-former unfold pass (staged tower Phase 1): eliminates
         `static method_for/object_for/for` before every elaboration stage.
         Needs Ast + StaticEval only; runs first in typeCheck's pipeline. -->
    <Compile Include="src/Unfold.fs" />
    <!-- Open where-clause constraint registry: extension modules register
         handlers for constraint keywords (PPL: indep); the checker
         dispatches WhereClause.Custom conjuncts through it. -->
    <Compile Include="src/Constraints.fs" />
    <!-- ML compiler layer (Blade.ML.*): spec model, CG tables, static
         builtins, ops elaboration. Lives under ml/compiler/ beside the
         BladeML reference project (which is a SEPARATE fsproj and does
         not compile these); core touchpoints are StaticEval's builtin
         registry and the MLElaborate.expand pipeline stage. -->
    <Compile Include="src/ml/compiler/MLSpec.fs" />
    <!-- The S_n permutation-module counting layer (stage 5a-i): RGS partition
         enumeration, the witness-unitriangularity certificate, and the
         perm_weight_dim/perm_bias_dim sizing arithmetic. Dependency-free
         integer code (not even MLSpec), so it sits beside MLSpec.fs and only
         has to precede MLStatics. NOT part of BladeML.fsproj — the ml/ oracle
         twin of the S_n arc is 5a-ii's exact-rational Reynolds block. -->
    <Compile Include="src/ml/compiler/MLPermSpec.fs" />
    <!-- Point groups, the second BLOCK-SPEC member (stage 5b-0): the frozen
         {C4, D4} integer tables + their load-time integrity certificate, the
         generic e-weighted counting core (MLSpec.homDim's TEST-PINNED TWIN,
         §3.6 "twin-not-reroute"), and the pgHomDim/pgHomBlocks sizing. Like
         MLPermSpec it is dependency-free integer code — deliberately NOT
         referencing MLSpec, since the twin pin lives in the test block — so it
         sits beside it and only has to precede MLStatics. NOT part of
         BladeML.fsproj; the ml/ oracle twin is tests/Test_PgOracle.fs. -->
    <Compile Include="src/ml/compiler/MLPointSpec.fs" />
    <Compile Include="src/ml/compiler/CartesianBridge.fs" />
    <Compile Include="src/ml/compiler/WignerTables.fs" />
    <!-- Sym^j(V_l) occurrence tables (stage 2b-i): needs MLSpec's powerSpec
         (count asserts) and WignerTables' uMatrix (realization), and must
         precede MLElaborate, which will consume the tables at 2b-iii.
         NOT part of BladeML.fsproj — the ml/ oracle twin is 2b-iii's. -->
    <Compile Include="src/ml/compiler/SymPowerTables.fs" />
    <Compile Include="src/ml/compiler/MLStatics.fs" />
    <!-- The abstract-interpretation walker shell (stage 5c): the syntactic
         walk (freeVars / patternVars / the left-to-right judge fold / the
         where-conjunct pre-scan) that MLEquiv, MLGalilean and MLPerm had
         verbatim in common. Rules stay in the three; only the walk is here,
         so it depends on nothing but Blade.Ast and must precede all three.
         NOT part of BladeML.fsproj (which compiles only compiler/MLSpec.fs). -->
    <Compile Include="src/ml/compiler/MLCertShell.fs" />
    <!-- The generator-based certification ENGINE, front half (stage 6b): the
         exact-rational polynomial extractor over the v1 closed-world fragment
         and the finite word-set discharge. Group-agnostic on purpose — it
         consumes integer matrices, never a registry — so 6c's radical-vector
         Lie discharger is a second CONSUMER of the same normal form. Depends
         on nothing but Blade.Ast / StaticEval and must precede MLEquiv, which
         calls it from judgeFunction's rejection path. NOT part of
         BladeML.fsproj. -->
    <Compile Include="src/ml/compiler/MLPolyExtract.fs" />
    <!-- The generator-based certification ENGINE, back half (stage 6c): the
         radical-vector module (Map<squarefree, Rat>), the exact so(3)
         generator tables per l derived against the coded uMatrix/harmonic
         conventions, and the Lie + (-I) discharge over MLPolyExtract's normal
         form. A SECOND CONSUMER of that normal form, not a second engine:
         it depends on MLPolyExtract (Rat/Mono/Poly/PolyForm) and MLSpec
         (block layout, parity) and must precede MLEquiv, which calls it from
         judgeFunction's rejection path for O3/SO3 certificates. NOT part of
         BladeML.fsproj; the oracle twin is tests/Test_LieTables.fs. -->
    <Compile Include="src/ml/compiler/MLLieDischarge.fs" />
    <!-- The engine's user-facing FAILURE TEXT, owned in one place. Pure
         functions of the two dischargers' failure records (so it must follow
         both) and consumed by BOTH front halves — MLEquiv's surface extractor
         and MLPolyExtractTyped's typed one — so it must precede the earlier of
         those, which is MLPolyExtractTyped. Depends on nothing else; it is
         string formatting and cap constants. NOT part of BladeML.fsproj. -->
    <Compile Include="src/ml/compiler/MLEquivMessages.fs" />
    <!-- Stage C2 of the retired equivariance-in-types plan: the TYPED front half of
         the same engine. Needs TypedAst + DeduceRep (both far earlier) and both
         dischargers (immediately above), so this is the earliest point it can
         sit; TypeCheck, which consumes it through DeduceRep's hook, is later
         still. -->
    <Compile Include="src/ml/compiler/MLPolyExtractTyped.fs" />
    <Compile Include="src/ml/compiler/MLEquiv.fs" />
    <Compile Include="src/ml/compiler/MLGalilean.fs" />
    <!-- The `where ml.perm_equiv(N)` certification lattice (stage 5a-iii):
         the THIRD registry member beside MLEquiv and MLGalilean, and the third
         copy of the abstract-interpretation walker shell that §7's stage 5c
         extracts. Needs MLPermSpec (the rank cap) and must precede
         MLElaborate, which runs the judgment at the equiv/galilean seam. -->
    <Compile Include="src/ml/compiler/MLPerm.fs" />
    <Compile Include="src/ml/compiler/MLElaborate.fs" />
    <!-- PPL compiler layer (Blade.Ppl.*): moment/comoment formers and
         declared independence, elaborated to plain Blade source. Lives
         under ppl/compiler/ beside the MomentAlgebra reference project
         (a SEPARATE fsproj); core touchpoint is the PplElaborate.expand
         pipeline stage in TypeCheck.typeCheck. -->
    <Compile Include="src/ppl/compiler/PplElaborate.fs" />
    <!-- Linear-algebra dispatch classification (Phase 5 of
         docs/plan-cpp-perf-exploitation.md): IR node / loop-nest shape ->
         typed LinAlgCall descriptor, plus the BLAS/LAPACK availability gates
         and the routing policy table. Depends on IR.fs and Types.fs ONLY (it
         matches IRExpr and the loop-nest records, all defined there), so it
         can sit this early — and it must, because THREE stages consult it and
         two of them precede codegen: MathElaborate reads `lapackAvailable ()`
         to decide whether `eigh` elaborates to the `__math_eigh` intrinsic or
         to synthesized Jacobi source (Phase 6 / Round B2); TypeCheck's
         `inferEigh` reads `classifyEigh` as the intrinsic's admissibility
         rule; and CodeGen consults the whole module instead of pattern-
         matching BLAS shapes itself. Moved here from just above CodeGen for
         exactly that reason — one definition of each gate, not three. -->
    <Compile Include="src/LinAlgPatterns.fs" />
    <!-- Math compiler layer (Blade.Math.*): tensor decompositions
         (Jacobi SVD/eigh, mode-n unfolding, HOSVD) elaborated to plain
         Blade source. Lives under math/compiler/ beside the BladeMath
         reference project (a SEPARATE fsproj); core touchpoint is the
         MathElaborate.expand pipeline stage in TypeCheck.typeCheck. -->
    <Compile Include="src/math/compiler/MathDecls.fs" />
    <Compile Include="src/math/compiler/MathElaborate.fs" />
    <Compile Include="src/rand/compiler/RandElaborate.fs" />
    <!-- display compiler layer (Blade.Display.Elaborate): `display.emit(mime,
         data)` -> the `__display_emit` intrinsic. Needs Ast + DisplayFrame
         only; core touchpoint is the DisplayElaborate.expand pipeline stage in
         TypeCheck.typeCheck. -->
    <Compile Include="src/display/compiler/DisplayElaborate.fs" />
    <!-- Spectra compiler layer (Blade.Spectra.*): FFT + arity-polymorphic
         polyspectra elaborated to plain Blade source. Lives under
         spectra/compiler/ beside the BladeSpectra oracle (a SEPARATE
         fsproj); core touchpoint is the SpectraElaborate.expand pipeline
         stage in TypeCheck.typeCheck. -->
    <Compile Include="src/spectra/compiler/SpectraDecls.fs" />
    <Compile Include="src/spectra/compiler/SpectraElaborate.fs" />
    <!-- sgs compiler layer (Blade.Sgs.*): subgrid-closure field formers
         (central-difference gradient, box filter, exact subgrid stress)
         elaborated to plain Blade source. Lives under sgs/compiler/ beside
         the BladeSgs physics oracle (a SEPARATE fsproj); reuses the
         Blade.Math.Decls AST helpers and the Blade.ML.CartesianBridge pack
         order (compile order), while its PIPELINE stage runs between ML and
         PPL (TypeCheck.typeCheck) so `where ml.galilean` bodies are judged
         with surface `sgs.*` calls still visible at ML's seam. -->
    <Compile Include="src/sgs/compiler/SgsDecls.fs" />
    <Compile Include="src/sgs/compiler/SgsElaborate.fs" />
    <Compile Include="src/IndexTypeValidator.fs" />
    <Compile Include="src/Unify.fs" />
    <Compile Include="src/TypeEnv.fs" />
    <Compile Include="src/Zonk.fs" />
    <Compile Include="src/TypeCheck.fs" />
    <!-- File-based module resolution: dotted import name -> .blade path, plus
         the transitive closure of an entry file's imports in dependency order.
         Needs Parser (import discovery) and ProviderRegistry/ProviderStatics
         (which names are provider pseudo-modules and must NOT be looked for on
         disk); must precede its three consumers — Ide.fs (`ide check` /
         `ide serve` resolve too), Lowering.fs (the multi-file diagnostics
         entry) and Cli.fs (compile / run / check / emit). -->
    <Compile Include="src/ModuleResolve.fs" />
    <Compile Include="src/Ide.fs" />
    <Compile Include="src/Lowering.fs" />
    <Compile Include="src/EmitCpp.fs" />
    <!-- Reynolds permutation term-plan (enumeration/dedup/ordering), extracted
         from CodeGen so a future IR interpreter can reuse the exact plan. Pure
         int/list logic; no IR/Types dependency, so it can precede CodeGen. -->
    <Compile Include="src/ReynoldsCore.fs" />
    <Compile Include="src/CodeGen.fs" />
    <!-- Tree-walking IR interpreter (differential twin of CodeGen; output must
         byte-match compiled binaries). Value = runtime value universe;
         CppFormat = iostream-parity printing; Numerics = bit-exact scalar and
         complex arithmetic; RandMirror = bit-exact blade_rand mirror. -->
    <Compile Include="src/Interp/Value.fs" />
    <Compile Include="src/Interp/CppFormat.fs" />
    <Compile Include="src/Interp/Numerics.fs" />
    <Compile Include="src/Interp/RandMirror.fs" />
    <Compile Include="src/Interp/ArrayOps.fs" />
    <Compile Include="src/Interp/Core.fs" />
    <Compile Include="src/Interp/Loops.fs" />
    <Compile Include="src/Interp/Print.fs" />
    <Compile Include="src/Interp/Run.fs" />
    <!-- Interpreter-backed REPL seam: lowerSession (one shared front-end pass)
         wraps Interp/Run.fs; consumed by Cli.replLoop. -->
    <Compile Include="src/Interp/Repl.fs" />
    <!-- The REPL's eval-once ENGINE (accumulating snippet list, rebind-in-place
         splicing, interp-first evaluation, ReplTypes annotation). Extracted
         from Cli.replLoop so `ide serve`'s notebook `eval` command drives the
         identical semantics; must follow Interp/Repl.fs (its lowering seam) and
         precede IdeServe.fs (its second front end). The g++ fallback lane is
         INJECTED by Cli.fs, which owns compileToExe. -->
    <Compile Include="src/ReplSession.fs" />
    <!-- `blade ide serve`: the NDJSON daemon wrapping Ide.fs's payload. Must
         follow Lowering.fs (the full tier monomorphizes) as well as Ide.fs,
         which is why it cannot live inside Ide.fs; must precede Cli.fs, which
         dispatches the verb and owns the serve regression block. -->
    <Compile Include="src/IdeServe.fs" />
    <Compile Include="src/Build.fs" />
    <!-- `blade doctor`: the native-toolchain health report. Real compile+run
         probes (the only reliable catch for the Windows PATH-shadow trap)
         over Build.fs's helpers and LinAlgPatterns' tier expansion; must
         follow Build.fs and precede Cli.fs, which dispatches the verb. -->
    <Compile Include="src/Doctor.fs" />
    <!-- `blade setup`: non-interactive bootstrap. Verifies every candidate
         config with Doctor's probes BEFORE persisting it to
         blade.toolchain.json; owns the OpenBLAS source build and the per-OS
         package-hint table. After Doctor.fs (verification), before Cli.fs
         (dispatch). -->
    <Compile Include="src/Setup.fs" />
    <Compile Include="tests/TestHarness.fs" />
    <Compile Include="tests/Expect.fs" />
    <Compile Include="tests/Corpus.fs" />
    <Compile Include="tests/Runner.fs" />
    <Compile Include="tests/InterpDiff.fs" />
    <Compile Include="tests/Test_Basic.fs" />
    <Compile Include="tests/Test_Loops.fs" />
    <Compile Include="tests/Test_Symmetry.fs" />
    <Compile Include="tests/Test_Reynolds.fs" />
    <Compile Include="tests/Test_Arity.fs" />
    <Compile Include="tests/Test_Functions.fs" />
    <Compile Include="tests/Test_Structs.fs" />
    <Compile Include="tests/Test_SumTypes.fs" />
    <Compile Include="tests/Test_Interfaces.fs" />
    <Compile Include="tests/Test_Modules.fs" />
    <!-- File-based module resolution (src/ModuleResolve.fs) and stdlib/units/SI.blade.
         Cannot be a corpus category: every case starts from a FILE ON DISK,
         which is the only way to reach the search path, the transitive walk and
         the cycle/duplicate checks. (Also `blade test module-resolve`.) -->
    <Compile Include="tests/Test_ModuleResolve.fs" />
    <Compile Include="tests/Test_Guards.fs" />
    <Compile Include="tests/Test_Bracketed.fs" />
    <Compile Include="tests/Test_IndexTypes.fs" />
    <!-- The OrbIdx bijection layer (src/OrbRank.fs): the traversal stream and
         the rank/unrank pair pinned against a BRUTE-FORCE canonicalization of
         every raw tuple — content and order — plus the hand-unrolled depth-2
         E/B/A nest and the depth-1 triangular-offset anchors. Pure integer,
         in-process, no Blade source pipeline. (Also `blade test orbrank`.) -->
    <Compile Include="tests/Test_OrbRank.fs" />
    <Compile Include="tests/OrbWreathTests.fs" />
    <Compile Include="tests/Test_Mutability.fs" />
    <Compile Include="tests/Test_Static.fs" />
    <Compile Include="tests/Test_Units.fs" />
    <Compile Include="tests/Test_Sqlish.fs" />
    <Compile Include="tests/Test_InferenceProbes.fs" />
    <Compile Include="tests/Test_FuncArrays.fs" />
    <Compile Include="tests/Test_Normalize.fs" />
    <Compile Include="tests/Test_Unify.fs" />
    <Compile Include="tests/Test_ValidateArrow.fs" />
    <Compile Include="tests/Test_ExprAttrs.fs" />
    <Compile Include="tests/Test_CodeGenSubst.fs" />
    <Compile Include="tests/Test_TypeStructure.fs" />
    <Compile Include="tests/Test_Shape.fs" />
    <Compile Include="tests/Test_Spans.fs" />
    <Compile Include="tests/Test_Diagnostics.fs" />
    <Compile Include="tests/Test_DiagCorpus.fs" />
    <Compile Include="tests/Test_RepDifferential.fs" />
    <Compile Include="tests/Test_RepCheckAgreement.fs" />
    <Compile Include="tests/Test_RepRejectCensus.fs" />
    <!-- MEASUREMENT SCAFFOLDING for the retired galilean-layer census: the
         experimental typed GALILEAN judgment and its two censuses. Lives in the
         test assembly deliberately — nothing in src/ may reference it, and it is
         not part of the full suite (verb `blade test gal-layer`). -->
    <Compile Include="tests/Test_GalLayerCensus.fs" />
    <!-- MEASUREMENT SCAFFOLDING for the retired perm-layer census: the experimental
         typed PERM judgment, its three censuses and the first-ever perm
         inference experiment. Test assembly only - nothing in src/ may
         reference it, and it is not part of the full suite
         (verb `blade test perm-layer`). -->
    <Compile Include="tests/Test_PermLayerCensus.fs" />
    <Compile Include="tests/Oracles.fs" />
    <Compile Include="tests/Test_Oracles.fs" />
    <Compile Include="tests/Test_WignerTables.fs" />
    <Compile Include="tests/Test_SymPowerTables.fs" />
    <Compile Include="tests/Test_PolyOracle.fs" />
    <Compile Include="tests/Test_LieTables.fs" />
    <Compile Include="tests/Test_PermSpec.fs" />
    <Compile Include="tests/Test_PermOracle.fs" />
    <!-- Constrained-record counting (stage C1): the module's own pins, then
         the INDEPENDENT third-route oracle. Two files on purpose — the oracle
         shares no helper, no fixture and no arithmetic with the block above
         it, which is the whole point of a third route. -->
    <Compile Include="tests/Test_StructIdxSpec.fs" />
    <Compile Include="tests/Test_StructIdxOracle.fs" />
    <Compile Include="tests/Test_PointSpec.fs" />
    <Compile Include="tests/Test_PgOracle.fs" />
    <Compile Include="tests/Test_CartesianBridge.fs" />
    <Compile Include="tests/Test_Ppl.fs" />
    <Compile Include="tests/Test_Math.fs" />
    <Compile Include="tests/Test_Rand.fs" />
    <!-- Display frames: the two corpus categories plus the in-process block
         that pins the frame BYTES and both channels (the REPL sentinel line on
         raw interpreter stdout, and `ide serve`'s display array on the real
         response encoder). Must follow IdeServe.fs, which is compiled with the
         src/ files far above. -->
    <Compile Include="tests/Test_Display.fs" />
    <Compile Include="tests/Test_Spectra.fs" />
    <Compile Include="tests/Test_Fallback.fs" />
    <Compile Include="tests/Test_Sgs.fs" />
    <Compile Include="tests/Differential.fs" />
    <Compile Include="tests/Benchmarks.fs" />
    <Compile Include="tests/CudaTests.fs" />
    <Compile Include="tests/OmpTests.fs" />
    <Compile Include="tests/LinAlgTests.fs" />
    <!-- Structural pins for `blade doctor`: row set/order, JSON shape, and
         the pinned-surface determinism (BLADE_BLAS=0 -> blas row off).
         Statuses of real probes are machine facts and are NOT asserted. -->
    <Compile Include="tests/DoctorTests.fs" />
    <!-- `blade setup` pure-half pins: parseArgs and the toolchain-file
         merge/remove roundtrip through the live Toolchain reader. -->
    <Compile Include="tests/SetupTests.fs" />
    <!-- Shape-monomorphization reach: which call sites earn a specialized copy
         (cross-module, self-recursive) and which must still decline. Emission
         text only — the decision is invisible in the values. -->
    <Compile Include="tests/ShapeSpecTests.fs" />
    <!-- Eigensolver dispatch emission + the inferEigh rejections (Phase 6 /
         Round B2). Separate block from LinAlgTests because the two gates,
         headers and defines are separate by design — and because this one must
         pin its gate across LOWERING, not just codegen: the eigh decision is
         made in MathElaborate, which runs inside typecheck. -->
    <Compile Include="tests/LapackTests.fs" />
    <Compile Include="tests/AllocTests.fs" />
    <Compile Include="tests/NetcdfTests.fs" />
    <Compile Include="tests/ZarrTests.fs" />
    <Compile Include="tests/CsvTests.fs" />
    <Compile Include="tests/MpiTests.fs" />
    <Compile Include="tests/HybridTests.fs" />
    <Compile Include="tests/DiffOracle.fs" />
    <Compile Include="tests/RunAll.fs" />
    <Compile Include="src/Cli.fs" />
    <Compile Include="src/Main.fs" />
  </ItemGroup>

  <!-- C++ runtime headers. Read at codegen time via AppContext.BaseDirectory.
       PreserveNewest copies on first build and on file change. The Link
       directive controls the destination subpath inside the output dir,
       so headers end up at bin/<config>/net7.0/cpp/ regardless of where
       dotnet run is invoked from. -->
  <!-- On-disk .blade test corpus (tests/Corpus.fs loads it). Copied next to
       the binary so the suite runs regardless of the working directory. -->
  <ItemGroup>
    <None Include="tests/corpus/**/*.blade">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Native-dependency pins (OpenBLAS tag/url). Copied beside the binary
         so the setup verb's source-build mode reads the manifest rather
         than embedding a drifting twin of it. -->
    <None Include="deps.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- The generated language surface (`blade ide surface`), checked in as the
         data half of the shared IDE-protocol package. Deployed beside the
         binary for the reason tests/corpus is: `blade test surface` compares
         this snapshot against a live render and must FAIL, not vacuously skip,
         when the suite runs from the output directory. No Link metadata, so
         the relative path is preserved (protocol/surface.json). -->
    <None Include="protocol/surface.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- The Blade standard library, in Blade source. ModuleResolve.fs looks for
       a `stdlib/` directory next to the running binary first (then walks up,
       so a dev tree finds <repo>/stdlib from bin/<config>/net7.0 too), which
       is why this copy exists: it makes `Blade.exe run` on a file that says
       `import units.SI` work from any working directory, with no environment
       variable set. The glob has no Link metadata, so each file keeps its
       relative path and lands at bin/config/net7.0/stdlib/units/SI.blade, the
       same arrangement tests/corpus/** already uses. BLADE_STDLIB overrides. -->
  <ItemGroup>
    <None Include="stdlib/**/*.blade">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- BLADE_RESTRICT / BLADE_IVDEP: the portable spellings codegen emits.
         Included by nested_array_utilities.hpp and blade_linalg_views.hpp, so
         it must ship wherever they do. -->
    <None Include="src/cpp/blade_portability.hpp">
      <Link>cpp/blade_portability.hpp</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="src/cpp/nested_array_utilities.hpp">
      <Link>cpp/nested_array_utilities.hpp</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="src/cpp/nested_array_types.hpp">
      <Link>cpp/nested_array_types.hpp</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="src/cpp/index_types.h">
      <Link>cpp/index_types.h</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="src/cpp/alloc_layout_tests.cpp">
      <Link>cpp/alloc_layout_tests.cpp</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="src/cpp/orbit_wreath_utilities.hpp">
      <Link>cpp/orbit_wreath_utilities.hpp</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="src/cpp/orb_wreath_tests.cpp">
      <Link>cpp/orb_wreath_tests.cpp</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="src/cpp/linearized_storage.hpp">
      <Link>cpp/linearized_storage.hpp</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="src/cpp/rand_runtime.hpp">
      <Link>cpp/rand_runtime.hpp</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="src/cpp/blade_runtime.hpp">
      <Link>cpp/blade_runtime.hpp</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="src/cpp/blade_linalg.hpp">
      <Link>cpp/blade_linalg.hpp</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- The BLAS-free half of the linalg layer (contiguity probe + staging
         views). Included by blade_linalg.hpp, and separately includable by
         cpp/linalg_probe_tests.cpp so the probe's regression suite runs on
         machines with no BLAS. -->
    <None Include="src/cpp/blade_linalg_views.hpp">
      <Link>cpp/blade_linalg_views.hpp</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- DEVICE (cuBLAS) dispatch, Round D. Two halves selected by __CUDACC__:
         extern "C" prototypes for the host .cpp (g++ cannot include the CUDA
         headers) and definitions for the companion .cu that Build.fs writes
         and nvcc compiles. -->
    <None Include="src/cpp/blade_linalg_cuda.hpp">
      <Link>cpp/blade_linalg_cuda.hpp</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Eigensolver dispatch (Phase 6 / Round B). LAPACK-only; included only
         by programs that emit a blade_lapack:: call. -->
    <None Include="src/cpp/blade_lapack.hpp">
      <Link>cpp/blade_lapack.hpp</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- ASan allocator-stats export (BLADE-MEMCHECK line at exit); included
         only by programs generated under BLADE_MEMCHECK=1. -->
    <None Include="src/cpp/blade_memcheck.hpp">
      <Link>cpp/blade_memcheck.hpp</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Round D's cuBLAS swap-table verification, compiled with nvcc and run
         by Blade.Tests.CudaTests.runCublasSwapTests (`blade test cuda`).
         Needs a real GPU, so it rides the opt-in CUDA phase. -->
    <None Include="src/cpp/cublas_swap_tests.cu">
      <Link>cpp/cublas_swap_tests.cu</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Runtime tests for the contiguity probe, compiled and run by
         Blade.Tests.LinAlgTests.runLinAlgProbeTests (`blade test linalg`). -->
    <None Include="src/cpp/linalg_probe_tests.cpp">
      <Link>cpp/linalg_probe_tests.cpp</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
