// TEST: p3b expm squaring stage as a matrix-valued let rec over a Step axis
import ad as ad
type I = Idx<2>
type Step = Idx<4>

function taylor6(a: Array<Float64 like I, I>) -> Array<Float64 like I, I> = {
    let id = [[1.0, 0.0], [0.0, 1.0]]
    let b = method_for(range<I>, range<I>) <@> lambda(i: I, j: I) -> a(i, j) / 8.0 |> compute
    let b2 = gram(b, transpose(b, [0, 1]))
    let b3 = gram(b2, transpose(b, [0, 1]))
    let b4 = gram(b3, transpose(b, [0, 1]))
    let b5 = gram(b4, transpose(b, [0, 1]))
    let b6 = gram(b5, transpose(b, [0, 1]))
    let t = method_for(range<I>, range<I>) <@> lambda(i: I, j: I) -> id(i, j) + b(i, j) + b2(i, j) / 2.0 + b3(i, j) / 6.0 + b4(i, j) / 24.0 + b5(i, j) / 120.0 + b6(i, j) / 720.0 |> compute
    t
}

// row 0 = T, row n = row(n-1)^2, so row 3 = T^8
function expm_rec(a: Array<Float64 like I, I>) -> Array<Float64 like I, I> = {
    let t = taylor6(a)
    let rec sq: Array<Float64 like Step, I, I> =
        match sq with
        | zero -> zero
        | zero :: s -> zero :: t
        | prefix :: n -> prefix :: gram(prefix(n - 1), transpose(prefix(n - 1), [0, 1]))
    let e = sq(3)
    e
}

function loss(a: Array<Float64 like I, I>) -> Float64 = {
    let e = expm_rec(a)
    2.0 * e(0, 1) + e(1, 1)
}

let A: Array<Float64 like I, I> = [[0.0, 0.5], [-0.5, 0.0]]
let E = expm_rec(A)
let alg_ok = abs(2.0 * E(0, 1) + E(1, 1) - 1.8364336391069036) < 0.00000000000001
// EXPECT: alg_ok = true
