// TEST: Physics -- The Observer Inside the Cascade: Kick + Bayes, Tower-Native
// ============================================================================
// The arc's two halves meet: example 34 made collisions OPERATORS ON TOWERS
// (the kick); the ppl tower-Bayes primitives make conditioning an operator
// on towers (the bookkeeping). This example runs a full measurement loop
// with both -- no ensemble anywhere in the inference path (grids appear
// only as ORACLES).
// THE SCENARIO: a hidden ball of unknown mass (in {0.92, 1.0, 1.08}, prior
// uniform) is buried behind four layers of fresh fuzzy medium. Each shot
// drives a sharp projectile through the whole chain; the hidden ball is
// STRUCK LAST and its exit velocity is read through an instrument of
// resolution sigma = 0.03 (knock-on spectroscopy: identify a buried mass
// by how fast it leaves when kicked). Two shots, fresh medium each time.
// FIRST FINDING -- IDENTIFIABILITY IS POSITIONAL (pinned): put the hidden
// ball at the NEAR end instead (interior once the front passes) and the
// three hypothesis means of the far-end arrival collapse to within 0.00017
// -- the telescope of ex 34 gauges interior masses away (their two roles
// cancel to O(w^2)). At the ENDPOINT the separation is 0.080: 467x more
// signal. The chain forgets its interior; an observer can only weigh what
// the product cannot cancel.
// The tower-native loop, per shot:
//   PREDICT   per-hypothesis predictive towers E[v^p | M = A_j] fall out
//             of the channel's CONDITIONAL STATE -- conditioning on the
//             last-struck mass IS the branch representation, so the
//             hypothesis bank is the state ex 34 already carries. Matrix
//             powers; twelve numbers; exact (pinned vs 3^4 grids, ~1e-15).
//   OBSERVE   the likelihood of a noisy read is an EXPECTATION under the
//             predictive tower: E[g(vhat - v)] = g + g''cm2/2 - g'''cm3/6
//             + g''''cm4/24. The medium's fuzz widens the instrument
//             (sigma_eff^2 = sigma^2 + kappa2 + ...), and the tower's
//             depth buys likelihood accuracy: the 4th-order jet matches
//             the exact grid likelihood ~19,000x closer than the mean-field
//             (spread-blind) one. Towers make better OBSERVERS, not just
//             better predictions.
//   UPDATE    Bayes on the 3-point latent is EXACT: any likelihood
//             restricted to the support is the quadratic
//             sum_j L_j l_j(m) (Lagrange), so the posterior is
//             dist_reweight(prior, c0, c1, c2) with runtime coefficients.
//             CONDITIONING SPENDS STOCHASTIC ORDER: the depth-6 prior
//             affords exactly two quadratic observations (6 -> 4 -> 2),
//             and the surviving order-2 posterior is spent whole on the
//             categorical readout (posterior probabilities = dist_expect
//             of the degree-2 Lagrange indicators, which partition unity
//             exactly). A third shot would need order the tower no longer
//             has -- the elaborator refuses (ppl corpus 048): AN
//             OBSERVER'S EVIDENCE BUDGET IS THE DEPTH OF THEIR TOWER.
// FINDINGS (pinned): channel = grid to 1e-15; jet likelihoods beat
// mean-field by ~19,000x against the exact grid likelihoods; the two-shot
// posterior lands on the true hypothesis (1.08) at 83.3%, ~1e-7 from
// the exact all-ensemble Bayes posterior (the jet likelihoods' own
// truncation -- the update itself reproduces the direct normalization of
// the same likelihoods to rounding); posterior mean 1.0666,
// posterior sd 0.030 -- the hidden ball, weighed through four layers of
// fuzz by an observer whose entire pipeline is towers.
// ============================================================================

import math as m

let MVAL = [0.92, 1.0, 1.08]
type Chan = Array<Float64 like Idx<12>, Idx<12>>

// ---- the kick: example 34's block channel (orders 1..4), powered to U^4 ----
// one collision's transfer factor: the front leaves mass i into mass j
function rho(i: Int64, j: Int64) -> Float64 = 2.0 * MVAL(i) / (MVAL(i) + MVAL(j))
// x^p as the explicit product chain x * x * ... * x (p factors)
function pow_chain(x: Float64, p: Int64) -> Float64 = if p < 2 then x else pow_chain(x, p - 1) * x
let U1: Chan = method_for(range<Idx<12>, Idx<12>>) <@> lambda(J: Int64, I: Int64) -> if J / 3 == I / 3 then pow_chain(rho(I % 3, J % 3), J / 3 + 1) / 3.0 else 0.0 |> compute
let U2: Chan = m.matmul(U1, U1)
let U4: Chan = m.matmul(U2, U2)

// ---- the interior case (the pinned negative): target struck FIRST, read
//      at the far end. Concentrated starts, four medium collisions after. ----
let W1H = method_for(range<Idx<3>, Idx<12>>) <@> lambda(h: Int64, J: Int64) -> if J % 3 == h then pow_chain(2.0 / (1.0 + MVAL(h)), J / 3 + 1) else 0.0 |> compute
let SINT = method_for(W1H, U4) <@> lambda(u: Array<Float64 like Idx<12>>, v: Array<Float64 like Idx<12>>) -> prodsum(u, v) |> compute
// each hypothesis's far-end mean: its state's order-1 cells, summed
let IM1 = reduce(method_for(range<Idx<3>, Idx<3>>) <@> lambda(h: Int64, j: Int64) -> SINT(h, j), (+))
let int_sep = abs(IM1(0) - IM1(2))

// ---- the endpoint case: target struck LAST. The channel's conditional
//      state IS the hypothesis bank: E[v5^p | m5 = A_j] = S5E(3(p-1)+j)
//      (uniform chain, the last-mass branches read off directly). ----
let M1 = method_for(range<Idx<12>>) <@> lambda(J: Int64) -> pow_chain(2.0 / (1.0 + MVAL(J % 3)), J / 3 + 1) |> compute
let S5E = method_for(U4) <@> lambda(row: Array<Float64 like Idx<12>>) -> prodsum(M1, row) |> compute
let mu0 = S5E(0)
let mu1 = S5E(1)
let mu2 = S5E(2)
let end_sep = abs(mu0 - mu2)
let pos_ratio = end_sep / int_sep
let pos_V = if pos_ratio > 20.0 then "INTERIOR_IS_GAUGE_ENDPOINT_IS_VISIBLE" else "NO"

// ---- grid oracles (3^4 medium per hypothesis h; target m5 = A_h fixed):
//      path r's four medium masses are its base-3 digits ----
function grid_front(r: Int64, h: Int64) -> Float64 =
    2.0 / (1.0 + MVAL(r % 3)) * rho(r % 3, (r / 3) % 3) * rho((r / 3) % 3, (r / 9) % 3) * rho((r / 9) % 3, r / 27) * rho(r / 27, h)
let GRID = method_for(range<Idx<3>, Idx<81>>) <@> lambda(h: Int64, r: Int64) -> grid_front(r, h) |> compute
let GMU = reduce(GRID, (+)) / 81.0
let gmu0 = GMU(0)
let gmu2 = GMU(2)
let chan_gap = abs(mu0 - gmu0) + abs(mu2 - gmu2)
let chan_V = if chan_gap < 1.0e-12 then "CHANNEL_MATCHES_GRID" else "NO"

// ---- the observations (two shots, fresh medium; sigma = 0.03, so
//      2 s^2 = 0.0018; the hidden truth behind these reads is 1.08) ----
let vh1 = 0.951
let vh2 = 0.964

// exact likelihoods from the grids (the oracle side): the instrument kernel
// averaged over each hypothesis's 81 medium paths, all three rows at once
let L1G = reduce(exp(0.0 - (vh1 - GRID) * (vh1 - GRID) / 0.0018), (+)) / 81.0
let L2G = reduce(exp(0.0 - (vh2 - GRID) * (vh2 - GRID) / 0.0018), (+)) / 81.0
let La1 = L1G(0)
let Lb1 = L1G(1)
let Lc1 = L1G(2)
let La2 = L2G(0)
let Lb2 = L2G(1)
let Lc2 = L2G(2)

// ---- the tower likelihoods: jet-smeared instrument, no ensemble. Hypothesis
//      j's predictive moments are S5E's branch-j cells; the kernel's
//      expectation is expanded to 4th order in their central moments.
//      s^2 = 0.0009, s^4 = 8.1e-7, s^6 = 7.29e-10, s^8 = 6.561e-13 ----
// the spread-blind (mean-field) likelihood: the kernel at the predictive mean
function mf_lik(vh: Float64, j: Int64) -> Float64 = exp(0.0 - (vh - S5E(j)) * (vh - S5E(j)) / 0.0018)
function jet_lik(vh: Float64, j: Int64) -> Float64 = {
    let mu = S5E(j)
    let c2 = S5E(3 + j) - mu * mu
    let c3 = S5E(6 + j) - 3.0 * mu * S5E(3 + j) + 2.0 * mu * mu * mu
    let c4 = S5E(9 + j) - 4.0 * mu * S5E(6 + j) + 6.0 * mu * mu * S5E(3 + j) - 3.0 * mu * mu * mu * mu
    let e = vh - mu
    mf_lik(vh, j) * (1.0 + (e * e / 8.1e-7 - 1.0 / 0.0009) * c2 / 2.0 - (0.0 - e * e * e / 7.29e-10 + 3.0 * e / 8.1e-7) * c3 / 6.0 + (e * e * e * e / 6.561e-13 - 6.0 * e * e / 7.29e-10 + 3.0 / 8.1e-7) * c4 / 24.0)
}
let T10 = jet_lik(vh1, 0)
let T11 = jet_lik(vh1, 1)
let T12 = jet_lik(vh1, 2)
let T20 = jet_lik(vh2, 0)
let T21 = jet_lik(vh2, 1)
let T22 = jet_lik(vh2, 2)
let jet_err = abs(T10 / La1 - 1.0) + abs(T11 / Lb1 - 1.0) + abs(T12 / Lc1 - 1.0)
let mf_err = abs(mf_lik(vh1, 0) / La1 - 1.0) + abs(mf_lik(vh1, 1) / Lb1 - 1.0) + abs(mf_lik(vh1, 2) / Lc1 - 1.0)
let dial_ratio = mf_err / jet_err
// jet_err ~ 2e-6 sits where the order-4 moment cancellation leaves the jet
// likelihood ~1e-10 of rounding (its last 3 digits move with FMA
// contraction), so the verdict pins the CLAIM: within 1e-5 of exact, four
// orders of magnitude better than mean-field
let dial_V = if jet_err < 1.0e-5 && dial_ratio > 1.0e4 then "TOWER_MAKES_BETTER_OBSERVERS" else "NO"

// ---- the bookkeeping: exact Bayes on the latent by Lagrange reweight.
//      Any likelihood on support {0.92, 1.0, 1.08} IS the quadratic
//      sum_j L_j l_j(m); indicator coefficient rows (columns 1, m, m^2):
//      l_0 = ( 84.375, -162.5,  78.125)
//      l_1 = (-155.25,  312.5, -156.25)
//      l_2 = ( 71.875, -150.0,  78.125) ----
import ppl as ppl
let MD: Array<Float64 like Idx<1>, Idx<3>> = [[0.92, 1.0, 1.08]]
let prior = ppl.dist(MD, 6)
let post1 = ppl.dist_reweight(prior, T10 * 84.375 + T11 * -155.25 + T12 * 71.875, T10 * -162.5 + T11 * 312.5 + T12 * -150.0, T10 * 78.125 + T11 * -156.25 + T12 * 78.125)
let post2 = ppl.dist_reweight(post1, T20 * 84.375 + T21 * -155.25 + T22 * 71.875, T20 * -162.5 + T21 * 312.5 + T22 * -150.0, T20 * 78.125 + T21 * -156.25 + T22 * 78.125)
let pmean = ppl.cumulant(post2, 1)
let pvar = ppl.cumulant(post2, 2)
// categorical readout: posterior probabilities = expectations of the
// degree-2 Lagrange indicators -- the surviving order, spent whole
let p_092 = ppl.dist_expect(post2, 84.375, -162.5, 78.125)
let p_100 = ppl.dist_expect(post2, -155.25, 312.5, -156.25)
let p_108 = ppl.dist_expect(post2, 71.875, -150.0, 78.125)
let psum = p_092 + p_100 + p_108
// the SAME two likelihood rows multiplied and normalized directly -- what an
// exact Bayes update on the 3-point latent must reproduce. The tower readout
// spends Lagrange coefficients of size ~150 on moments of size ~1, so it
// carries ~1e-10 of rounding: pinned as agreement, not as digits.
let zdir = T10 * T20 + T11 * T21 + T12 * T22
let PDIR = [T10 * T20, T11 * T21, T12 * T22] / zdir
let dmean = prodsum(PDIR, MVAL)
let dvar = prodsum(PDIR, MVAL * MVAL) - dmean * dmean
let readout_err = abs(p_092 - PDIR(0)) + abs(p_100 - PDIR(1)) + abs(p_108 - PDIR(2)) + abs(pmean(0) - dmean) + abs(pvar(0) - dvar)
let exact_V = if readout_err < 1.0e-8 then "TOWER_BAYES_IS_EXACT" else "NO"

// ---- the oracle Bayes: exact grid likelihoods, hand-normalized ----
let oz = La1 * La2 + Lb1 * Lb2 + Lc1 * Lc2
let o_108 = Lc1 * Lc2 / oz
// the tower's likelihoods are jets (truncated at order 4), so the posterior
// differs from the all-ensemble one by ~1e-7 -- the claim, with 2x margin
let bayes_gap = abs(p_108 - o_108)
let bayes_V = if bayes_gap < 2.0e-7 then "TOWER_BAYES_MATCHES_ORACLE" else "NO"
let win_V = if p_108 > p_100 && p_108 > p_092 && p_108 > 0.5 then "TRUE_HYPOTHESIS_WINS" else "NO"
let unity_V = if abs(psum - 1.0) < 1.0e-10 then "INDICATORS_PARTITION_UNITY" else "NO"

// positional identifiability; channel exactness; the likelihood dial;
// tower Bayes vs the all-ensemble oracle; the budget spent to the last
// order:
// EXPECT: int_sep = 0.000170939828914141
// EXPECT: end_sep = 0.0798714750773132
// EXPECT: pos_ratio = 467.249064098636
// EXPECT: pos_V = "INTERIOR_IS_GAUGE_ENDPOINT_IS_VISIBLE"
// EXPECT: mu0 = 1.03726308279479
// EXPECT: mu2 = 0.957391607717481
// EXPECT: chan_gap = 6.66133814775094e-16
// EXPECT: chan_V = "CHANNEL_MATCHES_GRID"
// EXPECT: La1 = 0.0165531037804856
// EXPECT: T12 = 0.973959217155912
// EXPECT: mf_err = 0.0397962072820295
// EXPECT: dial_V = "TOWER_MAKES_BETTER_OBSERVERS"
// EXPECT: pmean = [1.06658807503739]
// EXPECT: psum = 1.00000000000003
// EXPECT: exact_V = "TOWER_BAYES_IS_EXACT"
// EXPECT: o_108 = 0.833105472825543
// EXPECT: bayes_V = "TOWER_BAYES_MATCHES_ORACLE"
// EXPECT: win_V = "TRUE_HYPOTHESIS_WINS"
// EXPECT: unity_V = "INDICATORS_PARTITION_UNITY"
