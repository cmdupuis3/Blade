// TEST: Physics -- Collisions as Channels: Composing Towers Without Ensembles
// ============================================================================
// The composition gap (the review's #2, the reconstruction program's missing
// piece): every experiment so far ran parameters -> realizations ->
// statistics; the ensemble grew 3^K with depth. Here the collision becomes
// an OPERATOR ON TOWERS, and cascades compose at the tower level with a
// state that never grows.
// The move: condition on the shared mass. For the transmitted-front chain
// v' = v * rho(m, m'), rho_ij = 2 A_i/(A_i + A_j), with every mass an iid
// 3-point jet {0.92, 1.0, 1.08}, the tower state after each collision is
// the 3-branch conditional moment vector M[j][p] = E[v^p | last mass = j],
// and one collision acts EXACTLY and LINEARLY:
//     M'[j][p] = (1/3) sum_i rho_ij^p M[i][p].
// Each moment order rides its own 3x3 transfer matrix; the four orders
// stack into one block-diagonal 12x12 channel U. Composition = matrix
// powers (repeated squaring, five doublings to depth 20). FINDINGS:
//   * EXACT COMPOSITION, ZERO ENSEMBLES: at depth 6 the channel's four
//     moments match the exact 3^6-grid ensemble to ~1e-15 relative --
//     the channel is not an approximation of the ensemble, it IS the
//     ensemble's tower, transported. (Polynomial-in-v map + finite-support
//     jets => the hierarchy closes exactly order by order.)
//   * BEYOND ANY ENSEMBLE: the same state pushed to depth 20 -- where the
//     grid would need 3^20 = 3,486,784,401 realizations -- costs five
//     squarings of a 12x12 matrix. Pinned: E[v_20^p], p = 1..4. The
//     channel state is 12 numbers at every depth.
//   * A MEAN-TRANSFER IDENTITY AND THE AM-GM TAX: the naive independent-
//     factor model predicts E[rho] = 1 EXACTLY (rho_ij + rho_ji = 2,
//     pinned) -- mean front velocity conserved. The channel's true top
//     eigenvalue says otherwise: lambda_1 = 0.998930 = 1 - v0/2. Paired
//     transfers obey rho_ij rho_ji = 1 - f^2, so each collision taxes the
//     mean by HALF THE BOND VARIANCE of example 31 -- that spectrum's v0,
//     re-measured here as a decay rate. (And E[rho^2] - 1 = v0 exactly,
//     pinned: the same cell, third appearance.)
//   * THE FUZZ TELESCOPES: the moment hierarchy is nearly MARGINAL --
//     lambda_2/lambda_1^2 - 1 = 1.7e-6. Consecutive log-ratios
//     anticorrelate with the exact -1/2 additive structure (ex 31's
//     v1/v0 = -0.4999997), so the cascade's log-variance TELESCOPES to an
//     endpoint effect instead of random-walking: relative variance
//     saturates (0.00108 at depth 6 -> 0.00110 at depth 20, pinned)
//     instead of growing ~K. The intermittent residue exists -- but at
//     FOURTH order in the jet width, the same O(w^4) that broke
//     log-additivity in ex 31. A cascade of fuzzy masses forgets its
//     interior: only the first and last balls' fuzz survives in the
//     front velocity's tower.
//   * THE CLOSURE DIAL, ISOLATED: channels stay exact only while maps are
//     polynomial-reducible on the state. Part B pushes the observer's
//     RATIONAL inference increment ln[(2-v-eta)/(v+eta)] through jet
//     channels truncated at order r = 1, 2, 4 against the exact 5-point
//     noise: truncation errors fall monotonically in r cell by cell
//     (kappa1: 1.2e-5 -> 9.4e-11; kappa2: 4.6e-8 -> 1.4e-10) and compound
//     additively with depth. Where extension fails, the dial -- not the
//     ensemble -- is the honest object.
// The language angle: this file hand-rolls what a vector-valued dist_map /
// dist-through-pool should generate -- conditional-representation transfer
// matrices ARE the compiled form of "push a Dist through a collision".
// The channel calculus is the reconstruction program's missing operation:
// with it, towers meet dynamics without ever touching realizations.
// No external data; everything is range grids, table gathers, and
// m.matmul powers of one channel matrix.
// ============================================================================
import math as m

let MVAL = [0.92, 1.0, 1.08]
type Chan = Array<Float64 like Idx<12>, Idx<12>>

// one collision's transfer factor: the front leaves mass i into mass j
function rho(i: Int64, j: Int64) -> Float64 = 2.0 * MVAL(i) / (MVAL(i) + MVAL(j))
// x^p as the explicit product chain x * x * ... * x (p factors)
function pow_chain(x: Float64, p: Int64) -> Float64 = if p < 2 then x else pow_chain(x, p - 1) * x

// ---- the block channel U (12x12): order p = J/3 + 1, branches j = J%3;
//      cell (J, I) = rho_IJ^p / 3 inside order p's diagonal block ----
let U1: Chan = method_for(range<Idx<12>, Idx<12>>) <@> lambda(J: Int64, I: Int64) -> if J / 3 == I / 3 then pow_chain(rho(I % 3, J % 3), J / 3 + 1) / 3.0 else 0.0 |> compute

// ---- powers by repeated squaring ----
let U2: Chan = m.matmul(U1, U1)
let U4: Chan = m.matmul(U2, U2)
let U8: Chan = m.matmul(U4, U4)
let U16: Chan = m.matmul(U8, U8)
let U18: Chan = m.matmul(U16, U2)
let U19: Chan = m.matmul(U18, U1)
let U5: Chan = m.matmul(U4, U1)

// ---- initial state (depth 1: sharp projectile hits the first jet) ----
let M1 = method_for(range<Idx<12>>) <@> lambda(J: Int64) -> pow_chain(2.0 / (1.0 + MVAL(J % 3)), J / 3 + 1) |> compute
// row-kernel matvec: S_J = sum_I U^k[J][I] M1[I] -- the conditional update
// iterated k times
let S6 = method_for(U5) <@> lambda(row: Array<Float64 like Idx<12>>) -> prodsum(M1, row) |> compute
let S19 = method_for(U18) <@> lambda(row: Array<Float64 like Idx<12>>) -> prodsum(M1, row) |> compute
let S20 = method_for(U19) <@> lambda(row: Array<Float64 like Idx<12>>) -> prodsum(M1, row) |> compute

// ---- per-order means: the state as (order p, branch j), branches folded ----
function order_means(s: Array<Float64 like Idx<12>>) -> Array<Float64 like Idx<4>> =
    reduce(method_for(range<Idx<4>, Idx<3>>) <@> lambda(p: Int64, j: Int64) -> s(3 * p + j), (+)) / 3.0
let C6 = order_means(S6)
let C19 = order_means(S19)
let C20 = order_means(S20)
let c6p1 = C6(0)
let c6p2 = C6(1)
let c6p3 = C6(2)
let c6p4 = C6(3)
let c19p1 = C19(0)
let c19p2 = C19(1)
let c20p1 = C20(0)
let c20p2 = C20(1)
let c20p3 = C20(2)
let c20p4 = C20(3)

// ---- the exact 3^6 grid (the old way), for the cross-check: path r's
//      k-th mass is its k-th base-3 digit ----
let GM = method_for(range<Idx<6>, Idx<729>>) <@> lambda(k: Int64, r: Int64) -> MVAL((r / 3 ^ k) % 3) |> compute
let GX1 = 2.0 / (1.0 + GM(0))
let GX2 = GX1 * 2.0 * GM(0) / (GM(0) + GM(1))
let GX3 = GX2 * 2.0 * GM(1) / (GM(1) + GM(2))
let GX4 = GX3 * 2.0 * GM(2) / (GM(2) + GM(3))
let GX5 = GX4 * 2.0 * GM(3) / (GM(3) + GM(4))
let GX6 = GX5 * 2.0 * GM(4) / (GM(4) + GM(5))
let g6p1 = reduce(GX6, (+)) / 729.0
let g6p2 = prodsum(GX6, GX6) / 729.0
let g6p3 = reduce(GX6 * GX6 * GX6, (+)) / 729.0
let g6p4 = reduce(GX6 * GX6 * GX6 * GX6, (+)) / 729.0
let relgap1 = abs(c6p1 / g6p1 - 1.0)
let relgap2 = abs(c6p2 / g6p2 - 1.0)
let relgap3 = abs(c6p3 / g6p3 - 1.0)
let relgap4 = abs(c6p4 / g6p4 - 1.0)

// ---- spectral readout: growth rates, the mean-transfer identity, naive gap ----
let RHO = method_for(range<Idx<3>, Idx<3>>) <@> lambda(i: Int64, j: Int64) -> rho(i, j) |> compute
let erho1 = reduce(RHO, (+), axes = 2) / 9.0
let erho2 = reduce(RHO * RHO, (+), axes = 2) / 9.0
let lam1 = c20p1 / c19p1
let lam2 = c20p2 / c19p2
let itm = lam2 / (lam1 * lam1)
let grid20 = 3486784401.0
let rv6 = c6p2 / (c6p1 * c6p1) - 1.0
let rv20 = c20p2 / (c20p1 * c20p1) - 1.0
let amgm_tax = (1.0 - lam1) * 2.0

// ---- part B: the closure dial on a rational (inference) channel ----
// one calibration rung at v = 0.4: increment X = ln((2-v-eta)/(v+eta)) -
// ln((2-v)/v), noise = exact 5-point binomial (nodes +-2h, +-h, 0; h = 2e-3)
let NW = [1.0, 4.0, 6.0, 4.0, 1.0]
let NE = [-0.004, -0.002, 0.0, 0.002, 0.004]
// the increment at each noise node, exact and through each truncated jet,
// lifted over the five nodes; moments are NW-weighted sums (NW sums to 16)
let XE = log((1.6 - NE) / (0.4 + NE)) - log(4.0)
// r = 1 channel: X = h1 eta, h1 = -(1/(2-v) + 1/v) = -3.125
let XA = -3.125 * NE
// r = 2 channel: X += h2 eta^2 / 2, h2 = 1/v^2 - 1/(2-v)^2 = 5.859375
let XB = -3.125 * NE + 2.9296875 * NE * NE
// r = 4 channel: X += h3 eta^3/6 + h4 eta^4/24, h3 = -31.73828125,
// h4 = 233.45947265625
let XC = -3.125 * NE + 2.9296875 * NE * NE - 5.28971354166667 * NE * NE * NE + 9.72747802734375 * NE * NE * NE * NE
let xe1 = reduce(NW * XE, (+)) / 16.0
let xe2 = reduce(NW * XE * XE, (+)) / 16.0
let ke1 = xe1
let ke2 = xe2 - xe1 * xe1
let xa1 = reduce(NW * XA, (+)) / 16.0
let xa2 = reduce(NW * XA * XA, (+)) / 16.0
let ka1 = xa1
let ka2 = xa2 - xa1 * xa1
let xb1 = reduce(NW * XB, (+)) / 16.0
let xb2 = reduce(NW * XB * XB, (+)) / 16.0
let kb1 = xb1
let kb2 = xb2 - xb1 * xb1
let xc1 = reduce(NW * XC, (+)) / 16.0
let xc2 = reduce(NW * XC * XC, (+)) / 16.0
let kc1 = xc1
let kc2 = xc2 - xc1 * xc1
// truncation errors per cell and the dial
let ea1 = abs(ka1 - ke1)
let eb1 = abs(kb1 - ke1)
let ec1 = abs(kc1 - ke1)
let ea2 = abs(ka2 - ke2)
let eb2 = abs(kb2 - ke2)
let ec2 = abs(kc2 - ke2)
let chain4_err = 4.0 * eb2

// ---- verdicts ----
let exact_V = if relgap1 < 1.0e-10 && relgap2 < 1.0e-10 && relgap3 < 1.0e-10 && relgap4 < 1.0e-10 then "CHANNEL_MATCHES_GRID_EXACTLY" else "NO"
let mean_V = if abs(erho1 - 1.0) < 1.0e-15 then "MEAN_TRANSFER_IDENTITY" else "NO"
let drag_V = if lam1 < 1.0 then "COUPLING_DRAGS_THE_MEAN" else "NO"
let itm_V = if itm > 1.0 then "INTERMITTENT_MOMENT_HIERARCHY" else "NO"
let dial_V = if ec1 < eb1 && eb1 < ea1 && ec2 < eb2 && eb2 < ea2 then "CLOSURE_DIAL_MONOTONE" else "NO"

// the channel IS the ensemble's tower (machine-exact), composed to depths
// no grid can reach; the mean pays the AM-GM tax v0/2; the fuzz
// telescopes; the closure dial is monotone where exactness ends:
// EXPECT: c6p1 = 0.995727638387712
// EXPECT: c6p2 = 0.992543586494714
// EXPECT: c6p3 = 0.990435785692873
// EXPECT: c6p4 = 0.98939401357713
// EXPECT: relgap1 = 2.66453525910038e-15
// EXPECT: c20p1 = 0.980921519310032
// EXPECT: c20p2 = 0.96326863660244
// EXPECT: c20p3 = 0.946975408123225
// EXPECT: c20p4 = 0.931979999063015
// EXPECT: grid20 = 3486784401.0
// EXPECT: erho1 = 1.0
// EXPECT: erho2 = 1.00213675578932
// EXPECT: lam1 = 0.99893047883924
// EXPECT: lam2 = 0.997863813720907
// EXPECT: itm = 1.0000017158352
// EXPECT: amgm_tax = 0.00213904232151996
// EXPECT: rv6 = 0.00107925891446414
// EXPECT: rv20 = 0.00110330680103088
// EXPECT: ke1 = 1.17191391212912e-05
// EXPECT: ke2 = 3.9064028525626e-05
// EXPECT: ea1 = 1.1719139121291e-05
// EXPECT: eb1 = 3.89121291286855e-10
// EXPECT: ec1 = 2.21700912836353e-14
// EXPECT: ea2 = 1.52852562594966e-09
// EXPECT: eb2 = 1.32253197361099e-09
// EXPECT: ec2 = 6.64790284995477e-14
// EXPECT: chain4_err = 5.29012789444398e-09
// EXPECT: exact_V = "CHANNEL_MATCHES_GRID_EXACTLY"
// EXPECT: mean_V = "MEAN_TRANSFER_IDENTITY"
// EXPECT: drag_V = "COUPLING_DRAGS_THE_MEAN"
// EXPECT: itm_V = "INTERMITTENT_MOMENT_HIERARCHY"
// EXPECT: dial_V = "CLOSURE_DIAL_MONOTONE"
