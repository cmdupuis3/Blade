// TEST: Physics -- The Detector That Survives Noise: TICA/VAC In-Language
// ============================================================================
// Review-gap 3, closed. The arc's invariant detector (ex 09-16) reads
// conserved quantities as ZERO-VARIANCE combinations -- a criterion that
// dies at any measurement-noise floor. The noise-robust reformulation is
// the generalized eigenproblem C(tau) v = lambda C(0) v (TICA/VAC):
// white observation noise is lag-uncorrelated, so it inflates C(0) ONLY;
// invariants keep a tau-INDEPENDENT eigenvalue (a plateau) while every
// oscillating direction's eigenvalue moves with tau.
// ARCHITECTURE (halo rewrite): NO imperative loop remains -- the integrator
// is a RECURSIVE ARRAY. 8 velocity-Verlet trajectories of the 2D isotropic
// oscillator (1500 symplectic steps, h = 0.05) step together as a rank-3
// trajectory TRC(t, k, c); the exact-double LCG observation channel is a
// second recursive array (LCGS), and the noisy record TRN is the clean field
// plus each cell's own draw. The whole detector -- halo lag views,
// features, Grams, whitening, both lagged spectra, the Rayleigh probes and
// the energy-dispersion meter -- is ONE function, vac_detector, run on both
// records; every statistic in it is a pure sweep over the record.
// Dictionary: all 14 linear+quadratic monomials of (x, y, px, py).
// The clean VAC spectrum of this system is EXACTLY {1 x4, cos(tau) x4,
// cos(2 tau) x6}: the eigenvalue-1 subspace is the u(2) invariant algebra
// {Ex+Ey, Ex-Ey, Lz, xy+px py} (superintegrability made spectral), the
// linear monomials rotate at the orbital frequency, the remaining six
// quadratics at twice it. Lags: 12 and 24 steps (tau = 0.6, 1.2).
// FINDINGS (pinned):
//   * CLEAN: top four eigenvalues sit at 1 to ~1e-3 (Verlet floor); the
//     next cluster reads cos(0.6) = 0.8253 at lag 12 and cos(1.2) =
//     0.3624 at lag 24, the last six read cos(1.2) / cos(2.4) -- the
//     predicted trigonometric spectrum, measured.
//   * NOISE KILLS THE OLD DETECTOR: sigma = 0.1 observation noise lifts
//     the per-trajectory relative dispersion of E from the 1e-4 Verlet
//     floor to ~1e-1 -- three orders; every zero-variance verdict flips
//     VARIANT. The detector of ex 09-16 is structurally blind here.
//   * TICA SURVIVES: under the same noise the invariant quartet's
//     eigenvalues drop (each by its own noise load) but stay TOP and
//     PLATEAU: sum of top-4 |lambda(tau1) - lambda(tau2)| stays ~1e-2
//     while the 5th eigenvalue moves ~0.4 between the same two lags.
//     tau-independence, not magnitude, is the invariant's signature.
//   * THE DETECTOR VERDICT, REBORN PER QUANTITY: the Rayleigh quotient
//     lambda_v(tau) = v~' M(tau) v~ / v~'v~ is the noise-robust replacement
//     for the old dispersion test. Under noise the energy direction reads
//     ~0.88 at BOTH lags (plateau, |diff| = 0.003) while the oscillating
//     probe (x^2 - px^2) swings from +0.36 to -0.74 between the same two
//     lags. tau-independence per quantity -- immune even to the eigenvalue
//     near-degeneracies that mix the sorted eigenvectors.
// Two-route discipline: an independent F# route (same integrator/LCG,
// own Jacobi) reproduces every pin; the clean spectrum doubles as an
// analytic oracle (cos clusters known in closed form).
// ============================================================================
import math as m

// ---- initial conditions: spread in all four invariants ----
let ICS: Array<Float64 like Idx<8>, Idx<4>> = [
  [2.0, 0.1, 0.0, 1.6],
  [1.9, 0.1, 0.9, 0.1],
  [1.6, -0.9, 0.8, 0.3],
  [0.4, 1.3, 0.9, -0.2],
  [1.0, 0.5, -1.2, 0.9],
  [0.3, -0.8, 1.5, 0.7],
  [1.8, 1.1, 0.2, -1.1],
  [0.1, 1.7, 0.1, -1.2]
]

// ---- the 14-monomial dictionary as pair tables: feature f is coordinate
//      pa(f) for f < 4 (pb = -1 sentinel), else coord pa(f) * coord pb(f) ----
let pa = [0, 1, 2, 3, 0, 1, 2, 3, 0, 0, 0, 1, 1, 2]
let pb = [-1, -1, -1, -1, 0, 1, 2, 3, 1, 2, 3, 2, 3, 3]

// ---- integrate + emit, sigma = 0.0: the integrator is now a RECURSIVE
//      ARRAY (the imperative for-in is gone). Coordinate c of trajectory k at
//      step t lives at TRC(t, k, c) -- the same interleaved record as the old
//      flat cell 4*(1500 k + t) + c, indexed rank-3. ----
// one symplectic velocity-Verlet step of all 8 oscillators at once: each row
// of the 8 x 4 field carries one trajectory's (x, y, px, py); the substituted
// closed form of the leapfrog (px' reads the already-updated x) is written out
// per component.
function vstep8(prev: Array<Float64 like Idx<8>, Idx<4>>) -> Array<Float64 like Idx<8>, Idx<4>> =
    (method_for(range<Idx<8>, Idx<4>>) <@> lambda(k: Int64, c: Int64) -> {
        let x = prev(k, 0)
        let y = prev(k, 1)
        let px = prev(k, 2)
        let py = prev(k, 3)
        let pxh = px - 0.025 * x
        let pyh = py - 0.025 * y
        let xn = x + 0.05 * pxh
        let yn = y + 0.05 * pyh
        if c < 1 then xn else if c < 2 then yn else if c < 3 then pxh - 0.025 * xn else pyh - 0.025 * yn
    }) |> compute
// the 8 velocity-Verlet trajectories as a recursive array over time: leading
// axis is the 1500 symplectic steps, each slice is the whole 8 x 4 ensemble
// stepped once from the previous slice (seeded by one step off the ICS). The
// sigma = 0 channel is exactly this clean field (the old noise term was * 0.0).
let rec TRC: Array<Float64 like Idx<1500>, Idx<8>, Idx<4>> =
    match TRC with
    | zero -> zero
    | zero :: s -> zero :: vstep8(ICS)
    | prefix :: n -> prefix :: vstep8(prefix(n - 1))

// ---- the VAC detector, written once and run on both records. Every
//      statistic is a pure sweep over the record:
//   * interior + lagged phase-space views via halo<Idx<1500>, [-12, -24]>
//     -- the reach shrinks each collision to its 1476-step interior
//     (t = 24..1499, the old hand-gate and ring buffer, now in the type);
//   * the 14 linear+quadratic monomial features from the pa/pb pair tables;
//   * Gram / lagged cross-Gram matrices as row-pair prodsum sweeps;
//   * whitening by C(0)'s eigenfactor, both lagged spectra, and the two
//     probe directions' Rayleigh quotients;
//   * per-collision energy dispersion as a CENTERED row kernel over each
//     trajectory's energy series (the raw-moment form loses 7 digits to
//     cancellation on the clean record), max-folded. ----
// A B^T for 14 x 14 matrices (rows of A against rows of B)
function mnt14(a: Array<Float64 like Idx<14>, Idx<14>>, b: Array<Float64 like Idx<14>, Idx<14>>) -> Array<Float64 like Idx<14>, Idx<14>> =
    method_for(a, b) <@> lambda(u: Array<Float64 like Idx<14>>, v: Array<Float64 like Idx<14>>) -> prodsum(u, v) |> compute
// the Rayleigh quotient v'Mv / v'v, its double sum folded i-major, j-inner
function rayleigh(v: Array<Float64 like Idx<14>>, mat: Array<Float64 like Idx<14>, Idx<14>>) -> Float64 =
    reduce(method_for(range<Idx<14>, Idx<14>>) <@> lambda(i: Int64, j: Int64) -> v(i) * mat(i, j) * v(j), (+), axes = 2) / prodsum(v, v)
// one trajectory's relative E dispersion, CENTERED before squaring: the
// raw-moment form E[E^2] - E[E]^2 cancels to 5e-8 of E^2 on the clean
// record and hands its rounding to the result amplified 2e7-fold
function rel_dispersion(r: Array<Float64 like Idx<1476>>) -> Float64 = {
    let em = reduce(r, (+)) / 1476.0
    let d = r - em
    sqrt(prodsum(d, d) / 1476.0) / em
}
// returns (lag-12 spectrum, lag-24 spectrum, energy-direction Rayleigh
// quotients at the two lags, oscillating-probe quotients at the two lags,
// the largest per-collision relative E dispersion)
function vac_detector(tr: Array<Float64 like Idx<1500>, Idx<8>, Idx<4>>) -> (Array<Float64 like Idx<14>>, Array<Float64 like Idx<14>>, Float64, Float64, Float64, Float64, Float64) = {
    let va = method_for(range<Idx<8>, halo<Idx<1500>, [-12, -24]>, Idx<4>>) <@> lambda(k, w, c) -> tr(w(0), k, c) |> compute
    let vl = method_for(range<Idx<8>, halo<Idx<1500>, [-12, -24]>, Idx<4>>) <@> lambda(k, w, c) -> tr(w(-12), k, c) |> compute
    let vm = method_for(range<Idx<8>, halo<Idx<1500>, [-12, -24]>, Idx<4>>) <@> lambda(k, w, c) -> tr(w(-24), k, c) |> compute
    // feature f is coordinate pa(f) for f < 4, else the product pa(f) x pb(f);
    // the flat column u ravels (collision, interior step)
    let ji = method_for(range<Idx<14>, Idx<11808>>) <@> lambda(f, u) -> {
        let k = u / 1476
        let t = u - 1476 * k
        if pb(f) < 0 then va(k, t, pa(f)) else va(k, t, pa(f)) * va(k, t, pb(f))
    } |> compute
    let jl = method_for(range<Idx<14>, Idx<11808>>) <@> lambda(f, u) -> {
        let k = u / 1476
        let t = u - 1476 * k
        if pb(f) < 0 then vl(k, t, pa(f)) else vl(k, t, pa(f)) * vl(k, t, pb(f))
    } |> compute
    let jm = method_for(range<Idx<14>, Idx<11808>>) <@> lambda(f, u) -> {
        let k = u / 1476
        let t = u - 1476 * k
        if pb(f) < 0 then vm(k, t, pa(f)) else vm(k, t, pa(f)) * vm(k, t, pb(f))
    } |> compute
    // feature means, the Gram and the two lagged cross-Grams (symmetrized)
    let mu = method_for(ji) <@> lambda(r: Array<Float64 like Idx<11808>>) -> reduce(r, (+)) / 11808.0 |> compute
    let s0 = method_for(ji, ji) <@> lambda(ua: Array<Float64 like Idx<11808>>, ub: Array<Float64 like Idx<11808>>) -> prodsum(ua, ub) |> compute
    let sl = method_for(jl, ji) <@> lambda(ua: Array<Float64 like Idx<11808>>, ub: Array<Float64 like Idx<11808>>) -> prodsum(ua, ub) |> compute
    let sm = method_for(jm, ji) <@> lambda(ua: Array<Float64 like Idx<11808>>, ub: Array<Float64 like Idx<11808>>) -> prodsum(ua, ub) |> compute
    let c0: Array<Float64 like Idx<14>, Idx<14>> = method_for(range<Idx<14>, Idx<14>>) <@> lambda(i: Int64, j: Int64) -> s0(i, j) / 11808.0 - mu(i) * mu(j) |> compute
    let c12 = method_for(range<Idx<14>, Idx<14>>) <@> lambda(i: Int64, j: Int64) -> (sl(i, j) + sl(j, i)) / 2.0 / 11808.0 - mu(i) * mu(j) |> compute
    let c24 = method_for(range<Idx<14>, Idx<14>>) <@> lambda(i: Int64, j: Int64) -> (sm(i, j) + sm(j, i)) / 2.0 / 11808.0 - mu(i) * mu(j) |> compute
    // whiten by C(0): W = C(0)^(-1/2), M(tau) = W C(tau) W
    let (q0, l0) = m.eigh(c0)
    let qs = method_for(range<Idx<14>, Idx<14>>) <@> lambda(i: Int64, k: Int64) -> q0(i, k) / sqrt(l0(k)) |> compute
    let wh = mnt14(qs, q0)
    let m12: Array<Float64 like Idx<14>, Idx<14>> = mnt14(mnt14(wh, c12), wh)
    let m24: Array<Float64 like Idx<14>, Idx<14>> = mnt14(mnt14(wh, c24), wh)
    let (u12, lt12) = m.eigh(m12)
    let (u24, lt24) = m.eigh(m24)
    // the probe directions in whitened coordinates (W^-1 = C(0)^(1/2)):
    // energy E_x + E_y, and the oscillating x^2 - px^2
    let qt = method_for(range<Idx<14>, Idx<14>>) <@> lambda(i: Int64, k: Int64) -> q0(i, k) * sqrt(l0(k)) |> compute
    let w1 = mnt14(qt, q0)
    let ve = method_for(range<Idx<14>>) <@> lambda(i: Int64) -> 0.5 * (w1(i, 4) + w1(i, 5) + w1(i, 6) + w1(i, 7)) |> compute
    let vo = method_for(range<Idx<14>>) <@> lambda(i: Int64) -> w1(i, 4) - w1(i, 6) |> compute
    // per-collision energy series (half the squared phase-space norm) and
    // their relative dispersions
    let eo = 0.5 * reduce(va ^ 2.0, (+))
    let rel = method_for(eo) <@> lambda(r: Array<Float64 like Idx<1476>>) -> rel_dispersion(r) |> compute
    (lt12, lt24, rayleigh(ve, m12), rayleigh(ve, m24), rayleigh(vo, m12), rayleigh(vo, m24), reduce(rel, lambda(a, b) -> if a > b then a else b))
}

// ---- sigma = 0.0: the clean record ----
let (LT12C, LT24C, rE12C, rE24C, rO12C, rO24C, dmaxC) = vac_detector(TRC)
let lt12aC = LT12C(0)
let lt12dC = LT12C(3)
let lt12eC = LT12C(4)
let lt12iC = LT12C(8)
let lt24eC = LT24C(4)
// the invariant quartet's lag drift (top four) vs the 5th eigenvalue's
let plC = reduce(method_for(range<Idx<4>>) <@> lambda(k: Int64) -> abs(LT12C(k) - LT24C(k)), (+))
let omC = abs(LT12C(4) - LT24C(4))

// ---- sigma = 0.1: the SAME clean field plus an LCG noise channel. The
//      observation-noise LCG (physics/44's serial recurrence) is itself a
//      RECURSIVE ARRAY over the emitted-cell index: LCGS(v) is the (v+1)-th
//      draw from seed 20260717 (cell 4*(1500 k + t) + c uses draw
//      4*(1500 k + t) + c, matching the old in-order advance). ----
let rec LCGS: Array<Float64 like Idx<48000>> =
    match LCGS with
    | zero -> zero
    | zero :: s -> zero :: 20260717.0 * 48271.0 - floor(20260717.0 * 48271.0 / 2147483647.0) * 2147483647.0
    | prefix :: n -> prefix :: prefix(n - 1) * 48271.0 - floor(prefix(n - 1) * 48271.0 / 2147483647.0) * 2147483647.0
// the noisy record: clean coordinate + this cell's own scaled LCG draw
let TRN: Array<Float64 like Idx<1500>, Idx<8>, Idx<4>> = method_for(range<Idx<1500>, Idx<8>, Idx<4>>) <@> lambda(t: Int64, k: Int64, c: Int64) -> TRC(t, k, c) + (LCGS(4 * (1500 * k + t) + c) / 2147483647.0 - 0.5) * 3.46410161513775 * 0.1 |> compute
let (LT12N, LT24N, rE12N, rE24N, rO12N, rO24N, dmaxN) = vac_detector(TRN)
let lt12aN = LT12N(0)
let lt12dN = LT12N(3)
let lt12eN = LT12N(4)
let lt12iN = LT12N(8)
let lt24eN = LT24N(4)
let plN = reduce(method_for(range<Idx<4>>) <@> lambda(k: Int64) -> abs(LT12N(k) - LT24N(k)), (+))
let omN = abs(LT12N(4) - LT24N(4))

// ---- verdicts ----
let cleanV = if lt12dC > 0.99 && lt12eC < 0.9 then "FOUR_INVARIANTS_AT_ONE" else "NO"
let cosV = if abs(lt12eC - 0.825336) < 0.05 && abs(lt12iC - 0.362358) < 0.08 then "COS_CLUSTERS_AS_PREDICTED" else "NO"
let killV = if dmaxC < 0.001 && dmaxN > 0.05 then "ZERO_VARIANCE_DETECTOR_KILLED" else "NO"
let plateauV = if plN < 0.05 && omN > 0.1 then "INVARIANTS_PLATEAU_UNDER_NOISE" else "NO"
let rayV = if abs(rE12N - rE24N) < 0.02 && rE12N > 0.8 && abs(rO12N - rO24N) > 0.5 then "ENERGY_PLATEAUS_OSCILLATOR_MOVES" else "NO"

// the spectrum, the kill, the plateau, the recovery:
// EXPECT: lt12aC = 1.00636317473505
// EXPECT: lt12dC = 1.00002561504601
// EXPECT: lt12eC = 0.829776702463998
// EXPECT: lt12iC = 0.362270476478817
// EXPECT: lt24eC = 0.370016822317159
// EXPECT: cleanV = "FOUR_INVARIANTS_AT_ONE"
// EXPECT: cosV = "COS_CLUSTERS_AS_PREDICTED"
// EXPECT: plC = 0.000113032431726223
// EXPECT: omC = 0.459759880146839
// EXPECT: rE12C = 0.999991281219178
// EXPECT: rE24C = 1.00000642780998
// EXPECT: rO12C = 0.362274679654077
// EXPECT: rO24C = -0.737624341874798
// EXPECT: dmaxC = 0.000220805423860011
// EXPECT: dmaxN = 0.11991037124116
// EXPECT: killV = "ZERO_VARIANCE_DETECTOR_KILLED"
// EXPECT: lt12aN = 0.986011029932157
// EXPECT: lt12dN = 0.845388597692952
// EXPECT: lt12eN = 0.820554575143416
// EXPECT: lt12iN = 0.355131300761363
// EXPECT: lt24eN = 0.364657568355723
// EXPECT: plN = 0.0140412641665086
// EXPECT: omN = 0.455897006787693
// EXPECT: plateauV = "INVARIANTS_PLATEAU_UNDER_NOISE"
// EXPECT: rE12N = 0.881436112112715
// EXPECT: rE24N = 0.884377231310071
