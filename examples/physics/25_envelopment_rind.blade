// TEST: Physics -- The Rind: Enveloped in a Ball That Might Be There
// ============================================================================
// Two balls at known density, mass ratio 1000. The big one (M = 1000,
// R_B = 10, sharp) rests at the origin; the small one's mass is known only
// to TWO ORDERS OF MAGNITUDE (7-point log jet, m in [0.05, 20], so
// R_s in [0.37, 2.71]). The band of POSSIBLE contact surfaces -- the RIND,
// [10.37, 12.71], built from the small ball's OWN size uncertainty since
// contact sits at R_B + R_s -- is wider than the small ball itself. So "it
// could be inside the big one, in some sense". This example makes the sense
// precise, at T = 3.8 inside the fuzzy contact band:
//   * INSIDE THE ACTUAL BALL: never. The joint gap g = x_s - x_B - 10 - R_s
//     is >= 0 in every realization (min 0.19 here): P_joint(overlap) = 0,
//     EXACTLY. But the PRODUCT OF MARGINALS -- position decorrelated from
//     size -- overlaps with probability 15/49 = 0.31, up to 1.51 deep.
//     Impenetrability is INVISIBLE in the marginals; the law is stored in
//     the position-size cross-cumulants (the exclusion analogue of example
//     06's conservation-as-correlation).
//   * AND THE TOWER CAN TELL: a gap law must be a STIELTJES moment sequence
//     (support in [0, inf)). Both towers share the same mean (0.6599 --
//     decorrelation preserves first moments), but the shifted Hankel
//     m1 m3 - m2^2 is +0.086 for the joint tower and -1.485 for the
//     product tower: the decorrelated description is provably NOT a
//     nonnegative-gap law, from three moments alone. Impenetrability is a
//     realizability constraint on the joint tower.
//   * INSIDE THE MEAN BALL: genuinely -- P = 4/7. And 4/7 of realizations
//     have their WHOLE BODY below the outer possible surface: enveloped by
//     the rind. Inside the mean ball, wrapped in its own uncertainty shell,
//     never inside the actual ball.
//   * (tools/envelopment.ps1 also prints the SOFT WALL: the ensemble of
//     hard turning points is a diffuse sigmoid edge -- the classical shadow
//     of the nuclear optical model's surface diffuseness. Every realization
//     is hard; the ensemble description is soft.)
// ============================================================================
import ppl as ppl
let XS = [11.2, 11.2, 11.2, 11.2, 11.583916725, 12.6863910271, 14.169446307]
let XB = [0.0, 0.0, 0.0, 0.0, -0.00103657515753, -0.0109992936009, -0.059388926141]
let RS = [0.368403149864, 0.531329284591, 0.736806299728, 1.0, 1.39247665008, 1.94869516037, 2.71441761659]

// Each realization's gap is g = x_s - x_B - R_B - R_s: the position part
// x_s - x_B - R_B belongs to the position realization, R_s to the size one.
// The two ensembles then differ in ONE word. JOINT: realization k's position
// with realization k's own size -- co-iteration, zip. PRODUCT OF MARGINALS:
// every position realization with every size realization -- the outer
// product, 7 x 7 = 49 pairs.
let XG = XS - XB - 10.0
let GJ = method_for(zip(XG, RS)) <@> lambda(g, r) -> g - r |> compute
let GP = method_for(XG, RS) <@> lambda(g, r) -> g - r |> compute

// --- joint ensemble: overlap count and gap moments ---
let CJ = reduce(method_for(GJ) <@> lambda(g) -> (if g < 0.0 then 1.0 else 0.0), (+))
let P_joint = CJ / 7.0
// read the gap's raw moment tower off the former: the Stieltjes test below
// needs orders 1..3 of the SAME derived quantity.
let GJV: Array<Float64 like Idx<1>, Idx<7>> = [GJ]
let gj1 = ppl.moments(GJV, 1)
let gj2 = ppl.moments(GJV, 2)
let gj3 = ppl.moments(GJV, 3)
let Jm1 = gj1(0)
let Jm2 = gj2(0)
let Jm3 = gj3(0)
let sHJ = Jm1 * Jm3 - Jm2 * Jm2
let joint_V = if P_joint < 0.001 then "EXCLUDED" else "OVERLAPS"
let lawJ_V = if sHJ > 0.0 then "STIELTJES_OK" else "STIELTJES_VIOLATED"

// --- product of marginals: position-realization i paired with size-realization j ---
let CP = reduce(method_for(GP) <@> lambda(g) -> (if g < 0.0 then 1.0 else 0.0), (+), axes = 2)
let P_prod = CP / 49.0
let DP = reduce(method_for(GP) <@> lambda(g) -> (if g < 0.0 then 0.0 - g else 0.0), (+), axes = 2)
let meanDepth = DP / CP
// the decorrelated gap, same three raw orders. Its sample fiber is 2-D
// (7 positions x 7 sizes) and a former reads a 1-D one, so the three power
// sums come from one <&!>-fused sweep of the grid instead.
let LP = method_for(GP)
let (PR1, PR2, PR3) = reduce((LP <@> lambda(g) -> g) <&!> (LP <@> lambda(g) -> g * g) <&!> (LP <@> lambda(g) -> g * g * g), (+))
let Pm1 = PR1 / 49.0
let Pm2 = PR2 / 49.0
let Pm3 = PR3 / 49.0
let sHP = Pm1 * Pm3 - Pm2 * Pm2
let prod_V = if P_prod < 0.001 then "EXCLUDED" else "OVERLAPS"
let lawP_V = if sHP > 0.0 then "STIELTJES_OK" else "STIELTJES_VIOLATED"

// --- inside, in what sense: the mean ball and the rind's outer edge ---
let RSV: Array<Float64 like Idx<1>, Idx<7>> = [RS]
let rs1 = ppl.moments(RSV, 1)
let wallMean = 10.0 + rs1(0)
let rindOut = 10.0 + RS(6)
let CM = reduce(method_for(XS) <@> lambda(x) -> (if x < 11.2417325945 then 1.0 else 0.0), (+))
let P_inMean = CM / 7.0
let CR = reduce(method_for(zip(XS, RS)) <@> lambda(x, r) -> (if x + r < 12.7144176166 then 1.0 else 0.0), (+))
let P_rind = CR / 7.0

// never inside the actual ball; often inside the mean one, wrapped in the
// rind; and the decorrelated tower fails the Stieltjes test from 3 moments:
// EXPECT: P_joint = 0.0
// EXPECT: Jm1 = 0.659864384682347
// EXPECT: sHJ = 0.0855702802184315
// EXPECT: joint_V = "EXCLUDED"
// EXPECT: P_prod = 0.306122448979592
// EXPECT: meanDepth = 0.755506078712937
// EXPECT: Pm1 = 0.659864384682347
// EXPECT: sHP = -1.48467723727151
// EXPECT: prod_V = "OVERLAPS"
// EXPECT: lawJ_V = "STIELTJES_OK"
// EXPECT: P_inMean = 0.571428571428571
// EXPECT: P_rind = 0.571428571428571
// EXPECT: lawP_V = "STIELTJES_VIOLATED"