     f(61), f(62), f(63), f(64), f(65), f(66), f(67), f(68), f(69), f(70), 
     f(71), f(72), f(73), f(74), f(75), f(76), f(77), f(78), f(79), f(80), 
     f(81), f(82), f(83), f(84), f(85), f(86), f(87), f(88), f(89), f(90), 
     f(91), f(92), f(93), f(94), f(95), f(96), f(97), f(98), f(99), f(100), 
     f(101), f(102), f(103), f(104), f(105), f(106), f(107), f(108), f(109), 
     f(110), f(111), f(112), f(113), f(114), f(115), f(116), f(117), f(118), 
     f(119), f(120), f(121), f(122), f(123), f(124), f(125)
]
function as_k2(f: Array<Float like Idx<36>>) -> Array<Float like IrrepsIdx<JETK2>> = [
     f(0), f(1), f(2), f(3), f(4), f(5), f(6), f(7), f(8), f(9), f(10), 
     f(11), f(12), f(13), f(14), f(15), f(16), f(17), f(18), f(19), f(20), 
     f(21), f(22), f(23), f(24), f(25), f(26), f(27), f(28), f(29), f(30), 
