     f(81), f(82), f(83), f(84), f(85), f(86), f(87), f(88), f(89), f(90), 
     f(91), f(92)
]
function xc_tr(n: Int) -> Array<Float like IrrepsIdx<JETPAIR>> = {
    let rec o: Array<Float like Idx<126>> =
        match o with
