    f(245), f(246), f(247), f(248), f(249), f(250), f(251), f(252), f(253), 
    f(254), f(255), f(256), f(257), f(258), f(259), f(260), f(261), f(262), 
    f(263), f(264), f(265), f(266), f(267), f(268), f(269), f(270), f(271), 
    f(272), f(273), f(274), f(275), f(276), f(277), f(278), f(279), f(280), 
    f(281), f(282), f(283), f(284), f(285), f(286), f(287), f(288), f(289), 
    f(290), f(291), f(292), f(293), f(294), f(295), f(296), f(297), f(298), 
    f(299), f(300), f(301), f(302), f(303), f(304), f(305), f(306), f(307), 
    f(308), f(309), f(310), f(311), f(312), f(313), f(314), f(315), f(316), 
    f(317), f(318), f(319), f(320), f(321), f(322), f(323), f(324), f(325), 
    f(326), f(327), f(328), f(329)
]

// %% [markdown]
// ## One refusal
//
// The jet's l = 2 block is five numbers, and reading the first of them looks
// like reading any other array element. It is not: those five numbers are the
// components of a rank-2 tensor in a particular basis, and the component that
// is first depends on which basis. Rotate the molecule and `x(JO1)` changes;
// the tensor did not. So a function that returns it cannot be an equivariant
// map to a scalar, and under `where ml.equiv(O3)` the compiler refuses with
// BL4008 and names the read.
//
// Note what the same code does one slot earlier. `x(0)` is an l = 0 slot — a
// genuine invariant — and reading it certifies without complaint; that is what
// `ml.scalars` is. The refusal is not "no component reads", it is "no component
// reads that a rotation would move".
//
// **This cell fails on purpose.** A failing cell never joins the notebook
// session, so nothing downstream is disturbed. `examples/tetris_shapes.bladenb`
// runs the full suite of these, including a chirality theorem delivered as a
// compile error.

// %%
function anisotropy(x: Array<Float like IrrepsIdx<JETPAIR>>)
                    where ml.equiv(O3) -> Float = x(JO1)

// %% [markdown]
// ## The arithmetic bill
//
// The next three cells are where this notebook spends its time: 600 geometries
// times 210 pairs times two orders of `ml.derive_poly`, plus 600 times 21 atoms
// times three orders for the other arm. It runs once, in the interpreter, and
// every later cell reads the tables out of the session memo. The featurization
// depends on no weight, so it sits outside every gradient — which is also why
// the three arms can share one pass and differ only in what they read from it.
//
// One structural note for anyone extending this notebook: **do the elaboration
// first**. Every cell above this point that introduces a new `ml.*` operation
// has already run, on purpose. A cell that elaborates a new kernel invalidates
// the interpreter session's value memo, and if one appeared after these three
// it would pay for them again.

// %%
let __jtr = {
    let rec h: Array<Float like Idx<500>, Idx<126>> =
        match h with
        | zero -> zero
        | prefix :: n -> prefix :: jetrow(tr_flat(n))
    h
}
__jtr(499, 0)

// %%
let __jte = {
    let rec h: Array<Float like Idx<100>, Idx<126>> =
        match h with
        | zero -> zero
        | prefix :: n -> prefix :: jetrow(te_flat(n))
    h
}
__jte(99, 0)

// %%
let __qtr = {
    let rec h: Array<Float like Idx<500>, Idx<93>> =
        match h with
        | zero -> zero
        | prefix :: n -> prefix :: posrow(tr_flat(n))
    h
}
let __qte = {
    let rec h: Array<Float like Idx<100>, Idx<93>> =
        match h with
        | zero -> zero
        | prefix :: n -> prefix :: posrow(te_flat(n))
    h
}
__qte(99, 0)

// %% [markdown]
// ## Calibration, and why an l > 0 block gets no centre
//
// Raw jet slots differ in scale by two orders of magnitude — an order-4 moment
// of a 3 Angstrom vector is a hundred times an order-2 one — so the features are
// standardized before the network sees them. The rule is forced by
// equivariance, not chosen: an **invariant** slot may be given a centre and a
// spread, because shifting and scaling an invariant leaves it invariant; an
// **l > 0 multiplicity** may be given a spread only, and one spread for the
// whole multiplicity, because subtracting a constant from a vector is not
// equivariant and rescaling its components separately is not either. The
// compiler would be within its rights to say so if this were written inside a
// certified body; it is written outside one, so the discipline is ours to keep,
// and the group structure comes straight off `ml.irreps_offset`.
//
// The order-2 features are the standardized order-2+4 row projected by the
// baked gather `__k2ix`, so arm two literally reads a sub-array of arm three's
// input. Nothing else about the two arms differs.

// %%
function jmu_of(k: Int) -> Float = {
    let rec a: Array<Float like Idx<500>> =
        match a with
        | zero -> zero
        | prefix :: n -> prefix :: __jtr(n, k)
    reduce(a, (+)) / 500.0
}
function jms_of(k: Int) -> Float = {
    let rec a: Array<Float like Idx<500>> =
        match a with
        | zero -> zero
        | prefix :: n -> prefix :: __jtr(n, k) * __jtr(n, k)
    reduce(a, (+)) / 500.0
}
let __jmu = {
    let rec m: Array<Float like Idx<126>> =
        match m with
        | zero -> zero
        | prefix :: k -> prefix :: jmu_of(k)
    m
}
let __jms = {
    let rec m: Array<Float like Idx<126>> =
        match m with
        | zero -> zero
        | prefix :: k -> prefix :: jms_of(k)
    m
}
function qmu_of(k: Int) -> Float = {
    let rec a: Array<Float like Idx<500>> =
        match a with
        | zero -> zero
        | prefix :: n -> prefix :: __qtr(n, k)
    reduce(a, (+)) / 500.0
}
function qms_of(k: Int) -> Float = {
    let rec a: Array<Float like Idx<500>> =
        match a with
        | zero -> zero
        | prefix :: n -> prefix :: __qtr(n, k) * __qtr(n, k)
    reduce(a, (+)) / 500.0
}
let __qmu = {
    let rec m: Array<Float like Idx<93>> =
        match m with
        | zero -> zero
        | prefix :: k -> prefix :: qmu_of(k)
    m
}
let __qms = {
    let rec m: Array<Float like Idx<93>> =
        match m with
        | zero -> zero
        | prefix :: k -> prefix :: qms_of(k)
    m
}
// Multiplicity group of a slot: where it starts and how wide it is.
function jgs(k: Int) -> Int64 = {
    let kk = Int64(k)
    let a = JO1 + ((kk - JO1) / 5) * 5
    let b = JO2 + ((kk - JO2) / 9) * 9
    if kk < JO1 then kk else (if kk < JO2 then a else b)
}
// Block widths as plain ints: 1, 5, 9 -- the `jet_blocks` pin above is what
// asserts they are `ml.irreps_dim`'s answer for the three blocks.
function jgl(k: Int) -> Int64 = if k < JO1 then 1 else (if k < JO2 then 5 else 9)
function qgs(k: Int) -> Int64 = {
    let kk = Int64(k)
    let a = PJ1 + ((kk - PJ1) / 3) * 3
    let b = PJ2 + ((kk - PJ2) / 5) * 5
    let c = PJ3 + ((kk - PJ3) / 7) * 7
    let d = PJ4 + ((kk - PJ4) / 9) * 9
    if kk < PJ1 then kk else (if kk < PJ2 then a else (if kk < PJ3 then b else (if kk < PJ4 then c else d)))
}
function qgl(k: Int) -> Int64 = if k < PJ1 then 1 else (if k < PJ2 then 3 else (if k < PJ3 then 5 else (if k < PJ4 then 7 else 9)))
function grp_ms(ms: Array<Float like Idx<126>>, g: Int64, d: Int64) -> Float = {
    let rec a: Array<Float like Idx<9>> =
        match a with
        | zero -> zero
        | prefix :: j -> prefix :: (if Int64(j) < d then ms(g + Int64(j)) else 0.0)
    reduce(a, (+)) / Float64(d)
}
function grp_ms93(ms: Array<Float like Idx<93>>, g: Int64, d: Int64) -> Float = {
    let rec a: Array<Float like Idx<9>> =
        match a with
        | zero -> zero
        | prefix :: j -> prefix :: (if Int64(j) < d then ms(g + Int64(j)) else 0.0)
    reduce(a, (+)) / Float64(d)
}
function jsc_of(k: Int) -> Float = {
    let d = jgl(k)
    let base = grp_ms(__jms, jgs(k), d)
    let v = if k < JO1 then base - __jmu(k) * __jmu(k) else base
    if v < 0.000000000001 then 0.0 else 1.0 / sqrt(v)
}
function qsc_of(k: Int) -> Float = {
    let d = qgl(k)
    let base = grp_ms93(__qms, qgs(k), d)
    let v = if k < PJ1 then base - __qmu(k) * __qmu(k) else base
    if v < 0.000000000001 then 0.0 else 1.0 / sqrt(v)
}
let __jcen = {
    let rec m: Array<Float like Idx<126>> =
        match m with
        | zero -> zero
        | prefix :: k -> prefix :: (if k < JO1 then __jmu(k) else 0.0)
    m
}
let __qcen = {
    let rec m: Array<Float like Idx<93>> =
        match m with
        | zero -> zero
        | prefix :: k -> prefix :: (if k < PJ1 then __qmu(k) else 0.0)
    m
}
let __jsc = {
    let rec m: Array<Float like Idx<126>> =
        match m with
        | zero -> zero
        | prefix :: k -> prefix :: jsc_of(k)
    m
}
let __qsc = {
    let rec m: Array<Float like Idx<93>> =
        match m with
        | zero -> zero
        | prefix :: k -> prefix :: qsc_of(k)
    m
}
// JETK2 slot -> JETPAIR slot. Baked, because the arithmetic in `k2_of` uses
// `if` and the accessors below are read from inside differentiated bodies.
let __k2ix: Array<Int64 like Idx<36>> = [
     0, 2, 4, 6, 8, 10, 12, 13, 14, 15, 16, 22, 23, 24, 25, 26, 32, 33, 34, 
     35, 36, 42, 43, 44, 45, 46, 52, 53, 54, 55, 56, 62, 63, 64, 65, 66
]
function jstd(row: Array<Float like Idx<126>>) -> Array<Float like Idx<126>> = {
    let rec o: Array<Float like Idx<126>> =
        match o with
        | zero -> zero
        | prefix :: k -> prefix :: (row(k) - __jcen(k)) * __jsc(k)
    o
}
function qstd(row: Array<Float like Idx<93>>) -> Array<Float like Idx<93>> = {
    let rec o: Array<Float like Idx<93>> =
        match o with
        | zero -> zero
        | prefix :: k -> prefix :: (row(k) - __qcen(k)) * __qsc(k)
    o
}
function jrow_tr(n: Int) -> Array<Float like Idx<126>> = {
    let rec o: Array<Float like Idx<126>> =
        match o with
        | zero -> zero
        | prefix :: k -> prefix :: (__jtr(n, k) - __jcen(k)) * __jsc(k)
    o
}
function jrow_te(n: Int) -> Array<Float like Idx<126>> = {
    let rec o: Array<Float like Idx<126>> =
        match o with
        | zero -> zero
        | prefix :: k -> prefix :: (__jte(n, k) - __jcen(k)) * __jsc(k)
    o
}
let __ftr = {
    let rec h: Array<Float like Idx<500>, Idx<126>> =
        match h with
        | zero -> zero
        | prefix :: n -> prefix :: jrow_tr(n)
    h
}
let __fte = {
    let rec h: Array<Float like Idx<100>, Idx<126>> =
        match h with
        | zero -> zero
        | prefix :: n -> prefix :: jrow_te(n)
    h
}
let __gtr = {
    let rec h: Array<Float like Idx<500>, Idx<93>> =
        match h with
        | zero -> zero
        | prefix :: n -> prefix :: qstd(__qtr(n))
    h
}
let __gte = {
    let rec h: Array<Float like Idx<100>, Idx<93>> =
        match h with
        | zero -> zero
        | prefix :: n -> prefix :: qstd(__qte(n))
    h
}
// The representation-typed accessors. Each is a recursive array read out of a
// standardized table followed by the ascription that gives those numbers their
// representation; from here on the type system is in charge.
function as_jet(f: Array<Float like Idx<126>>) -> Array<Float like IrrepsIdx<JETPAIR>> = [
     f(0), f(1), f(2), f(3), f(4), f(5), f(6), f(7), f(8), f(9), f(10), 
     f(11), f(12), f(13), f(14), f(15), f(16), f(17), f(18), f(19), f(20), 
     f(21), f(22), f(23), f(24), f(25), f(26), f(27), f(28), f(29), f(30), 
