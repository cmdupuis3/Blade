import units.SI

// Welch's overlapped segment averaging (WOSA) over the generalized
// Lomb-Scargle DFT, for unevenly sampled series. Translated from the dask
// reference implementation; same estimator, spelled in Blade's typed-tuple +
// group_by idiom -- but NOT the same decomposition, because the overlap has
// structure the reference's sequential loop cannot see.
//
// THE OVERLAP IS A SLIDING WINDOW. 50%-overlapped segments are not a
// partition: each sample lands in up to two segments, so a per-segment loop
// evaluates cos(w t) and sin(w t) TWICE for every (sample, frequency), and
// those transcendentals are ~90% of the run time. With h = span/(N+1), the N
// segments are exactly the N ADJACENT PAIRS of the N+1 half-width cells
//     cell m = [m h, (m+1) h),   segment j = cell j + cell j+1
// so the even/odd families of non-overlapping segments collapse into ONE
// window of 2 over cells, and each transcendental is evaluated exactly ONCE.
//
// EVERY INPUT THE LS KERNEL NEEDS IS A SUM over a segment's samples, hence a
// sum of its two cells' sums. That includes the taper, which is the part that
// looks like it should not decompose: `hanning`'s span is 2h for EVERY segment
// and its cosine takes the ABSOLUTE time, so the taper VALUES are segment-
// independent and can be formed once, globally. Only the normalization
// scale = mean(w^2) over the segment's own samples varies, and that is
// (sum w^2 over both cells) / (count over both cells). The kernel's
// mean-centering decomposes the same way. So with u = s * w also global, the
// six per-(cell, frequency) accumulators below are sufficient.
//
// This is why the reference's two quirks are preserved rather than "fixed":
// the absolute-time taper argument is precisely what makes the decomposition
// exact. Flagged so nobody corrects one side into disagreement with the other.
//
// The LS kernel is the REAL-VALUED tau formulation, algebraically eliminated:
// with ct = cos(wt) and stt = sin(wt), the double-angle identities give the
// tau rotation from sum ct^2 and sum ct*stt, and sum cos^2(w(t-tau)) collapses
// to (n + |Z2|)/2 exactly -- so one shared trig pass feeds everything.

Unit day = 86400 * second
Unit time: day
Unit frequency: 1 / day

// The segment count is a COMPILE-TIME property here, not a runtime argument:
// the cell axis carries an index type, and `halo` needs its extent. So the
// CELL COUNT is the single source of truth and the segment count is derived
// from it -- a halo whose extent overshoots its operand reads out of bounds,
// and one that undershoots silently drops trailing windows, so the two must
// not be able to drift apart.
//
// The extent has to be a LITERAL: `Idx<n + 1>` over a `let static n`, whether
// written inline or behind an alias, currently mis-emits inside a lifted
// kernel (the halo's range is not forwarded). Hence 11 spelled out, with the
// segment count read back off the axis rather than written twice.
type CellIdx = Idx<11>

let i = complex(0.0, 1.0)
let two_pi = 6.283185307179586

function mymean(x: T^1) = reduce(x, (+)) / extents(x)

function variance(x: T^1) = {
    let d = x - mymean(x)
    prodsum(d, d) / extents(d)
}

function mymin(x: T^1) = reduce(x, lambda(a, b) -> if a < b then a else b)
function mymax(x: T^1) = reduce(x, lambda(a, b) -> if a > b then a else b)

/// Hamming-family taper (alpha = 0.53836), formed ONCE for the whole series.
/// Faithful to the reference, including the quirk that makes this possible:
/// the cosine's argument is the ABSOLUTE (epoch-shifted) time over the segment
/// span, not t - lower, and the span is 2h for every segment -- so the taper
/// is a function of t alone. Segments differ only in the normalization applied
/// downstream, which is why that is left to the caller.
function segment_taper(ts: T<time>^1, seg_span: T<time>) = {
    let alpha = 0.53836
    let beta = 1.0 - alpha
    (ts <@> lambda(t) -> alpha - beta * cos(two_pi * t / seg_span)) |> compute
}

/// WOSA: overlapped segments as ONE sliding window over half-width cells,
/// Hamming-tapered, per-segment LS spectra, modulus averaged and phase
/// circular-averaged, Welch normalization verbatim from the reference.
///
/// Reference quirk kept: segment bounds live on [0, t_max - t_min] but are
/// compared against ts = t_raw - t_zero (NOT shifted by t_min), so a series
/// whose ts does not start near zero selects off-window segments.
function lswosa(st: Tuple<U^1, T<time>^1>,
                freqs: T<frequency>^1, t_zero: T<time> = 0.0)
where omp(st: 1) = {
    let s_raw, t_raw = st
    let ts = t_raw - t_zero
    // `mymin`/`mymax` are generic over `T^1`, so the fold hands back a bare
    // number -- the `time` quantity does not survive a unit-agnostic callee.
    // Re-assert it here, at the one place the value is known to be a time.
    let t_min: Float64<time> = mymin(ts)
    let t_max: Float64<time> = mymax(ts)
    let span_total = t_max - t_min

    let s_var = variance(s_raw)
    let n_samples = extents(s_raw)
    // MUST equal CellIdx's extent - 1 (see the note by CellIdx). Reading it
    // back off the axis instead would tie the two, but neither
    // `extents(range<CellIdx>)` nor a static-expression extent emits today.
    let n_segments = 10.0

    // QUANTITIES ARE TERMINAL, so every derived value here is STRUCTURALLY
    // dimensioned (`86400 * second`) rather than carrying the nominal `time`.
    // Assert it once per binding, where the value is named.
    let h: Float64<time> = span_total / (n_segments + 1.0)
    let seg_span: Float64<time> = 2.0 * h
    let hi: Float64<time> = (n_segments + 1.0) * h

    // Global, segment-independent: the taper, the tapered signal, and w^2.
    let tap = segment_taper(ts, seg_span)
    let uu  = (s_raw * tap) |> compute
    let w2  = (tap * tap) |> compute

    // CELL PARTITION. Selection lives in the KEY function: a negative key
    // excludes the sample from every group (the sentinel rule), so nothing
    // needs a mask/compound pass. The top bound is inclusive -- hi is (N+1)h
    // = t_max exactly by construction, and a bare floor would mint a phantom
    // one-sample cell past the end, which is what the reference's inclusive
    // `t <= upper` avoids.
    let keys = (ts <@> lambda(t) ->
        if t >= 0.0 && t <= hi then {
            let k = floor(t / h)
            if k > n_segments then n_segments else k
        } else 0.0 - 1.0) |> compute
    let gk  = group_keys(keys)
    let gt  = group_by(ts, gk)
    let gu  = group_by(uu, gk)
    let gw2 = group_by(w2, gk)

    // Frequency-INDEPENDENT per-cell sums, hoisted clear of the omega loop:
    // the taper does not depend on the frequency, so its normalization and
    // the mean-centering are computed once for the whole spectrum.
    let n_cell  = (gt  <@> lambda(row: T^1) -> 1.0 * extents(row)) |> compute
    let w2_cell = (gw2 <@> lambda(row: T^1) -> reduce(row, (+))) |> compute
    let u_cell  = (gu  <@> lambda(row: T^1) -> reduce(row, (+))) |> compute

    let spec = freqs <@> lambda(f) where omp(f: 1) -> {
        let w = two_pi * f

        // ONE shared trig pass per (cell, frequency). ct/stt stay DEFERRED --
        // naming them IS the sharing declaration -- so the reduction join
        // fills all six accumulators in a single traversal of the cell's
        // samples, and the rank-raising literal hands them back per row.
        let cellacc = method_for(zip(gt, gu)) <@> lambda(trow: T<time>^1, urow: U^1) -> {
            let ct  = trow <@> lambda(t) -> cos(w * t)
            let stt = trow <@> lambda(t) -> sin(w * t)
            let a, b, c, d, e, g = object_for(<&!>) <@> (prodsum(urow, ct), prodsum(urow, stt),
                                                         reduce(ct, (+)), reduce(stt, (+)),
                                                         prodsum(ct, ct), prodsum(ct, stt))
            [a, b, c, d, e, g]
        } |> compute

        // SEGMENT = adjacent cell pair. Every read is X(win(0)) / X(win(1)),
        // so the taper normalization, the mean-centering and the six
        // accumulators all combine in one window.
        let segv = method_for(halo<CellIdx, [0, 1]>) <@> lambda(win) -> {
            let nf  = n_cell(win(0))  + n_cell(win(1))
            let sw2 = w2_cell(win(0)) + w2_cell(win(1))
            let su  = u_cell(win(0))  + u_cell(win(1))
            let rs  = 1.0 / sqrt(sw2 / nf)      // 1 / sqrt(scale) for this segment
            let mk  = rs * su / nf              // mean of the tapered row

            let sa_ = cellacc(win(0), 0) + cellacc(win(1), 0)
            let sb_ = cellacc(win(0), 1) + cellacc(win(1), 1)
            let sc_ = cellacc(win(0), 2) + cellacc(win(1), 2)
            let sd_ = cellacc(win(0), 3) + cellacc(win(1), 3)
            let qcc = cellacc(win(0), 4) + cellacc(win(1), 4)
            let qcs = cellacc(win(0), 5) + cellacc(win(1), 5)

            // Centering is linear, so it applies to the SUMMED accumulators.
            let pc = rs * sa_ - mk * sc_
            let ps = rs * sb_ - mk * sd_

            // tau nulls the cross term. 2A = arg(Z2) makes cos2A*C2 + sin2A*S2
            // collapse to |Z2|, so sum cos^2(w(t-tau)) = (n + |Z2|)/2 exactly.
            let c2 = 2.0 * qcc - nf
            let s2 = 2.0 * qcs
            let r  = sqrt(c2 * c2 + s2 * s2)
            let ha = atan2(s2, c2) / 2.0        // = w * tau, exactly
            let ca = cos(ha)
            let sa = sin(ha)

            let av = (ca * pc + sa * ps) / sqrt((nf + r) / 2.0)
            let bv = (ca * ps - sa * pc) / sqrt((nf - r) / 2.0)

            let zz = complex(av, bv) * exp(i * w * t_zero)
            let re = real(zz)
            let im = imag(zz)
            let ar = atan2(im, re)
            [re * re + im * im, cos(ar), sin(ar)]
        } |> compute

        // Fold the LEADING (segment) axis: an array-valued kernel combines
        // whole 3-vectors, leaving one set of accumulations per frequency.
        let acc = reduce(segv, lambda(a: T^1, b: T^1) -> a + b)
        // Two per-frequency outputs travel as ONE complex, so the frequency
        // map stays rank 1 and both fall out elementwise below (`<@>` over a
        // rank-2 array maps ELEMENTS, not rows, so it could not be sliced).
        complex(acc(0) / n_segments, atan2(acc(2) / n_segments, acc(1) / n_segments))
    } |> compute

    let mod_avg = (spec <@> lambda(z) -> real(z)) |> compute
    let arg_avg = (spec <@> lambda(z) -> imag(z)) |> compute

    // Welch normalization, verbatim from the reference.
    let nsegs = 2.0 * n_samples / (n_segments + 1.0)
    let df = reduce(freqs, (+)) / nsegs
    let factors = 2.0 / (n_segments * nsegs * df) * (s_var / (df * reduce(mod_avg, (+))))

    complex(cos <@> arg_avg |> compute, sin <@> arg_avg |> compute) * mod_avg * factors
}
